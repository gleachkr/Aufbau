  $ (a :x hF) + (b :x hC) = ((a + b) + (hZ :x h1)) :x hB $;
--| @conversion ltr
axiom addc_F_D (a b: bv):
  $ (a :x hF) + (b :x hD) = ((a + b) + (hZ :x h1)) :x hC $;
--| @conversion ltr
axiom addc_F_E (a b: bv):
  $ (a :x hF) + (b :x hE) = ((a + b) + (hZ :x h1)) :x hD $;
--| @conversion ltr
axiom addc_F_F (a b: bv):
  $ (a :x hF) + (b :x hF) = ((a + b) + (hZ :x h1)) :x hE $;
--| @conversion ltr
axiom add_zz: $ hZ + hZ = hZ $;

theorem thm (x v0 v1 a b d e f g: bv)
  (h1: $ v0 = x + (hZ :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF
    :x hF :x hF :x hF :x hF :x hF :x hF) $)
  (h2: $ v1 = v0 + (hZ :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1
    :x h1 :x h1 :x h1 :x h1 :x h1 :x h1) $)
  (h3: $ d = a + b $)
  (h4: $ e = d + (hZ :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0
    :x h0 :x h0 :x h0 :x h0 :x h0 :x h1) $)
  (h5: $ f = e + (hZ :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0
    :x h0 :x h0 :x h0 :x h0 :x h0 :x h1) $)
  (h6: $ g = f + e $)
  : $ v1 = x + (hZ :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0
    :x h0 :x h0 :x h0 :x h0 :x h0 :x h0) $;
