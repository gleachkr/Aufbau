  $ (a :x hF) + (b :x h9) = ((a + b) + (hZ :x h1)) :x h8 $;
--| @compute ltr
axiom addc_F_A (a b: bv):
  $ (a :x hF) + (b :x hA) = ((a + b) + (hZ :x h1)) :x h9 $;
--| @compute ltr
axiom addc_F_B (a b: bv):
  $ (a :x hF) + (b :x hB) = ((a + b) + (hZ :x h1)) :x hA $;
--| @compute ltr
axiom addc_F_C (a b: bv):
  $ (a :x hF) + (b :x hC) = ((a + b) + (hZ :x h1)) :x hB $;
--| @compute ltr
axiom addc_F_D (a b: bv):
  $ (a :x hF) + (b :x hD) = ((a + b) + (hZ :x h1)) :x hC $;
--| @compute ltr
axiom addc_F_E (a b: bv):
  $ (a :x hF) + (b :x hE) = ((a + b) + (hZ :x h1)) :x hD $;
--| @compute ltr
axiom addc_F_F (a b: bv):
  $ (a :x hF) + (b :x hF) = ((a + b) + (hZ :x h1)) :x hE $;
--| @compute ltr
axiom add_zz: $ hZ + hZ = hZ $;
--| @compute ltr
axiom add_z (a: bv): $ hZ + a = a $;

theorem thm_compute (x a b d e f g: bv)
  (h1: $ d = a + b $)
  (h2: $ e = d + (hZ :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0
    :x h0 :x h0 :x h0 :x h0 :x h0 :x h1) $)
  (h3: $ f = e + (hZ :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0 :x h0
    :x h0 :x h0 :x h0 :x h0 :x h0 :x h1) $)
  (h4: $ g = f + e $)
  (h5: $ d = x + (hZ :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF :x hF) + (hZ :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1) $)
  : $ d = x + (hZ :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h1 :x h0) $;
