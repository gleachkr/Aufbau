-- `@compute` acceptance: the carry-cascade digit table, folded.
--
-- The same 256-entry hex digit-addition table as
-- carry_cascade_interference.mm0 (plus the zero laws), but enrolled
-- with `@compute ltr` instead of `@conversion ltr`. Undirected
-- saturation explodes on this theory: every regrouping of a bag
-- matches, every application order mints distinct intermediate carry
-- towers, and the widened search grinds to a budget-limited fixpoint
-- without finding a chain. The directed fold scheduler instead
-- consumes one designated redex per class per round, so adding the
-- all-F and all-1 numerals is linearly many folds: the goal (the
-- correct 17-digit sum 0x1{1x15}0) must be FOUND at plain defaults,
-- interference chain and all.
--
-- `add_z` matters: carry prefixes accumulate hZ atoms ({hZ, t} bags),
-- and the digit rules alone cannot clear them (their patterns need two
-- `:x`-shaped members), so without the zero identity the correct sum
-- is not derivable at all.
--
-- Declaration order is the fold's redex priority: each class reduces
-- its first fresh match in rule order. With `add_z` last (as here),
-- digit pairs consume before zero debris clears; declared first, the
-- per-position {hZ, t} ladders clear as they form and the recorded
-- chain nests differently. Both orderings must extract and lower —
-- the reversed ordering (once an honest convertible-but-unlowered
-- miss, #149) is regression-guarded by a splice of this file in
-- tests.zig.
--
-- `+` is also declared `@acui`, so the lowering elides every
-- rearrangement proof (re-treeing seams, assoc/comm splices, hZ
-- clears): the line check's normalized validation re-derives them
-- wherever a join spans the gap, and the emitted chain is essentially
-- just the digit folds.

delimiter $ ( ) $;

provable sort wff;
sort bv;

term iff (a b: wff): wff;
infixl iff: $<->$ prec 20;
term eq (a b: bv): wff;
infixl eq: $=$ prec 50;

term hZ: bv;
term hx (a d: bv): bv;
infixl hx: $:x$ prec 100;
--| @acui add_assoc add_comm hZ _
term add (a b: bv): bv;
infixl add: $+$ prec 64;

term h0: bv;
term h1: bv;
term h2: bv;
term h3: bv;
term h4: bv;
term h5: bv;
term h6: bv;
term h7: bv;
term h8: bv;
term h9: bv;
term hA: bv;
term hB: bv;
term hC: bv;
term hD: bv;
term hE: bv;
term hF: bv;

--| @relation wff iff iff_refl iff_trans iff_symm mpbi
axiom iff_refl (a: wff): $ a <-> a $;
axiom iff_trans (a b c: wff) (h1: $ a <-> b $) (h2: $ b <-> c $):
  $ a <-> c $;
axiom iff_symm (a b: wff) (h: $ a <-> b $): $ b <-> a $;
axiom mpbi (a b: wff) (h1: $ a <-> b $) (h2: $ a $): $ b $;

--| @relation bv eq eq_refl eq_trans eq_symm _
axiom eq_refl (a: bv): $ a = a $;
axiom eq_trans (a b c: bv) (h1: $ a = b $) (h2: $ b = c $):
  $ a = c $;
axiom eq_symm (a b: bv) (h: $ a = b $): $ b = a $;

--| @congr
axiom eq_congr (a b c d: bv) (h1: $ a = b $) (h2: $ c = d $):
  $ (a = c) <-> (b = d) $;
--| @congr
axiom add_congr (a b c d: bv) (h1: $ a = b $) (h2: $ c = d $):
  $ (a + c) = (b + d) $;
--| @congr
axiom hx_congr (a b c d: bv) (h1: $ a = b $) (h2: $ c = d $):
  $ (a :x c) = (b :x d) $;

--| @conversion assoc
axiom add_assoc (a b c: bv): $ ((a + b) + c) = (a + (b + c)) $;
--| @conversion comm
axiom add_comm (a b: bv): $ (a + b) = (b + a) $;

--| @compute ltr
axiom addd_0_0 (a b: bv):
  $ (a :x h0) + (b :x h0) = (a + b) :x h0 $;
--| @compute ltr
axiom addd_0_1 (a b: bv):
  $ (a :x h0) + (b :x h1) = (a + b) :x h1 $;
--| @compute ltr
axiom addd_0_2 (a b: bv):
  $ (a :x h0) + (b :x h2) = (a + b) :x h2 $;
--| @compute ltr
axiom addd_0_3 (a b: bv):
  $ (a :x h0) + (b :x h3) = (a + b) :x h3 $;
--| @compute ltr
axiom addd_0_4 (a b: bv):
  $ (a :x h0) + (b :x h4) = (a + b) :x h4 $;
--| @compute ltr
axiom addd_0_5 (a b: bv):
