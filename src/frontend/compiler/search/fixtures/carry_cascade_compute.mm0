--| @compute ltr
axiom addd_1_5 (a b: bv):
  $ (a :x h1) + (b :x h5) = (a + b) :x h6 $;
--| @compute ltr
axiom addd_1_6 (a b: bv):
  $ (a :x h1) + (b :x h6) = (a + b) :x h7 $;
--| @compute ltr
axiom addd_1_7 (a b: bv):
  $ (a :x h1) + (b :x h7) = (a + b) :x h8 $;
--| @compute ltr
axiom addd_1_8 (a b: bv):
  $ (a :x h1) + (b :x h8) = (a + b) :x h9 $;
--| @compute ltr
axiom addd_1_9 (a b: bv):
  $ (a :x h1) + (b :x h9) = (a + b) :x hA $;
--| @compute ltr
axiom addd_1_A (a b: bv):
  $ (a :x h1) + (b :x hA) = (a + b) :x hB $;
--| @compute ltr
axiom addd_1_B (a b: bv):
