--| @compute ltr
axiom addd_0_7 (a b: bv):
  $ (a :x h0) + (b :x h7) = (a + b) :x h7 $;
--| @compute ltr
axiom addd_0_8 (a b: bv):
  $ (a :x h0) + (b :x h8) = (a + b) :x h8 $;
--| @compute ltr
axiom addd_0_9 (a b: bv):
  $ (a :x h0) + (b :x h9) = (a + b) :x h9 $;
--| @compute ltr
axiom addd_0_A (a b: bv):
  $ (a :x h0) + (b :x hA) = (a + b) :x hA $;
--| @compute ltr
axiom addd_0_B (a b: bv):
  $ (a :x h0) + (b :x hB) = (a + b) :x hB $;
--| @compute ltr
axiom addd_0_C (a b: bv):
  $ (a :x h0) + (b :x hC) = (a + b) :x hC $;
--| @compute ltr
axiom addd_0_D (a b: bv):
