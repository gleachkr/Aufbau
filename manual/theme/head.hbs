<script type="module">
  import "@aufbau/editor";
</script>
<script>
  // The proof editor lives in a shadow root, so its keystrokes bubble out to
  // `document` retargeted to the <aufbau-*> host, where mdbook's global key
  // handlers (the `?` help overlay, `s`/`/` search, chapter nav) mistake them
  // for page shortcuts and swallow characters — you couldn't type the `?` in
  // `auto?`. Stop keyboard events that originate inside a cell before they
  // reach those handlers. This runs from <head>, before book.js, so it is the
  // first document listener in the bubble phase and can halt the rest.
  for (const type of ["keydown", "keyup", "keypress"]) {
    document.addEventListener(type, function (event) {
      for (const node of event.composedPath()) {
        if (node.tagName && node.tagName.startsWith("AUFBAU-")) {
          event.stopImmediatePropagation();
          return;
        }
      }
    });
  }
</script>
<style>
  .aufbau-cell {
    margin: 1.2rem 0;
    /* Proof lines run much longer than a line of prose, so let cells spill
       out of the 750px reading column when the window has room to spare.
       The spill is end-side only: that margin is ragged anyway, and every
       cell keeps the same start edge as the prose. The breakpoints stay
       inside the free space beside `.content main` on that one side, with
       the 300px sidebar open; below 1200px there is none, so the cell sits
       in the column and the editor falls back to wrapping. */
    margin-inline-end: calc(-1 * var(--aufbau-cell-bleed, 0px));
  }
  @media only screen and (min-width: 1200px) {
    .aufbau-cell { --aufbau-cell-bleed: 4rem; }
  }
  @media only screen and (min-width: 1500px) {
    .aufbau-cell { --aufbau-cell-bleed: 11rem; }
  }
  @media only screen and (min-width: 1800px) {
    .aufbau-cell { --aufbau-cell-bleed: 18rem; }
  }
  aufbau-proof,
  aufbau-theory,
  aufbau-index {
    display: block;
    margin: 0.6rem 0;
    /* Match the size mdbook gives its code blocks (--code-font-size); the
       cells inherit the prose size otherwise, which is a fifth wider. */
    font-size: var(--code-font-size, 0.875em);
  }
</style>
