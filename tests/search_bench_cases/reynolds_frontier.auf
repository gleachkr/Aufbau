poly_compose
------------

l1: $ g , f : b → c , n : a → b , x : a ⊢ x : a $ by t_var
l2: $ g , f : b → c , n : a → b , x : a ⊢ n : a → b $ by t_var
l3: $ g , f : b → c , n : a → b , x : a ⊢ n · x : b $ by t_app [l2, l1]
l4: $ g , f : b → c , n : a → b , x : a ⊢ f : b → c $ by t_var
l5: $ g , f : b → c , n : a → b , x : a ⊢ f · (n · x) : c $ by t_app [l4, l3]
l6: $ g , f : b → c , n : a → b ⊢ (λ x : a. f · (n · x)) : a → c $ by t_lam [l5]
l7: $ g , f : b → c ⊢ (λ n : a → b. λ x : a. f · (n · x)) : (a → b) → a → c $
  by t_lam [l6]
l8: $ g ⊢ (λ f : b → c. λ n : a → b. λ x : a. f · (n · x))
      : (b → c) → (a → b) → a → c $ by t_lam [l7]
l9: $ g ⊢ (Λ c. λ f : b → c. λ n : a → b. λ x : a. f · (n · x))
      : ∀ c. (b → c) → (a → b) → a → c $ by t_tlam [l8]
l10: $ g ⊢ (Λ b. Λ c. λ f : b → c. λ n : a → b. λ x : a. f · (n · x))
      : ∀ b. ∀ c. (b → c) → (a → b) → a → c $ by t_tlam [l9]
l11: $ g ⊢ (Λ a. Λ b. Λ c. λ f : b → c. λ n : a → b. λ x : a. f · (n · x))
      : ∀ a. ∀ b. ∀ c. (b → c) → (a → b) → a → c $ by t_tlam [l10]

