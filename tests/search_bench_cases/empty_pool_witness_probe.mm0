-- Depth-frontier probe: the drinker from an empty pool.
--
-- Wired as a depth-frontier regression guard in build.zig (test-frontier-smoke).
-- The theory is `nd_fol`'s. At k=9 the pool is empty and the outer `ex_intro`
-- witness is free (anything but `y`), so it is invented from the `@vars` pool.
-- The invented branch reaches `¬E , P u , ¬ P y ⊢ ⊥`, where the eager
-- `not_left` must run before `raa`: its conclusion `g , ¬ a` is additive, so it
-- sorts with the non-splitting rules (`split.conclusionIsSplit`) and its cut
-- skips `raa`'s `¬ ⊥` detours, which otherwise spend the node budget.
delimiter $ ( ) [ / ] $;

provable sort wff;
sort ctx;

--| @vars x y z u v w
sort obj;

-- ============================================================
-- First-order formula language
-- ============================================================

term im (a b: wff): wff;
infixr im: $→$ prec 25;
term an (a b: wff): wff;
infixr an: $∧$ prec 35;
term or (a b: wff): wff;
infixr or: $∨$ prec 30;
term not (a: wff): wff;
prefix not: $¬$ prec 40;
term bi (a b: wff): wff;
infixl bi: $↔$ prec 20;
term bot: wff;
notation bot: wff = ($⊥$:max);

term all {x: obj} (p: wff x): wff;
prefix all: $∀$ prec 41;
term ex {x: obj} (p: wff x): wff;
prefix ex: $∃$ prec 41;

-- Object-level substitution `[x/t] p` and `subst x / t a`, the machinery the
-- quantifier rules normalize through.
term sb_f {x: obj} (t: obj x) (p: wff x): wff;
notation sb_f {x: obj} (t: obj x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;
term sb_t {x: obj} (t: obj x) (a: obj x): obj;
notation sb_t {x: obj} (t: obj x) (a: obj x): obj =
  ($subst$:41) x ($/$:0) t a;

-- A small signature of predicate and constant symbols so concrete goals can
-- be written.  The calculus is schematic in them.
term P (a: obj): wff;
prefix P: $P$ prec 45;
term Q (a: obj): wff;
prefix Q: $Q$ prec 45;
term R (a b: obj): wff;
term cc: obj;
notation cc: obj = ($C$:max);
term dd: obj;
notation dd: obj = ($D$:max);
term ee: obj;
notation ee: obj = ($E$:max);

-- ============================================================
-- Contexts: ACUI sets of formulas (the open assumptions).
-- ============================================================

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($∅$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;

-- The ND judgement: formula `a` follows from the assumptions `g`.
term nd (g: ctx) (a: wff): wff;
infixl nd: $⊢$ prec 1;

term eq (a b: obj): wff;
infixl eq: $=$ prec 50;

-- ============================================================
-- Relation / congruence batteries (for ACUI + substitution normalization)
-- ============================================================

-- The bi-conditional is the rewrite relation on wff.
--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ a ↔ a $;
axiom bitr (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom bisym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom mpbi (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

-- ACUI equality on contexts.
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @relation obj eq eq_refl eq_trans eq_sym _
axiom eq_refl (a: obj): $ a = a $;
axiom eq_trans (a b c: obj):
  $ a = b $ > $ b = c $ > $ a = c $;
axiom eq_sym (a b: obj): $ a = b $ > $ b = a $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom nd_congr (e f: ctx) (a b: wff):
  $ ctx_eq e f $ > $ a ↔ b $ > $ (e ⊢ a) ↔ (f ⊢ b) $;

--| @congr
axiom im_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;
--| @congr
axiom an_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;
--| @congr
axiom or_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∨ c) ↔ (b ∨ d) $;
--| @congr
axiom not_congr (a b: wff): $ a ↔ b $ > $ ¬ a ↔ ¬ b $;
--| @congr
axiom all_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom ex_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;
--| @congr
axiom P_congr (a b: obj): $ a = b $ > $ P a ↔ P b $;
--| @congr
axiom Q_congr (a b: obj): $ a = b $ > $ Q a ↔ Q b $;
--| @congr
axiom R_congr (a b c d: obj):
  $ a = b $ > $ c = d $ > $ R a c ↔ R b d $;

-- Alpha-renaming rules used by @freshen when a context contains the same
-- bound variable a quantifier rule is trying to bind.
--| @alpha x y
axiom all_alpha {x y: obj} (p: wff x y):
  $ ∀ x p ↔ ∀ y ([x/y] p) $;
--| @alpha x y
axiom ex_alpha {x y: obj} (p: wff x y):
  $ ∃ x p ↔ ∃ y ([x/y] p) $;

-- Substitution pushed through the syntactic operators, so the @rewrite
-- automation can normalize the `[x/t] p` instances the quantifier rules emit.
--| @rewrite
axiom sb_t_var {x: obj} (t: obj x): $ (subst x / t x) = t $;
--| @rewrite
axiom sb_t_other {x y: obj} (t: obj x): $ (subst x / t y) = y $;
--| @rewrite
axiom sb_t_irrel {x: obj} (t: obj x) (a: obj): $ (subst x / t a) = a $;
--| @rewrite
axiom sb_f_irrel {x: obj} (t: obj x) (p: wff): $ [x/t] p ↔ p $;
--| @rewrite
axiom sb_f_im {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;
--| @rewrite
axiom sb_f_bi {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ↔ q) ↔ ([x/t] p ↔ [x/t] q) $;
--| @rewrite
axiom sb_f_an {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ∧ q) ↔ ([x/t] p ∧ [x/t] q) $;
--| @rewrite
axiom sb_f_or {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ∨ q) ↔ ([x/t] p ∨ [x/t] q) $;
--| @rewrite
axiom sb_f_not {x: obj} (t: obj x) (p: wff x):
  $ [x/t] (¬ p) ↔ ¬ [x/t] p $;
--| @rewrite
axiom sb_f_all {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∀ y p) ↔ ∀ y ([x/t] p) $;
--| @rewrite
axiom sb_f_ex {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∃ y p) ↔ ∃ y ([x/t] p) $;
--| @rewrite
axiom sb_f_bot {x: obj} (t: obj x): $ [x/t] ⊥ ↔ ⊥ $;
--| @rewrite
axiom sb_f_P {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (P a) ↔ P (subst x / t a) $;
--| @rewrite
axiom sb_f_Q {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (Q a) ↔ Q (subst x / t a) $;
--| @rewrite
axiom sb_f_R {x: obj} (t: obj x) (a b: obj x):
  $ [x/t] (R a b) ↔ R (subst x / t a) (subst x / t b) $;

-- ============================================================
-- Primitive rules: textbook classical natural deduction
-- ============================================================
--
-- Judgements `g ⊢ a` over an ACUI assumption set `g`. The introduction rules
-- are enrolled for backward search. The elimination rules are NOT: applied
-- backward, an elimination must invent its major premise (`all_elim` has to
-- guess a `∀ x ?p` whose instance is the goal), which is exactly the non-analytic
-- step normal-form ND never needs. Search reaches the eliminations through the
-- derived left rules below instead.

--| @auto trigger (hyp a)
axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

-- Weakening. Admissible (it is built into `ax`), but not derivable as a single
-- rule without it, and the derived left rules below need it.
axiom weak (g h: ctx) (a: wff): $ g ⊢ a $ > $ g , h ⊢ a $;

--| @auto eager
axiom imp_intro (g: ctx) (a b: wff):
  $ g , a ⊢ b $ > $ g ⊢ a → b $;
axiom imp_elim (g: ctx) (a b: wff):
  $ g ⊢ a → b $ > $ g ⊢ a $ > $ g ⊢ b $;

--| @auto eager 2
axiom and_intro (g: ctx) (a b: wff):
  $ g ⊢ a $ > $ g ⊢ b $ > $ g ⊢ a ∧ b $;
axiom and_elim_l (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ a $;
axiom and_elim_r (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ b $;

--| @auto backward
axiom or_intro_l (g: ctx) (a b: wff): $ g ⊢ a $ > $ g ⊢ a ∨ b $;
--| @auto backward
axiom or_intro_r (g: ctx) (a b: wff): $ g ⊢ b $ > $ g ⊢ a ∨ b $;
axiom or_elim (g: ctx) (a b c: wff):
  $ g ⊢ a ∨ b $ > $ g , a ⊢ c $ > $ g , b ⊢ c $ > $ g ⊢ c $;

--| @auto eager
axiom not_intro (g: ctx) (a: wff): $ g , a ⊢ ⊥ $ > $ g ⊢ ¬ a $;
axiom not_elim (g: ctx) (a: wff): $ g ⊢ ¬ a $ > $ g ⊢ a $ > $ g ⊢ ⊥ $;

--| @auto eager 2
axiom bi_intro (g: ctx) (a b: wff):
  $ g , a ⊢ b $ > $ g , b ⊢ a $ > $ g ⊢ a ↔ b $;
axiom bi_elim_l (g: ctx) (a b: wff): $ g ⊢ a ↔ b $ > $ g ⊢ a $ > $ g ⊢ b $;
axiom bi_elim_r (g: ctx) (a b: wff): $ g ⊢ a ↔ b $ > $ g ⊢ b $ > $ g ⊢ a $;

-- Classical reductio, the only classical principle.
--| @auto backward
axiom raa (g: ctx) (a: wff): $ g , ¬ a ⊢ ⊥ $ > $ g ⊢ a $;

-- Eigenvariable: `g: ctx` cannot depend on `x`, which is the side condition.
--| @freshen g x
--| @auto eager
axiom all_intro (g: ctx) {x: obj} (p: wff x): $ g ⊢ p $ > $ g ⊢ ∀ x p $;

--| @view {x: obj} (g: ctx x) (t: obj x) (p: wff x) (q: wff): $ g ⊢ ∀ x p $ > $ g ⊢ q $
--| @recover t q p x
axiom all_elim {x: obj} (g: ctx x) (p: wff x) (t: obj):
  $ g ⊢ ∀ x p $ > $ g ⊢ [x/t] p $;

--| @view {x: obj} (g: ctx x) (t: obj x) (p: wff x) (q: wff): $ g ⊢ q $ > $ g ⊢ ∃ x p $
--| @recover t q p x
--| @auto backward
axiom ex_intro {x: obj} (g: ctx x) (p: wff x) (t: obj):
  $ g ⊢ [x/t] p $ > $ g ⊢ ∃ x p $;

-- Eigenvariable: neither `h` nor `c` may depend on `x` (the major premise's
-- context `g` may).
--| @freshen h x
--| @freshen c x
axiom ex_elim {x: obj} (g: ctx x) (h: ctx) (p: wff x) (c: wff):
  $ g ⊢ ∃ x p $ > $ h , p ⊢ c $ > $ g , h ⊢ c $;

-- ============================================================
-- Derived left rules: the search layer (proofs in nd_fol.auf)
-- ============================================================
--
-- Each elimination rule re-stated with its major premise an assumption, in
-- the general-elimination style. Applied backward they only decompose a
-- formula already in the context, so normal-form search stays analytic.
-- Invertible ones are eager. `imp_left`, `not_left` and `all_left` keep the
-- principal, since a later branch may need it again; `not_left` is still
-- classically invertible (`raa` and weakening recover its premise), so it is
-- eager too.

--| @auto eager
theorem and_left (g: ctx) (a b c: wff):
  $ g , a , b ⊢ c $ > $ g , (a ∧ b) ⊢ c $;

--| @auto eager 2
theorem or_left (g: ctx) (a b c: wff):
  $ g , a ⊢ c $ > $ g , b ⊢ c $ > $ g , (a ∨ b) ⊢ c $;

-- Classical disjunction introduction: `a ∨ b` holds iff `a` does once `¬ b`
-- is assumed. Invertible, unlike `or_intro_l`/`or_intro_r`, which make the
-- search guess a disjunct.
--| @auto eager
theorem or_right (g: ctx) (a b: wff):
  $ g , ¬ b ⊢ a $ > $ g ⊢ a ∨ b $;

--| @auto eager
theorem bi_left (g: ctx) (a b c: wff):
  $ g , (a → b) , (b → a) ⊢ c $ > $ g , (a ↔ b) ⊢ c $;

--| @auto backward
theorem imp_left (g: ctx) (a b c: wff):
  $ g , (a → b) ⊢ a $ > $ g , (a → b) , b ⊢ c $ > $ g , (a → b) ⊢ c $;

--| @auto eager 3
theorem not_left (g: ctx) (a: wff): $ g , ¬ a ⊢ a $ > $ g , ¬ a ⊢ ⊥ $;

--| @view {x: obj} (g: ctx x) (t: obj x) (p: wff x) (q c: wff): $ g , (∀ x p) , q ⊢ c $ > $ g , (∀ x p) ⊢ c $
--| @recover t q p x
--| @freshen c x
--| @auto backward
theorem all_left {x: obj} (g: ctx x) (p: wff x) (t: obj) (c: wff):
  $ g , (∀ x p) , [x/t] p ⊢ c $ > $ g , (∀ x p) ⊢ c $;

--| @freshen g x
--| @freshen c x
--| @auto eager
theorem ex_left (g: ctx) {x: obj} (p: wff x) (c: wff):
  $ g , p ⊢ c $ > $ g , (∃ x p) ⊢ c $;

-- ============================================================
-- The probe
-- ============================================================

theorem empty_pool_witness_probe {x y: obj}:
  $ ¬ ∃ x (P x → ∀ y P y) ⊢ ∃ x (P x → ∀ y P y) $;
