l5: $ (P C → (P D → P E)) , P C , P D ⊢ P E $ by imp_left [l1, l4]
l6: $ (P C → (P D → P E)) , (P C ∧ P D) ⊢ P E $ by and_left [l5]
l7: $ (P C → (P D → P E)) ⊢ (P C ∧ P D) → P E $ by imp_intro [l6]
l8: $ ∅ ⊢ (P C → (P D → P E)) → ((P C ∧ P D) → P E) $ by imp_intro [l7]

dist_or_an_fwd
--------------
l1: $ P C ⊢ P C $ by ax
l2: $ P C ⊢ P C ∨ P D $ by or_intro_l [l1]
l3: $ P C ⊢ P C ∨ P E $ by or_intro_l [l1]
l4: $ P C ⊢ (P C ∨ P D) ∧ (P C ∨ P E) $ by and_intro [l2, l3]
l5: $ P D , P E ⊢ P D $ by ax
l6: $ P D , P E ⊢ P C ∨ P D $ by or_intro_r [l5]
l7: $ P D , P E ⊢ P E $ by ax
l8: $ P D , P E ⊢ P C ∨ P E $ by or_intro_r [l7]
l9: $ P D , P E ⊢ (P C ∨ P D) ∧ (P C ∨ P E) $ by and_intro [l6, l8]
l10: $ P D ∧ P E ⊢ (P C ∨ P D) ∧ (P C ∨ P E) $ by and_left [l9]
l11: $ P C ∨ (P D ∧ P E) ⊢ (P C ∨ P D) ∧ (P C ∨ P E) $ by or_left [l4, l10]
l12: $ ∅ ⊢ (P C ∨ (P D ∧ P E)) → ((P C ∨ P D) ∧ (P C ∨ P E)) $ by imp_intro [l11]

absorb_an_fwd
-------------
