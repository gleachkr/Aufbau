l2n: $ (∀ x (¬ P x)) , P u , ¬ P u ⊢ ¬ (P u) $ by ax
l2: $ (∀ x (¬ P x)) , P u , ¬ P u ⊢ ⊥ $ by not_elim [l2n, l1]
l3: $ (∀ x (¬ P x)) , P u ⊢ ⊥ $ by all_left [l2]
l4: $ (∀ x (¬ P x)) , (∃ y P y) ⊢ ⊥ $ by ex_left [l3]
l5: $ ∀ x (¬ P x) ⊢ ¬ ∃ y P y $ by not_intro [l4]
l6: $ ∅ ⊢ (∀ x (¬ P x)) → ¬ ∃ y P y $ by imp_intro [l5]

ex_conj_weak
------------
l1: $ P u , Q u ⊢ P u $ by ax
l2: $ P u , Q u ⊢ ∃ y P y $ by ex_intro [l1]
l3: $ P u ∧ Q u ⊢ ∃ y P y $ by and_left [l2]
l4: $ ∃ x (P x ∧ Q x) ⊢ ∃ y P y $ by ex_left [l3]
l5: $ ∅ ⊢ (∃ x (P x ∧ Q x)) → (∃ y P y) $ by imp_intro [l4]

ex_witness_conj
---------------
l1: $ P C , Q C ⊢ P C $ by ax
l2: $ P C , Q C ⊢ Q C $ by ax
l3: $ P C , Q C ⊢ P C ∧ Q C $ by and_intro [l1, l2]
l4: $ P C , Q C ⊢ ∃ x (P x ∧ Q x) $ by ex_intro [l3]
l5: $ P C ∧ Q C ⊢ ∃ x (P x ∧ Q x) $ by and_left [l4]
l6: $ ∅ ⊢ (P C ∧ Q C) → (∃ x (P x ∧ Q x)) $ by imp_intro [l5]

vac_intro
---------
l1: $ s0 ⊢ s0 $ by ax
l2: $ s0 ⊢ ∀ x s0 $ by all_intro [l1]
l3: $ ∅ ⊢ s0 → ∀ x s0 $ by imp_intro [l2]

vac_ex
------
