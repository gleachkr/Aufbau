l5: $ ¬ P C , ¬ P D , (P C ∨ P D) ⊢ ⊥ $ by or_left [l2, l4]
l6: $ (¬ P C ∧ ¬ P D) , (P C ∨ P D) ⊢ ⊥ $ by and_left [l5]
l7: $ ¬ P C ∧ ¬ P D ⊢ ¬ (P C ∨ P D) $ by not_intro [l6]
l8: $ ∅ ⊢ (¬ P C ∧ ¬ P D) → ¬ (P C ∨ P D) $ by imp_intro [l7]

exportation_fwd
---------------
l1: $ ((P C ∧ P D) → P E) , P C , P D ⊢ P C $ by ax
l2: $ ((P C ∧ P D) → P E) , P C , P D ⊢ P D $ by ax
l3: $ ((P C ∧ P D) → P E) , P C , P D ⊢ P C ∧ P D $ by and_intro [l1, l2]
l4: $ ((P C ∧ P D) → P E) , P C , P D , P E ⊢ P E $ by ax
l5: $ ((P C ∧ P D) → P E) , P C , P D ⊢ P E $ by imp_left [l3, l4]
l6: $ ((P C ∧ P D) → P E) , P C ⊢ P D → P E $ by imp_intro [l5]
l7: $ ((P C ∧ P D) → P E) ⊢ P C → (P D → P E) $ by imp_intro [l6]
l8: $ ∅ ⊢ ((P C ∧ P D) → P E) → (P C → (P D → P E)) $ by imp_intro [l7]

exportation_bwd
---------------
