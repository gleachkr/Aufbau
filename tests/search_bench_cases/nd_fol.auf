l3: $ ∅ ⊢ (P C ∧ (P C ∨ P D)) → P C $ by imp_intro [l2]

or_assoc_fwd
------------
l1: $ P C ⊢ P C $ by ax
l2: $ P C ⊢ P C ∨ (P D ∨ P E) $ by or_intro_l [l1]
l3: $ P D ⊢ P D $ by ax
l4: $ P D ⊢ P D ∨ P E $ by or_intro_l [l3]
l5: $ P D ⊢ P C ∨ (P D ∨ P E) $ by or_intro_r [l4]
l6: $ P C ∨ P D ⊢ P C ∨ (P D ∨ P E) $ by or_left [l2, l5]
l7: $ P E ⊢ P E $ by ax
l8: $ P E ⊢ P D ∨ P E $ by or_intro_r [l7]
l9: $ P E ⊢ P C ∨ (P D ∨ P E) $ by or_intro_r [l8]
l10: $ (P C ∨ P D) ∨ P E ⊢ P C ∨ (P D ∨ P E) $ by or_left [l6, l9]
l11: $ ∅ ⊢ ((P C ∨ P D) ∨ P E) → (P C ∨ (P D ∨ P E)) $ by imp_intro [l10]

ex_not_to_not_all
-----------------
l1: $ ¬ P u , (∀ y P y) , P u ⊢ P u $ by ax
l2: $ ¬ P u , (∀ y P y) ⊢ P u $ by all_left [l1]
l3n: $ ¬ P u , (∀ y P y) ⊢ ¬ (P u) $ by ax
l3: $ ¬ P u , (∀ y P y) ⊢ ⊥ $ by not_elim [l3n, l2]
l4: $ (∃ x (¬ P x)) , (∀ y P y) ⊢ ⊥ $ by ex_left [l3]
l5: $ ∃ x (¬ P x) ⊢ ¬ ∀ y P y $ by not_intro [l4]
l6: $ ∅ ⊢ (∃ x (¬ P x)) → ¬ ∀ y P y $ by imp_intro [l5]

all_not_to_not_ex
-----------------
