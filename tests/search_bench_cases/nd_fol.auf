l1: $ (∀ x (P x → Q x)) , P u , (P u → Q u) ⊢ P u $ by ax
l2: $ (∀ x (P x → Q x)) , P u , (P u → Q u) , Q u ⊢ Q u $ by ax
l3: $ (∀ x (P x → Q x)) , P u , (P u → Q u) , Q u ⊢ ∃ z Q z $ by ex_intro [l2]
l4: $ (∀ x (P x → Q x)) , P u , (P u → Q u) ⊢ ∃ z Q z $ by imp_left [l1, l3]
l5: $ (∀ x (P x → Q x)) , P u ⊢ ∃ z Q z $ by all_left [l4]
l6: $ (∀ x (P x → Q x)) , (∃ y P y) ⊢ ∃ z Q z $ by ex_left [l5]
l7: $ (∀ x (P x → Q x)) ⊢ (∃ y P y) → (∃ z Q z) $ by imp_intro [l6]
l8: $ ∅ ⊢ (∀ x (P x → Q x)) → ((∃ y P y) → (∃ z Q z)) $ by imp_intro [l7]

b_comb
------
l1: $ (P D → P E) , (P C → P D) , P C ⊢ P C $ by ax
l2: $ (P D → P E) , (P C → P D) , P C , P D ⊢ P D $ by ax
l3: $ (P D → P E) , (P C → P D) , P C ⊢ P D $ by imp_left [l1, l2]
l4: $ (P D → P E) , (P C → P D) , P C , P E ⊢ P E $ by ax
l5: $ (P D → P E) , (P C → P D) , P C ⊢ P E $ by imp_left [l3, l4]
l6: $ (P D → P E) , (P C → P D) ⊢ P C → P E $ by imp_intro [l5]
l7: $ (P D → P E) ⊢ (P C → P D) → (P C → P E) $ by imp_intro [l6]
l8: $ ∅ ⊢ (P D → P E) → ((P C → P D) → (P C → P E)) $ by imp_intro [l7]

c_comb
------
l1: $ (P C → (P D → P E)) , P D , P C ⊢ P C $ by ax
l2: $ (P C → (P D → P E)) , P D , P C , (P D → P E) ⊢ P D $ by ax
l3: $ (P C → (P D → P E)) , P D , P C , (P D → P E) , P E ⊢ P E $ by ax
l4: $ (P C → (P D → P E)) , P D , P C , (P D → P E) ⊢ P E $ by imp_left [l2, l3]
l5: $ (P C → (P D → P E)) , P D , P C ⊢ P E $ by imp_left [l1, l4]
l6: $ (P C → (P D → P E)) , P D ⊢ P C → P E $ by imp_intro [l5]
l7: $ (P C → (P D → P E)) ⊢ P D → (P C → P E) $ by imp_intro [l6]
l8: $ ∅ ⊢ (P C → (P D → P E)) → (P D → (P C → P E)) $ by imp_intro [l7]

w_comb
------
l1: $ (P C → (P C → P D)) , P C ⊢ P C $ by ax
l2: $ (P C → (P C → P D)) , P C , (P C → P D) ⊢ P C $ by ax
l3: $ (P C → (P C → P D)) , P C , (P C → P D) , P D ⊢ P D $ by ax
l4: $ (P C → (P C → P D)) , P C , (P C → P D) ⊢ P D $ by imp_left [l2, l3]
l5: $ (P C → (P C → P D)) , P C ⊢ P D $ by imp_left [l1, l4]
l6: $ (P C → (P C → P D)) ⊢ P C → P D $ by imp_intro [l5]
l7: $ ∅ ⊢ (P C → (P C → P D)) → (P C → P D) $ by imp_intro [l6]

clavius
-------
l1: $ (¬ P C → P C) , ¬ P C ⊢ ¬ P C $ by ax
l2: $ (¬ P C → P C) , ¬ P C , P C ⊢ P C $ by ax
l3: $ (¬ P C → P C) , ¬ P C ⊢ P C $ by imp_left [l1, l2]
l4n: $ (¬ P C → P C) , ¬ P C ⊢ ¬ (P C) $ by ax
l4: $ (¬ P C → P C) , ¬ P C ⊢ ⊥ $ by not_elim [l4n, l3]
l5: $ (¬ P C → P C) ⊢ P C $ by raa [l4]
l6: $ ∅ ⊢ (¬ P C → P C) → P C $ by imp_intro [l5]

mat_cases
---------
l1: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C ⊢ P C $ by ax
l2: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C , P D ⊢ P D $ by ax
l3: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C ⊢ P D $ by imp_left [l1, l2]
l4: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C ⊢ P D ∨ P E $ by or_intro_l [l3]
l5n: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C ⊢ ¬ (P D ∨ P E) $ by ax
l5: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P C ⊢ ⊥ $ by not_elim [l5n, l4]
l6: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) ⊢ ¬ P C $ by not_intro [l5]
l7: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) , P E ⊢ P E $ by ax
l8: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) ⊢ P E $ by imp_left [l6, l7]
l9: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) ⊢ P D ∨ P E $ by or_intro_r [l8]
l10n: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) ⊢ ¬ (P D ∨ P E) $ by ax
l10: $ (P C → P D) , (¬ P C → P E) , ¬ (P D ∨ P E) ⊢ ⊥ $ by not_elim [l10n, l9]
l11: $ (P C → P D) , (¬ P C → P E) ⊢ P D ∨ P E $ by raa [l10]
l12: $ (P C → P D) ∧ (¬ P C → P E) ⊢ P D ∨ P E $ by and_left [l11]
l13: $ ∅ ⊢ ((P C → P D) ∧ (¬ P C → P E)) → (P D ∨ P E) $ by imp_intro [l12]

mat_imp_bwd
-----------
l1: $ ¬ P C , P C , ¬ P D ⊢ P C $ by ax
l2n: $ ¬ P C , P C , ¬ P D ⊢ ¬ (P C) $ by ax
l2: $ ¬ P C , P C , ¬ P D ⊢ ⊥ $ by not_elim [l2n, l1]
l3: $ ¬ P C , P C ⊢ P D $ by raa [l2]
l4: $ P D , P C ⊢ P D $ by ax
l5: $ (¬ P C ∨ P D) , P C ⊢ P D $ by or_left [l3, l4]
l6: $ ¬ P C ∨ P D ⊢ P C → P D $ by imp_intro [l5]
l7: $ ∅ ⊢ (¬ P C ∨ P D) → (P C → P D) $ by imp_intro [l6]

de_morgan_conj_bwd
------------------
l1: $ ¬ P C , P C , P D ⊢ P C $ by ax
l2n: $ ¬ P C , P C , P D ⊢ ¬ (P C) $ by ax
l2: $ ¬ P C , P C , P D ⊢ ⊥ $ by not_elim [l2n, l1]
l3: $ ¬ P D , P C , P D ⊢ P D $ by ax
l4n: $ ¬ P D , P C , P D ⊢ ¬ (P D) $ by ax
l4: $ ¬ P D , P C , P D ⊢ ⊥ $ by not_elim [l4n, l3]
l5: $ (¬ P C ∨ ¬ P D) , P C , P D ⊢ ⊥ $ by or_left [l2, l4]
l6: $ (¬ P C ∨ ¬ P D) , (P C ∧ P D) ⊢ ⊥ $ by and_left [l5]
l7: $ ¬ P C ∨ ¬ P D ⊢ ¬ (P C ∧ P D) $ by not_intro [l6]
l8: $ ∅ ⊢ (¬ P C ∨ ¬ P D) → ¬ (P C ∧ P D) $ by imp_intro [l7]

de_morgan_disj_fwd
------------------
l1: $ ¬ (P C ∨ P D) , P C ⊢ P C $ by ax
l2: $ ¬ (P C ∨ P D) , P C ⊢ P C ∨ P D $ by or_intro_l [l1]
l3n: $ ¬ (P C ∨ P D) , P C ⊢ ¬ (P C ∨ P D) $ by ax
l3: $ ¬ (P C ∨ P D) , P C ⊢ ⊥ $ by not_elim [l3n, l2]
l4: $ ¬ (P C ∨ P D) ⊢ ¬ P C $ by not_intro [l3]
l5: $ ¬ (P C ∨ P D) , P D ⊢ P D $ by ax
l6: $ ¬ (P C ∨ P D) , P D ⊢ P C ∨ P D $ by or_intro_r [l5]
l7n: $ ¬ (P C ∨ P D) , P D ⊢ ¬ (P C ∨ P D) $ by ax
l7: $ ¬ (P C ∨ P D) , P D ⊢ ⊥ $ by not_elim [l7n, l6]
l8: $ ¬ (P C ∨ P D) ⊢ ¬ P D $ by not_intro [l7]
l9: $ ¬ (P C ∨ P D) ⊢ ¬ P C ∧ ¬ P D $ by and_intro [l4, l8]
l10: $ ∅ ⊢ ¬ (P C ∨ P D) → (¬ P C ∧ ¬ P D) $ by imp_intro [l9]

de_morgan_disj_bwd
------------------
l1: $ ¬ P C , ¬ P D , P C ⊢ P C $ by ax
l2n: $ ¬ P C , ¬ P D , P C ⊢ ¬ (P C) $ by ax
