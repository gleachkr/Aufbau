l2: $ ∃ x s0 ⊢ s0 $ by ex_left [l1]
l3: $ ∅ ⊢ (∃ x s0) → s0 $ by imp_intro [l2]

vac_all
-------
l1: $ (∀ x s0) , s0 ⊢ s0 $ by ax
l2: $ ∀ x s0 ⊢ s0 $ by all_left (t := $ u $) [l1]
l3: $ ∅ ⊢ (∀ x s0) → s0 $ by imp_intro [l2]

vac_all_p
---------
l1: $ (∀ x P C) , P C ⊢ P C $ by ax
l2: $ ∀ x P C ⊢ P C $ by all_left (t := $ u $) [l1]
l3: $ ∅ ⊢ (∀ x P C) → P C $ by imp_intro [l2]

vac_all_or
----------
