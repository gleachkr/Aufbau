-- Hand proofs of the nd_fol.mm0 theorems.
--
-- The derived rules (left rules and `or_right`) come first, proved from the
-- primitive eliminations (these blocks use rules search never sees; the
-- depth bench skips them with `--exclude=_left,or_right`).
-- The battery proofs are in normal form: introduction rules and left rules
-- only, closing at `ax`, with `raa` for the classical steps and `not_elim`
-- against a negated assumption to reach `⊥`.

and_left
--------
l1: $ g , a ⊢ b → c $ by imp_intro [#1]
l2: $ g ⊢ a → b → c $ by imp_intro [l1]
l3: $ g , (a ∧ b) ⊢ a → b → c $ by weak [l2]
l4: $ g , (a ∧ b) ⊢ a ∧ b $ by ax
l5: $ g , (a ∧ b) ⊢ a $ by and_elim_l [l4]
l6: $ g , (a ∧ b) ⊢ b → c $ by imp_elim [l3, l5]
l7: $ g , (a ∧ b) ⊢ b $ by and_elim_r [l4]
l8: $ g , (a ∧ b) ⊢ c $ by imp_elim [l6, l7]

or_left
-------
l1: $ g , (a ∨ b) , a ⊢ c $ by weak [#1]
l2: $ g , (a ∨ b) , b ⊢ c $ by weak [#2]
l3: $ g , (a ∨ b) ⊢ a ∨ b $ by ax
l4: $ g , (a ∨ b) ⊢ c $ by or_elim [l3, l1, l2]

or_right
--------
l1: $ g , ¬ (a ∨ b) , b ⊢ b $ by ax
l2: $ g , ¬ (a ∨ b) , b ⊢ a ∨ b $ by or_intro_r [l1]
l3: $ g , ¬ (a ∨ b) , b ⊢ ¬ (a ∨ b) $ by ax
l4: $ g , ¬ (a ∨ b) , b ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (a ∨ b) ⊢ ¬ b $ by not_intro [l4]
l6: $ g ⊢ ¬ b → a $ by imp_intro [#1]
l7: $ g , ¬ (a ∨ b) ⊢ ¬ b → a $ by weak [l6]
l8: $ g , ¬ (a ∨ b) ⊢ a $ by imp_elim [l7, l5]
l9: $ g , ¬ (a ∨ b) ⊢ a ∨ b $ by or_intro_l [l8]
l10: $ g , ¬ (a ∨ b) ⊢ ¬ (a ∨ b) $ by ax
l11: $ g , ¬ (a ∨ b) ⊢ ⊥ $ by not_elim [l10, l9]
l12: $ g ⊢ a ∨ b $ by raa [l11]

or_right_l
----------
l1: $ g , ¬ (a ∨ b) , a ⊢ a $ by ax
l2: $ g , ¬ (a ∨ b) , a ⊢ a ∨ b $ by or_intro_l [l1]
l3: $ g , ¬ (a ∨ b) , a ⊢ ¬ (a ∨ b) $ by ax
l4: $ g , ¬ (a ∨ b) , a ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (a ∨ b) ⊢ ¬ a $ by not_intro [l4]
l6: $ g ⊢ ¬ a → b $ by imp_intro [#1]
l7: $ g , ¬ (a ∨ b) ⊢ ¬ a → b $ by weak [l6]
l8: $ g , ¬ (a ∨ b) ⊢ b $ by imp_elim [l7, l5]
l9: $ g , ¬ (a ∨ b) ⊢ a ∨ b $ by or_intro_r [l8]
l10: $ g , ¬ (a ∨ b) ⊢ ¬ (a ∨ b) $ by ax
l11: $ g , ¬ (a ∨ b) ⊢ ⊥ $ by not_elim [l10, l9]
l12: $ g ⊢ a ∨ b $ by raa [l11]

bi_left
-------
l1: $ g , a ⊢ b → c $ by imp_intro [#1]
l2: $ g ⊢ a → b → c $ by imp_intro [l1]
l3: $ g , (a ↔ b) , ¬ c , a ⊢ a → b → c $ by weak [l2]
l4: $ g , (a ↔ b) , ¬ c , a ⊢ a $ by ax
l5: $ g , (a ↔ b) , ¬ c , a ⊢ b → c $ by imp_elim [l3, l4]
l6: $ g , (a ↔ b) , ¬ c , a ⊢ a ↔ b $ by ax
l7: $ g , (a ↔ b) , ¬ c , a ⊢ b $ by bi_elim_l [l6, l4]
l8: $ g , (a ↔ b) , ¬ c , a ⊢ c $ by imp_elim [l5, l7]
l9: $ g , (a ↔ b) , ¬ c , a ⊢ ¬ c $ by ax
l10: $ g , (a ↔ b) , ¬ c , a ⊢ ⊥ $ by not_elim [l9, l8]
l11: $ g , (a ↔ b) , ¬ c ⊢ ¬ a $ by not_intro [l10]
l12: $ g , (a ↔ b) , ¬ c , b ⊢ a → b → c $ by weak [l2]
l13: $ g , (a ↔ b) , ¬ c , b ⊢ a ↔ b $ by ax
l14: $ g , (a ↔ b) , ¬ c , b ⊢ b $ by ax
l15: $ g , (a ↔ b) , ¬ c , b ⊢ a $ by bi_elim_r [l13, l14]
l16: $ g , (a ↔ b) , ¬ c , b ⊢ b → c $ by imp_elim [l12, l15]
l17: $ g , (a ↔ b) , ¬ c , b ⊢ c $ by imp_elim [l16, l14]
l18: $ g , (a ↔ b) , ¬ c , b ⊢ ¬ c $ by ax
l19: $ g , (a ↔ b) , ¬ c , b ⊢ ⊥ $ by not_elim [l18, l17]
l20: $ g , (a ↔ b) , ¬ c ⊢ ¬ b $ by not_intro [l19]
l21: $ g , ¬ a ⊢ ¬ b → c $ by imp_intro [#2]
l22: $ g ⊢ ¬ a → ¬ b → c $ by imp_intro [l21]
l23: $ g , (a ↔ b) , ¬ c ⊢ ¬ a → ¬ b → c $ by weak [l22]
l24: $ g , (a ↔ b) , ¬ c ⊢ ¬ b → c $ by imp_elim [l23, l11]
l25: $ g , (a ↔ b) , ¬ c ⊢ c $ by imp_elim [l24, l20]
l26: $ g , (a ↔ b) , ¬ c ⊢ ¬ c $ by ax
l27: $ g , (a ↔ b) , ¬ c ⊢ ⊥ $ by not_elim [l26, l25]
l28: $ g , (a ↔ b) ⊢ c $ by raa [l27]

imp_left
--------
l1: $ g , (a → b) ⊢ b → c $ by imp_intro [#2]
l2: $ g , (a → b) ⊢ a → b $ by ax
l3: $ g , (a → b) ⊢ b $ by imp_elim [l2, #1]
l4: $ g , (a → b) ⊢ c $ by imp_elim [l1, l3]

contra_left
-----------
l1: $ g , ¬ a , a ⊢ ¬ a $ by ax
l2: $ g , ¬ a , a ⊢ a $ by ax
l3: $ g , ¬ a , a ⊢ ⊥ $ by not_elim [l1, l2]
l4: $ g , ¬ a , a , ¬ c ⊢ ⊥ $ by weak [l3]
l5: $ g , ¬ a , a ⊢ c $ by raa [l4]

not_not_left
------------
l1: $ g ⊢ a → c $ by imp_intro [#1]
l2: $ g , ¬ ¬ a ⊢ a → c $ by weak [l1]
l3: $ g , ¬ ¬ a , ¬ a ⊢ ¬ ¬ a $ by ax
l4: $ g , ¬ ¬ a , ¬ a ⊢ ¬ a $ by ax
l5: $ g , ¬ ¬ a , ¬ a ⊢ ⊥ $ by not_elim [l3, l4]
l6: $ g , ¬ ¬ a ⊢ a $ by raa [l5]
l7: $ g , ¬ ¬ a ⊢ c $ by imp_elim [l2, l6]

not_or_left
-----------
l1: $ g , ¬ (a ∨ b) , a ⊢ a $ by ax
l2: $ g , ¬ (a ∨ b) , a ⊢ a ∨ b $ by or_intro_l [l1]
l3: $ g , ¬ (a ∨ b) , a ⊢ ¬ (a ∨ b) $ by ax
l4: $ g , ¬ (a ∨ b) , a ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (a ∨ b) ⊢ ¬ a $ by not_intro [l4]
l6: $ g , ¬ (a ∨ b) , b ⊢ b $ by ax
l7: $ g , ¬ (a ∨ b) , b ⊢ a ∨ b $ by or_intro_r [l6]
l8: $ g , ¬ (a ∨ b) , b ⊢ ¬ (a ∨ b) $ by ax
l9: $ g , ¬ (a ∨ b) , b ⊢ ⊥ $ by not_elim [l8, l7]
l10: $ g , ¬ (a ∨ b) ⊢ ¬ b $ by not_intro [l9]
l11: $ g , ¬ a ⊢ ¬ b → c $ by imp_intro [#1]
l12: $ g ⊢ ¬ a → ¬ b → c $ by imp_intro [l11]
l13: $ g , ¬ (a ∨ b) ⊢ ¬ a → ¬ b → c $ by weak [l12]
l14: $ g , ¬ (a ∨ b) ⊢ ¬ b → c $ by imp_elim [l13, l5]
l15: $ g , ¬ (a ∨ b) ⊢ c $ by imp_elim [l14, l10]

not_imp_left
------------
l1: $ g , ¬ (a → b) , ¬ a , a ⊢ b $ by contra_left
l2: $ g , ¬ (a → b) , ¬ a ⊢ a → b $ by imp_intro [l1]
l3: $ g , ¬ (a → b) , ¬ a ⊢ ¬ (a → b) $ by ax
l4: $ g , ¬ (a → b) , ¬ a ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (a → b) ⊢ a $ by raa [l4]
l6: $ g , ¬ (a → b) , b , a ⊢ b $ by ax
l7: $ g , ¬ (a → b) , b ⊢ a → b $ by imp_intro [l6]
l8: $ g , ¬ (a → b) , b ⊢ ¬ (a → b) $ by ax
l9: $ g , ¬ (a → b) , b ⊢ ⊥ $ by not_elim [l8, l7]
l10: $ g , ¬ (a → b) ⊢ ¬ b $ by not_intro [l9]
l11: $ g , a ⊢ ¬ b → c $ by imp_intro [#1]
l12: $ g ⊢ a → ¬ b → c $ by imp_intro [l11]
l13: $ g , ¬ (a → b) ⊢ a → ¬ b → c $ by weak [l12]
l14: $ g , ¬ (a → b) ⊢ ¬ b → c $ by imp_elim [l13, l5]
l15: $ g , ¬ (a → b) ⊢ c $ by imp_elim [l14, l10]

not_and_left
------------
l1: $ g ⊢ ¬ a → c $ by imp_intro [#1]
l2: $ g , ¬ (a ∧ b) , ¬ c , ¬ a ⊢ ¬ a → c $ by weak [l1]
l3: $ g , ¬ (a ∧ b) , ¬ c , ¬ a ⊢ ¬ a $ by ax
l4: $ g , ¬ (a ∧ b) , ¬ c , ¬ a ⊢ c $ by imp_elim [l2, l3]
l5: $ g , ¬ (a ∧ b) , ¬ c , ¬ a ⊢ ¬ c $ by ax
l6: $ g , ¬ (a ∧ b) , ¬ c , ¬ a ⊢ ⊥ $ by not_elim [l5, l4]
l7: $ g , ¬ (a ∧ b) , ¬ c ⊢ a $ by raa [l6]
l8: $ g ⊢ ¬ b → c $ by imp_intro [#2]
l9: $ g , ¬ (a ∧ b) , ¬ c , ¬ b ⊢ ¬ b → c $ by weak [l8]
l10: $ g , ¬ (a ∧ b) , ¬ c , ¬ b ⊢ ¬ b $ by ax
l11: $ g , ¬ (a ∧ b) , ¬ c , ¬ b ⊢ c $ by imp_elim [l9, l10]
l12: $ g , ¬ (a ∧ b) , ¬ c , ¬ b ⊢ ¬ c $ by ax
l13: $ g , ¬ (a ∧ b) , ¬ c , ¬ b ⊢ ⊥ $ by not_elim [l12, l11]
l14: $ g , ¬ (a ∧ b) , ¬ c ⊢ b $ by raa [l13]
l15: $ g , ¬ (a ∧ b) , ¬ c ⊢ a ∧ b $ by and_intro [l7, l14]
l16: $ g , ¬ (a ∧ b) , ¬ c ⊢ ¬ (a ∧ b) $ by ax
l17: $ g , ¬ (a ∧ b) , ¬ c ⊢ ⊥ $ by not_elim [l16, l15]
l18: $ g , ¬ (a ∧ b) ⊢ c $ by raa [l17]

not_bi_left
-----------
l1: $ g , a ⊢ ¬ b → c $ by imp_intro [#1]
l2: $ g ⊢ a → ¬ b → c $ by imp_intro [l1]
l3: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ a → ¬ b → c $ by weak [l2]
l4: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ a $ by ax
l5: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ ¬ b → c $ by imp_elim [l3, l4]
l6: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ ¬ b $ by ax
l7: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ c $ by imp_elim [l5, l6]
l8: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ ¬ c $ by ax
l9: $ g , ¬ (a ↔ b) , ¬ c , a , ¬ b ⊢ ⊥ $ by not_elim [l8, l7]
l10: $ g , ¬ (a ↔ b) , ¬ c , a ⊢ b $ by raa [l9]
l11: $ g , ¬ a ⊢ b → c $ by imp_intro [#2]
l12: $ g ⊢ ¬ a → b → c $ by imp_intro [l11]
l13: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ ¬ a → b → c $ by weak [l12]
l14: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ ¬ a $ by ax
l15: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ b → c $ by imp_elim [l13, l14]
l16: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ b $ by ax
l17: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ c $ by imp_elim [l15, l16]
l18: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ ¬ c $ by ax
l19: $ g , ¬ (a ↔ b) , ¬ c , b , ¬ a ⊢ ⊥ $ by not_elim [l18, l17]
l20: $ g , ¬ (a ↔ b) , ¬ c , b ⊢ a $ by raa [l19]
l21: $ g , ¬ (a ↔ b) , ¬ c ⊢ a ↔ b $ by bi_intro [l10, l20]
l22: $ g , ¬ (a ↔ b) , ¬ c ⊢ ¬ (a ↔ b) $ by ax
l23: $ g , ¬ (a ↔ b) , ¬ c ⊢ ⊥ $ by not_elim [l22, l21]
l24: $ g , ¬ (a ↔ b) ⊢ c $ by raa [l23]

not_all_left
------------
l1: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) , ¬ [x/u] p ⊢ ¬ [x/u] p $ by ax
l2: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) , ¬ [x/u] p ⊢ ∃ x (¬ p) $ by ex_intro [l1]
l3: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) , ¬ [x/u] p ⊢ ¬ (∃ x (¬ p)) $ by ax
l4: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) , ¬ [x/u] p ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) ⊢ [x/u] p $ by raa [l4]
l6: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) ⊢ ∀ x p $ by all_intro [l5]
l7: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) ⊢ ¬ (∀ x p) $ by ax
l8: $ g , ¬ (∀ x p) , ¬ (∃ x (¬ p)) ⊢ ⊥ $ by not_elim [l7, l6]
l9: $ g , ¬ (∀ x p) ⊢ ∃ x (¬ p) $ by raa [l8]
l10: $ g ⊢ (∃ x (¬ p)) → c $ by imp_intro [#1]
l11: $ g , ¬ (∀ x p) ⊢ (∃ x (¬ p)) → c $ by weak [l10]
l12: $ g , ¬ (∀ x p) ⊢ c $ by imp_elim [l11, l9]

not_ex_left
-----------
l1: $ g , ¬ (∃ x p) , [x/u] p ⊢ [x/u] p $ by ax
l2: $ g , ¬ (∃ x p) , [x/u] p ⊢ ∃ x p $ by ex_intro [l1]
l3: $ g , ¬ (∃ x p) , [x/u] p ⊢ ¬ (∃ x p) $ by ax
l4: $ g , ¬ (∃ x p) , [x/u] p ⊢ ⊥ $ by not_elim [l3, l2]
l5: $ g , ¬ (∃ x p) ⊢ ¬ [x/u] p $ by not_intro [l4]
l6: $ g , ¬ (∃ x p) ⊢ ∀ x (¬ p) $ by all_intro [l5]
l7: $ g ⊢ (∀ x (¬ p)) → c $ by imp_intro [#1]
l8: $ g , ¬ (∃ x p) ⊢ (∀ x (¬ p)) → c $ by weak [l7]
l9: $ g , ¬ (∃ x p) ⊢ c $ by imp_elim [l8, l6]

all_left
--------
l1: $ g , (∀ x p) ⊢ [x/t] p → c $ by imp_intro [#1]
l2: $ g , (∀ x p) ⊢ ∀ x p $ by ax
l3: $ g , (∀ x p) ⊢ [x/t] p $ by all_elim [l2]
l4: $ g , (∀ x p) ⊢ c $ by imp_elim [l1, l3]

ex_left
-------
l1: $ g , (∃ x p) ⊢ ∃ x p $ by ax
l2: $ g , (∃ x p) ⊢ c $ by ex_elim [l1, #1]

imp_refl
--------
l1: $ P C ⊢ P C $ by ax
l2: $ ∅ ⊢ P C → P C $ by imp_intro [l1]

and_comm
--------
l1: $ P C , Q C ⊢ Q C $ by ax
l2: $ P C , Q C ⊢ P C $ by ax
l3: $ P C , Q C ⊢ Q C ∧ P C $ by and_intro [l1, l2]
l4: $ P C ∧ Q C ⊢ Q C ∧ P C $ by and_left [l3]
l5: $ ∅ ⊢ (P C ∧ Q C) → (Q C ∧ P C) $ by imp_intro [l4]

or_comm
-------
l1: $ P C ⊢ P C $ by ax
l2: $ P C ⊢ Q C ∨ P C $ by or_intro_r [l1]
l3: $ Q C ⊢ Q C $ by ax
l4: $ Q C ⊢ Q C ∨ P C $ by or_intro_l [l3]
l5: $ P C ∨ Q C ⊢ Q C ∨ P C $ by or_left [l2, l4]
l6: $ ∅ ⊢ (P C ∨ Q C) → (Q C ∨ P C) $ by imp_intro [l5]

imp_trans
---------
l1: $ (P C → P D) , (P D → P E) , P C ⊢ P C $ by ax
l2: $ (P C → P D) , (P D → P E) , P C , P D ⊢ P D $ by ax
l3: $ (P C → P D) , (P D → P E) , P C ⊢ P D $ by imp_left [l1, l2]
l4: $ (P C → P D) , (P D → P E) , P C , P E ⊢ P E $ by ax
l5: $ (P C → P D) , (P D → P E) , P C ⊢ P E $ by imp_left [l3, l4]
l6: $ (P C → P D) , (P D → P E) ⊢ P C → P E $ by imp_intro [l5]
l7: $ (P C → P D) ⊢ (P D → P E) → (P C → P E) $ by imp_intro [l6]
l8: $ ∅ ⊢ (P C → P D) → (P D → P E) → (P C → P E) $ by imp_intro [l7]

excluded_middle
---------------
l1: $ ¬ (P C ∨ ¬ P C) , P C ⊢ P C $ by ax
l2: $ ¬ (P C ∨ ¬ P C) , P C ⊢ P C ∨ ¬ P C $ by or_intro_l [l1]
l3n: $ ¬ (P C ∨ ¬ P C) , P C ⊢ ¬ (P C ∨ ¬ P C) $ by ax
l3: $ ¬ (P C ∨ ¬ P C) , P C ⊢ ⊥ $ by not_elim [l3n, l2]
l4: $ ¬ (P C ∨ ¬ P C) ⊢ ¬ P C $ by not_intro [l3]
l5: $ ¬ (P C ∨ ¬ P C) ⊢ P C ∨ ¬ P C $ by or_intro_r [l4]
l6n: $ ¬ (P C ∨ ¬ P C) ⊢ ¬ (P C ∨ ¬ P C) $ by ax
l6: $ ¬ (P C ∨ ¬ P C) ⊢ ⊥ $ by not_elim [l6n, l5]
l7: $ ∅ ⊢ P C ∨ ¬ P C $ by raa [l6]

peirce
------
l1: $ ((P C → Q C) → P C) , ¬ P C , P C , ¬ Q C ⊢ P C $ by ax
l2n: $ ((P C → Q C) → P C) , ¬ P C , P C , ¬ Q C ⊢ ¬ (P C) $ by ax
l2: $ ((P C → Q C) → P C) , ¬ P C , P C , ¬ Q C ⊢ ⊥ $ by not_elim [l2n, l1]
l3: $ ((P C → Q C) → P C) , ¬ P C , P C ⊢ Q C $ by raa [l2]
l4: $ ((P C → Q C) → P C) , ¬ P C ⊢ P C → Q C $ by imp_intro [l3]
l5: $ ((P C → Q C) → P C) , ¬ P C , P C ⊢ P C $ by ax
l6: $ ((P C → Q C) → P C) , ¬ P C ⊢ P C $ by imp_left [l4, l5]
l7n: $ ((P C → Q C) → P C) , ¬ P C ⊢ ¬ (P C) $ by ax
l7: $ ((P C → Q C) → P C) , ¬ P C ⊢ ⊥ $ by not_elim [l7n, l6]
l8: $ ((P C → Q C) → P C) ⊢ P C $ by raa [l7]
l9: $ ∅ ⊢ ((P C → Q C) → P C) → P C $ by imp_intro [l8]

de_morgan
---------
l1: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P C ⊢ ¬ P C $ by ax
l2: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P C ⊢ ¬ P C ∨ ¬ P D $ by or_intro_l [l1]
l3n: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P C ⊢ ¬ (¬ P C ∨ ¬ P D) $ by ax
l3: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P C ⊢ ⊥ $ by not_elim [l3n, l2]
l4: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) ⊢ P C $ by raa [l3]
l5: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P D ⊢ ¬ P D $ by ax
l6: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P D ⊢ ¬ P C ∨ ¬ P D $ by or_intro_r [l5]
l7n: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P D ⊢ ¬ (¬ P C ∨ ¬ P D) $ by ax
l7: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) , ¬ P D ⊢ ⊥ $ by not_elim [l7n, l6]
l8: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) ⊢ P D $ by raa [l7]
l9: $ ¬ (P C ∧ P D) , ¬ (¬ P C ∨ ¬ P D) ⊢ P C ∧ P D $ by and_intro [l4, l8]
