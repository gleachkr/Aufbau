-- Quantifier-alternation forward-saturation stress (META_STRESS.md workstream
-- 3, the ∀∃ theory). Exercises the Stage 7 × Stage 4/5 *product*: a universal
-- fact is instantiated *forward* into a family fact carrying a universal meta
-- (`P ?t → Q (f ?t)`), and an existential goal opens a *backward* witness hole
-- (`Q ?s`); the forward-derived fact discharges the open hole and the witness
-- (possibly a compound term like `f c`) is read off by structural @recover. The
-- two meta kinds must stay separate — universal solved first from concrete
-- structure, existential bound to a concrete term after.
--
-- Hilbert-style first-order skeleton (no ACUI contexts) so the generic
-- forward/backward metavariable path is isolated. Substitution/rewrite battery
-- is the all_elim_forward.mm0 one, extended with ∃, a function symbol `f`, and a
-- binary relation `R`. Pure ∀→∃ over the same matrix is deliberately absent: it
-- is underdetermined (any witness works), so the solvable cells all thread a
-- concrete anchor (`P c`) through a forward derivation.
delimiter $ ( ) [ / ] $;
provable sort wff;
sort obj;

term imp (a b: wff): wff;
infixr imp: $→$ prec 25;
term iff (a b: wff): wff;
infixr iff: $↔$ prec 20;
term all {x: obj} (p: wff x): wff;
prefix all: $∀$ prec 41;
term ex {x: obj} (p: wff x): wff;
prefix ex: $∃$ prec 41;
term eq (a b: obj): wff;
infixl eq: $=$ prec 35;

term P (x: obj): wff;
prefix P: $P$ prec 40;
term Q (x: obj): wff;
prefix Q: $Q$ prec 40;
term S (x: obj): wff;
prefix S: $S$ prec 40;
term R (x y: obj): wff;
term f (x: obj): obj;
term c: obj;
term d: obj;

term sb_t {x: obj} (t: obj x) (a: obj x): obj;
notation sb_t {x: obj} (t: obj x) (a: obj x): obj =
  ($subst$:41) x ($/$:0) t a;
term sb_f {x: obj} (t: obj x) (p: wff x): wff;
notation sb_f {x: obj} (t: obj x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a ↔ a $;
axiom iff_trans (a b c: wff): $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom iff_sym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom iff_mp (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

--| @relation obj eq eq_refl eq_trans eq_sym _
axiom eq_refl (a: obj): $ a = a $;
axiom eq_trans (a b c: obj): $ a = b $ > $ b = c $ > $ a = c $;
axiom eq_sym (a b: obj): $ a = b $ > $ b = a $;

--| @congr
axiom imp_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;

--| @congr
axiom all_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;

--| @congr
axiom ex_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;

--| @congr
axiom P_congr (a b: obj): $ a = b $ > $ P a ↔ P b $;

--| @congr
axiom Q_congr (a b: obj): $ a = b $ > $ Q a ↔ Q b $;

--| @congr
axiom S_congr (a b: obj): $ a = b $ > $ S a ↔ S b $;

--| @congr
axiom R_congr (a b c d: obj): $ a = b $ > $ c = d $ > $ R a c ↔ R b d $;

--| @congr
axiom f_congr (a b: obj): $ a = b $ > $ f a = f b $;

--| @rewrite
axiom sb_t_var {x: obj} (t: obj x): $ subst x / t x = t $;

--| @rewrite
axiom sb_t_other {x y: obj} (t: obj x): $ subst x / t y = y $;

--| @rewrite
axiom sb_t_irrel {x: obj} (t: obj x) (a: obj): $ subst x / t a = a $;

--| @rewrite
axiom sb_t_f {x: obj} (t: obj x) (a: obj x): $ subst x / t (f a) = f (subst x / t a) $;

--| @rewrite
axiom sb_f_imp {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;

--| @rewrite
axiom sb_f_all {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∀ y p) ↔ ∀ y ([x/t] p) $;

--| @rewrite
axiom sb_f_ex {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∃ y p) ↔ ∃ y ([x/t] p) $;

--| @rewrite
axiom sb_f_P {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (P a) ↔ P (subst x / t a) $;

--| @rewrite
axiom sb_f_Q {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (Q a) ↔ Q (subst x / t a) $;

--| @rewrite
axiom sb_f_S {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (S a) ↔ S (subst x / t a) $;

--| @rewrite
axiom sb_f_R {x: obj} (t: obj x) (a b: obj x):
  $ [x/t] (R a b) ↔ R (subst x / t a) (subst x / t b) $;

-- Universal elimination, the @auto forward rule (Stage 7). Raw conclusion
-- `[x/t] p` is the substitution term; @view advertises the applied surface `q`
-- and @recover extracts the witness `t` by structural correspondence.
--| @view {x: obj} (t: obj x) (p: wff x) (q: wff): $ ∀ x p $ > $ q $
--| @recover t q p x
--| @auto forward
axiom all_elim {x: obj} (t: obj x) (p: wff x):
  $ ∀ x p $ > $ [x/t] p $;

-- Existential introduction, the @auto backward rule (Stage 4/5). Its hypothesis
-- `[x/t] p` (the witnessed instance `q`) goes open as `φ[x ↦ ?t]`; @recover
-- reads the witness `t` off the discharging fact's surface.
--| @view {x: obj} (t: obj x) (p: wff x) (q: wff): $ q $ > $ ∃ x p $
--| @recover t q p x
--| @auto backward
axiom ex_intro {x: obj} (t: obj x) (p: wff x):
  $ [x/t] p $ > $ ∃ x p $;

-- Plain modus ponens. Enrolled BOTH ways. Backward: its major premise may open
-- as `?a → <goal>` when nothing pins `a` first. Forward: it JOINS a universal
-- family fact with a concrete fact — `P ?t → Q ?t` (from `all_elim`) plus `P c`
-- derives the concrete fact `Q c`, grounding the family's universal `?t := c`
-- transiently at the join (the family stays general). That concrete fact is
-- what the backward `ex_intro` then witnesses, so the ∀→∃ alternation closes
-- without threading a live universal meta through a backward sibling slot.
--| @auto forward
--| @auto backward
axiom mp (a b: wff): $ a → b $ > $ a $ > $ b $;

-- IMPORTANT ordering note: the *product* cells come FIRST, the pure-backward
-- ∃-intro *baselines* LAST. A baseline like `Q c ⊢ ∃y Qy` declared earlier would
-- otherwise sit in a later cell's pool as a one-step LEMMA and shortcut the
-- forward→ex_intro witness path the product cells are meant to exercise
-- (statement-order lockstep makes earlier theorems available as refs).

-- Product cell E: GENUINELY UNDETERMINED witness (declared FIRST so nothing
-- earlier can shortcut it as a pool lemma — `step_ex` shares the conclusion
-- `∃ y (P y)`). `∀ x (P x)`, `∃ y (P y)`: the forward family `P ?t` never
-- grounds (no concrete anchor fact to join), so the existential witness is
-- free — *any* term works. The backward `ex_intro` side owns the choice. This
-- is the witness-INVENTION case (distinct from cells A–D, whose witness is
-- forced by a sibling concrete fact): the backward engine must supply a witness
-- rather than read one off a forward-derived concrete fact.
theorem free_instance_ex {x y: obj}:
  $ ∀ x (P x) $ > $ ∃ y (P y) $;

-- Probe: free witness BURIED under a function in the goal matrix.
theorem compound_free_ex {x y: obj}:
  $ ∀ x (P x) $ > $ ∃ y (P (f y)) $;

-- Probe: TWO-LAYER forward join. `P c` joins `P ?t → Q ?t` to give `Q c`, which
-- in turn joins `Q ?s → S ?s` to give `S c`; `∃ y (S y)` then witnesses `c`.
-- Stresses pin propagation across NESTED recipe layers — `S c`'s recipe nests
-- `Q c`'s recipe (each carrying its own `?t := c` / `?s := c` pin).
theorem chain_ex {x y: obj}:
  $ ∀ x (P x → Q x) $ > $ ∀ x (Q x → S x) $ > $ P c $ > $ ∃ y (S y) $;

-- Product cell A: forward family `P ?t → Q ?t` + backward ex_intro. Witness `c`
-- flows from the concrete `P c` through the forward derivation, discharging the
-- ex_intro witness hole `Q ?w` (`?w := c`, grounded by the minor `P c`).
theorem all_imp_ex {x y: obj}:
  $ ∀ x (P x → Q x) $ > $ P c $ > $ ∃ y (Q y) $;

-- Product cell B: COMPOUND witness. Forward family `P ?t → Q (f ?t)` derives
-- `Q (f c)`; the existential witness is the compound term `f c` (`?w := f ?t`).
theorem all_imp_ex_compound {x y: obj}:
  $ ∀ x (P x → Q (f x)) $ > $ P c $ > $ ∃ y (Q y) $;

-- Product cell C: two-layer, same predicate. `∀ x (P x → P (f x))`, `P c` give
-- `P (f c)`. NB: a SHORTCUT witness `c` exists (`P c` closes the ex_intro hole
-- directly), so this cell stays solvable even when the genuine compound path
-- (witness `f c`) does not.
theorem step_ex {x y: obj}:
  $ ∀ x (P x → P (f x)) $ > $ P c $ > $ ∃ y (P y) $;

-- Product cell D: relational alternation. `∀ x (P x → R c x)`, `P d` give
-- `R c d`; existential witness `d` from the forward-derived relational fact.
theorem all_rel_ex {x y: obj}:
  $ ∀ x (P x → R c x) $ > $ P d $ > $ ∃ y (R c y) $;

-- Probe F: DEEP COMPOUND witness. `∀ x (P x → P (f x))`, `P c` step twice
-- (`P c → P (f c) → P (f (f c))`); the existential witness `c` sits under TWO
-- function layers (`P (f (f y))`, recovered by structural correspondence through
-- both `f`s). Two same-predicate forward layers + a doubly-nested compound
-- witness — deeper than step_ex (whose shortcut witness is shallow).
theorem deep_compound_ex {x y: obj}:
  $ ∀ x (P x → P (f x)) $ > $ P c $ > $ ∃ y (P (f (f y))) $;

-- Probe F2: TRIPLE compound witness — one layer deeper than `deep_compound_ex`.
-- `∀ x (P x → P (f x))`, `P c` step THREE times (`P c → P (f c) → P (f (f c)) →
-- P (f (f (f c)))`); the existential witness `c` sits under THREE function
-- layers. The whole-proof regen reuses the SAME family fact `P ?x → P (f ?x)`
-- THRICE with distinct witnesses (`?x = c`, `f c`, `f (f c)`), so it stresses the
-- per-occurrence recipe materialization at depth 3 (a regression that only
-- mishandled two reuses would still pass `deep_compound_ex` but fail here).
theorem triple_compound_ex {x y: obj}:
  $ ∀ x (P x → P (f x)) $ > $ P c $ > $ ∃ y (P (f (f (f y)))) $;

-- Probe G: DIAGONAL witness. Forward family `P ?t → R ?t ?t` carries the
-- universal meta in TWO positions; joining `P c` must ground both consistently
-- (`R c c`). The existential witness `y` then occurs twice in the matrix
-- (`R y y`), so @recover must read a single consistent witness off both slots.
theorem diag_ex {x y: obj}:
  $ ∀ x (P x → R x x) $ > $ P c $ > $ ∃ y (R y y) $;

-- Probe G2: COMPOUND DIAGONAL witness — `diag_ex` × the compound-witness path.
-- Forward family `P ?t → R (f ?t) (f ?t)` carries the universal meta in two
-- positions, BOTH wrapped in `f`; joining `P c` grounds `R (f c) (f c)`. The
-- existential `∃ y (R y y)` is then witnessed by the COMPOUND term `f c`, which
-- @recover must read consistently off both diagonal slots (a witness that is
-- both diagonal and compound, unlike `diag_ex`'s bare `c`).
theorem diag_compound_ex {x y: obj}:
  $ ∀ x (P x → R (f x) (f x)) $ > $ P c $ > $ ∃ y (R y y) $;

-- Probe H: NESTED universal, free inner witness. Two forward `all_elim` layers
-- peel `∀ x ∀ y (P x → R x y)`; the outer meta `?t` grounds from `P c` at the
-- mp join, but the inner meta stays UNIVERSAL (no anchor fixes the second
-- position). The existential `∃ v (R c v)` is then witnessed by the surviving
-- universal — exercises a forward fact concrete in one argument and universal
-- in the other discharging an existential hole.
theorem nested_rel_ex {x y v: obj}:
  $ ∀ x ∀ y (P x → R x y) $ > $ P c $ > $ ∃ v (R c v) $;

-- Probe I: AMBIGUOUS anchor. Both `P c` and `P d` join the family `P ?t → S ?t`
-- (either witness closes `∃ y (S y)`); the engine must pick one without
-- double-counting or fabricating. Robustness/determinism probe (fresh predicate
-- `S` keeps the conclusion off every earlier cell's lemma shortcut).
theorem ambiguous_anchor_ex {x y: obj}:
  $ ∀ x (P x → S x) $ > $ P c $ > $ P d $ > $ ∃ y (S y) $;

-- Probe K: FORWARD-DERIVED fact under a NESTED existential — the forward-join
-- product cells (D) × the nested-`ex_intro` carried-witness machinery
-- (`nested_concrete_ex`). `∀ x (P x → R c x)`, `P d` forward-derive `R c d` (no
-- such hypothesis is given); the doubly-nested `∃ u ∃ v (R u v)` is then closed
-- with the outer witness `u := c` buried two `∃` layers up and the inner
-- `v := d`. Unlike `nested_concrete_ex` (whose `R c d` is a bare hypothesis), the
-- relational fact must first be MANUFACTURED by forward saturation, so this
-- exercises forward join + carried-meta nested introduction together. Declared
-- BEFORE `nested_concrete_ex`/`double_all_ex` so neither can shortcut it as a
-- pool lemma (their hypotheses are unavailable here, and vice versa).
theorem forward_nested_ex {x u v: obj}:
  $ ∀ x (P x → R c x) $ > $ P d $ > $ ∃ u ∃ v (R u v) $;

-- Minimal repro for the nested-ex_intro composition gap: a CONCRETE relational
-- fact `R c d` (no forward/universal layer) under a doubly-nested existential.
-- Outer ex_intro's subgoal is itself `∃ v (R ?w v)`, whose witness `?w` is only
-- determined two levels down when the inner ex_intro closes against `R c d`.
theorem nested_concrete_ex {u v: obj}:
  $ R c d $ > $ ∃ u ∃ v (R u v) $;

-- Probe J: NESTED existential introduction over a doubly-universal hypothesis.
-- `∀ x ∀ y (R x y)` is purely underdetermined (any witnesses); both the outer
-- and inner `ex_intro` invent a witness, and the outer step must push its
-- substitution through the inner `∃` (sb_f_ex) to recover its witness. Stresses
-- the substitution-through-binder rewrite path under nested existential
-- introduction.
theorem double_all_ex {x y u v: obj}:
  $ ∀ x ∀ y (R x y) $ > $ ∃ u ∃ v (R u v) $;

-- Baseline (declared LAST, see ordering note): a concrete instance directly
-- witnesses the existential (pure backward ex_intro from a pool ref; no forward
-- layer, no generation).
theorem direct_instance_ex {y: obj}:
  $ Q c $ > $ ∃ y (Q y) $;

-- Baseline relational: witness `d` recovered from `R c d`.
theorem rel_instance_ex {y: obj}:
  $ R c d $ > $ ∃ y (R c y) $;

-- ============================================================
-- Carried-witness COMPOUND probes (witness-unification migration)
-- ============================================================
-- Pure-backward baselines whose existential witness is a COMPOUND term read
-- off a hypothesis ref by unification — the shape the old bound-witness
-- enumeration (designated variables only) could never produce. The nested
-- variants force the CARRIED (outer) meta itself to take a compound value:
-- the inner `ex_intro` resolves `W := f c` via `solveCarriedViewMetas`, and
-- the checker receives it through the explicit-bindings retry (the
-- `UnifyMismatch` holey-goal arm in `validateSelectedRefs`) — the inference
-- solver's placeholder model absorbs a wildcard-for-leaf (`W` vs `c`) but not
-- wildcard-for-subtree (`W` vs `f c`), so only these compound variants catch
-- a regression the bare-witness cases above cannot.
theorem compound_instance_ex {y: obj}:
  $ Q (f c) $ > $ ∃ y (Q y) $;
theorem compound_instance_ex2 {y: obj}:
  $ Q (f (f c)) $ > $ ∃ y (Q y) $;
theorem nested_compound_outer_ex {u v: obj}:
  $ R (f c) d $ > $ ∃ u ∃ v (R u v) $;
theorem nested_compound_inner_ex {u v: obj}:
  $ R c (f d) $ > $ ∃ u ∃ v (R u v) $;
theorem nested_compound_ex {u v: obj}:
  $ R (f c) (f d) $ > $ ∃ u ∃ v (R u v) $;
