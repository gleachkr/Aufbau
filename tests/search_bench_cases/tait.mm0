-- Tait's one-sided sequent calculus for classical first-order logic.
--
-- Where `additive_fol` is the *two-sided* additive calculus (G3c, `Γ ⊢ Δ`),
-- this is its one-sided cousin in the style of Tait and Schütte: a sequent is a
-- single ACUI *succedent* `⊢ Δ`, and a two-sided `Γ ⊢ Δ` is read as `⊢ ¬Γ, Δ`.
--
-- Dropping the left-hand side reshapes the rule set. There is nowhere to move a
-- formula *to*, so there is no negation rule that crosses the turnstile.
-- Instead the calculus splits each connective's two two-sided rules
-- (left/right) into a **positive/negative** pair on the one succedent:
--
--   * a *positive* introduction rule for the connective itself
--     (`ror`, `rand`, `rim`, `rbi`, `rall`, `rex`), and
--   * a *De Morgan* rule for the connective under a negation
--     (`rdm_an`, `rdm_or`, `rdm_im`, `rdm_all`, `rdm_ex`, plus `rdm_not` for
--     double negation).
--
-- The De Morgan rules drive `¬` toward the atoms one connective at a time; `¬`
-- survives only on an atom, where it forms one half of an `ax` literal pair.
-- This is the analytic engine additive_fol spends its `lnot`/`lim`/`lan`/`lor`
-- left rules on, re-expressed one-sidedly. (It cannot be done by the automatic
-- @rewrite normalizer, because binder inference is exact and runs *before*
-- normalization — see the sibling comment on `rdm_an` — so De Morgan must be
-- first-class rules the proof and the search apply explicitly.)
--
-- The quantifiers show the economy best: additive_fol needs four rules
-- (`rall`/`lall`/`rex`/`lex`); here the whole first-order fragment runs on two
-- positive rules — `rall` (eigenvariable) and `rex` (witness) — plus the two
-- De Morgan rules that turn a negated ∀ into a succedent ∃ and vice versa. The
-- eigenvariable side condition is carried, exactly as in additive_fol, by MM0's
-- dependency discipline: a context `d: ctx` cannot mention a rule's bound
-- `{x: obj}`, which *is* the "x not free in Δ" proviso, and `@freshen` repairs
-- benign alpha-collisions.
--
-- The calculus is classical because the succedent is a multi-formula ACUI set:
-- excluded middle, Peirce's law, and the drinker paradox are all provable, the
-- last cut-free via a double `rex` contraction on one kept `∃` with two
-- different witnesses.
--
-- Implication and the biconditional are kept primitive (with their own rules)
-- so goals read naturally. The substitution battery and the congruence/relation
-- scaffolding are the usual euclid subset, kept self-contained per the fixture
-- convention.
delimiter $ ( ) [ / ] $;

provable sort wff;
sort ctx;

--| @vars x y z u v w
sort obj;

-- ============================================================
-- First-order formula language
-- ============================================================

term im (a b: wff): wff;
infixr im: $→$ prec 25;
term an (a b: wff): wff;
infixr an: $∧$ prec 35;
term or (a b: wff): wff;
infixr or: $∨$ prec 30;
term not (a: wff): wff;
prefix not: $¬$ prec 40;
term bi (a b: wff): wff;
infixl bi: $↔$ prec 20;

term all {x: obj} (p: wff x): wff;
prefix all: $∀$ prec 41;
term ex {x: obj} (p: wff x): wff;
prefix ex: $∃$ prec 41;

-- Object-level substitution `[x/t] p` and `subst x / t a`, the machinery the
-- quantifier rules normalize through.
term sb_f {x: obj} (t: obj x) (p: wff x): wff;
notation sb_f {x: obj} (t: obj x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;
term sb_t {x: obj} (t: obj x) (a: obj x): obj;
notation sb_t {x: obj} (t: obj x) (a: obj x): obj =
  ($subst$:41) x ($/$:0) t a;

-- A small signature of predicate and constant symbols so concrete goals can
-- be written.  The calculus is schematic in them.
term P (a: obj): wff;
prefix P: $P$ prec 45;
term Q (a: obj): wff;
prefix Q: $Q$ prec 45;
term R (a b: obj): wff;
term cc: obj;
notation cc: obj = ($C$:max);
term dd: obj;
notation dd: obj = ($D$:max);
term ee: obj;
notation ee: obj = ($E$:max);

-- ============================================================
-- Contexts: ACUI sets of formulas.  A one-sided sequent is a single one.
-- ============================================================

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($∅$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;

-- The one-sided sequent: a single succedent context is the sole provable shape.
term seq (d: ctx): wff;
prefix seq: $⊢$ prec 1;

term eq (a b: obj): wff;
infixl eq: $=$ prec 50;

-- ============================================================
-- Relation / congruence batteries (for ACUI + substitution normalization)
-- ============================================================

-- The bi-conditional is the rewrite relation on wff.
--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ a ↔ a $;
axiom bitr (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom bisym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom mpbi (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

-- ACUI equality on contexts.
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @relation obj eq eq_refl eq_trans eq_sym _
axiom eq_refl (a: obj): $ a = a $;
axiom eq_trans (a b c: obj):
  $ a = b $ > $ b = c $ > $ a = c $;
axiom eq_sym (a b: obj): $ a = b $ > $ b = a $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom seq_congr (e f: ctx):
  $ ctx_eq e f $ > $ (⊢ e) ↔ (⊢ f) $;

--| @congr
axiom im_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;
--| @congr
axiom an_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;
--| @congr
axiom or_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∨ c) ↔ (b ∨ d) $;
--| @congr
axiom not_congr (a b: wff): $ a ↔ b $ > $ ¬ a ↔ ¬ b $;
--| @congr
axiom all_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom ex_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;
--| @congr
axiom P_congr (a b: obj): $ a = b $ > $ P a ↔ P b $;
--| @congr
axiom Q_congr (a b: obj): $ a = b $ > $ Q a ↔ Q b $;
--| @congr
axiom R_congr (a b c d: obj):
  $ a = b $ > $ c = d $ > $ R a c ↔ R b d $;

-- Alpha-renaming rules used by @freshen when a context contains the same
-- bound variable a quantifier rule is trying to bind.
--| @alpha x y
axiom all_alpha {x y: obj} (p: wff x y):
  $ ∀ x p ↔ ∀ y ([x/y] p) $;
--| @alpha x y
axiom ex_alpha {x y: obj} (p: wff x y):
  $ ∃ x p ↔ ∃ y ([x/y] p) $;

-- Substitution pushed through the syntactic operators, so the @rewrite
-- automation can normalize the `[x/t] p` instances the quantifier rules emit.
--| @rewrite
axiom sb_t_var {x: obj} (t: obj x): $ (subst x / t x) = t $;
--| @rewrite
axiom sb_t_other {x y: obj} (t: obj x): $ (subst x / t y) = y $;
--| @rewrite
axiom sb_t_irrel {x: obj} (t: obj x) (a: obj): $ (subst x / t a) = a $;
--| @rewrite
axiom sb_f_irrel {x: obj} (t: obj x) (p: wff): $ [x/t] p ↔ p $;
--| @rewrite
axiom sb_f_im {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;
--| @rewrite
axiom sb_f_bi {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ↔ q) ↔ ([x/t] p ↔ [x/t] q) $;
--| @rewrite
axiom sb_f_an {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ∧ q) ↔ ([x/t] p ∧ [x/t] q) $;
--| @rewrite
axiom sb_f_or {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p ∨ q) ↔ ([x/t] p ∨ [x/t] q) $;
--| @rewrite
axiom sb_f_not {x: obj} (t: obj x) (p: wff x):
  $ [x/t] (¬ p) ↔ ¬ [x/t] p $;
--| @rewrite
axiom sb_f_all {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∀ y p) ↔ ∀ y ([x/t] p) $;
--| @rewrite
axiom sb_f_ex {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∃ y p) ↔ ∃ y ([x/t] p) $;
--| @rewrite
axiom sb_f_P {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (P a) ↔ P (subst x / t a) $;
--| @rewrite
axiom sb_f_Q {x: obj} (t: obj x) (a: obj x):
  $ [x/t] (Q a) ↔ Q (subst x / t a) $;
--| @rewrite
axiom sb_f_R {x: obj} (t: obj x) (a b: obj x):
  $ [x/t] (R a b) ↔ R (subst x / t a) (subst x / t b) $;

-- ============================================================
-- The one-sided Tait rule set
-- ============================================================
--
-- Convention: the principal formula is the singleton joined onto the rest of
-- the succedent, `a , d`.  Because join is ACUI, `a , d` matches any succedent
-- containing `a` and `d` absorbs the rest — additive sharing, no partition.

-- Initial sequent: a formula and its negation close the branch.  Stated for an
-- arbitrary `a`; the De Morgan rules reduce compound negations so that in a
-- closed leaf the pair is a complementary literal.
axiom ax (d: ctx) (a: wff): $ ⊢ a , (¬ a) , d $;

-- ------------------------------------------------------------
-- Positive introduction rules (one per connective).
-- ------------------------------------------------------------

-- Every decomposition rule in this section and the De Morgan section is
-- *invertible* (conclusion provable ⟺ premises provable), so they are
-- enrolled `@auto eager`: tried first, committed to once applied, and exempt
-- from the depth budget. Priority 1 = the non-branching (alpha) ladder,
-- priority 2 = the branching (beta) rules `rand`/`rbi` — the classic tableau
-- discipline. `rex` (contraction, a genuine witness choice) stays plain
-- `@auto backward`; `ax`/`rall` stay un-enrolled (tried first anyway).

-- Disjunction: ⊢ Γ, a, b  ⟹  ⊢ Γ, a ∨ b.
--| @auto eager
axiom ror (d: ctx) (a b: wff):
  $ ⊢ a , b , d $ > $ ⊢ (a ∨ b) , d $;

-- Conjunction (additive: the whole succedent d is copied to both premises).
--| @auto eager 2
axiom rand (d: ctx) (a b: wff):
  $ ⊢ a , d $ > $ ⊢ b , d $ > $ ⊢ (a ∧ b) , d $;

-- Implication, kept primitive: a → b behaves as ¬a ∨ b, so ⊢ Γ, ¬a, b ⟹ ⊢ Γ, a → b.
--| @auto eager
axiom rim (d: ctx) (a b: wff):
  $ ⊢ (¬ a) , b , d $ > $ ⊢ (a → b) , d $;

-- Biconditional, kept primitive: a ↔ b as (a → b) ∧ (b → a), additive.
--| @auto eager 2
axiom rbi (d: ctx) (a b: wff):
  $ ⊢ (a → b) , d $ > $ ⊢ (b → a) , d $ > $ ⊢ (a ↔ b) , d $;

-- Universal: eigenvariable `x` is the fresh rule binder; `d: ctx` cannot depend
-- on it — that *is* the eigenvariable side condition.  @freshen repairs benign
-- alpha-collisions where the succedent already binds the same name.
--| @freshen d x
axiom rall (d: ctx) {x: obj} (p: wff x):
  $ ⊢ p , d $ > $ ⊢ (∀ x p) , d $;

-- Existential: witness `t` sits only in the generated premise, buried inside
-- the instance `[x/t] p`; the principal `∃ x p` is *kept* (contraction), which
-- is what makes the drinker paradox provable cut-free.  A `@view` exposes the
-- instance as a surface formula `q` and `@recover` reconstructs the witness `t`
-- from it — the open-backward-generation path, exactly as euclid's `ex_intro`.
--| @view {x: obj} (d: ctx x) (t: obj x) (p: wff x) (q: wff): $ ⊢ q , (∃ x p) , d $ > $ ⊢ (∃ x p) , d $
--| @recover t q p x
--| @freshen d x
--| @auto backward
axiom rex (d: ctx) {x: obj} (p: wff x) (t: obj):
  $ ⊢ [x/t] p , (∃ x p) , d $ > $ ⊢ (∃ x p) , d $;

-- ------------------------------------------------------------
-- De Morgan rules (one per connective's negated form).
--
-- These are ordinary sequent rules rather than @rewrite normalizations by
-- necessity: the compiler solves a rule's omitted binders by *exact* unify
-- replay against the proof line and its refs, which runs before any rewrite
-- normalization.  A hypothesis like `rim`'s `¬a` therefore has to match a
-- reference line structurally; if that line had already been pushed to negation
-- normal form by a rewrite, the metavariable `a` could not be recovered.  So
-- each De Morgan step is an explicit rule the proof (and `auto?`) applies, and
-- every hypothesis matches its reference exactly.
-- ------------------------------------------------------------

-- Double negation: ⊢ Γ, a  ⟹  ⊢ Γ, ¬¬a.
--| @auto eager
axiom rdm_not (d: ctx) (a: wff):
  $ ⊢ a , d $ > $ ⊢ (¬ ¬ a) , d $;

-- ¬(a → b) as a ∧ ¬b.
--| @auto eager
axiom rdm_im (d: ctx) (a b: wff):
  $ ⊢ (a ∧ ¬ b) , d $ > $ ⊢ ¬ (a → b) , d $;

-- ¬(a ∧ b) as ¬a ∨ ¬b.
--| @auto eager
axiom rdm_an (d: ctx) (a b: wff):
  $ ⊢ (¬ a ∨ ¬ b) , d $ > $ ⊢ ¬ (a ∧ b) , d $;

-- ¬(a ∨ b) as ¬a ∧ ¬b.
--| @auto eager
axiom rdm_or (d: ctx) (a b: wff):
  $ ⊢ (¬ a ∧ ¬ b) , d $ > $ ⊢ ¬ (a ∨ b) , d $;

-- ¬(∀ x p) as ∃ x ¬p.  No witness or eigenvariable — just moves ¬ inside — but
-- `x` is still a bound rule binder, so `@freshen` alpha-renames a context
-- formula that happens to reuse the same bound name (MM0's dependency check
-- counts bound occurrences), exactly as `rall`/`rex` do.
--| @freshen d x
--| @auto eager
axiom rdm_all (d: ctx) {x: obj} (p: wff x):
  $ ⊢ (∃ x (¬ p)) , d $ > $ ⊢ ¬ (∀ x p) , d $;

-- ¬(∃ x p) as ∀ x ¬p.
--| @freshen d x
--| @auto eager
axiom rdm_ex (d: ctx) {x: obj} (p: wff x):
  $ ⊢ (∀ x (¬ p)) , d $ > $ ⊢ ¬ (∃ x p) , d $;

-- ============================================================
-- Theorems (proofs in tait.auf)
-- ============================================================

-- Propositional, classical.  `→` introductions push their antecedent across as
-- a negation (`rim`), which the De Morgan rules then drive to the atoms.
theorem imp_refl: $ ⊢ P C → P C $;
theorem and_comm: $ ⊢ (P C ∧ Q C) → (Q C ∧ P C) $;
theorem or_comm: $ ⊢ (P C ∨ Q C) → (Q C ∨ P C) $;
theorem imp_trans: $ ⊢ (P C → P D) → (P D → P E) → (P C → P E) $;
theorem excluded_middle: $ ⊢ P C ∨ ¬ P C $;
theorem peirce: $ ⊢ ((P C → Q C) → P C) → P C $;
theorem de_morgan: $ ⊢ ¬ (P C ∧ P D) → (¬ P C ∨ ¬ P D) $;
theorem contra_classical: $ ⊢ (¬ P D → ¬ P C) → (P C → P D) $;
theorem resolution: $ ⊢ ((P C ∨ P D) ∧ (¬ P C ∨ P E)) → (P D ∨ P E) $;
-- Biconditional introduction (`rbi`), the primitive-↔ showcase.
theorem iff_comm: $ ⊢ (P C ∧ Q C) ↔ (Q C ∧ P C) $;

-- First-order: witness rule (`rex`) — a negated ∀ becomes a succedent ∃.
theorem all_inst {x: obj}: $ ⊢ (∀ x P x) → P C $;
theorem ex_intro {x: obj}: $ ⊢ P C → ∃ x P x $;

-- First-order: eigenvariable rule (`rall`) and quantifier alternation.  Every
-- quantifier occurrence gets a distinct bound name so the dependency analysis
-- never aliases a succedent formula with a rule's eigenvariable.
theorem all_swap {x y z w: obj}:
  $ ⊢ (∀ x ∀ y R x y) → (∀ z ∀ w R w z) $;
theorem ex_swap {x y z w: obj}:
  $ ⊢ (∃ x ∃ y R x y) → (∃ z ∃ w R w z) $;
theorem ex_all_to_all_ex {x y z w: obj}:
  $ ⊢ (∃ y ∀ x R x y) → (∀ z ∃ w R z w) $;
theorem forall_mono {x y z: obj}:
  $ ⊢ (∀ x (P x → Q x)) → ((∀ y P y) → (∀ z Q z)) $;

-- Classical quantifier De Morgan: the `rdm_all`/`rdm_ex` rules in action.
theorem not_all_to_ex_not {x y: obj}:
  $ ⊢ (¬ ∀ x P x) → ∃ y (¬ P y) $;
theorem not_ex_to_all_not {x y: obj}:
  $ ⊢ (¬ ∃ x P x) → ∀ y (¬ P y) $;
theorem all_an_dist_fwd {x y z: obj}:
  $ ⊢ (∀ x (P x ∧ Q x)) → (∀ y P y ∧ ∀ z Q z) $;

-- The drinker paradox: cut-free it needs `rex` twice on the *same* kept `∃`
-- with two different witnesses (a constant, then the `rall` eigenvariable).
theorem drinker {x y: obj}:
  $ ⊢ ∃ x (P x → ∀ y P y) $;

-- ============================================================
-- Extended battery ported from additive_fol
-- ============================================================
--
-- These are the classical propositional (and two first-order) theorems the
-- two-sided fixture proves with an empty antecedent, `∅ ⊢ φ`.  Under the
-- one-sided reading `∅ ⊢ φ` is simply `⊢ φ`, so each ports verbatim as a goal;
-- the proof re-derives it by the analytic procedure (rim strips `→`, the
-- De Morgan rules drive `¬` inward, rand/ror split the connectives, ax closes a
-- complementary literal pair).  The `⊥`-valued theorems (`pbc`, `contradiction`,
-- ...) are omitted — this calculus keeps no `⊥` constant.

-- Double negation elimination (classical): `¬` reaches an atom by `rdm_not`.
theorem dne: $ ⊢ ¬ ¬ P C → P C $;
-- Positive paradox / weakening.
theorem weakening: $ ⊢ P C → (P D → P C) $;
-- Internalized modus ponens.
theorem mp_internal: $ ⊢ P C → ((P C → P D) → P D) $;
-- Modus tollens.
theorem modus_tollens: $ ⊢ ((P C → P D) ∧ ¬ P D) → ¬ P C $;
-- Disjunctive syllogism.
theorem disj_syllogism: $ ⊢ ((P C ∨ P D) ∧ ¬ P C) → P D $;
-- Proof by cases (classical).
theorem cases_classical: $ ⊢ ((P C → P D) ∧ (¬ P C → P D)) → P D $;
-- Material implication, forward half.
theorem mat_imp_fwd: $ ⊢ (P C → P D) → (¬ P C ∨ P D) $;
-- Contraposition, forward half.
theorem contrapos_fwd: $ ⊢ (P C → P D) → (¬ P D → ¬ P C) $;
-- Triple negation collapse.
theorem triple_neg: $ ⊢ ¬ ¬ ¬ P C → ¬ P C $;
-- Associativity of conjunction, forward half (three-way additive split).
theorem and_assoc_fwd: $ ⊢ ((P C ∧ P D) ∧ P E) → (P C ∧ (P D ∧ P E)) $;
-- The S combinator (intuitionistically valid; a deeper implication nest).
theorem s_comb:
  $ ⊢ (P C → (P D → P E)) → ((P C → P D) → (P C → P E)) $;
-- Dummett's law (linearity of implication), a purely classical disjunction.
theorem dummett: $ ⊢ (P C → P D) ∨ (P D → P C) $;

-- First-order: `∀ → ∃` on a (classically) non-empty domain — both quantifiers
-- discharged by `rex` at the constant witness `C`.
theorem all_ex_inst {x y: obj}: $ ⊢ (∀ x P x) → (∃ y P y) $;
-- Existential monotonicity: the `rall` eigenvariable doubles as the `rex`
-- witness, the one-sided mirror of additive_fol's lex/lall/rex interplay.
theorem exists_mono {x y z: obj}:
  $ ⊢ (∀ x (P x → Q x)) → ((∃ y P y) → (∃ z Q z)) $;

-- ---- Extended battery, second port ----

-- Remaining combinators (b/c/w; s was ported above).
theorem b_comb: $ ⊢ (P D → P E) → ((P C → P D) → (P C → P E)) $;
theorem c_comb: $ ⊢ (P C → (P D → P E)) → (P D → (P C → P E)) $;
theorem w_comb: $ ⊢ (P C → (P C → P D)) → (P C → P D) $;
-- Consequentia mirabilis (Clavius' law): a formula follows from its own
-- negation implying it.  The `rand` copies the single `ax` leaf to both sides.
theorem clavius: $ ⊢ (¬ P C → P C) → P C $;
-- Constructive/material case forms.
theorem mat_cases: $ ⊢ ((P C → P D) ∧ (¬ P C → P E)) → (P D ∨ P E) $;
theorem mat_imp_bwd: $ ⊢ (¬ P C ∨ P D) → (P C → P D) $;
-- The De Morgan family beyond `de_morgan` (¬(A∧B)→(¬A∨¬B), above).
theorem de_morgan_conj_bwd: $ ⊢ (¬ P C ∨ ¬ P D) → ¬ (P C ∧ P D) $;
theorem de_morgan_disj_fwd: $ ⊢ ¬ (P C ∨ P D) → (¬ P C ∧ ¬ P D) $;
theorem de_morgan_disj_bwd: $ ⊢ (¬ P C ∧ ¬ P D) → ¬ (P C ∨ P D) $;
-- Exportation / currying (both directions).
theorem exportation_fwd:
  $ ⊢ ((P C ∧ P D) → P E) → (P C → (P D → P E)) $;
theorem exportation_bwd:
  $ ⊢ (P C → (P D → P E)) → ((P C ∧ P D) → P E) $;
-- Distributivity of ∨ over ∧, forward half.
theorem dist_or_an_fwd:
  $ ⊢ (P C ∨ (P D ∧ P E)) → ((P C ∨ P D) ∧ (P C ∨ P E)) $;
-- Absorption of ∧ over ∨, forward half.
theorem absorb_an_fwd: $ ⊢ (P C ∧ (P C ∨ P D)) → P C $;
-- Associativity of ∨, forward half.
theorem or_assoc_fwd: $ ⊢ ((P C ∨ P D) ∨ P E) → (P C ∨ (P D ∨ P E)) $;

-- First-order: the two quantifier-De-Morgan directions that do NOT cross ¬
-- inward but pull it out (the constructive halves), plus existential weakening
-- (eigenvariable + witness) and existential introduction with a compound
-- instance — the `rex` @view/@recover machinery on a conjunctive body.
theorem ex_not_to_not_all {x y: obj}: $ ⊢ (∃ x (¬ P x)) → ¬ ∀ y P y $;
theorem all_not_to_not_ex {x y: obj}: $ ⊢ (∀ x (¬ P x)) → ¬ ∃ y P y $;
theorem ex_conj_weak {x y: obj}: $ ⊢ (∃ x (P x ∧ Q x)) → (∃ y P y) $;
theorem ex_witness_conj {x: obj}: $ ⊢ (P C ∧ Q C) → (∃ x (P x ∧ Q x)) $;

-- Vacuous quantification: the erased-witness invention path.  `s0` is a
-- closed atomic formula, so eliminating a vacuously quantified formula by
-- `rex` mints a witness the instance never mentions — the `@recover` leaf
-- swap `p[x ↦ ?t]` is a no-op, the view premise comes out fully concrete,
-- and nothing downstream determines `t`.  The three `vac_all*` goals pin the
-- erased-witness fallback in `emitOpenTarget` (search/backward/backtrack.zig),
-- which grounds the dangling meta from the `@vars` pool and renders the
-- explicit `(t := …)` binding; they were clean MISSes without it.
-- `vac_intro`/`vac_ex` are the eigenvariable-direction controls (no witness,
-- never affected).
term s0: wff;

theorem vac_intro {x: obj}: $ ⊢ s0 → ∀ x s0 $;
theorem vac_ex {x: obj}: $ ⊢ (∃ x s0) → s0 $;
theorem vac_all {x: obj}: $ ⊢ (∀ x s0) → s0 $;
theorem vac_all_p {x: obj}: $ ⊢ (∀ x P C) → P C $;
theorem vac_all_or {x: obj}: $ ⊢ (∀ x (s0 ∨ s0)) → s0 $;
