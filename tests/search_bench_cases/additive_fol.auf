l10: $ ∅ ⊢ ((P C → P E) ∧ ((P D → P E) ∧ (P C ∨ P D))) → P E $ by rim [l9]

diamond
-------
l1: $ P C , (P C → P E) , (P E → Q C) ⊢ P C , P D , Q C $ by ax
l2: $ P C , (P C → P E) , (P E → Q C) , P D ⊢ P D , Q C $ by ax
l3: $ P C , (P C → P D) , (P C → P E) , (P E → Q C) ⊢ P D , Q C $ by lim [l1, l2]
l4: $ P C , (P C → P D) , (P C → P E) , (P E → Q C) , Q C ⊢ Q C $ by ax
l5: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q C) ⊢ Q C $ by lim [l3, l4]
l6: $ P C , (P C → P D) , (P C → P E) , ((P D → Q C) ∧ (P E → Q C)) ⊢ Q C $ by lan [l5]
l7: $ P C , (P C → P D) , ((P C → P E) ∧ ((P D → Q C) ∧ (P E → Q C))) ⊢ Q C $ by lan [l6]
l8: $ P C , ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ (P E → Q C)))) ⊢ Q C $ by lan [l7]
l9: $ P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ (P E → Q C)))) ⊢ Q C $ by lan [l8]
l10: $ ∅ ⊢ (P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ (P E → Q C))))) → Q C $ by rim [l9]

diamond_join
------------
l1: $ P C , (P C → P E) ⊢ P C , P D , Q C $ by ax
l2: $ P C , (P C → P E) , P D ⊢ P D , Q C $ by ax
l3: $ P C , (P C → P D) , (P C → P E) ⊢ P D , Q C $ by lim [l1, l2]
l4: $ P C , (P C → P D) ⊢ P C , P E , Q C $ by ax
l5: $ P C , (P C → P D) , P E ⊢ P E , Q C $ by ax
l6: $ P C , (P C → P D) , (P C → P E) ⊢ P E , Q C $ by lim [l4, l5]
l7: $ P C , (P C → P D) , (P C → P E) ⊢ (P D ∧ P E) , Q C $ by ran [l3, l6]
l8: $ P C , (P C → P D) , (P C → P E) , Q C ⊢ Q C $ by ax
l9: $ P C , (P C → P D) , (P C → P E) , ((P D ∧ P E) → Q C) ⊢ Q C $ by lim [l7, l8]
l10: $ P C , (P C → P D) , ((P C → P E) ∧ ((P D ∧ P E) → Q C)) ⊢ Q C $ by lan [l9]
l11: $ P C , ((P C → P D) ∧ ((P C → P E) ∧ ((P D ∧ P E) → Q C))) ⊢ Q C $ by lan [l10]
l12: $ P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D ∧ P E) → Q C))) ⊢ Q C $ by lan [l11]
l13: $ ∅ ⊢ (P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D ∧ P E) → Q C)))) → Q C $ by rim [l12]

lukasiewicz
-----------
l1: $ Q C , P C ⊢ P D , P E , P C $ by ax
l2: $ Q C ⊢ (P C → P D) , P E , P C $ by rim [l1]
l3: $ Q C , P E ⊢ P E , P C $ by ax
l4: $ ((P C → P D) → P E) , Q C ⊢ P E , P C $ by lim [l2, l3]
l5: $ ((P C → P D) → P E) , Q C , P C ⊢ P C $ by ax
l6: $ ((P C → P D) → P E) , (P E → P C) , Q C ⊢ P C $ by lim [l4, l5]
l7: $ ((P C → P D) → P E) , (P E → P C) ⊢ Q C → P C $ by rim [l6]
l8: $ ((P C → P D) → P E) ⊢ (P E → P C) → (Q C → P C) $ by rim [l7]
l9: $ ∅ ⊢ ((P C → P D) → P E) → ((P E → P C) → (Q C → P C)) $ by rim [l8]

case_irrel
----------
l1: $ P C ⊢ P C , P D , P E $ by ax
l2: $ P C , P D ⊢ P D , P E $ by ax
l3: $ P C ⊢ ¬ P D , P D , P E $ by rnot [l2]
l4: $ P C ⊢ (P C ∧ ¬ P D) , P D , P E $ by ran [l1, l3]
l5: $ P C , P E ⊢ P D , P E $ by ax
l6: $ ((P C ∧ ¬ P D) → P E) , P C ⊢ P D , P E $ by lim [l4, l5]
l7: $ ((P C ∧ ¬ P D) → P E) , P C ⊢ P C , P E $ by ax
l8: $ ((P C ∧ ¬ P D) → P E) , P C ⊢ (P C ∧ P D) , P E $ by ran [l7, l6]
l9: $ ((P C ∧ ¬ P D) → P E) , P C , P E ⊢ P E $ by ax
l10: $ ((P C ∧ P D) → P E) , ((P C ∧ ¬ P D) → P E) , P C ⊢ P E $ by lim [l8, l9]
l11: $ ((P C ∧ P D) → P E) ∧ ((P C ∧ ¬ P D) → P E) , P C ⊢ P E $ by lan [l10]
l12: $ ((P C ∧ P D) → P E) ∧ ((P C ∧ ¬ P D) → P E) ⊢ P C → P E $ by rim [l11]
l13: $ ∅ ⊢ (((P C ∧ P D) → P E) ∧ ((P C ∧ ¬ P D) → P E)) → (P C → P E) $ by rim [l12]

resolution_chain
----------------
l1: $ (¬ P E ∨ Q C) , ¬ Q C , P C ⊢ P C , P D $ by ax
l2: $ ¬ P C , (¬ P E ∨ Q C) , ¬ Q C , P C ⊢ P D $ by lnot [l1]
l3: $ ¬ Q C , P C , P E ⊢ P E , P D $ by ax
l4: $ ¬ P E , ¬ Q C , P C , P E ⊢ P D $ by lnot [l3]
l5: $ P C , P E , Q C ⊢ Q C , P D $ by ax
l6: $ ¬ Q C , P C , P E , Q C ⊢ P D $ by lnot [l5]
l7: $ (¬ P E ∨ Q C) , ¬ Q C , P C , P E ⊢ P D $ by lor [l4, l6]
l8: $ (¬ P C ∨ P E) , (¬ P E ∨ Q C) , ¬ Q C , P C ⊢ P D $ by lor [l2, l7]
l9: $ (¬ P C ∨ P E) , (¬ P E ∨ Q C) , ¬ Q C , P D ⊢ P D $ by ax
l10: $ (P C ∨ P D) , (¬ P C ∨ P E) , (¬ P E ∨ Q C) , ¬ Q C ⊢ P D $ by lor [l8, l9]
l11: $ (P C ∨ P D) , (¬ P C ∨ P E) , ((¬ P E ∨ Q C) ∧ ¬ Q C) ⊢ P D $ by lan [l10]
l12: $ (P C ∨ P D) , ((¬ P C ∨ P E) ∧ ((¬ P E ∨ Q C) ∧ ¬ Q C)) ⊢ P D $ by lan [l11]
l13: $ (P C ∨ P D) ∧ ((¬ P C ∨ P E) ∧ ((¬ P E ∨ Q C) ∧ ¬ Q C)) ⊢ P D $ by lan [l12]
l14: $ ∅ ⊢ ((P C ∨ P D) ∧ ((¬ P C ∨ P E) ∧ ((¬ P E ∨ Q C) ∧ ¬ Q C))) → P D $ by rim [l13]

hidden_branch
-------------
l1: $ P C , (Q C → P E) , (Q D → P E) , (Q E → P E) ⊢ P C , P D , P E $ by ax
l2: $ P C , (Q C → P E) , (Q D → P E) , (Q E → P E) , P D ⊢ P D , P E $ by ax
l3: $ P C , (P C → P D) , (Q C → P E) , (Q D → P E) , (Q E → P E) ⊢ P D , P E $ by lim [l1, l2]
l4: $ P C , (P C → P D) , (Q C → P E) , (Q D → P E) , (Q E → P E) , P E ⊢ P E $ by ax
l5: $ P C , (P C → P D) , (P D → P E) , (Q C → P E) , (Q D → P E) , (Q E → P E) ⊢ P E $ by lim [l3, l4]
l6: $ P C , (P C → P D) , (P D → P E) , (Q C → P E) , ((Q D → P E) ∧ (Q E → P E)) ⊢ P E $ by lan [l5]
l7: $ P C , (P C → P D) , (P D → P E) , ((Q C → P E) ∧ ((Q D → P E) ∧ (Q E → P E))) ⊢ P E $ by lan [l6]
l8: $ P C , (P C → P D) , ((P D → P E) ∧ ((Q C → P E) ∧ ((Q D → P E) ∧ (Q E → P E)))) ⊢ P E $ by lan [l7]
l9: $ P C , ((P C → P D) ∧ ((P D → P E) ∧ ((Q C → P E) ∧ ((Q D → P E) ∧ (Q E → P E))))) ⊢ P E $ by lan [l8]
l10: $ P C ∧ ((P C → P D) ∧ ((P D → P E) ∧ ((Q C → P E) ∧ ((Q D → P E) ∧ (Q E → P E))))) ⊢ P E $ by lan [l9]
l11: $ ∅ ⊢ (P C ∧ ((P C → P D) ∧ ((P D → P E) ∧ ((Q C → P E) ∧ ((Q D → P E) ∧ (Q E → P E)))))) → P E $ by rim [l10]

fan_in
------
l1: $ P C , (P C → P E) , (P E → Q D) ⊢ P C , P D , Q C , Q E $ by ax
l2: $ P C , (P C → P E) , (P E → Q D) , P D ⊢ P D , Q C , Q E $ by ax
l3: $ P C , (P C → P D) , (P C → P E) , (P E → Q D) ⊢ P D , Q C , Q E $ by lim [l1, l2]
l4: $ P C , (P C → P D) , (P C → P E) , (P E → Q D) , Q C ⊢ Q C , Q E $ by ax
l5: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q D) ⊢ Q C , Q E $ by lim [l3, l4]
l6: $ P C , (P C → P D) , (P D → Q C) ⊢ P C , P E , Q D , Q E $ by ax
l7: $ P C , (P C → P D) , (P D → Q C) , P E ⊢ P E , Q D , Q E $ by ax
l8: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) ⊢ P E , Q D , Q E $ by lim [l6, l7]
l9: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , Q D ⊢ Q D , Q E $ by ax
l10: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q D) ⊢ Q D , Q E $ by lim [l8, l9]
l11: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q D) ⊢ (Q C ∧ Q D) , Q E $ by ran [l5, l10]
l12: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q D) , Q E ⊢ Q E $ by ax
l13: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , (P E → Q D) , ((Q C ∧ Q D) → Q E) ⊢ Q E $ by lim [l11, l12]
l14: $ P C , (P C → P D) , (P C → P E) , (P D → Q C) , ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E)) ⊢ Q E $ by lan [l13]
l15: $ P C , (P C → P D) , (P C → P E) , ((P D → Q C) ∧ ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E))) ⊢ Q E $ by lan [l14]
l16: $ P C , (P C → P D) , ((P C → P E) ∧ ((P D → Q C) ∧ ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E)))) ⊢ Q E $ by lan [l15]
l17: $ P C , ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E))))) ⊢ Q E $ by lan [l16]
l18: $ P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E))))) ⊢ Q E $ by lan [l17]
l19: $ ∅ ⊢ (P C ∧ ((P C → P D) ∧ ((P C → P E) ∧ ((P D → Q C) ∧ ((P E → Q D) ∧ ((Q C ∧ Q D) → Q E)))))) → Q E $ by rim [l18]

nested_branch
-------------
l1: $ P C , P D ⊢ P D , P E $ by ax
l2: $ P C ⊢ ¬ P D , P D , P E $ by rnot [l1]
l3: $ P C , P E ⊢ P D , P E $ by ax
l4: $ P C , (¬ P D → P E) ⊢ P D , P E $ by lim [l2, l3]
l5: $ P C , (¬ P D → P E) , P E ⊢ P E $ by ax
l6: $ P C , (P D → P E) , (¬ P D → P E) ⊢ P E $ by lim [l4, l5]
l7: $ P C , ((P D → P E) ∧ (¬ P D → P E)) ⊢ P E $ by lan [l6]
l8: $ P C ⊢ P C , P E $ by ax
l9: $ P C , (P C → ((P D → P E) ∧ (¬ P D → P E))) ⊢ P E $ by lim [l8, l7]
l10: $ (P C → ((P D → P E) ∧ (¬ P D → P E))) ⊢ ¬ P C , P E $ by rnot [l9]
l11: $ (P C → ((P D → P E) ∧ (¬ P D → P E))) , P E ⊢ P E $ by ax
l12: $ (P C → ((P D → P E) ∧ (¬ P D → P E))) , (¬ P C → P E) ⊢ P E $ by lim [l10, l11]
l13: $ (P C → ((P D → P E) ∧ (¬ P D → P E))) ∧ (¬ P C → P E) ⊢ P E $ by lan [l12]
l14: $ ∅ ⊢ ((P C → ((P D → P E) ∧ (¬ P D → P E))) ∧ (¬ P C → P E)) → P E $ by rim [l13]

and_assoc_fwd
-------------
l1: $ P C , P D , P E ⊢ P C $ by ax
l2: $ P C , P D , P E ⊢ P D $ by ax
l3: $ P C , P D , P E ⊢ P E $ by ax
l4: $ P C , P D , P E ⊢ P D ∧ P E $ by ran [l2, l3]
l5: $ P C , P D , P E ⊢ P C ∧ (P D ∧ P E) $ by ran [l1, l4]
l6: $ P C ∧ P D , P E ⊢ P C ∧ (P D ∧ P E) $ by lan [l5]
l7: $ (P C ∧ P D) ∧ P E ⊢ P C ∧ (P D ∧ P E) $ by lan [l6]
l8: $ ∅ ⊢ ((P C ∧ P D) ∧ P E) → (P C ∧ (P D ∧ P E)) $ by rim [l7]

or_assoc_fwd
------------
l1: $ P C ⊢ P C , (P D ∨ P E) $ by ax
l2: $ P C ⊢ P C ∨ (P D ∨ P E) $ by ror [l1]
l3: $ P D ⊢ P C , P D , P E $ by ax
l4: $ P D ⊢ P C , (P D ∨ P E) $ by ror [l3]
l5: $ P D ⊢ P C ∨ (P D ∨ P E) $ by ror [l4]
l6: $ P C ∨ P D ⊢ P C ∨ (P D ∨ P E) $ by lor [l2, l5]
l7: $ P E ⊢ P C , P D , P E $ by ax
l8: $ P E ⊢ P C , (P D ∨ P E) $ by ror [l7]
l9: $ P E ⊢ P C ∨ (P D ∨ P E) $ by ror [l8]
l10: $ (P C ∨ P D) ∨ P E ⊢ P C ∨ (P D ∨ P E) $ by lor [l6, l9]
l11: $ ∅ ⊢ ((P C ∨ P D) ∨ P E) → (P C ∨ (P D ∨ P E)) $ by rim [l10]

contrapos_fwd
-------------
l1: $ P C ⊢ P C , P D $ by ax
l2: $ P C , P D ⊢ P D $ by ax
l3: $ P C , P C → P D ⊢ P D $ by lim [l1, l2]
l4: $ P C , P C → P D , ¬ P D ⊢ ∅ $ by lnot [l3]
l5: $ P C → P D , ¬ P D ⊢ ¬ P C $ by rnot [l4]
l6: $ P C → P D ⊢ ¬ P D → ¬ P C $ by rim [l5]
l7: $ ∅ ⊢ (P C → P D) → (¬ P D → ¬ P C) $ by rim [l6]

triple_neg
----------
l1: $ P C ⊢ P C $ by ax
l2: $ P C , ¬ P C ⊢ ∅ $ by lnot [l1]
l3: $ P C ⊢ ¬ ¬ P C $ by rnot [l2]
l4: $ ¬ ¬ ¬ P C , P C ⊢ ∅ $ by lnot [l3]
l5: $ ¬ ¬ ¬ P C ⊢ ¬ P C $ by rnot [l4]
l6: $ ∅ ⊢ ¬ ¬ ¬ P C → ¬ P C $ by rim [l5]

hilbert_dilemma
---------------
l1: $ P C , P D → P E ⊢ P C , P E $ by ax
l2: $ P C , P E , P D → P E ⊢ P E $ by ax
l3: $ P C , P C → P E , P D → P E ⊢ P E $ by lim [l1, l2]
l4: $ P D , P C → P E ⊢ P D , P E $ by ax
l5: $ P D , P E , P C → P E ⊢ P E $ by ax
l6: $ P D , P D → P E , P C → P E ⊢ P E $ by lim [l4, l5]
l7: $ P C ∨ P D , P C → P E , P D → P E ⊢ P E $ by lor [l3, l6]
l8: $ P C ∨ P D , P C → P E ⊢ (P D → P E) → P E $ by rim [l7]
l9: $ P C ∨ P D ⊢ (P C → P E) → ((P D → P E) → P E) $ by rim [l8]
l10: $ ∅ ⊢ (P C ∨ P D) → ((P C → P E) → ((P D → P E) → P E)) $ by rim [l9]

ex_conj_weak
------------
l1: $ P x , Q x ⊢ P x , ∃ y P y $ by ax
l2: $ P x , Q x ⊢ ∃ y P y $ by rex [l1]
l3: $ P x ∧ Q x ⊢ ∃ y P y $ by lan [l2]
l4: $ ∃ x (P x ∧ Q x) ⊢ ∃ y P y $ by lex [l3]
l5: $ ∅ ⊢ (∃ x (P x ∧ Q x)) → (∃ y P y) $ by rim [l4]

ex_witness_conj
---------------
l1: $ P C , Q C ⊢ P C , ∃ x (P x ∧ Q x) $ by ax
l2: $ P C , Q C ⊢ Q C , ∃ x (P x ∧ Q x) $ by ax
l3: $ P C , Q C ⊢ (P C ∧ Q C) , ∃ x (P x ∧ Q x) $ by ran [l1, l2]
l4: $ P C , Q C ⊢ ∃ x (P x ∧ Q x) $ by rex [l3]
l5: $ P C ∧ Q C ⊢ ∃ x (P x ∧ Q x) $ by lan [l4]
l6: $ ∅ ⊢ (P C ∧ Q C) → (∃ x (P x ∧ Q x)) $ by rim [l5]
