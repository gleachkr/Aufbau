  by arr_beta [l4, l4, l6, #4]
l8: $ g ⊢ ≡[[x/s] B]
  ((J x y q A (B → [x/y] B) (λ w : B. w) s s (refl A s)) · u) = u $
  by eq_tm_trans [l5, l7]

