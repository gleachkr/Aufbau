  [x/t] B $ by arr_elim [l4, l3, #6, l5]

transport_refl
--------------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (B → [x/y] B) $
  by transport_motive [#1, #2]
l2: $ g , x : A ⊢ (λ w : B. w) : (B → B) $ by lam_id_ty [#2]
