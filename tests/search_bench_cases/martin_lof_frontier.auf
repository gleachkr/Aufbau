zero_code_one
-------------

l1: $ g ⊢ Ty U $ by U_form [#1]
l2: $ g ⊢ nat_c : U $ by nat_c_intro [#1]
l3: $ g ⊢ (λ w : U. empty_c) : (U → U) $ by zero_code_step_ty [#1]
l4: $ g ⊢ zero : Nat $ by zero_intro [#1]
l5: $ g ⊢ ≡[U] (zero_code (suc zero)) =
  ((λ w : U. empty_c) · (zero_code zero)) $ by nat_rec_suc [#1, l1, l2, l3, l4]
l6: $ g ⊢ zero_code zero : U $ by zero_code_ty [#1, l4]
l7: $ ok (g , w : U) $ by ext_ok [#1, l1]
l8: $ g , w : U ⊢ empty_c : U $ by empty_c_intro [l7]
l9: $ g ⊢ ≡[U] ((λ w : U. empty_c) · (zero_code zero)) = empty_c $
  by arr_beta [l1, l1, l8, l6]
l10: $ g ⊢ ≡[U] (zero_code (suc zero)) = empty_c $ by eq_tm_trans [l5, l9]
l11: $ g , y : U ⊢ y : U $ by var [l1]
l12: $ g , y : U ⊢ Ty (El y) $ by El_form [l11]
l13: $ g ⊢ El (zero_code (suc zero)) ≡ Empty $ by sb_ty_eq [l12, l10]

zero_ne_one
-----------

l1: $ g ⊢ zero : Nat $ by zero_intro [#1]
l2: $ g ⊢ suc zero : Nat $ by suc_intro [l1]
l3: $ g ⊢ Ty (Id Nat zero (suc zero)) $ by Id_form [l1, l2]
l4: $ ok (g , p : Id Nat zero (suc zero)) $ by ext_ok [#1, l3]
l5: $ g , p : Id Nat zero (suc zero) ⊢ Ty Nat $ by nat_form [l4]
l6: $ ok (g , p : Id Nat zero (suc zero) , x : Nat) $ by ext_ok [l4, l5]
l7: $ g , p : Id Nat zero (suc zero) , x : Nat ⊢ x : Nat $ by var [l5]
l8: $ g , p : Id Nat zero (suc zero) , x : Nat ⊢ zero_code x : U $
  by zero_code_ty [l6, l7]
l9: $ g , p : Id Nat zero (suc zero) , x : Nat ⊢ Ty (El (zero_code x)) $
  by El_form [l8]
l10: $ g , p : Id Nat zero (suc zero) ⊢ zero : Nat $ by zero_intro [l4]
l11: $ g , p : Id Nat zero (suc zero) ⊢ suc zero : Nat $ by suc_intro [l10]
l12: $ g , p : Id Nat zero (suc zero) ⊢ p : Id Nat zero (suc zero) $
  by var [l3]
l13: $ g , p : Id Nat zero (suc zero) ⊢ El (zero_code zero) ≡ Nat $
  by zero_code_zero [l4]
l14: $ g , p : Id Nat zero (suc zero) ⊢ Nat ≡ El (zero_code zero) $
  by eq_ty_sym [l13]
l15: $ g , p : Id Nat zero (suc zero) ⊢ zero : El (zero_code zero) $
  by ty_conv [l14, l10]
l16: $ g , p : Id Nat zero (suc zero) ⊢
  transport Nat x (El (zero_code x)) zero (suc zero) p zero :
  El (zero_code (suc zero)) $ by transport_ty [l5, l9, l10, l11, l12, l15]
l17: $ g , p : Id Nat zero (suc zero) ⊢ El (zero_code (suc zero)) ≡ Empty $
  by zero_code_one [l4]
l18: $ g , p : Id Nat zero (suc zero) ⊢
  transport Nat x (El (zero_code x)) zero (suc zero) p zero : Empty $
  by ty_conv [l17, l16]
l19: $ g ⊢ Ty Empty $ by empty_form [#1]
l20: $ g ⊢ zero_ne_one_p : (Id Nat zero (suc zero) → Empty) $
  by arr_intro [l3, l19, l18]
