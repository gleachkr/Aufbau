l5: $ g ⊢ ≡[[x/s] B]
  ((J x y q A (B → [x/y] B) (λ w : B. w) s s (refl A s)) · u) =
  ((λ w : [x/s] B. w) · u) $ by app_eq_left [l4, l4, l3, #4]
