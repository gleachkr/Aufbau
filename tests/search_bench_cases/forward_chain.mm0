-- Bench-only sequent theory for the forward-recipe re-grounding guard: a
-- triple-nested universal transitivity fact instantiated by `@auto forward`
-- all_elim and chained by `@auto forward` imp_elim over a six-fact relation
-- chain. Every family fact derived from the ∀-hypothesis shares ONE universal
-- meta per binder, so the goal's recipe re-grounds the same `?z` at several
-- nested layers (`… at z := j` wrapped around a minor premise that was itself
-- `… at z := i`); the recipe resolver must let the innermost pin win, or the
-- goal fact sits in the derived pool but never validates. The ND core
-- (contexts, congruences, substitution battery) is the nd_forward_backward.mm0
-- subset of euclid.mm0, kept self-contained per the bench fixture convention.
delimiter $ ( ) [ / ] $;

provable sort wff;
sort ctx;
sort obj;

term im (a b: wff): wff;
infixr im: $→$ prec 25;
term bi (a b: wff): wff;
infixl bi: $↔$ prec 20;

term all {x: obj} (p: wff x): wff;
prefix all: $∀$ prec 41;

term sb_f {x: obj} (t: obj x) (p: wff x): wff;
notation sb_f {x: obj} (t: obj x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;
term sb_t {x: obj} (t: obj x) (a: obj x): obj;
notation sb_t {x: obj} (t: obj x) (a: obj x): obj =
  ($subst$:41) x ($/$:0) t a;

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;

term nd (g: ctx) (a: wff): wff;
infixl nd: $⊢$ prec 0;

term eq (a b: obj): wff;
infixl eq: $=$ prec 50;

term R (a b: obj): wff;

-- The bi-conditional is the rewrite relation on wff.
--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ a ↔ a $;
axiom bitr (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom bisym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom mpbi (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

-- ACUI equality on contexts.
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @relation obj eq eq_refl eq_trans eq_sym _
axiom eq_refl (a: obj): $ a = a $;
axiom eq_trans (a b c: obj):
  $ a = b $ > $ b = c $ > $ a = c $;
axiom eq_sym (a b: obj): $ a = b $ > $ b = a $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a ↔ b $ > $ (g ⊢ a) ↔ (h ⊢ b) $;
--| @congr
axiom im_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;
--| @congr
axiom all_congr {x: obj} (p q: wff x):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom R_congr (a b c d: obj):
  $ a = b $ > $ c = d $ > $ (R a c) ↔ (R b d) $;

--| @rewrite
axiom sb_t_var {x: obj} (t: obj x): $ (subst x / t x) = t $;
--| @rewrite
axiom sb_t_other {x y: obj} (t: obj x): $ (subst x / t y) = y $;
--| @rewrite
axiom sb_t_irrel {x: obj} (t: obj x) (a: obj): $ (subst x / t a) = a $;
--| @rewrite
axiom sb_f_im {x: obj} (t: obj x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;
--| @rewrite
axiom sb_f_all {x y: obj} (t: obj x) (p: wff x y):
  $ [x/t] (∀ y p) ↔ ∀ y ([x/t] p) $;
--| @rewrite
axiom sb_f_R {x: obj} (t: obj x) (a b: obj x):
  $ [x/t] (R a b) ↔ R (subst x / t a) (subst x / t b) $;

-- ND structural rules.
axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

-- Implication elimination, the forward chaining rule (the derived contexts
-- `g , g` collapse to `g` under ACUI canonicalization).
--| @auto forward
axiom imp_elim (g h: ctx) (a b: wff):
  $ g ⊢ a → b $ > $ h ⊢ a $ > $ g , h ⊢ b $;

-- Sequent-form universal elimination, the @auto forward rule.
--| @view {x: obj} (g: ctx x) (t: obj x) (p: wff x) (q: wff): $ g ⊢ ∀ x p $ > $ g ⊢ q $
--| @recover t q p x
--| @auto forward
axiom all_elim {x: obj} (g: ctx x) (t: obj x) (p: wff x):
  $ g ⊢ ∀ x p $ > $ g ⊢ [x/t] p $;

-- Six-fact chain. Five facts already succeed through a shallower route; six
-- is the first length whose every recipe nests a re-grounding of `?z`.
theorem chain6 {x y z: obj} (g: ctx) (a b c d e i j: obj):
  $ g ⊢ ∀ x ∀ y ∀ z (R x y → R y z → R x z) $ >
  $ g ⊢ R a b $ > $ g ⊢ R b c $ > $ g ⊢ R c d $ >
  $ g ⊢ R d e $ > $ g ⊢ R e i $ > $ g ⊢ R i j $ >
  $ g ⊢ R a j $;
