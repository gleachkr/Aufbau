forall_not_to_not_exists
------------------------

l1: $ (∀ a (¬ (F a b))) ⊢ ∀ a (¬ (F a b)) $ by ax []
l2: $ _wff $ by all_elim (t := $ a $) [l1]
l3: $ (F a b) ⊢ F a b $ by ax []
l4: $ _wff $ by not_elim [l2, l3]
l5: $ (∃ a (F a b)) ⊢ ∃ a (F a b) $ by ax []
l6: $ _wff $ by ex_elim [l5, l4]
l7: $ _ctx ⊢ ¬ (∃ a (F a b)) $ by not_intro [l6]
l8: $ _wff $ by imp_intro [l7]
