-- Proofs use ordinary LTL rules only. Server behavior enters through
-- theorem hypotheses or the explicit server_spec assumption.

gop_ind_thm
-----------

l1: $ G (p → ○ p) , p ⊢ G (p → ○ p) $ by ax
l2: $ G (p → ○ p) , p ⊢ p $ by ax
l3: $ G (p → ○ p) , p ⊢ G p $ by gop_ind [l1, l2]
l4: $ G (p → ○ p) ⊢ p → G p $ by imp_intro [l3]
l5: $ _ ⊢ (G (p → ○ p)) → (p → G p) $ by imp_intro [l4]

gop_K_thm
---------

l1: $ G (p → q) , G p ⊢ G (p → q) $ by ax
l2: $ G (p → q) , G p ⊢ G p $ by ax
l3: $ G (p → q) , G p ⊢ G q $ by gop_K [l1, l2]
l4: $ G (p → q) ⊢ G p → G q $ by imp_intro [l3]
l5: $ _ ⊢ (G (p → q)) → (G p → G q) $ by imp_intro [l4]

invariant_pair
--------------

-- Split the base case, induct on each component, then combine under G.
l1: $ g ⊢ p $ by and_elim_l [#3]
l2: $ g ⊢ q $ by and_elim_r [#3]
l3: $ g ⊢ G p $ by gop_ind [#1, l1]
l4: $ g ⊢ G q $ by gop_ind [#2, l2]
l5: $ g ⊢ G (p ∧ q) $ by gop_and [l3, l4]

stick_req
---------

l1: $ g ⊢ G req $ by gop_ind [#1, #2]

stick_res
---------

l1: $ g ⊢ G res $ by gop_ind [#1, #2]

req_response
------------

-- Specialize responsiveness to now, then obtain an eventual response.
l1: $ g ⊢ req → F res $ by gop_T [#1]
l2: $ g ⊢ F res $ by imp_elim [l1, #3]
-- Causality holds at that future response-state, not merely now.
l3: $ g ⊢ F (req ∧ res) $ by fop_pair [l2, #2]

response_stable
---------------

-- Opening the transparent specification exposes the two step laws.
l1: $ server_spec , (req ∧ res) ⊢ server_spec $ by ax
l2: $ server_spec , (req ∧ res) ⊢ G (req → ○ req) $
  by and_elim_l [l1]
l3: $ server_spec , (req ∧ res) ⊢
  G (res → ○ res) ∧ G (req → F res) ∧ G (res → req) $
  by and_elim_r [l1]
l4: $ server_spec , (req ∧ res) ⊢ G (res → ○ res) $
  by and_elim_l [l3]
l5: $ server_spec , (req ∧ res) ⊢ req ∧ res $ by ax
l6: $ server_spec , (req ∧ res) ⊢ G (req ∧ res) $
  by invariant_pair [l2, l4, l5]
l7: $ server_spec ⊢ (req ∧ res) → G (req ∧ res) $
  by imp_intro [l6]

req_response_safe
-----------------

-- Extract the laws in the context of a current request.
l1: $ server_spec , req ⊢ server_spec $ by ax
l2: $ server_spec , req ⊢ G (req → ○ req) $ by and_elim_l [l1]
l3: $ server_spec , req ⊢
  G (res → ○ res) ∧ G (req → F res) ∧ G (res → req) $
  by and_elim_r [l1]
l4: $ server_spec , req ⊢ G (req → F res) ∧ G (res → req) $
  by and_elim_r [l3]
l5: $ server_spec , req ⊢ G (req → F res) $ by and_elim_l [l4]
l6: $ server_spec , req ⊢ G (res → req) $ by and_elim_r [l4]
l7: $ server_spec , req ⊢ req $ by ax
-- Safety and liveness are separate derivations, then joined explicitly.
l8: $ server_spec , req ⊢ G req $ by stick_req [l2, l7]
l9: $ server_spec , req ⊢ F (req ∧ res) $
  by req_response [l5, l6, l7]
l10: $ server_spec , req ⊢ G req ∧ F (req ∧ res) $
  by and_intro [l8, l9]
l11: $ server_spec ⊢ req → (G req ∧ F (req ∧ res)) $
  by imp_intro [l10]
