import "lib/ctx.mm0";
import "lib/iff.mm0";

term seq (g d: ctx): wff;
infixl seq: $==>$ prec 0;

--| @congr
axiom seq_congr (g1 g2 d1 d2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq d1 d2 $ > $ (g1 ==> d1) ↔ (g2 ==> d2) $;

axiom quad_cut (g h i j d e f k: ctx) (a b c p: wff):
  $ g , a ==> d $
  > $ h , b ==> e $
  > $ i , c ==> f $
  > $ j , p ==> k $
  > $ g , h , i , j ==> d , e , f , k $;

theorem acui_four_way_cut_stress (a b c p u v w z: wff):
  $ a ==> u $
  > $ b ==> v $
  > $ c ==> w $
  > $ p ==> z $
  > $ emp ==> u , v , w , z $;
