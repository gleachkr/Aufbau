delimiter $ ( ) $;
--| @hole _
--| @unknown ?
provable sort wff;
term imp (a b: wff): wff;
infixr imp: $->$ prec 25;
axiom mp (a b: wff): $ a -> b $ > $ a $ > $ b $;
axiom ax1 (a b: wff): $ a -> b -> a $;
axiom ax2 (a b c: wff): $ (a -> b -> c) -> (a -> b) -> a -> c $;
--| have by use: l1's statement is fixed by l3
theorem use_fixes (p q: wff): $ p $ > $ q -> p $;
--| id via the usual Hilbert proof with all formulas named
theorem id (p: wff): $ p -> p $;
