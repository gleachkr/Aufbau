-- Hoare logic over first-order dynamic logic: verified little programs.
--
-- This is the assignment layer on top of the `pratt` fixture's PDL core.
-- Where `pratt` derives the structural Hoare rules (seq, while, consequence)
-- from the Segerberg axioms, this fixture adds *program variables* and the
-- assignment command, and then verifies actual programs:
--
--   overwrite:  ⦃ ⊤ ⦄ x ≔ a ⨟ x ≔ b ⟦ x = b ⟧          (last write wins)
--   swap:       ⦃ x = a ∧ y = b ⦄ t ≔ x ⨟ x ≔ y ⨟ y ≔ t ⟦ x = b ∧ y = a ⟧
--   countdown:  ⦃ ⊤ ⦄ while (¬ x = 0) (x ≔ pred x) ⟦ x = 0 ⟧
--
-- The key encoding choice: `⟨ x ≔ e ⟩` is a program constructor whose
-- variable is a *bound binder*, exactly the binding shape of the
-- substitution operator `⌊ x / e ⌋ p` — the expression `e` may mention the
-- old value of `x`, and the formula under the box consumes `x`.  The Floyd
-- assignment axiom is then one more rewrite:
--
--   [ ⟨ x ≔ e ⟩ ] p  ≃  ⌊ x / e ⌋ p     (red_assign, @rewrite)
--
-- and substitution pushes through the formula language by the standard
-- `sb` battery.  The payoff is that the rewrite engine computes weakest
-- preconditions: the proofs below cite `hoare_assign` with the *computed*
-- precondition already written out, and normalization proves it equal to
-- the substitution instance — no substitution step is ever written by hand.
-- `countdown` is verified without a single axiom about `pred` or `0`:
-- partial correctness of the loop needs only logic.
delimiter $ ( ) [ / ] $;

provable sort wff;
sort ctx;
--| @vars u v s
sort world;
sort form;
sort prog;
--| @vars z
sort obj;

-- ============================================================
-- Program variables and expressions
-- ============================================================

term zero: obj;
notation zero: obj = ($0$:max);
term pred (a: obj): obj;

-- ============================================================
-- Formulas
-- ============================================================

term imp (p q: form): form;
infixr imp: $→$ prec 25;
term an (p q: form): form;
infixr an: $∧$ prec 35;
term neg (p: form): form;
prefix neg: $¬$ prec 40;
term tt: form;
notation tt: form = ($⊤$:max);
term bot: form;
notation bot: form = ($⊥$:max);
term eq (a b: obj): form;
infixl eq: $=$ prec 50;

-- ============================================================
-- Programs
-- ============================================================

term sq (a b: prog): prog;
infixr sq: $⨟$ prec 32;
term star (a: prog): prog;
prefix star: $⋆$ prec 45;
term test (p: form): prog;
prefix test: $?$ prec 45;

-- Assignment: `e` may mention the old value of `x`.
term assign {x: obj} (e: obj x): prog;
notation assign {x: obj} (e: obj x): prog =
  ($⟨$:45) x ($≔$:0) e ($⟩$:0);

-- The box modality, indexed by a program.
term box (a: prog) (p: form): form;
notation box (a: prog) (p: form): form = ($[$:41) a ($]$:0) p;

-- Substitution: `⌊ x / t ⌋ p` and `subst x / t a`, the machinery the
-- assignment axiom normalizes through.
term sb_f {x: obj} (t: obj x) (p: form x): form;
notation sb_f {x: obj} (t: obj x) (p: form x): form =
  ($⌊$:41) x ($/$:0) t ($⌋$:0) p;
term sb_t {x: obj} (t: obj x) (a: obj x): obj;
notation sb_t {x: obj} (t: obj x) (a: obj x): obj =
  ($subst$:41) x ($/$:0) t a;

-- ============================================================
-- Judgments
-- ============================================================

term iff (a b: wff): wff;
infixr iff: $↔$ prec 20;
term feq (p q: form): wff;
infixr feq: $≃$ prec 20;
term peq (a b: prog): wff;
infixr peq: $≡$ prec 20;
term weq (w v: world): wff;
infixl weq: $≈$ prec 50;
term oeq (a b: obj): wff;
infixl oeq: $≐$ prec 50;

-- "p holds at world w" and "program a steps from w to v".
term at (w: world) (p: form): wff;
infixl at: $:$ prec 24;
term step (w: world) (a: prog) (v: world): wff;
notation step (w: world) (a: prog) (v: world): wff = ($step$:35) w a v;

-- Contexts: ACUI sets of labelled facts.
term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($∅$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (a: wff): wff;
infixl nd: $⊢$ prec 0;

-- Validity: p holds at every state.
term valid (p: form): wff;
prefix valid: $⊨$ prec 3;

-- The Hoare triple, sugar for a valid box formula (see ht_intro/ht_elim).
term ht (p: form) (a: prog) (q: form): wff;
notation ht (p: form) (a: prog) (q: form): wff =
  ($⦃$:35) p ($⦄$:0) a ($⟦$:35) q ($⟧$:0);

-- ============================================================
-- Relation / congruence batteries
-- ============================================================

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a ↔ a $;
axiom iff_trans (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom iff_sym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom iff_mp (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

-- Formula equivalence is the rewrite relation on form.
--| @relation form feq feq_refl feq_trans feq_sym _
axiom feq_refl (p: form): $ p ≃ p $;
axiom feq_trans (p q r: form):
  $ p ≃ q $ > $ q ≃ r $ > $ p ≃ r $;
axiom feq_sym (p q: form): $ p ≃ q $ > $ q ≃ p $;

--| @relation prog peq peq_refl peq_trans peq_sym _
axiom peq_refl (a: prog): $ a ≡ a $;
axiom peq_trans (a b c: prog):
  $ a ≡ b $ > $ b ≡ c $ > $ a ≡ c $;
axiom peq_sym (a b: prog): $ a ≡ b $ > $ b ≡ a $;

--| @relation world weq weq_refl weq_trans weq_sym _
axiom weq_refl (w: world): $ w ≈ w $;
axiom weq_trans (w v u: world):
  $ w ≈ v $ > $ v ≈ u $ > $ w ≈ u $;
axiom weq_sym (w v: world): $ w ≈ v $ > $ v ≈ w $;

--| @relation obj oeq oeq_refl oeq_trans oeq_sym _
axiom oeq_refl (a: obj): $ a ≐ a $;
axiom oeq_trans (a b c: obj):
  $ a ≐ b $ > $ b ≐ c $ > $ a ≐ c $;
axiom oeq_sym (a b: obj): $ a ≐ b $ > $ b ≐ a $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (∅ , g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a ↔ b $ > $ (g ⊢ a) ↔ (h ⊢ b) $;

--| @congr
axiom imp_congr (p1 p2 q1 q2: form):
  $ p1 ≃ p2 $ > $ q1 ≃ q2 $ > $ (p1 → q1) ≃ (p2 → q2) $;
--| @congr
axiom an_congr (p1 p2 q1 q2: form):
  $ p1 ≃ p2 $ > $ q1 ≃ q2 $ > $ (p1 ∧ q1) ≃ (p2 ∧ q2) $;
--| @congr
axiom neg_congr (p q: form): $ p ≃ q $ > $ ¬ p ≃ ¬ q $;
--| @congr
axiom eq_congr (a b c d: obj):
  $ a ≐ b $ > $ c ≐ d $ > $ (a = c) ≃ (b = d) $;
--| @congr
axiom pred_congr (a b: obj): $ a ≐ b $ > $ pred a ≐ pred b $;
--| @congr
axiom box_congr (a1 a2: prog) (p q: form):
  $ a1 ≡ a2 $ > $ p ≃ q $ > $ [ a1 ] p ≃ [ a2 ] q $;

--| @congr
axiom sq_congr (a1 a2 b1 b2: prog):
  $ a1 ≡ a2 $ > $ b1 ≡ b2 $ > $ (a1 ⨟ b1) ≡ (a2 ⨟ b2) $;
--| @congr
axiom star_congr (a b: prog): $ a ≡ b $ > $ ⋆ a ≡ ⋆ b $;
--| @congr
axiom test_congr (p q: form): $ p ≃ q $ > $ ? p ≡ ? q $;

--| @congr
axiom at_congr (w1 w2: world) (p q: form):
  $ w1 ≈ w2 $ > $ p ≃ q $ > $ (w1 : p) ↔ (w2 : q) $;
--| @congr
axiom step_congr (w1 w2: world) (a1 a2: prog) (v1 v2: world):
  $ w1 ≈ w2 $ > $ a1 ≡ a2 $ > $ v1 ≈ v2 $ >
  $ (step w1 a1 v1) ↔ (step w2 a2 v2) $;
--| @congr
axiom valid_congr (p q: form): $ p ≃ q $ > $ (⊨ p) ↔ (⊨ q) $;
--| @congr
axiom ht_congr (p1 p2: form) (a1 a2: prog) (q1 q2: form):
  $ p1 ≃ p2 $ > $ a1 ≡ a2 $ > $ q1 ≃ q2 $ >
  $ (⦃ p1 ⦄ a1 ⟦ q1 ⟧) ↔ (⦃ p2 ⦄ a2 ⟦ q2 ⟧) $;

-- ============================================================
-- Substitution computation
-- ============================================================

--| @rewrite
axiom sb_t_var {x: obj} (t: obj x): $ (subst x / t x) ≐ t $;
--| @rewrite
axiom sb_t_other {x y: obj} (t: obj x): $ (subst x / t y) ≐ y $;
--| @rewrite
axiom sb_t_irrel {x: obj} (t: obj x) (a: obj): $ (subst x / t a) ≐ a $;
--| @rewrite
axiom sb_t_pred {x: obj} (t: obj x) (a: obj x):
  $ (subst x / t (pred a)) ≐ pred (subst x / t a) $;
--| @rewrite
axiom sb_f_irrel {x: obj} (t: obj x) (p: form): $ (⌊ x / t ⌋ p) ≃ p $;
--| @rewrite
axiom sb_f_eq {x: obj} (t: obj x) (a b: obj x):
  $ (⌊ x / t ⌋ (a = b)) ≃ ((subst x / t a) = (subst x / t b)) $;
--| @rewrite
axiom sb_f_an {x: obj} (t: obj x) (p q: form x):
  $ (⌊ x / t ⌋ (p ∧ q)) ≃ ((⌊ x / t ⌋ p) ∧ (⌊ x / t ⌋ q)) $;
--| @rewrite
axiom sb_f_imp {x: obj} (t: obj x) (p q: form x):
  $ (⌊ x / t ⌋ (p → q)) ≃ ((⌊ x / t ⌋ p) → (⌊ x / t ⌋ q)) $;
--| @rewrite
axiom sb_f_neg {x: obj} (t: obj x) (p: form x):
  $ (⌊ x / t ⌋ (¬ p)) ≃ (¬ (⌊ x / t ⌋ p)) $;

-- ============================================================
-- Labelled natural deduction: propositional core
-- ============================================================

axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

--| @auto eager
axiom imp_intro (g: ctx) (w: world) (p q: form):
  $ g , w : p ⊢ w : q $ > $ g ⊢ w : (p → q) $;
--| @auto forward
axiom imp_elim (g h: ctx) (w: world) (p q: form):
  $ g ⊢ w : (p → q) $ > $ h ⊢ w : p $ > $ g , h ⊢ w : q $;

--| @auto eager 2
axiom an_intro (g: ctx) (w: world) (p q: form):
  $ g ⊢ w : p $ > $ g ⊢ w : q $ > $ g ⊢ w : (p ∧ q) $;
--| @auto forward
axiom an_elim_l (g: ctx) (w: world) (p q: form):
  $ g ⊢ w : (p ∧ q) $ > $ g ⊢ w : p $;
--| @auto forward
axiom an_elim_r (g: ctx) (w: world) (p q: form):
  $ g ⊢ w : (p ∧ q) $ > $ g ⊢ w : q $;

--| @auto eager
axiom neg_intro (g: ctx) (w: world) (p: form):
  $ g , w : p ⊢ w : ⊥ $ > $ g ⊢ w : (¬ p) $;
--| @auto forward
axiom neg_elim (g h: ctx) (w: world) (p: form):
  $ g ⊢ w : (¬ p) $ > $ h ⊢ w : p $ > $ g , h ⊢ w : ⊥ $;
axiom bot_elim (g: ctx) (w v: world) (p: form):
  $ g ⊢ w : ⊥ $ > $ g ⊢ v : p $;
axiom tt_intro (g: ctx) (w: world): $ g ⊢ w : ⊤ $;

-- Classical base logic: proof by contradiction.
axiom pbc (g: ctx) (w: world) (p: form):
  $ g , w : (¬ p) ⊢ w : ⊥ $ > $ g ⊢ w : p $;

-- Equality is reflexive at every state.
axiom eq_refl_nd (g: ctx) (w: world) (a: obj): $ g ⊢ w : (a = a) $;

-- Formula equivalence transports along `:` (sequent premise first, so a
-- cited line pins `p` before the equivalence premise is elaborated).
axiom at_mp (g: ctx) (w: world) (p q: form):
  $ g ⊢ w : p $ > $ p ≃ q $ > $ g ⊢ w : q $;

-- ============================================================
-- The modality: K and necessitation for every program at once
-- ============================================================

axiom box_intro (g: ctx) (w: world) {v: world} (a: prog) (p: form):
  $ g , step w a v ⊢ v : p $ > $ g ⊢ w : ([ a ] p) $;
--| @auto forward
axiom box_elim (g h: ctx) (w v: world) (a: prog) (p: form):
  $ g ⊢ w : ([ a ] p) $ > $ h ⊢ step w a v $ > $ g , h ⊢ v : p $;

-- ============================================================
-- Program structure: reduction axioms, including assignment
-- ============================================================

--| @rewrite
axiom red_seq (a b: prog) (p: form):
  $ [ a ⨟ b ] p ≃ [ a ] ([ b ] p) $;
--| @rewrite
axiom red_test (q p: form):
  $ [ ? q ] p ≃ (q → p) $;

-- The Floyd assignment axiom, as a rewrite into the substitution battery.
--| @rewrite
axiom red_assign {x: obj} (e: obj x) (p: form x):
  $ [ ⟨ x ≔ e ⟩ ] p ≃ (⌊ x / e ⌋ p) $;

-- Iteration: fixpoint unfolding (not a rewrite — it would loop) and the
-- induction rule.
axiom star_fix (a: prog) (p: form):
  $ [ ⋆ a ] p ≃ (p ∧ ([ a ] ([ ⋆ a ] p))) $;
axiom star_ind (g: ctx) (w: world) (a: prog) (p: form):
  $ g ⊢ w : p $ >
  $ g ⊢ w : ([ ⋆ a ] (p → ([ a ] p))) $ >
  $ g ⊢ w : ([ ⋆ a ] p) $;

-- ============================================================
-- Validity and Hoare triples
-- ============================================================

axiom valid_intro {w: world} (p: form):
  $ ∅ ⊢ w : p $ > $ ⊨ p $;
--| @auto backward
axiom valid_elim (g: ctx) (w: world) (p: form):
  $ ⊨ p $ > $ g ⊢ w : p $;

--| @auto eager
axiom ht_intro (p q: form) (a: prog):
  $ ⊨ (p → ([ a ] q)) $ > $ ⦃ p ⦄ a ⟦ q ⟧ $;
--| @auto forward
axiom ht_elim (p q: form) (a: prog):
  $ ⦃ p ⦄ a ⟦ q ⟧ $ > $ ⊨ (p → ([ a ] q)) $;

-- The while loop is a definition, not a primitive.
def while (b: form) (a: prog): prog = $ ⋆ (? b ⨟ a) ⨟ ? (¬ b) $;

-- ============================================================
-- The modal toolkit (proofs in hoare.auf)
-- ============================================================

theorem imp_refl_valid (p: form): $ ⊨ (p → p) $;
theorem valid_mp (p q: form): $ ⊨ (p → q) $ > $ ⊨ p $ > $ ⊨ q $;
theorem valid_nec (a: prog) (p: form): $ ⊨ p $ > $ ⊨ ([ a ] p) $;
theorem box_k (a: prog) (p q: form):
  $ ⊨ (([ a ] (p → q)) → (([ a ] p) → ([ a ] q))) $;
theorem box_mono (a: prog) (p q: form):
  $ ⊨ (p → q) $ > $ ⊨ (([ a ] p) → ([ a ] q)) $;

-- ============================================================
-- Hoare logic, derived (as in pratt) — plus the assignment rule
-- ============================================================

theorem hoare_conseq (a: prog) (p p2 q q2: form):
  $ ⊨ (p2 → p) $ >
  $ ⦃ p ⦄ a ⟦ q ⟧ $ >
  $ ⊨ (q → q2) $ >
  $ ⦃ p2 ⦄ a ⟦ q2 ⟧ $;

theorem hoare_seq (a b: prog) (p q r: form):
  $ ⦃ p ⦄ a ⟦ q ⟧ $ >
  $ ⦃ q ⦄ b ⟦ r ⟧ $ >
  $ ⦃ p ⦄ (a ⨟ b) ⟦ r ⟧ $;

-- The Floyd/Hoare assignment rule: derived, not primitive.  The @view is
-- what lets proofs cite it with a *computed* precondition: its phantom
-- binder `q` absorbs whatever precondition the line states, while the
-- assignment and postcondition positions pin x, e, p, leaving a fully
-- determined `⌊ x / e ⌋ p` for the rewrite engine to reconcile.  Without
-- it, inference dies at the `⌊ x / e ⌋ p` position — recovering e and p
-- from a reduced form is ambiguous, and inference never guesses.
--| @view {x: obj} (e: obj x) (p: form x) (q: form x): $ ⦃ q ⦄ ⟨ x ≔ e ⟩ ⟦ p ⟧ $
theorem hoare_assign {x: obj} (e: obj x) (p: form x):
  $ ⦃ ⌊ x / e ⌋ p ⦄ ⟨ x ≔ e ⟩ ⟦ p ⟧ $;

-- The strengthening form: "q implies the weakest precondition".  The view
-- above only applies when the stated precondition is exactly the computed
-- one; when a step wants a merely stronger precondition (the ⊤ steps in
-- the programs below), the verification condition `q → …` sits in this
-- rule's hypothesis.  Its own view gives that hypothesis a phantom `r` for
-- the same reason hoare_assign's view has a phantom `q`: the VC is cited
-- in computed form, and the rewrite engine reconciles it with
-- `⌊ x / e ⌋ p`, so neither assignment rule ever shows an sb term at a
-- use site.
--| @view {x: obj} (e: obj x) (p: form x) (q: form x) (r: form x): $ ⊨ (q → r) $ > $ ⦃ q ⦄ ⟨ x ≔ e ⟩ ⟦ p ⟧ $
theorem hoare_assign_wp {x: obj} (e: obj x) (p: form x) (q: form x):
  $ ⊨ (q → (⌊ x / e ⌋ p)) $ >
  $ ⦃ q ⦄ ⟨ x ≔ e ⟩ ⟦ p ⟧ $;

theorem hoare_while (a: prog) (b p: form):
  $ ⦃ p ∧ b ⦄ a ⟦ p ⟧ $ >
  $ ⦃ p ⦄ while b a ⟦ p ∧ (¬ b) ⟧ $;

-- ============================================================
-- Verified programs.  The preconditions on the assignment lines in the
-- proofs are the *computed* ones; the rewrite engine (red_assign + the
-- sb battery) proves them equal to the substitution instances.
-- ============================================================

-- Last write wins.
theorem overwrite {x: obj} (a b: obj):
  $ ⦃ ⊤ ⦄ (⟨ x ≔ a ⟩ ⨟ ⟨ x ≔ b ⟩) ⟦ x = b ⟧ $;

-- The classic three-assignment swap, via a temporary.
theorem swap {x y t: obj} (a b: obj):
  $ ⦃ (x = a) ∧ (y = b) ⦄
    (⟨ t ≔ x ⟩ ⨟ ⟨ x ≔ y ⟩ ⨟ ⟨ y ≔ t ⟩)
    ⟦ (x = b) ∧ (y = a) ⟧ $;

-- A while loop, verified end to end with the derived while rule.  Note
-- that no axiom about `pred` or `0` is used: partial correctness of the
-- loop is pure logic (the loop exits exactly when the guard fails).
theorem countdown {x: obj}:
  $ ⦃ ⊤ ⦄ while (¬ (x = 0)) (⟨ x ≔ pred x ⟩) ⟦ x = 0 ⟧ $;
