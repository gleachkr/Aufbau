delimiter $ ( ) $;
provable sort wff;
sort ctx;
--| @vars x y
sort var;
sort name;
sort tm;
term v2t (x: var): tm;
coercion v2t: var > tm;
term n2t (a: name): tm;
coercion n2t: name > tm;

term iff (a b: wff): wff;
infixr iff: $<->$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
term hyp (a: wff): ctx;
term cl (g: ctx): wff;
term cf (g: ctx) (a: wff): wff;
term all {x: var} (p: wff x): wff;
prefix all: $A.$ prec 41;
term ex {x: var} (p: wff x): wff;
prefix ex: $E.$ prec 41;
term neg (a: wff): wff;
prefix neg: $~$ prec 45;
term pred (t: tm): wff;
prefix pred: $P$ prec 50;
term sb (t: tm) {x: var} (p: wff x): wff;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a <-> a $;
axiom iff_trans (a b c: wff):
  $ a <-> b $ > $ b <-> c $ > $ a <-> c $;
axiom iff_sym (a b: wff): $ a <-> b $ > $ b <-> a $;
axiom iff_mp (a b: wff): $ a <-> b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq (join (join g h) i) (join g (join h i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (join g h) (join h g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (join g g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (join emp g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (join g1 h1) (join g2 h2) $;

--| @congr
axiom hyp_congr (a b: wff): $ a <-> b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom cl_congr (g h: ctx): $ ctx_eq g h $ > $ cl g <-> cl h $;

--| @congr
axiom cf_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a <-> b $ > $ cf g a <-> cf h b $;

--| @rewrite
axiom sb_pred (t: tm) {x: var}: $ sb t x (P x) <-> P t $;

--| @rewrite
axiom sb_irrel (t: tm) {x: var} (p: wff): $ sb t x p <-> p $;
--| @rewrite
axiom sb_id {x: var} (p: wff x): $ sb x x p <-> p $;

-- A tableau step for a universal row: the branch `g ; A. x p` closes once
-- `g ; A. x p ; p[t/x]` does. The view names the new row `q`, and the
-- instance `t` is read back out of it.
--| @view {x: var} (g: ctx x) (t: tm) (p: wff x) (q: wff): $ cl (join (join g (hyp (A. x p))) (hyp q)) $ > $ cf g (A. x p) $
--| @recover t q p x
axiom all_step {x: var} (g: ctx x) (t: tm) (p: wff x):
  $ cl (join (join g (hyp (A. x p))) (hyp (sb t x p))) $ > $ cf g (A. x p) $;

-- The same step with an instance that may mention `x`.
--| @view {x: var} (g: ctx x) (t: tm x) (p: wff x) (q: wff): $ cl (join (join g (hyp (A. x p))) (hyp q)) $ > $ cf g (A. x p) $
--| @recover t q p x
axiom all_step_open {x: var} (g: ctx x) (t: tm x) (p: wff x):
  $ cl (join (join g (hyp (A. x p))) (hyp (sb t x p))) $ > $ cf g (A. x p) $;

-- `A. x P b` instantiates to `P b` whatever the instance, so `@recover` has
-- no occurrence of `x` to read `t` from. `t` may not mention `x`, so it is
-- a fresh variable from the `var` pool, coerced to `tm`.
theorem vacuous_fresh_instance {x: var} {b: name}:
  $ cl (join (join (hyp (~ P b)) (hyp (A. x (P b)))) (hyp (P b))) $
  > $ cf (hyp (~ P b)) (A. x (P b)) $;

-- Here `t` may mention `x`, so it is `x` itself, coerced to `tm`.
theorem vacuous_identity_instance {x: var} {b: name}:
  $ cl (join (join (hyp (~ P b)) (hyp (A. x (P b)))) (hyp (P b))) $
  > $ cf (hyp (~ P b)) (A. x (P b)) $;
