-- The proof progression is:
--   * a Π identity warmup
--   * Bool and Nat computation examples
--   * judgemental equality chaining
--   * an internal identity toolkit built by path induction
--   * addition laws, ending in commutativity
--
-- ==================================================================
-- SECTION 0: Structural helpers
-- ==================================================================

weaken2
-------

l1: $ g , x : T1 ⊢ J $ by weaken [#1, #3]
l2: $ g , x : T1 , y : T2 ⊢ J $ by weaken [#2, l1]

weaken3
-------

l1: $ g , x : T1 , y : T2 ⊢ J $ by weaken2 [#1, #2, #4]
l2: $ g , x : T1 , y : T2 , z : T3 ⊢ J $ by weaken [#3, l1]

var_wk
------

l1: $ g , x : A ⊢ x : A $ by var [#1]
l2: $ g , x : A , y : B ⊢ x : A $ by weaken [#2, l1]

var_wk2
-------

l1: $ g , x : A , y : B ⊢ x : A $ by var_wk [#1, #2]
l2: $ g , x : A , y : B , z : C ⊢ x : A $ by weaken [#3, l1]

-- ==================================================================
-- SECTION 1: Π warmup
-- ==================================================================

arr_form
--------

l1: $ g , x : A ⊢ Ty B $ by weaken [#1, #2]
l2: $ g ⊢ Ty (A → B) $ by pi_form [#1, l1]

arr_elim
--------

l1: $ g , x : A ⊢ Ty B $ by weaken [#1, #4]
l2: $ g ⊢ f · u : B $ by app_elim [#2, #3, l1]

id_ty
-----

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A ⊢ x : A $ by var [#1]
l3: $ g ⊢ (λ x : A. x) : (Π x : A. A) $ by lam_intro [#1, l1, l2]

app_id_beta
-----------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A ⊢ x : A $ by var [#1]
l3: $ g ⊢ ≡[A] ((λ x : A. x) · u) = u $ by app_beta [#1, l1, l2, #2]

-- ==================================================================
-- SECTION 2: Bool warmup
-- ==================================================================

bool_not_ty
-----------

l1: $ g ⊢ false : Bool $ by false_intro [#1]
l2: $ g ⊢ true : Bool $ by true_intro [#1]
l3: $ g ⊢ ¬ b : Bool $ by bool_elim [l1, l2, #2]

bool_not_true
-------------

l1: $ g ⊢ false : Bool $ by false_intro [#1]
l2: $ g ⊢ true : Bool $ by true_intro [#1]
l3: $ g ⊢ ≡[Bool] (¬ true) = false $ by bool_beta_true [l1, l2]

bool_not_false
--------------

l1: $ g ⊢ false : Bool $ by false_intro [#1]
l2: $ g ⊢ true : Bool $ by true_intro [#1]
l3: $ g ⊢ ≡[Bool] (¬ false) = true $ by bool_beta_false [l1, l2]

-- ==================================================================
-- SECTION 3: Nat warmup
-- ==================================================================

one_ty
------

l1: $ g ⊢ zero : Nat $ by zero_intro [#1]
l2: $ g ⊢ suc zero : Nat $ by suc_intro [l1]

nat_rec_step_ty
---------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty (const_ty k A) $ by weaken [l1, #2]
l3: $ g , k : Nat , ih : const_ty k A ⊢ s : (A → A) $
  by weaken2 [l1, l2, #3]
l4: $ g , k : Nat , ih : const_ty k A ⊢ ih : const_ty k A $ by var [l2]
l5: $ g , k : Nat , ih : const_ty k A ⊢ Ty A $ by weaken2 [l1, l2, #2]
l6: $ g , k : Nat , ih : const_ty k A ⊢ s · ih : A $
  by arr_elim [l5, l3, l4, l5]

nat_rec_ty
----------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty A $ by weaken [l1, #2]
l3: $ g , k : Nat , ih : const_ty k A ⊢ s · ih : A $
  by nat_rec_step_ty [#1, #2, #4]
l4: $ g ⊢ nat_ind k ih (const_ty k A) z (s · ih) n :
  [k/n] (const_ty k A) $ by nat_ind_elim [l2, #3, l3, #5]

nat_rec_zero
------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty A $ by weaken [l1, #2]
l3: $ g , k : Nat , ih : const_ty k A ⊢ s · ih : A $
  by nat_rec_step_ty [#1, #2, #4]
l4: $ g ⊢ ≡[[k/zero] (const_ty k A)]
  (nat_ind k ih (const_ty k A) z (s · ih) zero) = z $
  by nat_ind_zero [l2, #3, l3]

nat_rec_suc
-----------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty A $ by weaken [l1, #2]
l3: $ g , k : Nat , ih : const_ty k A ⊢ s · ih : A $
  by nat_rec_step_ty [#1, #2, #4]
l4: $ g ⊢ ≡[[k/suc n] (const_ty k A)]
  (nat_ind k ih (const_ty k A) z (s · ih) (suc n)) =
  (⟦ ih / nat_ind k ih (const_ty k A) z (s · ih) n ⟧
      (⟦ k / n ⟧ (s · ih))) $
  by nat_ind_suc [l2, #3, l3, #5]

-- ==================================================================
-- SECTION 4: Typed equality warmup
-- ==================================================================

double_step_ty
--------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty Nat $ by weaken [l1, l1]
l3: $ g , k : Nat ⊢ k : Nat $ by var [l1]
l4: $ g , k : Nat ⊢ suc k : Nat $ by suc_intro [l3]
l5: $ g , k : Nat ⊢ suc (suc k) : Nat $ by suc_intro [l4]
l6: $ g ⊢ (λ k : Nat. suc (suc k)) : (Nat → Nat) $
  by lam_intro [l1, l2, l5]

nat_rec_two_step_one
--------------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g ⊢ zero : Nat $ by zero_intro [#1]
l3: $ g ⊢ (λ k : Nat. suc (suc k)) : (Nat → Nat) $ by double_step_ty [#1]
l4: $ g ⊢ ≡[Nat] (nat_rec Nat zero (λ k : Nat. suc (suc k))
  (suc zero)) = ((λ k : Nat. suc (suc k)) ·
  (nat_rec Nat zero (λ k : Nat. suc (suc k)) zero)) $
  by nat_rec_suc [#1, l1, l2, l3, l2]
l5: $ g ⊢ ≡[Nat] (nat_rec Nat zero (λ k : Nat. suc (suc k)) zero) = zero $
  by nat_rec_zero [#1, l1, l2, l3]
l6: $ g ⊢ ≡[Nat] ((λ k : Nat. suc (suc k)) ·
  (nat_rec Nat zero (λ k : Nat. suc (suc k)) zero)) =
  ((λ k : Nat. suc (suc k)) · zero) $ by app_eq_right [l1, l3, l5]
l7: $ g , k : Nat ⊢ Ty Nat $ by weaken [l1, l1]
l8: $ g , k : Nat ⊢ k : Nat $ by var [l1]
l9: $ g , k : Nat ⊢ suc k : Nat $ by suc_intro [l8]
l10: $ g , k : Nat ⊢ suc (suc k) : Nat $ by suc_intro [l9]
l11: $ g ⊢ ≡[Nat] ((λ k : Nat. suc (suc k)) · zero) =
  (suc (suc zero)) $ by app_beta [l1, l7, l10, l2]
l12: $ g ⊢ ≡[Nat] (nat_rec Nat zero (λ k : Nat. suc (suc k))
  (suc zero)) = ((λ k : Nat. suc (suc k)) · zero) $
  by eq_tm_trans [l4, l6]
l13: $ g ⊢ ≡[Nat] (nat_rec Nat zero (λ k : Nat. suc (suc k))
  (suc zero)) = (suc (suc zero)) $ by eq_tm_trans [l12, l11]

-- ==================================================================
-- SECTION 5: Identity warmup
-- ==================================================================

id_ctx_ty
---------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A , y : A ⊢ x : A $ by var_wk [#1, l1]
l3: $ g , x : A , y : A ⊢ y : A $ by var [l1]
l4: $ g , x : A , y : A ⊢ Ty (Id A x y) $ by Id_form [l2, l3]

id_sym_motive
-------------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A , y : A ⊢ Ty (Id A x y) $ by id_ctx_ty [#1]
l3: $ g , x : A , y : A , q : Id A x y ⊢ y : A $ by var_wk [l1, l2]
l4: $ g , x : A , y : A , q : Id A x y ⊢ x : A $ by var_wk2 [#1, l1, l2]
l5: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id A y x) $
  by Id_form [l3, l4]

id_sym_ty
---------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id A y x) $
  by id_sym_motive [#1]
l2: $ g , x : A ⊢ x : A $ by var [#1]
l3: $ g , x : A ⊢ refl A x : Id A x x $ by refl_intro [l2]
l4: $ g ⊢ J x y q A (Id A y x) (refl A x) s t p :
  [x/s] [y/t] [q/p] (Id A y x) $ by J_elim [l1, l3, #2, #3, #4]

id_sym_refl
-----------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id A y x) $
  by id_sym_motive [#1]
l2: $ g , x : A ⊢ x : A $ by var [#1]
l3: $ g , x : A ⊢ refl A x : Id A x x $ by refl_intro [l2]
l4: $ g ⊢ ≡[[x/s] [y/s] [q/refl A s] (Id A y x)]
  (J x y q A (Id A y x) (refl A x) s s (refl A s)) =
  (⟦ x / s ⟧ (refl A x)) $ by J_beta [l1, l3, #2]

id_trans_motive
---------------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A , y : A ⊢ Ty (Id A x y) $ by id_ctx_ty [#1]
l3: $ g , x : A , y : A , z : Id A x y ⊢ y : A $ by var_wk [l1, l2]
l4: $ g , x : A , y : A , z : Id A x y ⊢ x : A $ by var_wk2 [#1, l1, l2]
l5: $ g , x : A , y : A , z : Id A x y ⊢ u : A $
  by weaken3 [#1, l1, l2, #2]
l6: $ g , x : A , y : A , z : Id A x y ⊢ Ty (Id A y u) $
  by Id_form [l3, l5]
l7: $ g , x : A , y : A , z : Id A x y ⊢ Ty (Id A x u) $
  by Id_form [l4, l5]
l8: $ g , x : A , y : A , z : Id A x y ⊢ Ty (Id A y u → Id A x u) $
  by arr_form [l6, l7]

id_trans_branch
---------------

l1: $ g , x : A ⊢ x : A $ by var [#1]
l2: $ g , x : A ⊢ u : A $ by weaken [#1, #2]
l3: $ g , x : A ⊢ Ty (Id A x u) $ by Id_form [l1, l2]
l4: $ g , x : A ⊢ (λ w : Id A x u. w) : (Id A x u → Id A x u) $
  by id_ty [l3]

id_trans_ty
-----------

l1: $ g , x : A , y : A , z : Id A x y ⊢ Ty (Id A y u → Id A x u) $
  by id_trans_motive [#1, #4]
l2: $ g , x : A ⊢ (λ w : Id A x u. w) : (Id A x u → Id A x u) $
  by id_trans_branch [#1, #4]
l3: $ g ⊢ J x y z A (Id A y u → Id A x u)
  (λ w : Id A x u. w) s t p : (Id A t u → Id A s u) $
  by J_elim [l1, l2, #2, #3, #5]
l4: $ g ⊢ Ty (Id A t u) $ by Id_form [#3, #4]
l5: $ g ⊢ Ty (Id A s u) $ by Id_form [#2, #4]
l6: $ g ⊢ (J x y z A (Id A y u → Id A x u)
  (λ w : Id A x u. w) s t p) · q : Id A s u $
  by arr_elim [l4, l3, #6, l5]

id_trans_refl_left
------------------

l1: $ g , x : A , y : A , z : Id A x y ⊢ Ty (Id A y u → Id A x u) $
  by id_trans_motive [#1, #3]
l2: $ g , x : A ⊢ (λ w : Id A x u. w) : (Id A x u → Id A x u) $
  by id_trans_branch [#1, #3]
l3: $ g ⊢ ≡[[x/s] [y/s] [z/refl A s] (Id A y u → Id A x u)]
  (J x y z A (Id A y u → Id A x u) (λ w : Id A x u. w)
    s s (refl A s)) = (⟦ x / s ⟧ (λ w : Id A x u. w)) $
  by J_beta [l1, l2, #2]
l4: $ g ⊢ Ty (Id A s u) $ by Id_form [#2, #3]
l5: $ g ⊢ ≡[Id A s u]
  ((J x y z A (Id A y u → Id A x u) (λ w : Id A x u. w)
    s s (refl A s)) · q) = ((λ w : Id A s u. w) · q) $
  by app_eq_left [l4, l3, #4]
l6: $ g , w : Id A s u ⊢ Ty (Id A s u) $ by weaken [l4, l4]
l7: $ g , w : Id A s u ⊢ w : Id A s u $ by var [l4]
l8: $ g ⊢ ≡[Id A s u] ((λ w : Id A s u. w) · q) = q $
  by app_beta [l4, l6, l7, #4]
l9: $ g ⊢ ≡[Id A s u]
  ((J x y z A (Id A y u → Id A x u) (λ w : Id A x u. w)
    s s (refl A s)) · q) = q $ by eq_tm_trans [l5, l8]

ap_motive
---------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A , y : A ⊢ Ty (Id A x y) $ by id_ctx_ty [#1]
l3: $ g , x : A , y : A , q : Id A x y ⊢ x : A $ by var_wk2 [#1, l1, l2]
l4: $ g , x : A , y : A , q : Id A x y ⊢ y : A $ by var_wk [l1, l2]
l5: $ g , x : A , y : A , q : Id A x y ⊢ f : (A → B) $
  by weaken3 [#1, l1, l2, #3]
l6: $ g , x : A , y : A , q : Id A x y ⊢ Ty B $ by weaken3 [#1, l1, l2, #2]
l7: $ g , x : A , y : A , q : Id A x y ⊢ Ty A $ by weaken3 [#1, l1, l2, #1]
l8: $ g , x : A , y : A , q : Id A x y ⊢ f · x : B $
  by arr_elim [l7, l5, l3, l6]
l9: $ g , x : A , y : A , q : Id A x y ⊢ f · y : B $
  by arr_elim [l7, l5, l4, l6]
l10: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id B (f · x) (f · y)) $
  by Id_form [l8, l9]

ap_branch
---------

l1: $ g , x : A ⊢ f : (A → B) $ by weaken [#1, #3]
l2: $ g , x : A ⊢ x : A $ by var [#1]
l3: $ g , x : A ⊢ Ty B $ by weaken [#1, #2]
l4: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l5: $ g , x : A ⊢ f · x : B $ by arr_elim [l4, l1, l2, l3]
l6: $ g , x : A ⊢ refl B (f · x) : Id B (f · x) (f · x) $
  by refl_intro [l5]

ap_ty
-----

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id B (f · x) (f · y)) $
  by ap_motive [#1, #2, #3]
l2: $ g , x : A ⊢ refl B (f · x) : Id B (f · x) (f · x) $
  by ap_branch [#1, #2, #3]
l3: $ g ⊢ J x y q A (Id B (f · x) (f · y))
  (refl B (f · x)) s t p : Id B (f · s) (f · t) $
  by J_elim [l1, l2, #4, #5, #6]

ap_refl
-------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (Id B (f · x) (f · y)) $
  by ap_motive [#1, #2, #3]
l2: $ g , x : A ⊢ refl B (f · x) : Id B (f · x) (f · x) $
  by ap_branch [#1, #2, #3]
l3: $ g ⊢ ≡[Id B (f · s) (f · s)]
  (J x y q A (Id B (f · x) (f · y)) (refl B (f · x))
    s s (refl A s)) = (refl B (f · s)) $
  by J_beta [l1, l2, #4]

ap_suc_motive
-------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , x : Nat ⊢ Ty Nat $ by weaken [l1, l1]
l3: $ g , x : Nat , y : Nat ⊢ Ty (Id Nat x y) $ by id_ctx_ty [l1]
l4: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢ x : Nat $
  by var_wk2 [l1, l2, l3]
l5: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢ y : Nat $ by var_wk [l2, l3]
l6: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢ suc x : Nat $
  by suc_intro [l4]
l7: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢ suc y : Nat $
  by suc_intro [l5]
l8: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢
  Ty (Id Nat (suc x) (suc y)) $ by Id_form [l6, l7]

ap_suc_branch
-------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , x : Nat ⊢ x : Nat $ by var [l1]
l3: $ g , x : Nat ⊢ suc x : Nat $ by suc_intro [l2]
l4: $ g , x : Nat ⊢ refl Nat (suc x) : Id Nat (suc x) (suc x) $
  by refl_intro [l3]

ap_suc_ty
---------

l1: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢
  Ty (Id Nat (suc x) (suc y)) $ by ap_suc_motive [#1]
l2: $ g , x : Nat ⊢ refl Nat (suc x) : Id Nat (suc x) (suc x) $
  by ap_suc_branch [#1]
l3: $ g ⊢ ap_suc s t p : Id Nat (suc s) (suc t) $
  by J_elim [l1, l2, #2, #3, #4]

ap_suc_refl
-----------

l1: $ g , x : Nat , y : Nat , q : Id Nat x y ⊢
  Ty (Id Nat (suc x) (suc y)) $ by ap_suc_motive [#1]
l2: $ g , x : Nat ⊢ refl Nat (suc x) : Id Nat (suc x) (suc x) $
  by ap_suc_branch [#1]
l3: $ g ⊢ ≡[Id Nat (suc s) (suc s)]
  (ap_suc s s (refl Nat s)) = refl Nat (suc s) $
  by J_beta [l1, l2, #2]

transport_motive
----------------

l1: $ g , x : A ⊢ Ty A $ by weaken [#1, #1]
l2: $ g , x : A , y : A ⊢ Ty (Id A x y) $ by id_ctx_ty [#1]
l3: $ g , x : A , y : A , q : Id A x y ⊢ Ty B $ by weaken2 [l1, l2, #2]
l4: $ g , x : A , y : A ⊢ Ty ([x/y] B) $ by sb_ty_var_form [#1, #2]
l5: $ g , x : A , y : A , q : Id A x y ⊢ Ty ([x/y] B) $ by weaken [l2, l4]
l6: $ g , x : A , y : A , q : Id A x y ⊢ Ty (B → [x/y] B) $
  by arr_form [l3, l5]

transport_ty
------------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (B → [x/y] B) $
  by transport_motive [#1, #2]
l2: $ g , x : A ⊢ (λ w : B. w) : (B → B) $ by id_ty [#2]
l3: $ g ⊢ J x y q A (B → [x/y] B) (λ w : B. w) s t p :
  ([x/s] B → [x/t] B) $
  by J_elim [l1, l2, #3, #4, #5]
l4: $ g ⊢ Ty ([x/s] B) $ by sb_ty_form [#2, #3]
l5: $ g ⊢ Ty ([x/t] B) $ by sb_ty_form [#2, #4]
l6: $ g ⊢ (J x y q A (B → [x/y] B) (λ w : B. w) s t p) · u :
  [x/t] B $ by arr_elim [l4, l3, #6, l5]

transport_refl
--------------

l1: $ g , x : A , y : A , q : Id A x y ⊢ Ty (B → [x/y] B) $
  by transport_motive [#1, #2]
l2: $ g , x : A ⊢ (λ w : B. w) : (B → B) $ by id_ty [#2]
l3: $ g ⊢ ≡[[x/s] [y/s] [q/refl A s] (B → [x/y] B)]
  (J x y q A (B → [x/y] B) (λ w : B. w) s s (refl A s)) =
  (⟦ x / s ⟧ (λ w : B. w)) $ by J_beta [l1, l2, #3]
l4: $ g ⊢ Ty ([x/s] B) $ by sb_ty_form [#2, #3]
l5: $ g ⊢ ≡[[x/s] B]
  ((J x y q A (B → [x/y] B) (λ w : B. w) s s (refl A s)) · u) =
  ((λ w : [x/s] B. w) · u) $ by app_eq_left [l4, l3, #4]
l6: $ g , w : [x/s] B ⊢ Ty ([x/s] B) $ by weaken [l4, l4]
l7: $ g , w : [x/s] B ⊢ w : [x/s] B $ by var [l4]
l8: $ g ⊢ ≡[[x/s] B] ((λ w : [x/s] B. w) · u) = u $
  by app_beta [l4, l6, l7, #4]
l9: $ g ⊢ ≡[[x/s] B]
  ((J x y q A (B → [x/y] B) (λ w : B. w) s s (refl A s)) · u) = u $
  by eq_tm_trans [l5, l8]

-- ==================================================================
-- SECTION 6: Arithmetic warmup
-- ==================================================================

suc_fn_ty
---------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty Nat $ by weaken [l1, l1]
l3: $ g , k : Nat ⊢ k : Nat $ by var [l1]
l4: $ g , k : Nat ⊢ suc k : Nat $ by suc_intro [l3]
l5: $ g ⊢ suc_fn : (Nat → Nat) $ by lam_intro [l1, l2, l4]

add_ty
------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g ⊢ suc_fn : (Nat → Nat) $ by suc_fn_ty [#1]
l3: $ g ⊢ m + n : Nat $ by nat_rec_ty [#1, l1, #3, l2, #2]

add_zero_left
-------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g ⊢ suc_fn : (Nat → Nat) $ by suc_fn_ty [#1]
l3: $ g ⊢ ≡[Nat] (zero + n) = n $ by nat_rec_zero [#1, l1, #2, l2]

add_suc_left
------------

l1: $ g ⊢ Ty Nat $ by nat_form [#1]
l2: $ g , k : Nat ⊢ Ty Nat $ by weaken [l1, l1]
l3: $ g , k : Nat ⊢ k : Nat $ by var [l1]
l4: $ g , k : Nat ⊢ suc k : Nat $ by suc_intro [l3]
l5: $ g ⊢ (λ k : Nat. suc k) : (Nat → Nat) $
  by lam_intro [l1, l2, l4]
l6: $ g ⊢ m + n : Nat $ by add_ty [#1, #2, #3]
l7: $ g ⊢ ≡[Nat] ((suc m) + n) =
  ((λ k : Nat. suc k) · (m + n)) $ by nat_rec_suc [#1, l1, #3, l5, #2]
l8: $ g ⊢ ≡[Nat] ((λ k : Nat. suc k) · (m + n)) = suc (m + n) $
  by app_beta [l1, l2, l4, l6]
l9: $ g ⊢ ≡[Nat] ((suc m) + n) = suc (m + n) $
  by eq_tm_trans [l7, l8]

one_plus_one
------------

l1: $ g ⊢ zero : Nat $ by zero_intro [#1]
l2: $ g ⊢ suc zero : Nat $ by suc_intro [l1]
l3: $ g ⊢ ≡[Nat] ((suc zero) + (suc zero)) =
  suc (zero + (suc zero)) $ by add_suc_left [#1, l1, l2]
l4: $ g ⊢ ≡[Nat] (zero + (suc zero)) = suc zero $
  by add_zero_left [#1, l2]
l5: $ g ⊢ ≡[Nat] suc (zero + (suc zero)) = suc (suc zero) $
  by suc_eq [l4]
l6: $ g ⊢ ≡[Nat] ((suc zero) + (suc zero)) = (suc (suc zero)) $
  by eq_tm_trans [l3, l5]

