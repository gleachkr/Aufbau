l27: $ g , k : Nat , ih : Id Nat (k + n) (n + k) ⊢ suc k : Nat $ by suc_intro [l17]
l28: $ g , k : Nat , ih : Id Nat (k + n) (n + k) ⊢ n + suc k : Nat $ by add_ty [l16, l18, l27]
