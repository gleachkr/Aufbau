hole_beside_def
---------------
l1: $ _wff -> c e. img f B $ by sep_in_imp [#1]
l2: $ c e. B -> c e. img f B $ by sep_in_imp [#1]

hole_under_def
--------------
l1: $ c e. B -> c e. img f _set $ by sep_in_imp [#1]
l2: $ c e. B -> c e. img f B $ by sep_in_imp [#1]

hint_hole_under_def
-------------------
l1: $ c e. img f _set $ by mp [sep_in_imp [#1], #1]
l2: $ c e. img f B $ by mp [sep_in_imp [#1], #1]

hole_in_unfolded_def
--------------------
l1: $ c e. sep x _set (R f x) $ by img_in (f := $ f $) [#1]
l2: $ c e. sep x B (R f x) $ by img_in (f := $ f $) [#1]
