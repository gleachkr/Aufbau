-- A @view only guides inference. `drop`'s view names the dropped member `q`,
-- which the rule spells `~ p`; with `g` and `p` both given the view's premise
-- bag leaves just `q` open, and a positional view match cannot read it out of
-- a line that lists `g` before `p`. Every rule binder is explicit, so the rule
-- alone decides.
delimiter $ ( ) $;
provable sort wff;
sort ctx;

term PP: wff;
term PA: wff;
term PB: wff;

term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui bag_assoc bag_comm emp _
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (p: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @relation ctx ctx_eq bag_refl bag_trans bag_sym _
axiom bag_refl (g: ctx): $ ctx_eq g g $;
axiom bag_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom bag_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom bag_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom bag_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom bag_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;

term neg (p: wff): wff;
prefix neg: $~$ prec 40;

--| @view (g: ctx) (p q: wff): $ q , p , g ⊢ PP $ > $ p , g ⊢ PP $
axiom drop (g: ctx) (p: wff): $ ~ p , p , g ⊢ PP $ > $ p , g ⊢ PP $;

theorem view_explicit_member: $ ~ PA , PB , PA ⊢ PP $ > $ PA , PB ⊢ PP $;
