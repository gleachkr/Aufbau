-- Proofs for the rules-of-passage battery. Every proof body below was
-- generated by a single `conversion?` search on the goal line kept in the
-- comment above it; the search saturates the passage laws in both
-- directions and lowers the found path to these ordinary rewrite chains.

-- goal: $ (∀ x (P x)) ∨ q $ by conversion?
prenex_or
---------
goal_1: $ P x ∨ q ↔ q ∨ P x $ by or_comm
goal_2: $ ∀ x (P x ∨ q) ↔ ∀ x (q ∨ P x) $ by all_congr [goal_1]
goal_3: $ ∀ x (q ∨ P x) ↔ q ∨ ∀ x P x $ by pass_al_or
goal_4: $ ∀ x (P x ∨ q) ↔ q ∨ ∀ x P x $ by bi_trans [goal_2, goal_3]
goal_5: $ ∀ x P x ∨ q ↔ q ∨ ∀ x P x $ by or_comm
goal_6: $ q ∨ ∀ x P x ↔ ∀ x P x ∨ q $ by bi_symm [goal_5]
goal_7: $ ∀ x (P x ∨ q) ↔ ∀ x P x ∨ q $ by bi_trans [goal_4, goal_6]
goal: $ (∀ x (P x)) ∨ q $ by mpbi [goal_7, #1]

-- goal: $ (∀ x (P x)) → q $ by conversion?
drinker_half
------------
goal_1: $ ∀ x P x → q ↔ ∃ x (P x → q) $ by pass_im_ante_al
goal_2: $ ∃ x (P x → q) ↔ ∀ x P x → q $ by bi_symm [goal_1]
goal: $ (∀ x (P x)) → q $ by mpbi [goal_2, #1]

-- goal: $ ∃ x ((P x) ∧ q) $ by conversion?
miniscope_an
------------
goal_1: $ ∃ x P x ∧ q ↔ q ∧ ∃ x P x $ by an_comm
goal_2: $ ∃ x (q ∧ P x) ↔ q ∧ ∃ x P x $ by pass_ex_an
goal_3: $ q ∧ ∃ x P x ↔ ∃ x (q ∧ P x) $ by bi_symm [goal_2]
goal_4: $ ∃ x P x ∧ q ↔ ∃ x (q ∧ P x) $ by bi_trans [goal_1, goal_3]
goal_5: $ P x ∧ q ↔ q ∧ P x $ by an_comm
goal_6: $ q ∧ P x ↔ P x ∧ q $ by bi_symm [goal_5]
goal_7: $ ∃ x (q ∧ P x) ↔ ∃ x (P x ∧ q) $ by ex_congr [goal_6]
goal_8: $ ∃ x P x ∧ q ↔ ∃ x (P x ∧ q) $ by bi_trans [goal_4, goal_7]
goal: $ ∃ x ((P x) ∧ q) $ by mpbi [goal_8, #1]

-- goal: $ ¬ (∀ x (P x)) $ by conversion?
prenex_neg
----------
goal_1: $ ¬ ∀ x P x ↔ ∃ x (¬ P x) $ by neg_al
goal_2: $ ∃ x (¬ P x) ↔ ¬ ∀ x P x $ by bi_symm [goal_1]
goal: $ ¬ (∀ x (P x)) $ by mpbi [goal_2, #1]

-- goal: $ ∃ x (∃ y ((P x) → (Q y))) $ by conversion?
prenex_two
----------
goal_1: $ ∀ x P x → ∃ y Q y ↔ ∃ x (P x → ∃ y Q y) $ by pass_im_ante_al
goal_2: $ P x → ∃ y Q y ↔ ∃ y (P x → Q y) $ by pass_im_cons_ex
goal_3: $ ∃ x (P x → ∃ y Q y) ↔ ∃ x ∃ y (P x → Q y) $ by ex_congr [goal_2]
goal_4: $ ∀ x P x → ∃ y Q y ↔ ∃ x ∃ y (P x → Q y) $ by bi_trans [goal_1, goal_3]
goal: $ ∃ x (∃ y ((P x) → (Q y))) $ by mpbi [goal_4, #1]

-- goal: $ ∀ x (∀ y (((P x) ∨ q) → (Q y))) $ by conversion?
prenex_deep
-----------
goal_1: $ ∃ x P x ∨ q ↔ q ∨ ∃ x P x $ by or_comm
goal_2: $ ∃ x (q ∨ P x) ↔ q ∨ ∃ x P x $ by pass_ex_or
goal_3: $ q ∨ ∃ x P x ↔ ∃ x (q ∨ P x) $ by bi_symm [goal_2]
goal_4: $ ∃ x P x ∨ q ↔ ∃ x (q ∨ P x) $ by bi_trans [goal_1, goal_3]
goal_5: $ P x ∨ q ↔ q ∨ P x $ by or_comm
goal_6: $ q ∨ P x ↔ P x ∨ q $ by bi_symm [goal_5]
goal_7: $ ∃ x (q ∨ P x) ↔ ∃ x (P x ∨ q) $ by ex_congr [goal_6]
goal_8: $ ∃ x P x ∨ q ↔ ∃ x (P x ∨ q) $ by bi_trans [goal_4, goal_7]
goal_9: $ ∀ y Q y ↔ ∀ y Q y $ by bi_refl
goal_10: $ ∃ x P x ∨ q → ∀ y Q y ↔ ∃ x (P x ∨ q) → ∀ y Q y $ by im_congr [goal_8, goal_9]
goal_11: $ ∃ x (P x ∨ q) → ∀ y Q y ↔ ∀ x (P x ∨ q → ∀ y Q y) $ by pass_im_ante_ex
goal_12: $ ∃ x P x ∨ q → ∀ y Q y ↔ ∀ x (P x ∨ q → ∀ y Q y) $ by bi_trans [goal_10, goal_11]
goal_13: $ P x ∨ q → ∀ y Q y ↔ ∀ y (P x ∨ q → Q y) $ by pass_im_cons_al
goal_14: $ ∀ x (P x ∨ q → ∀ y Q y) ↔ ∀ x ∀ y (P x ∨ q → Q y) $ by all_congr [goal_13]
goal_15: $ ∃ x P x ∨ q → ∀ y Q y ↔ ∀ x ∀ y (P x ∨ q → Q y) $ by bi_trans [goal_12, goal_14]
goal: $ ∀ x (∀ y (((P x) ∨ q) → (Q y))) $ by mpbi [goal_15, #1]

-- goal: $ ∀ x (P x) $ by conversion?
constant_gen
------------
goal_1: $ ∀ x p ↔ p $ by al_vac
goal_2: $ p ↔ ∀ x p $ by bi_symm [goal_1]
goal_3: $ P x ↔ ∀ x p $ by bi_trans [#1, goal_2]
goal_4: $ p ↔ P x $ by bi_symm [#1]
goal_5: $ ∀ x p ↔ ∀ x P x $ by all_congr [goal_4]
goal_6: $ P x ↔ ∀ x P x $ by bi_trans [goal_3, goal_5]
goal: $ ∀ x (P x) $ by mpbi [goal_6, #2]

-- goal: $ (∀ x (P x)) ↔ (∀ y (P y)) $ by conversion?
rename_iff
----------
goal_1: $ ∀ x P x ↔ ∀ y sb x y (P x) $ by all_alpha
goal_2: $ sb x y (P x) ↔ P y $ by sb_p
goal_3: $ ∀ y sb x y (P x) ↔ ∀ y P y $ by all_congr [goal_2]
goal_4: $ ∀ x P x ↔ ∀ y P y $ by bi_trans [goal_1, goal_3]
goal_5: $ ∀ x P x ↔ ∀ x P x $ by bi_refl
goal: $ (∀ x (P x)) ↔ (∀ y (P y)) $ by bi_trans [goal_5, goal_4]

-- goal: $ ∀ y ((¬ (P y)) ∧ ((Q y) ∨ q)) $ by conversion?
rename_deep
-----------
goal_1: $ sb y x (P y) ↔ P x $ by sb_p
goal_2: $ P x ↔ sb y x (P y) $ by bi_symm [goal_1]
goal_3: $ ¬ P x ↔ ¬ sb y x (P y) $ by not_congr [goal_2]
goal_4: $ sb y x (¬ P y) ↔ ¬ sb y x (P y) $ by sb_not
goal_5: $ ¬ sb y x (P y) ↔ sb y x (¬ P y) $ by bi_symm [goal_4]
goal_6: $ ¬ P x ↔ sb y x (¬ P y) $ by bi_trans [goal_3, goal_5]
goal_7: $ Q x ∨ q ↔ Q x ∨ q $ by bi_refl
goal_8: $ ¬ P x ∧ (Q x ∨ q) ↔ sb y x (¬ P y) ∧ (Q x ∨ q) $ by an_congr [goal_6, goal_7]
goal_9: $ sb y x (Q y) ↔ Q x $ by sb_q
goal_10: $ Q x ↔ sb y x (Q y) $ by bi_symm [goal_9]
goal_11: $ q ↔ q $ by bi_refl
goal_12: $ Q x ∨ q ↔ sb y x (Q y) ∨ q $ by or_congr [goal_10, goal_11]
goal_13: $ sb y x q ↔ q $ by sb_const
goal_14: $ q ↔ sb y x q $ by bi_symm [goal_13]
goal_15: $ sb y x (Q y) ↔ sb y x (Q y) $ by bi_refl
goal_16: $ sb y x (Q y) ∨ q ↔ sb y x (Q y) ∨ sb y x q $ by or_congr [goal_15, goal_14]
goal_17: $ Q x ∨ q ↔ sb y x (Q y) ∨ sb y x q $ by bi_trans [goal_12, goal_16]
goal_18: $ sb y x (Q y ∨ q) ↔ sb y x (Q y) ∨ sb y x q $ by sb_or
goal_19: $ sb y x (Q y) ∨ sb y x q ↔ sb y x (Q y ∨ q) $ by bi_symm [goal_18]
goal_20: $ Q x ∨ q ↔ sb y x (Q y ∨ q) $ by bi_trans [goal_17, goal_19]
goal_21: $ sb y x (¬ P y) ↔ sb y x (¬ P y) $ by bi_refl
goal_22: $ sb y x (¬ P y) ∧ (Q x ∨ q) ↔ sb y x (¬ P y) ∧ sb y x (Q y ∨ q) $ by an_congr [goal_21, goal_20]
goal_23: $ ¬ P x ∧ (Q x ∨ q) ↔ sb y x (¬ P y) ∧ sb y x (Q y ∨ q) $ by bi_trans [goal_8, goal_22]
goal_24: $ sb y x (¬ P y ∧ (Q y ∨ q)) ↔ sb y x (¬ P y) ∧ sb y x (Q y ∨ q) $ by sb_an
goal_25: $ sb y x (¬ P y) ∧ sb y x (Q y ∨ q) ↔ sb y x (¬ P y ∧ (Q y ∨ q)) $ by bi_symm [goal_24]
goal_26: $ ¬ P x ∧ (Q x ∨ q) ↔ sb y x (¬ P y ∧ (Q y ∨ q)) $ by bi_trans [goal_23, goal_25]
goal_27: $ ∀ x (¬ P x ∧ (Q x ∨ q)) ↔ ∀ x sb y x (¬ P y ∧ (Q y ∨ q)) $ by all_congr [goal_26]
goal_28: $ ∀ y (¬ P y ∧ (Q y ∨ q)) ↔ ∀ x sb y x (¬ P y ∧ (Q y ∨ q)) $ by all_alpha
goal_29: $ ∀ x sb y x (¬ P y ∧ (Q y ∨ q)) ↔ ∀ y (¬ P y ∧ (Q y ∨ q)) $ by bi_symm [goal_28]
goal_30: $ ∀ x (¬ P x ∧ (Q x ∨ q)) ↔ ∀ y (¬ P y ∧ (Q y ∨ q)) $ by bi_trans [goal_27, goal_29]
goal: $ ∀ y ((¬ (P y)) ∧ ((Q y) ∨ q)) $ by mpbi [goal_30, #1]

-- goal: $ (∀ y (P y)) ∨ q $ by conversion?
rename_prenex
-------------
goal_1: $ P x ∨ q ↔ q ∨ P x $ by or_comm
goal_2: $ ∀ x (P x ∨ q) ↔ ∀ x (q ∨ P x) $ by all_congr [goal_1]
goal_3: $ ∀ x (q ∨ P x) ↔ q ∨ ∀ x P x $ by pass_al_or
goal_4: $ ∀ x (P x ∨ q) ↔ q ∨ ∀ x P x $ by bi_trans [goal_2, goal_3]
goal_5: $ ∀ x P x ∨ q ↔ q ∨ ∀ x P x $ by or_comm
goal_6: $ q ∨ ∀ x P x ↔ ∀ x P x ∨ q $ by bi_symm [goal_5]
goal_7: $ ∀ x (P x ∨ q) ↔ ∀ x P x ∨ q $ by bi_trans [goal_4, goal_6]
goal_8: $ sb y x (P y) ↔ P x $ by sb_p
goal_9: $ P x ↔ sb y x (P y) $ by bi_symm [goal_8]
goal_10: $ ∀ x P x ↔ ∀ x sb y x (P y) $ by all_congr [goal_9]
goal_11: $ ∀ y P y ↔ ∀ x sb y x (P y) $ by all_alpha
goal_12: $ ∀ x sb y x (P y) ↔ ∀ y P y $ by bi_symm [goal_11]
goal_13: $ ∀ x P x ↔ ∀ y P y $ by bi_trans [goal_10, goal_12]
goal_14: $ q ↔ q $ by bi_refl
goal_15: $ ∀ x P x ∨ q ↔ ∀ y P y ∨ q $ by or_congr [goal_13, goal_14]
goal_16: $ ∀ x (P x ∨ q) ↔ ∀ y P y ∨ q $ by bi_trans [goal_7, goal_15]
goal: $ (∀ y (P y)) ∨ q $ by mpbi [goal_16, #1]

-- goal: $ ∀ y (¬ (P y)) $ by conversion?
rename_neg
----------
goal_1: $ ∃ x P x ↔ ∃ y sb x y (P x) $ by ex_alpha
goal_2: $ sb x y (P x) ↔ P y $ by sb_p
goal_3: $ ∃ y sb x y (P x) ↔ ∃ y P y $ by ex_congr [goal_2]
goal_4: $ ∃ x P x ↔ ∃ y P y $ by bi_trans [goal_1, goal_3]
goal_5: $ ¬ ∃ x P x ↔ ¬ ∃ y P y $ by not_congr [goal_4]
goal_6: $ ¬ ∃ y P y ↔ ∀ y (¬ P y) $ by neg_ex
goal_7: $ ¬ ∃ x P x ↔ ∀ y (¬ P y) $ by bi_trans [goal_5, goal_6]
goal: $ ∀ y (¬ (P y)) $ by mpbi [goal_7, #1]

-- goal: $ ∀ u (∃ v ((P u) ∧ (Q v))) $ by conversion?
rename_nested
-------------
goal_1: $ ∃ y (P x ∧ Q y) ↔ P x ∧ ∃ y Q y $ by pass_ex_an
goal_2: $ sb u x (P u) ↔ P x $ by sb_p
goal_3: $ P x ↔ sb u x (P u) $ by bi_symm [goal_2]
goal_4: $ ∃ y Q y ↔ ∃ y Q y $ by bi_refl
goal_5: $ P x ∧ ∃ y Q y ↔ sb u x (P u) ∧ ∃ y Q y $ by an_congr [goal_3, goal_4]
goal_6: $ ∃ y (P x ∧ Q y) ↔ sb u x (P u) ∧ ∃ y Q y $ by bi_trans [goal_1, goal_5]
goal_7: $ sb u x (∃ y Q y) ↔ ∃ y Q y $ by sb_const
goal_8: $ ∃ y Q y ↔ sb u x (∃ y Q y) $ by bi_symm [goal_7]
goal_9: $ sb v y (Q v) ↔ Q y $ by sb_q
goal_10: $ Q y ↔ sb v y (Q v) $ by bi_symm [goal_9]
goal_11: $ ∃ y Q y ↔ ∃ y sb v y (Q v) $ by ex_congr [goal_10]
goal_12: $ ∃ v Q v ↔ ∃ y sb v y (Q v) $ by ex_alpha
goal_13: $ ∃ y sb v y (Q v) ↔ ∃ v Q v $ by bi_symm [goal_12]
goal_14: $ ∃ y Q y ↔ ∃ v Q v $ by bi_trans [goal_11, goal_13]
goal_15: $ x =o x $ by eqo_refl
goal_16: $ sb u x (∃ y Q y) ↔ sb u x (∃ v Q v) $ by sb_congr [goal_15, goal_14]
goal_17: $ ∃ y Q y ↔ sb u x (∃ v Q v) $ by bi_trans [goal_8, goal_16]
goal_18: $ sb u x (P u) ↔ sb u x (P u) $ by bi_refl
goal_19: $ sb u x (P u) ∧ ∃ y Q y ↔ sb u x (P u) ∧ sb u x (∃ v Q v) $ by an_congr [goal_18, goal_17]
goal_20: $ ∃ y (P x ∧ Q y) ↔ sb u x (P u) ∧ sb u x (∃ v Q v) $ by bi_trans [goal_6, goal_19]
goal_21: $ sb u x (P u ∧ ∃ v Q v) ↔ sb u x (P u) ∧ sb u x (∃ v Q v) $ by sb_an
goal_22: $ sb u x (P u) ∧ sb u x (∃ v Q v) ↔ sb u x (P u ∧ ∃ v Q v) $ by bi_symm [goal_21]
goal_23: $ ∃ y (P x ∧ Q y) ↔ sb u x (P u ∧ ∃ v Q v) $ by bi_trans [goal_20, goal_22]
goal_24: $ ∃ v (P u ∧ Q v) ↔ P u ∧ ∃ v Q v $ by pass_ex_an
goal_25: $ P u ∧ ∃ v Q v ↔ ∃ v (P u ∧ Q v) $ by bi_symm [goal_24]
goal_26: $ sb u x (P u ∧ ∃ v Q v) ↔ sb u x (∃ v (P u ∧ Q v)) $ by sb_congr [goal_15, goal_25]
goal_27: $ ∃ y (P x ∧ Q y) ↔ sb u x (∃ v (P u ∧ Q v)) $ by bi_trans [goal_23, goal_26]
goal_28: $ ∀ x ∃ y (P x ∧ Q y) ↔ ∀ x sb u x (∃ v (P u ∧ Q v)) $ by all_congr [goal_27]
goal_29: $ ∀ u ∃ v (P u ∧ Q v) ↔ ∀ x sb u x (∃ v (P u ∧ Q v)) $ by all_alpha
goal_30: $ ∀ x sb u x (∃ v (P u ∧ Q v)) ↔ ∀ u ∃ v (P u ∧ Q v) $ by bi_symm [goal_29]
goal_31: $ ∀ x ∃ y (P x ∧ Q y) ↔ ∀ u ∃ v (P u ∧ Q v) $ by bi_trans [goal_28, goal_30]
goal: $ ∀ u (∃ v ((P u) ∧ (Q v))) $ by mpbi [goal_31, #1]

-- goal: $ ∀ u ((P u) → q) $ by conversion?
prenex_rename
-------------
goal_1: $ ∃ x P x ↔ ∃ u sb x u (P x) $ by ex_alpha
goal_2: $ sb x u (P x) ↔ P u $ by sb_p
goal_3: $ ∃ u sb x u (P x) ↔ ∃ u P u $ by ex_congr [goal_2]
goal_4: $ ∃ x P x ↔ ∃ u P u $ by bi_trans [goal_1, goal_3]
goal_5: $ q ↔ q $ by bi_refl
goal_6: $ ∃ x P x → q ↔ ∃ u P u → q $ by im_congr [goal_4, goal_5]
goal_7: $ ∃ u P u → q ↔ ∀ u (P u → q) $ by pass_im_ante_ex
goal_8: $ ∃ x P x → q ↔ ∀ u (P u → q) $ by bi_trans [goal_6, goal_7]
goal: $ ∀ u ((P u) → q) $ by mpbi [goal_8, #1]

-- goal: $ ∃ u (∃ v ((P u) → (Q v))) $ by conversion?
prenex_rename_two
-----------------
goal_1: $ ∀ x P x ↔ ∀ u sb x u (P x) $ by all_alpha
goal_2: $ sb x u (P x) ↔ P u $ by sb_p
goal_3: $ ∀ u sb x u (P x) ↔ ∀ u P u $ by all_congr [goal_2]
goal_4: $ ∀ x P x ↔ ∀ u P u $ by bi_trans [goal_1, goal_3]
goal_5: $ ∃ y Q y ↔ ∃ y Q y $ by bi_refl
goal_6: $ ∀ x P x → ∃ y Q y ↔ ∀ u P u → ∃ y Q y $ by im_congr [goal_4, goal_5]
goal_7: $ ∀ u P u → ∃ y Q y ↔ ∃ u (P u → ∃ y Q y) $ by pass_im_ante_al
goal_8: $ ∀ x P x → ∃ y Q y ↔ ∃ u (P u → ∃ y Q y) $ by bi_trans [goal_6, goal_7]
goal_9: $ ∃ y Q y ↔ ∃ v sb y v (Q y) $ by ex_alpha
goal_10: $ sb y v (Q y) ↔ Q v $ by sb_q
goal_11: $ ∃ v sb y v (Q y) ↔ ∃ v Q v $ by ex_congr [goal_10]
goal_12: $ ∃ y Q y ↔ ∃ v Q v $ by bi_trans [goal_9, goal_11]
goal_13: $ P u ↔ P u $ by bi_refl
goal_14: $ P u → ∃ y Q y ↔ P u → ∃ v Q v $ by im_congr [goal_13, goal_12]
goal_15: $ P u → ∃ v Q v ↔ ∃ v (P u → Q v) $ by pass_im_cons_ex
goal_16: $ P u → ∃ y Q y ↔ ∃ v (P u → Q v) $ by bi_trans [goal_14, goal_15]
goal_17: $ ∃ u (P u → ∃ y Q y) ↔ ∃ u ∃ v (P u → Q v) $ by ex_congr [goal_16]
goal_18: $ ∀ x P x → ∃ y Q y ↔ ∃ u ∃ v (P u → Q v) $ by bi_trans [goal_8, goal_17]
goal: $ ∃ u (∃ v ((P u) → (Q v))) $ by mpbi [goal_18, #1]
