-- Natural-deduction proofs of Cantor, Cantor–Bernstein, and König.
-- Contexts are sets of assumptions: ACUI removes duplicates and emp.

-- Elementary natural deduction and separation.

nd_imp_id
---------
l1: $ p ⊢ p $ by ax
l2: $ _ ⊢ p → p $ by imp_intro [l1]

nd_explosion
------------
l1: $ ⊥ ⊢ ⊥ $ by ax
l2: $ ⊥ ⊢ p $ by bot_elim [l1]
l3: $ _ ⊢ ⊥ → p $ by imp_intro [l2]

nd_and_comm
-----------
l1: $ p ∧ q ⊢ p ∧ q $ by ax
l2: $ p ∧ q ⊢ p $ by and_elim_l [l1]
l3: $ p ∧ q ⊢ q $ by and_elim_r [l1]
l4: $ p ∧ q ⊢ q ∧ p $ by and_intro [l3, l2]
l5: $ _ ⊢ (p ∧ q) → (q ∧ p) $ by imp_intro [l4]

nd_or_comm
----------
l1: $ p ∨ q ⊢ p ∨ q $ by ax
l2: $ p ⊢ p $ by ax
l3: $ p ⊢ q ∨ p $ by or_intro_r [l2]
l4: $ q ⊢ q $ by ax
l5: $ q ⊢ q ∨ p $ by or_intro_l [l4]
l6: $ p ∨ q ⊢ q ∨ p $ by or_elim [l1, l3, l5]
l7: $ _ ⊢ (p ∨ q) → (q ∨ p) $ by imp_intro [l6]

nd_forall_const_intro
---------------------
l1: $ p ⊢ p $ by ax
l2: $ p ⊢ ∀ x p $ by all_intro [l1]
l3: $ _ ⊢ p → ∀ x p $ by imp_intro [l2]

nd_forall_specialize
--------------------
l1: $ _ ⊢ A ∈ A $ by all_elim [#1]

nd_exists_intro_mem
-------------------
l1: $ A ∈ A ⊢ A ∈ A $ by ax
l2: $ A ∈ A ⊢ ∃ x (x ∈ A) $ by ex_intro [l1]
l3: $ _ ⊢ A ∈ A → ∃ x (x ∈ A) $ by imp_intro [l2]

nd_exists_elim_const
--------------------
l1: $ ∃ x p ⊢ ∃ x p $ by ax
l2: $ p → q ⊢ p → q $ by ax
l3: $ p ⊢ p $ by ax
l4: $ p → q , p ⊢ q $ by imp_elim [l2, l3]
l5: $ ∃ x p , p → q ⊢ q $ by ex_elim [l1, l4]
l6: $ ∃ x p ⊢ (p → q) → q $ by imp_intro [l5]
l7: $ _ ⊢ (∃ x p) → ((p → q) → q) $ by imp_intro [l6]

nd_eq_refl
----------
l1: $ _ ⊢ a = a $ by eq_intro

nd_eq_symm
----------
l1: $ a = b ⊢ a = b $ by ax
l2: $ a = b ⊢ a = a $ by eq_intro
l3: $ a = b ⊢ b = a $ by eq_replace [l1, l2]
l4: $ _ ⊢ a = b → b = a $ by imp_intro [l3]

nd_eq_subst_mem
---------------
l1: $ a = b ⊢ a = b $ by ax
l2: $ a ∈ A ⊢ a ∈ A $ by ax
l3: $ a = b , a ∈ A ⊢ b ∈ A $ by eq_replace [l1, l2]
l4: $ a = b ⊢ a ∈ A → b ∈ A $ by imp_intro [l3]
l5: $ _ ⊢ a = b → (a ∈ A → b ∈ A) $ by imp_intro [l4]

nd_empty_elim_imp
-----------------
l1: $ x ∈ ∅ ⊢ x ∈ ∅ $ by ax
l2: $ x ∈ ∅ ⊢ ⊥ $ by empty_elim [l1]
l3: $ x ∈ ∅ ⊢ p $ by bot_elim [l2]
l4: $ _ ⊢ x ∈ ∅ → p $ by imp_intro [l3]

nd_pairset_left
---------------
l1: $ _ ⊢ x ∈ pairset x y $ by pairset_intro_left

nd_pairset_elim_imp
-------------------
l1: $ x ∈ pairset y z ⊢ x ∈ pairset y z $ by ax
l2: $ x ∈ pairset y z ⊢ x = y ∨ x = z $ by pairset_elim [l1]
l3: $ _ ⊢ x ∈ pairset y z → (x = y ∨ x = z) $ by imp_intro [l2]

nd_union_intro_imp
------------------
l1: $ x ∈ y ⊢ x ∈ y $ by ax
l2: $ y ∈ A ⊢ y ∈ A $ by ax
l3: $ x ∈ y , y ∈ A ⊢ x ∈ union A $ by union_intro [l1, l2]
l4: $ x ∈ y ⊢ y ∈ A → x ∈ union A $ by imp_intro [l3]
l5: $ _ ⊢ x ∈ y → (y ∈ A → x ∈ union A) $ by imp_intro [l4]

nd_power_intro_elim
-------------------
l1: $ B ⊆ A ⊢ B ⊆ A $ by ax
l2: $ B ⊆ A ⊢ B ∈ 𝒫 A $ by power_intro [l1]
l3: $ _ ⊢ (B ⊆ A) → B ∈ 𝒫 A $ by imp_intro [l2]

nd_power_elim_imp
-----------------
l1: $ B ∈ 𝒫 A ⊢ B ∈ 𝒫 A $ by ax
l2: $ B ∈ 𝒫 A ⊢ B ⊆ A $ by power_elim [l1]
l3: $ _ ⊢ B ∈ 𝒫 A → (B ⊆ A) $ by imp_intro [l2]

nd_ext_imp
----------
l1: $ A ⊆ B ⊢ A ⊆ B $ by ax
l2: $ B ⊆ A ⊢ B ⊆ A $ by ax
l3: $ A ⊆ B , B ⊆ A ⊢ A = B $ by ext [l1, l2]
l4: $ A ⊆ B ⊢ (B ⊆ A) → A = B $ by imp_intro [l3]
l5: $ _ ⊢ (A ⊆ B) → ((B ⊆ A) → A = B) $ by imp_intro [l4]

nd_sep_intro_imp
----------------
l1: $ a ∈ A ⊢ a ∈ A $ by ax
l2: $ [x/a] p ⊢ [x/a] p $ by ax
l3: $ a ∈ A , [x/a] p ⊢ a ∈ {x ∈ A | p} $ by sep_intro [l1, l2]
l4: $ a ∈ A ⊢ [x/a] p → a ∈ {x ∈ A | p} $ by imp_intro [l3]
l5: $ _ ⊢ a ∈ A → ([x/a] p → a ∈ {x ∈ A | p}) $ by imp_intro [l4]

nd_sep_elim_left_imp
--------------------
l1: $ a ∈ {x ∈ A | p} ⊢ a ∈ {x ∈ A | p} $ by ax
l2: $ a ∈ {x ∈ A | p} ⊢ a ∈ A $ by sep_elim_left [l1]
l3: $ _ ⊢ a ∈ {x ∈ A | p} → a ∈ A $ by imp_intro [l2]

nd_sep_elim_right_imp
---------------------
l1: $ a ∈ {x ∈ A | p} ⊢ a ∈ {x ∈ A | p} $ by ax
l2: $ a ∈ {x ∈ A | p} ⊢ [x/a] p $ by sep_elim_right [l1]
l3: $ _ ⊢ a ∈ {x ∈ A | p} → [x/a] p $ by imp_intro [l2]

nd_sep_self
-----------
l1: $ x ∈ {x ∈ A | p} ⊢ x ∈ {x ∈ A | p} $ by ax
l2: $ x ∈ {x ∈ A | p} ⊢ x ∈ A $ by sep_elim_left [l1]
l3: $ x ∈ {x ∈ A | p} ⊢ p $ by sep_elim_right [l1]
l4: $ x ∈ {x ∈ A | p} ⊢ x ∈ A ∧ p $ by and_intro [l2, l3]
l5: $ _ ⊢ x ∈ {x ∈ A | p} → (x ∈ A ∧ p) $ by imp_intro [l4]
l6: $ x ∈ A ∧ p ⊢ x ∈ A ∧ p $ by ax
l7: $ x ∈ A ∧ p ⊢ x ∈ A $ by and_elim_l [l6]
l8: $ x ∈ A ∧ p ⊢ p $ by and_elim_r [l6]
l9: $ x ∈ A ∧ p ⊢ x ∈ {x ∈ A | p} $ by sep_intro [l7, l8]
l10: $ _ ⊢ (x ∈ A ∧ p) → x ∈ {x ∈ A | p} $ by imp_intro [l9]
l11: $ _ ⊢ x ∈ {x ∈ A | p} ↔ (x ∈ A ∧ p) $ by bi_intro [l5, l10]

nd_sep_subset
-------------
l1: $ _ ⊢ {x ∈ A | p} ⊆ A $ by sep_subset

-- Subset, difference, and image rules.

subset_intro
------------
l1: $ G ⊢ x ∈ A → x ∈ B $ by imp_intro [#1]
l2: $ G ⊢ ∀ x (x ∈ A → x ∈ B) $ by all_intro [l1]

subset_elim
-----------
l1: $ G ⊢ x ∈ A → x ∈ B $ by all_elim [#1]
l2: $ G , H ⊢ x ∈ B $ by imp_elim [l1, #2]

setdiff_subset
--------------
l1: $ G ⊢ A ∖ B ⊆ A $ by sep_subset

setdiff_elim_left
-----------------
l1: $ G ⊢ x ∈ A $ by sep_elim_left [#1]

setdiff_elim_right
------------------
l1: $ G ⊢ x ∉ B $ by sep_elim_right [#1]

setdiff_intro
-------------
l1: $ G , H ⊢ x ∈ A ∖ B $ by sep_intro [#1, #2]

setdiff_missing
---------------
l0a: $ x ∈ B ⊢ x ∈ B $ by ax
l0b: $ x ∉ B ⊢ x ∉ B $ by ax
l1: $ G , x ∉ B ⊢ x ∈ A ∖ B $ by setdiff_intro [#1, l0b]
l2: $ G , H , x ∉ B ⊢ ⊥ $ by not_elim [#2, l1]
l3: $ G , H , x ∉ B ⊢ x ∈ B $ by bot_elim [l2]
l4: $ emp ⊢ x ∈ B ∨ x ∉ B $ by excluded_middle_nd
l5: $ G , H ⊢ x ∈ B $ by or_elim [l4, l0a, l3]

has_preimage_intro
------------------
l1: $ G , H ⊢ x ∈ X ∧ maps f x y $ by and_intro [#1, #2]
l2: $ G , H ⊢ has_preimage f X y $ by ex_intro [l1]

image_subset
------------
l1: $ G ⊢ image f X B ⊆ B $ by sep_subset

image_elim_mem
--------------
l1: $ G ⊢ y ∈ B $ by sep_elim_left [#1]

image_has_preimage
------------------
l1: $ G ⊢ ∃ x (x ∈ X ∧ maps f x y) $ by sep_elim_right [#1]

image_intro
-----------
l1: $ H , K ⊢ has_preimage f X y $ by has_preimage_intro [#2, #3]
l2: $ G , H , K ⊢ y ∈ image f X B $ by sep_intro [#1, l1]

-- Equality and function rules.

mem_eq_right
------------
l1: $ G , H ⊢ x ∈ B $ by eq_replace [#1, #2]

set_sym
-------
l1: $ G ⊢ a = a $ by eq_intro
l2: $ G ⊢ b = a $ by eq_replace [#1, l1]

mem_arg_eq
----------
l1: $ G , H ⊢ y ∈ A $ by eq_replace [#1, #2]

not_mem_eq_right
----------------
l1: $ G , H ⊢ x ∉ B $ by eq_replace [#1, #2]

function_functional
-------------------
l1: $ G ⊢ functional f $ by and_elim_l [#1]

functional_elim
---------------
l1: $ G ⊢ ∀ u (∀ v ((maps f x u ∧ maps f x v) → u = v)) $
  by all_elim [#1]
l2: $ G ⊢ ∀ v ((maps f x y ∧ maps f x v) → y = v) $
  by all_elim [l1]
l3: $ G ⊢ (maps f x y ∧ maps f x z) → y = z $
  by all_elim [l2]
l4: $ H , K ⊢ maps f x y ∧ maps f x z $ by and_intro [#2, #3]
l5: $ G , H , K ⊢ y = z $ by imp_elim [l3, l4]

function_unique
---------------
l1: $ G ⊢ functional f $ by function_functional [#1]
l2: $ G , H , K ⊢ y = z $ by functional_elim [l1, #2, #3]

function_domain_on
------------------
l1: $ G ⊢ domain_on f A ∧ range_sub f B $ by and_elim_r [#1]
l2: $ G ⊢ domain_on f A $ by and_elim_l [l1]

function_range_sub
------------------
l1: $ G ⊢ domain_on f A ∧ range_sub f B $ by and_elim_r [#1]
l2: $ G ⊢ range_sub f B $ by and_elim_r [l1]

domain_on_maps_mem
------------------
l1: $ G ⊢ x ∈ A ↔ ∃ u (maps f x u) $ by all_elim [#1]
l2: $ H ⊢ ∃ u (maps f x u) $ by ex_intro [#2]
l3: $ G , H ⊢ x ∈ A $ by bi_elim_r [l1, l2]

range_sub_elim
---------------
l1: $ G ⊢ (∃ u (maps f u y)) → y ∈ B $ by all_elim [#1]
l2: $ H ⊢ ∃ u (maps f u y) $ by ex_intro [#2]
l3: $ G , H ⊢ y ∈ B $ by imp_elim [l1, l2]

function_maps_domain
--------------------
l1: $ G ⊢ domain_on f A $ by function_domain_on [#1]
l2: $ G , H ⊢ x ∈ A $ by domain_on_maps_mem [l1, #2]

function_maps_range
-------------------
l1: $ G ⊢ range_sub f B $ by function_range_sub [#1]
l2: $ G , H ⊢ y ∈ B $ by range_sub_elim [l1, #2]

injective_function
------------------
l1: $ G ⊢ function f A B $ by and_elim_l [#1]

injective_maps_domain
---------------------
l1: $ G ⊢ function f A B $ by injective_function [#1]
l2: $ G , H ⊢ x ∈ A $ by function_maps_domain [l1, #2]

injective_maps_range
--------------------
l1: $ G ⊢ function f A B $ by injective_function [#1]
l2: $ G , H ⊢ y ∈ B $ by function_maps_range [l1, #2]

injective_elim
--------------
l1: $ G ⊢
      ∀ u ∀ v ∀ w
        (((u ∈ A ∧ v ∈ A) ∧ (maps f u w ∧ maps f v w)) → u = v) $
  by and_elim_r [#1]
l2: $ G ⊢
      ∀ v ∀ w
        (((x ∈ A ∧ v ∈ A) ∧ (maps f x w ∧ maps f v w)) → x = v) $
  by all_elim [l1]
l3: $ G ⊢
      ∀ w
        (((x ∈ A ∧ y ∈ A) ∧ (maps f x w ∧ maps f y w)) → x = y) $
  by all_elim [l2]
l4: $ G ⊢
      (((x ∈ A ∧ y ∈ A) ∧ (maps f x z ∧ maps f y z)) → x = y) $
  by all_elim [l3]
l5: $ H , I ⊢ x ∈ A ∧ y ∈ A $ by and_intro [#2, #3]
l6: $ J , K ⊢ maps f x z ∧ maps f y z $ by and_intro [#4, #5]
l7: $ H , I , J , K ⊢
      (x ∈ A ∧ y ∈ A) ∧ (maps f x z ∧ maps f y z) $
  by and_intro [l5, l6]
l8: $ G , H , I , J , K ⊢ x = y $ by imp_elim [l4, l7]

injective_elim_auto
-------------------
l1: $ G , H ⊢ x ∈ A $ by injective_maps_domain [#1, #2]
l2: $ G , K ⊢ y ∈ A $ by injective_maps_domain [#1, #3]
l3: $ G , H , K ⊢ x = y $
  by injective_elim [#1, l1, l2, #2, #3]

domain_on_has_maps
------------------
l1: $ G ⊢ x ∈ A ↔ ∃ y (maps f x y) $ by all_elim [#1]
l2: $ G , H ⊢ ∃ y (maps f x y) $ by bi_elim_l [l1, #2]

function_intro
--------------
l1: $ H , I ⊢ domain_on f A ∧ range_sub f B $ by and_intro [#2, #3]
l2: $ G , H , I ⊢ function f A B $ by and_intro [#1, l1]

injective_intro
---------------
l1: $ G , H ⊢ injective f A B $ by and_intro [#1, #2]

range_sub_intro
---------------
l0: $ ∃ x (maps f x y) ⊢ ∃ x (maps f x y) $ by ax
l0a: $ maps f x y ⊢ maps f x y $ by ax
l1: $ G ⊢ ∀ x (maps f x y → y ∈ B) $ by all_elim [#1]
l2: $ G ⊢ maps f x y → y ∈ B $ by all_elim [l1]
l3: $ G , maps f x y ⊢ y ∈ B $ by imp_elim [l2, l0a]
l4: $ ∃ x (maps f x y) , G ⊢ y ∈ B $ by ex_elim [l0, l3]
l5: $ G ⊢ (∃ x (maps f x y)) → y ∈ B $ by imp_intro [l4]
l6: $ G ⊢ ∀ y ((∃ x (maps f x y)) → y ∈ B) $ by all_intro [l5]

surj_intro
----------
l1: $ G , H ⊢ surj f A B $ by and_intro [#1, #2]

bijective_intro
---------------
l1: $ G , H ⊢ bijective f A B $ by and_intro [#1, #2]

surj_has_preimage
-----------------
l1: $ G ⊢ ∀ u (u ∈ B → has_preimage f A u) $ by and_elim_r [#1]
l2: $ G ⊢ y ∈ B → has_preimage f A y $ by all_elim [l1]
l3: $ G , H ⊢ has_preimage f A y $ by imp_elim [l2, #2]

-- Cantor: no function from A can surject onto its power set.

diag_subset
-----------
l1: $ G ⊢ diag A f ⊆ A $ by sep_subset

diag_elim
---------
l1: $ G ⊢ ∀ y (maps f a y → a ∉ y) $ by sep_elim_right [#1]
l2: $ G ⊢ maps f a b → a ∉ b $ by all_elim [l1]
l3: $ G , H ⊢ a ∉ b $ by imp_elim [l2, #2]

diag_intro
----------
l1: $ G , H ⊢ a ∈ diag A f $ by sep_intro [#1, #2]

cantor_in_case
--------------
l1: $ H , G ⊢ a ∉ diag A f $ by diag_elim [#2, #1]
l2: $ G , H ⊢ ⊥ $ by not_elim [l1, #2]

cantor_out_case
---------------
l0a: $ maps f a y ⊢ maps f a y $ by ax
l0b: $ a ∈ y ⊢ a ∈ y $ by ax
l1: $ G , K , maps f a y ⊢ y = diag A f $ by function_unique [#1, l0a, #3]
l2: $ G , K , maps f a y , a ∈ y ⊢ a ∈ diag A f $
  by mem_eq_right [l1, l0b]
l3: $ G , K , L , maps f a y , a ∈ y ⊢ ⊥ $ by not_elim [#4, l2]
l4: $ G , K , L , maps f a y ⊢ a ∉ y $ by not_intro [l3]
l5: $ G , K , L ⊢ maps f a y → a ∉ y $ by imp_intro [l4]
l6: $ G , K , L ⊢ ∀ y (maps f a y → a ∉ y) $ by all_intro [l5]
l7: $ H , G , K , L ⊢ a ∈ diag A f $ by diag_intro [#2, l6]
l8: $ G , H , K , L ⊢ ⊥ $ by not_elim [#4, l7]

cantor
------
l0a: $ a ∈ A ∧ maps f a (diag A f) ⊢
       a ∈ A ∧ maps f a (diag A f) $ by ax
l0b: $ a ∈ diag A f ⊢ a ∈ diag A f $ by ax
l0c: $ a ∉ diag A f ⊢ a ∉ diag A f $ by ax
l1: $ emp ⊢ diag A f ⊆ A $ by diag_subset
l2: $ emp ⊢ diag A f ∈ 𝒫 A $ by power_intro [l1]
l3: $ emp ⊢ ∃ a (a ∈ A ∧ maps f a (diag A f)) $
  by surj_has_preimage [#2, l2]
l4: $ a ∈ A ∧ maps f a (diag A f) ⊢ a ∈ A $ by and_elim_l [l0a]
l5: $ a ∈ A ∧ maps f a (diag A f) ⊢ maps f a (diag A f) $
  by and_elim_r [l0a]
l6: $ emp ⊢ a ∈ diag A f ∨ a ∉ diag A f $ by excluded_middle_nd
l7: $ a ∈ A ∧ maps f a (diag A f) , a ∈ diag A f ⊢ ⊥ $
  by cantor_in_case [l5, l0b]
l8: $ a ∈ A ∧ maps f a (diag A f) , a ∉ diag A f ⊢ ⊥ $
  by cantor_out_case [#1, l4, l5, l0c]
l9: $ a ∈ A ∧ maps f a (diag A f) ⊢ ⊥ $ by or_elim [l6, l7, l8]
l10: $ emp ⊢ ⊥ $ by ex_elim [l3, l9]

-- Cantor–Bernstein: a fixed point of the step operator.

subset_not_mem
--------------
l0: $ x ∈ A ⊢ x ∈ A $ by ax
l1: $ G , x ∈ A ⊢ x ∈ B $ by subset_elim [#1, l0]
l2: $ G , H , x ∈ A ⊢ ⊥ $ by not_elim [#2, l1]
l3: $ G , H ⊢ x ∉ A $ by not_intro [l2]

setdiff_antitone_right
----------------------
l0: $ x ∈ A ∖ C ⊢ x ∈ A ∖ C $ by ax
l1: $ x ∈ A ∖ C ⊢ x ∈ A $ by setdiff_elim_left [l0]
l2: $ x ∈ A ∖ C ⊢ x ∉ C $ by setdiff_elim_right [l0]
l3: $ G , x ∈ A ∖ C ⊢ x ∉ B $ by subset_not_mem [#1, l2]
l4: $ x ∈ A ∖ C , G ⊢ x ∈ A ∖ B $ by setdiff_intro [l1, l3]
l5: $ G ⊢ A ∖ C ⊆ A ∖ B $ by subset_intro [l4]

image_mono
----------
l0: $ y ∈ image f X B ⊢ y ∈ image f X B $ by ax
l1: $ y ∈ image f X B ⊢ y ∈ B $ by image_elim_mem [l0]
l2: $ y ∈ image f X B ⊢ ∃ x (x ∈ X ∧ maps f x y) $
  by image_has_preimage [l0]
l0a: $ x ∈ X ∧ maps f x y ⊢ x ∈ X ∧ maps f x y $ by ax
l3: $ x ∈ X ∧ maps f x y ⊢ x ∈ X $ by and_elim_l [l0a]
l4: $ x ∈ X ∧ maps f x y ⊢ maps f x y $ by and_elim_r [l0a]
l5: $ G , x ∈ X ∧ maps f x y ⊢ x ∈ Y $ by subset_elim [#1, l3]
l6: $ y ∈ image f X B , G , x ∈ X ∧ maps f x y ⊢ y ∈ image f Y B $
  by image_intro [l1, l5, l4]
l7: $ y ∈ image f X B , G ⊢ y ∈ image f Y B $ by ex_elim [l2, l6]
l8: $ G ⊢ image f X B ⊆ image f Y B $ by subset_intro [l7]

inter_subsets_subset
--------------------
l1: $ G ⊢ inter_subsets A S ⊆ A $
  by sep_subset

inter_subsets_elim
------------------
l1: $ G ⊢ ∀ Y (Y ∈ S → x ∈ Y) $ by sep_elim_right [#1]
l2: $ G ⊢ X ∈ S → x ∈ X $ by all_elim [l1]
l3: $ G , H ⊢ x ∈ X $ by imp_elim [l2, #2]

inter_subsets_intro
-------------------
l1: $ G , H ⊢ x ∈ inter_subsets A S $ by sep_intro [#1, #2]

cb_core_subset
--------------
l1: $ G ⊢ cb_core A B f g ⊆ A $ by inter_subsets_subset

cb_core_elim_prefixed
---------------------
l1: $ G , H ⊢ x ∈ X $ by inter_subsets_elim [#1, #2]

cb_step_subset
--------------
l1: $ G ⊢ cb_step A B f g X ⊆ A $ by setdiff_subset

cb_step_elim_left
-----------------
l1: $ G ⊢ x ∈ A $ by setdiff_elim_left [#1]

cb_step_elim_right
------------------
l1: $ G ⊢ x ∉ image g (B ∖ image f X B) A $ by setdiff_elim_right [#1]

cb_step_intro
-------------
l1: $ G , H ⊢ x ∈ cb_step A B f g X $ by setdiff_intro [#1, #2]

cb_step_in_power
----------------
l1: $ G ⊢ cb_step A B f g X ⊆ A $ by cb_step_subset
l2: $ G ⊢ cb_step A B f g X ∈ 𝒫 A $ by power_intro [l1]

cb_prefixeds_elim_power
-----------------------
l1: $ G ⊢ X ∈ 𝒫 A $ by sep_elim_left [#1]

cb_prefixeds_elim_subset
------------------------
l1: $ G ⊢ X ∈ 𝒫 A $ by cb_prefixeds_elim_power [#1]
l2: $ G ⊢ X ⊆ A $ by power_elim [l1]

cb_prefixeds_elim_prefixed
--------------------------
l1: $ G ⊢ cb_prefixed A B f g X $ by sep_elim_right [#1]

cb_prefixeds_intro
------------------
l1: $ G ⊢ X ∈ 𝒫 A $ by power_intro [#1]
l2: $ G , H ⊢ X ∈ cb_prefixeds A B f g $ by sep_intro [l1, #2]

cb_prefixed_elim
----------------
l1: $ G ⊢ cb_prefixed A B f g X $ by cb_prefixeds_elim_prefixed [#1]
l2: $ G , H ⊢ x ∈ X $ by subset_elim [l1, #2]

cb_core_in_power
----------------
l1: $ G ⊢ cb_core A B f g ⊆ A $ by cb_core_subset
l2: $ G ⊢ cb_core A B f g ∈ 𝒫 A $ by power_intro [l1]

cb_core_subset_prefixed
-----------------------
l0: $ x ∈ cb_core A B f g ⊢ x ∈ cb_core A B f g $ by ax
l1: $ x ∈ cb_core A B f g , G ⊢ x ∈ X $
  by cb_core_elim_prefixed [l0, #1]
l2: $ G ⊢ cb_core A B f g ⊆ X $ by subset_intro [l1]

cb_step_mono
------------
l0: $ x ∈ cb_step A B f g X ⊢ x ∈ cb_step A B f g X $ by ax
l1: $ G ⊢ image f X B ⊆ image f Y B $ by image_mono [#1]
l2: $ G ⊢ B ∖ image f Y B ⊆ B ∖ image f X B $
  by setdiff_antitone_right [l1]
l3: $ G ⊢ image g (B ∖ image f Y B) A ⊆ image g (B ∖ image f X B) A $
  by image_mono [l2]
l4: $ x ∈ cb_step A B f g X ⊢ x ∈ A $ by cb_step_elim_left [l0]
l5: $ x ∈ cb_step A B f g X ⊢ x ∉ image g (B ∖ image f X B) A $
  by cb_step_elim_right [l0]
l6: $ G , x ∈ cb_step A B f g X ⊢ x ∉ image g (B ∖ image f Y B) A $
  by subset_not_mem [l3, l5]
l7: $ x ∈ cb_step A B f g X , G ⊢ x ∈ cb_step A B f g Y $
  by cb_step_intro [l4, l6]
l8: $ G ⊢ cb_step A B f g X ⊆ cb_step A B f g Y $
  by subset_intro [l7]

cb_core_step_prefixed
---------------------
l1: $ G ⊢ cb_core A B f g ⊆ X $ by cb_core_subset_prefixed [#1]
l2: $ G ⊢ cb_step A B f g (cb_core A B f g) ⊆ cb_step A B f g X $
  by cb_step_mono [l1]
l3: $ G , H ⊢ x ∈ cb_step A B f g X $ by subset_elim [l2, #2]
l4: $ G , H ⊢ x ∈ X $ by cb_prefixed_elim [#1, l3]

cb_core_prefixed
----------------
l0: $ G , x ∈ cb_step A B f g (cb_core A B f g) ⊢
      x ∈ cb_step A B f g (cb_core A B f g) $ by ax
l1: $ G , x ∈ cb_step A B f g (cb_core A B f g) ⊢ x ∈ A $
  by cb_step_elim_left [l0]
l0a: $ X ∈ cb_prefixeds A B f g ⊢ X ∈ cb_prefixeds A B f g $
  by ax
l2: $ G , x ∈ cb_step A B f g (cb_core A B f g) , X ∈ cb_prefixeds A B f g ⊢
      x ∈ X $ by cb_core_step_prefixed [l0a, l0]
l3: $ G , x ∈ cb_step A B f g (cb_core A B f g) ⊢
      X ∈ cb_prefixeds A B f g → x ∈ X $ by imp_intro [l2]
l4: $ G , x ∈ cb_step A B f g (cb_core A B f g) ⊢
      ∀ X (X ∈ cb_prefixeds A B f g → x ∈ X) $ by all_intro [l3]
l5: $ G , x ∈ cb_step A B f g (cb_core A B f g) ⊢
      x ∈ cb_core A B f g $ by inter_subsets_intro [l1, l4]
l6: $ G ⊢ cb_step A B f g (cb_core A B f g) ⊆ cb_core A B f g $
  by subset_intro [l5]

cb_step_core_prefixed
---------------------
l1: $ G ⊢ cb_step A B f g (cb_core A B f g) ⊆ cb_core A B f g $
  by cb_core_prefixed
l2: $ G ⊢ cb_step A B f g (cb_step A B f g (cb_core A B f g)) ⊆
      cb_step A B f g (cb_core A B f g) $ by cb_step_mono [l1]

cb_step_core_in_prefixeds
-------------------------
l1: $ G ⊢ cb_step A B f g (cb_core A B f g) ⊆ A $ by cb_step_subset
l2: $ G ⊢ cb_prefixed A B f g (cb_step A B f g (cb_core A B f g)) $
  by cb_step_core_prefixed
l3: $ G ⊢ cb_step A B f g (cb_core A B f g) ∈ cb_prefixeds A B f g $
  by cb_prefixeds_intro [l1, l2]

cb_core_subset_step_core
------------------------
l1: $ G ⊢ cb_step A B f g (cb_core A B f g) ∈ cb_prefixeds A B f g $
  by cb_step_core_in_prefixeds
l2: $ G ⊢ cb_core A B f g ⊆ cb_step A B f g (cb_core A B f g) $
  by cb_core_subset_prefixed [l1]

cb_step_core_subset_core
------------------------
l1: $ G ⊢ cb_prefixed A B f g (cb_core A B f g) $ by cb_core_prefixed

cb_core_fixed
-------------
l1: $ G ⊢ cb_core A B f g ⊆ cb_step A B f g (cb_core A B f g) $
  by cb_core_subset_step_core
l2: $ G ⊢ cb_step A B f g (cb_core A B f g) ⊆ cb_core A B f g $
  by cb_step_core_subset_core
l3: $ G ⊢ cb_core A B f g = cb_step A B f g (cb_core A B f g) $
  by ext [l1, l2]

-- The piecewise bijection and its two branches.

cb_bijection_maps_pair_mem
--------------------------
l1: $ G ⊢ ⟨ x , y ⟩ ∈ pair_carrier A B $
  by sep_elim_left [#1]

cb_bijection_maps_cases
-----------------------
l1: $ G ⊢ ∃ u ∃ v
      (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) $
  by sep_elim_right [#1]

cb_bijection_maps_intro
-----------------------
l1: $ G , H ⊢ ⟨ x , y ⟩ ∈ pair_carrier A B $
  by opair_mem_pair_carrier [#1, #2]
l2: $ K ⊢ ⟨ x , y ⟩ = ⟨ x , y ⟩ $ by eq_intro
l3: $ K ⊢ ⟨ x , y ⟩ = ⟨ x , y ⟩ ∧ cb_branch A B f g x y $
  by and_intro [l2, #3]
l4: $ K ⊢ ∃ v
      (⟨ x , y ⟩ = ⟨ x , v ⟩ ∧ cb_branch A B f g x v) $
  by ex_intro [l3]
l5: $ K ⊢ ∃ u ∃ v
      (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) $
  by ex_intro [l4]
l6: $ G , H , K ⊢ maps (cb_bijection A B f g) x y $
  by sep_intro [l1, l5]

cb_bijection_f_branch_maps
--------------------------
l1: $ K ⊢ cb_branch A B f g x y $ by or_intro_l [#3]
l2: $ G , H , K ⊢ maps (cb_bijection A B f g) x y $
  by cb_bijection_maps_intro [#1, #2, l1]

cb_bijection_g_branch_maps
--------------------------
l1: $ K ⊢ cb_branch A B f g x y $ by or_intro_r [#3]
l2: $ G , H , K ⊢ maps (cb_bijection A B f g) x y $
  by cb_bijection_maps_intro [#1, #2, l1]

cb_f_branch_core
----------------
l1: $ G ⊢ x ∈ cb_core A B f g $ by and_elim_l [#1]

cb_f_branch_maps
----------------
l1: $ G ⊢ maps f x y $ by and_elim_r [#1]

cb_g_branch_not_core
--------------------
l1: $ G ⊢ x ∉ cb_core A B f g $ by and_elim_l [#1]

cb_g_branch_maps
----------------
l1: $ G ⊢ maps g y x $ by and_elim_r [#1]

cb_branch_intro_f
-----------------
l1: $ G ⊢ cb_branch A B f g x y $ by or_intro_l [#1]

cb_branch_intro_g
-----------------
l1: $ G ⊢ cb_branch A B f g x y $ by or_intro_r [#1]

cb_branch_eq
------------
l1: $ G ⊢ u = x $ by set_sym [#1]
l2: $ H ⊢ v = y $ by set_sym [#2]
l3: $ G , I ⊢ cb_branch A B f g x v $ by eq_replace [l1, #3]
l4: $ H , G , I ⊢ cb_branch A B f g x y $ by eq_replace [l2, l3]

cb_bijection_maps_branch
------------------------
l0: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢
      ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v $ by ax
l1: $ G ⊢ ∃ u ∃ v
      (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) $
  by cb_bijection_maps_cases [#1]
l2: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢
      ⟨ x , y ⟩ = ⟨ u , v ⟩ $ by and_elim_l [l0]
l3: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢
      cb_branch A B f g u v $ by and_elim_r [l0]
l4: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢ x = u $
  by opair_eq_left [l2]
l5: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢ y = v $
  by opair_eq_right [l2]
l6: $ ⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v ⊢
      cb_branch A B f g x y $ by cb_branch_eq [l4, l5, l3]
l6a: $ ∃ v (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) ⊢
       ∃ v (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) $ by ax
l7: $ ∃ v (⟨ x , y ⟩ = ⟨ u , v ⟩ ∧ cb_branch A B f g u v) ⊢
      cb_branch A B f g x y $ by ex_elim [l6a, l6]
l8: $ G ⊢ cb_branch A B f g x y $ by ex_elim [l1, l7]

cb_bijection_maps_domain
------------------------
l0f: $ cb_f_branch A B f g x y ⊢ cb_f_branch A B f g x y $ by ax
l0g: $ cb_g_branch A B f g x y ⊢ cb_g_branch A B f g x y $ by ax
l1: $ H ⊢ cb_branch A B f g x y $
  by cb_bijection_maps_branch [#2]
l2: $ cb_f_branch A B f g x y ⊢ x ∈ cb_core A B f g $
  by cb_f_branch_core [l0f]
l3: $ emp ⊢ cb_core A B f g ⊆ A $ by cb_core_subset
l4: $ cb_f_branch A B f g x y ⊢ x ∈ A $ by subset_elim [l3, l2]
l5: $ cb_g_branch A B f g x y ⊢ maps g y x $ by cb_g_branch_maps [l0g]
l6: $ G , cb_g_branch A B f g x y ⊢ x ∈ A $
  by injective_maps_range [#1, l5]
l7: $ H , G ⊢ x ∈ A $ by or_elim [l1, l4, l6]

cb_bijection_maps_range
-----------------------
l0f: $ cb_f_branch A B f g x y ⊢ cb_f_branch A B f g x y $ by ax
l0g: $ cb_g_branch A B f g x y ⊢ cb_g_branch A B f g x y $ by ax
l1: $ H ⊢ cb_branch A B f g x y $
  by cb_bijection_maps_branch [#3]
l2: $ cb_f_branch A B f g x y ⊢ maps f x y $ by cb_f_branch_maps [l0f]
l3: $ F , cb_f_branch A B f g x y ⊢ y ∈ B $
  by injective_maps_range [#1, l2]
l4: $ cb_g_branch A B f g x y ⊢ maps g y x $ by cb_g_branch_maps [l0g]
l5: $ G , cb_g_branch A B f g x y ⊢ y ∈ B $
  by injective_maps_domain [#2, l4]
l6: $ H , F , G ⊢ y ∈ B $ by or_elim [l1, l3, l5]

cb_branch_ff_functional
-----------------------
l1: $ F ⊢ function f A B $ by injective_function [#1]
l2: $ G ⊢ maps f x y $ by cb_f_branch_maps [#2]
l3: $ H ⊢ maps f x z $ by cb_f_branch_maps [#3]
l4: $ F , G , H ⊢ y = z $ by function_unique [l1, l2, l3]

cb_branch_gg_functional
-----------------------
l1: $ G ⊢ maps g y x $ by cb_g_branch_maps [#2]
l2: $ H ⊢ maps g z x $ by cb_g_branch_maps [#3]
l3: $ F , G , H ⊢ y = z $ by injective_elim_auto [#1, l1, l2]

cb_branch_fg_functional
-----------------------
l1: $ G ⊢ x ∈ cb_core A B f g $ by cb_f_branch_core [#1]
l2: $ H ⊢ x ∉ cb_core A B f g $ by cb_g_branch_not_core [#2]
l3: $ G , H ⊢ ⊥ $ by not_elim [l2, l1]
l4: $ G , H ⊢ y = z $ by bot_elim [l3]

cb_branch_gf_functional
-----------------------
l1: $ G ⊢ x ∉ cb_core A B f g $ by cb_g_branch_not_core [#1]
l2: $ H ⊢ x ∈ cb_core A B f g $ by cb_f_branch_core [#2]
l3: $ G , H ⊢ ⊥ $ by not_elim [l1, l2]
l4: $ G , H ⊢ y = z $ by bot_elim [l3]

cb_core_not_mem_image
---------------------
l1: $ H ⊢ cb_core A B f g = cb_step A B f g (cb_core A B f g) $
  by cb_core_fixed
l2: $ H ⊢ x ∉ cb_step A B f g (cb_core A B f g) $
  by not_mem_eq_right [l1, #2]
l3: $ G , H ⊢ x ∈ image g (B ∖ image f (cb_core A B f g) B) A $
  by setdiff_missing [#1, l2]

cb_f_branch_image
-----------------
l1: $ G ⊢ x ∈ cb_core A B f g $ by cb_f_branch_core [#2]
l2: $ G ⊢ maps f x y $ by cb_f_branch_maps [#2]
l3: $ F , G ⊢ y ∈ B $ by injective_maps_range [#1, l2]
l4: $ F , G ⊢ y ∈ image f (cb_core A B f g) B $
  by image_intro [l3, l1, l2]

cb_branch_fg_injective_mixed
----------------------------
l0: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢
      a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y $ by ax
l1: $ F , H ⊢ z ∈ image f (cb_core A B f g) B $
  by cb_f_branch_image [#1, #3]
l2: $ I ⊢ y ∉ cb_core A B f g $ by cb_g_branch_not_core [#4]
l3: $ I ⊢ maps g z y $ by cb_g_branch_maps [#4]
l4: $ G , I ⊢ y ∈ A $ by injective_maps_range [#2, l3]
l5: $ G , I ⊢ y ∈ image g (B ∖ image f (cb_core A B f g) B) A $
  by cb_core_not_mem_image [l4, l2]
l6: $ G , I ⊢
      ∃ a (a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y) $
  by image_has_preimage [l5]
l7: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢
      a ∈ B ∖ image f (cb_core A B f g) B $ by and_elim_l [l0]
l8: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢
      maps g a y $ by and_elim_r [l0]
l9: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢ a ∈ B $
  by setdiff_elim_left [l7]
l10: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢
       a ∉ image f (cb_core A B f g) B $ by setdiff_elim_right [l7]
l11: $ G , I ⊢ z ∈ B $ by injective_maps_domain [#2, l3]
l12: $ G , I ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y ⊢ z = a $
  by injective_elim [#2, l11, l9, l3, l8]
l13: $ G , I ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y , F , H ⊢
       a ∈ image f (cb_core A B f g) B $ by mem_arg_eq [l12, l1]
l14: $ G , I ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y , F , H ⊢ ⊥ $
  by not_elim [l10, l13]
l15: $ G , I ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a y , F , H ⊢
       x = y $ by bot_elim [l14]
l16: $ G , I , F , H ⊢ x = y $ by ex_elim [l6, l15]

cb_branch_gf_injective_mixed
----------------------------
l0: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
      a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x $ by ax
l1: $ F , I ⊢ z ∈ image f (cb_core A B f g) B $
  by cb_f_branch_image [#1, #4]
l2: $ H ⊢ x ∉ cb_core A B f g $ by cb_g_branch_not_core [#3]
l3: $ H ⊢ maps g z x $ by cb_g_branch_maps [#3]
l4: $ G , H ⊢ x ∈ A $ by injective_maps_range [#2, l3]
l5: $ G , H ⊢ x ∈ image g (B ∖ image f (cb_core A B f g) B) A $
  by cb_core_not_mem_image [l4, l2]
l6: $ G , H ⊢
      ∃ a (a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x) $
  by image_has_preimage [l5]
l7: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
      a ∈ B ∖ image f (cb_core A B f g) B $ by and_elim_l [l0]
l8: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
      maps g a x $ by and_elim_r [l0]
l9: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢ a ∈ B $
  by setdiff_elim_left [l7]
l10: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
       a ∉ image f (cb_core A B f g) B $ by setdiff_elim_right [l7]
l11: $ G , H ⊢ z ∈ B $ by injective_maps_domain [#2, l3]
l12: $ G , H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢ z = a $
  by injective_elim [#2, l11, l9, l3, l8]
l13: $ G , H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x , F , I ⊢
       a ∈ image f (cb_core A B f g) B $ by mem_arg_eq [l12, l1]
l14: $ G , H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x , F , I ⊢ ⊥ $
  by not_elim [l10, l13]
l15: $ G , H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x , F , I ⊢
       x = y $ by bot_elim [l14]
l16: $ G , H , F , I ⊢ x = y $ by ex_elim [l6, l15]

cb_branch_ff_injective
----------------------
l1: $ G ⊢ maps f x z $ by cb_f_branch_maps [#2]
l2: $ H ⊢ maps f y z $ by cb_f_branch_maps [#3]
l3: $ F , G , H ⊢ x = y $ by injective_elim_auto [#1, l1, l2]

cb_branch_gg_injective
----------------------
l1: $ F ⊢ function g B A $ by injective_function [#1]
l2: $ G ⊢ maps g z x $ by cb_g_branch_maps [#2]
l3: $ H ⊢ maps g z y $ by cb_g_branch_maps [#3]
l4: $ F , G , H ⊢ x = y $ by function_unique [l1, l2, l3]

cb_branch_functional
--------------------
l0f: $ cb_f_branch A B f g x y ⊢ cb_f_branch A B f g x y $ by ax
l0g: $ cb_g_branch A B f g x y ⊢ cb_g_branch A B f g x y $ by ax
l1f: $ cb_f_branch A B f g x z ⊢ cb_f_branch A B f g x z $ by ax
l1g: $ cb_g_branch A B f g x z ⊢ cb_g_branch A B f g x z $ by ax
l2: $ F , cb_f_branch A B f g x y , cb_f_branch A B f g x z ⊢
      y = z $ by cb_branch_ff_functional [#1, l0f, l1f]
l3: $ cb_f_branch A B f g x y , cb_g_branch A B f g x z ⊢
      y = z $ by cb_branch_fg_functional [l0f, l1g]
l4: $ I , F , cb_f_branch A B f g x y ⊢ y = z $
  by or_elim [#4, l2, l3]
l5: $ cb_g_branch A B f g x y , cb_f_branch A B f g x z ⊢
      y = z $ by cb_branch_gf_functional [l0g, l1f]
l6: $ G , cb_g_branch A B f g x y , cb_g_branch A B f g x z ⊢
      y = z $ by cb_branch_gg_functional [#2, l0g, l1g]
l7: $ I , G , cb_g_branch A B f g x y ⊢ y = z $
  by or_elim [#4, l5, l6]
l8: $ H , I , F , G ⊢ y = z $ by or_elim [#3, l4, l7]

cb_branch_injective
-------------------
l0f: $ cb_f_branch A B f g x z ⊢ cb_f_branch A B f g x z $ by ax
l0g: $ cb_g_branch A B f g x z ⊢ cb_g_branch A B f g x z $ by ax
l1f: $ cb_f_branch A B f g y z ⊢ cb_f_branch A B f g y z $ by ax
l1g: $ cb_g_branch A B f g y z ⊢ cb_g_branch A B f g y z $ by ax
l2: $ F , cb_f_branch A B f g x z , cb_f_branch A B f g y z ⊢
      x = y $ by cb_branch_ff_injective [#1, l0f, l1f]
l3: $ F , G , cb_f_branch A B f g x z , cb_g_branch A B f g y z ⊢
      x = y $ by cb_branch_fg_injective_mixed [#1, #2, l0f, l1g]
l4: $ I , F , G , cb_f_branch A B f g x z ⊢ x = y $
  by or_elim [#4, l2, l3]
l5: $ F , G , cb_g_branch A B f g x z , cb_f_branch A B f g y z ⊢
      x = y $ by cb_branch_gf_injective_mixed [#1, #2, l0g, l1f]
l6: $ G , cb_g_branch A B f g x z , cb_g_branch A B f g y z ⊢
      x = y $ by cb_branch_gg_injective [#2, l0g, l1g]
l7: $ I , F , G , cb_g_branch A B f g x z ⊢ x = y $
  by or_elim [#4, l5, l6]
l8: $ H , I , F , G ⊢ x = y $ by or_elim [#3, l4, l7]

cb_bijection_maps_functional
----------------------------
l1: $ H ⊢ cb_branch A B f g x y $
  by cb_bijection_maps_branch [#3]
l2: $ I ⊢ cb_branch A B f g x z $
  by cb_bijection_maps_branch [#4]
l3: $ F , G , H , I ⊢ y = z $ by cb_branch_functional [#1, #2, l1, l2]

cb_bijection_maps_injective
---------------------------
l1: $ H ⊢ cb_branch A B f g x z $
  by cb_bijection_maps_branch [#3]
l2: $ I ⊢ cb_branch A B f g y z $
  by cb_bijection_maps_branch [#4]
l3: $ F , G , H , I ⊢ x = y $ by cb_branch_injective [#1, #2, l1, l2]

-- Assemble the function, injectivity, and surjectivity proofs.

cb_bijection_has_value_from_injections
--------------------------------------
l0c: $ x ∈ cb_core A B f g ⊢ x ∈ cb_core A B f g $ by ax
l0n: $ x ∉ cb_core A B f g ⊢ x ∉ cb_core A B f g $ by ax
l1: $ F ⊢ function f A B $ by injective_function [#1]
l2: $ F ⊢ domain_on f A $ by function_domain_on [l1]
l3: $ F , H ⊢ ∃ a (maps f x a) $
  by domain_on_has_maps [l2, #2]
l4a: $ maps f x a ⊢ maps f x a $ by ax
l4b: $ F , maps f x a ⊢ a ∈ B $ by injective_maps_range [#1, l4a]
l4c: $ x ∈ cb_core A B f g , maps f x a ⊢
       x ∈ cb_core A B f g ∧ maps f x a $ by and_intro [l0c, l4a]
l4d: $ H , F , x ∈ cb_core A B f g , maps f x a ⊢
       maps (cb_bijection A B f g) x a $
  by cb_bijection_f_branch_maps [#2, l4b, l4c]
l4e: $ H , F , x ∈ cb_core A B f g , maps f x a ⊢
       ∃ y (maps (cb_bijection A B f g) x y) $ by ex_intro [l4d]
l4f: $ F , H , x ∈ cb_core A B f g ⊢
       ∃ y (maps (cb_bijection A B f g) x y) $ by ex_elim [l3, l4e]
l5: $ H , x ∉ cb_core A B f g ⊢
      x ∈ image g (B ∖ image f (cb_core A B f g) B) A $
  by cb_core_not_mem_image [#2, l0n]
l6: $ H , x ∉ cb_core A B f g ⊢
      ∃ a (a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x) $
  by image_has_preimage [l5]
l7a: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x $ by ax
l7b0: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
        a ∈ B ∖ image f (cb_core A B f g) B $ by and_elim_l [l7a]
l7b: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
       a ∈ B $ by setdiff_elim_left [l7b0]
l7c: $ a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
       maps g a x $ by and_elim_r [l7a]
l7d: $ x ∉ cb_core A B f g ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ⊢
       x ∉ cb_core A B f g ∧ maps g a x $ by and_intro [l0n, l7c]
l7e: $ H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ,
       x ∉ cb_core A B f g ⊢ maps (cb_bijection A B f g) x a $
  by cb_bijection_g_branch_maps [#2, l7b, l7d]
l7f: $ H ,
       a ∈ B ∖ image f (cb_core A B f g) B ∧ maps g a x ,
       x ∉ cb_core A B f g ⊢
       ∃ y (maps (cb_bijection A B f g) x y) $ by ex_intro [l7e]
l7g: $ H , x ∉ cb_core A B f g ⊢
       ∃ y (maps (cb_bijection A B f g) x y) $ by ex_elim [l6, l7f]
l8: $ emp ⊢ x ∈ cb_core A B f g ∨ x ∉ cb_core A B f g $
  by excluded_middle_nd
l9: $ F , H ⊢
      ∃ y (maps (cb_bijection A B f g) x y) $
  by or_elim [l8, l4f, l7g]

cb_bijection_domain_on_from_injections
--------------------------------------
l0: $ x ∈ A ⊢ x ∈ A $ by ax
l1: $ F , x ∈ A ⊢ ∃ y (maps (cb_bijection A B f g) x y) $
  by cb_bijection_has_value_from_injections [#1, l0]
l2: $ F ⊢ x ∈ A → ∃ y (maps (cb_bijection A B f g) x y) $
  by imp_intro [l1]
l3a: $ maps (cb_bijection A B f g) x y ⊢
       maps (cb_bijection A B f g) x y $ by ax
l3: $ G , maps (cb_bijection A B f g) x y ⊢ x ∈ A $
  by cb_bijection_maps_domain [#2, l3a]
l4a: $ ∃ y (maps (cb_bijection A B f g) x y) ⊢
       ∃ y (maps (cb_bijection A B f g) x y) $ by ax
l4: $ ∃ y (maps (cb_bijection A B f g) x y) , G ⊢ x ∈ A $
  by ex_elim [l4a, l3]
l5: $ G ⊢ (∃ y (maps (cb_bijection A B f g) x y)) → x ∈ A $
  by imp_intro [l4]
l6: $ F , G ⊢
      x ∈ A ↔ ∃ y (maps (cb_bijection A B f g) x y) $
  by bi_intro [l2, l5]
l7: $ F , G ⊢ domain_on (cb_bijection A B f g) A $
  by all_intro [l6]

cb_bijection_functional_from_injections
---------------------------------------
l0: $ maps (cb_bijection A B f g) x y ∧
       maps (cb_bijection A B f g) x z ⊢
       maps (cb_bijection A B f g) x y ∧
       maps (cb_bijection A B f g) x z $ by ax
l1: $ maps (cb_bijection A B f g) x y ∧
      maps (cb_bijection A B f g) x z ⊢
      maps (cb_bijection A B f g) x y $ by and_elim_l [l0]
l2: $ maps (cb_bijection A B f g) x y ∧
      maps (cb_bijection A B f g) x z ⊢
      maps (cb_bijection A B f g) x z $ by and_elim_r [l0]
l3: $ F , G , maps (cb_bijection A B f g) x y ∧
      maps (cb_bijection A B f g) x z ⊢ y = z $
  by cb_bijection_maps_functional [#1, #2, l1, l2]
l4: $ F , G ⊢
      (maps (cb_bijection A B f g) x y ∧
       maps (cb_bijection A B f g) x z) → y = z $ by imp_intro [l3]
l5: $ F , G ⊢ ∀ x ∀ y ∀ z
      ((maps (cb_bijection A B f g) x y ∧
        maps (cb_bijection A B f g) x z) → y = z) $
  by all_intro [all_intro [all_intro [l4]]]

cb_bijection_range_sub_from_injections
--------------------------------------
l0: $ maps (cb_bijection A B f g) x y ⊢
      maps (cb_bijection A B f g) x y $ by ax
l1: $ F , G , maps (cb_bijection A B f g) x y ⊢ y ∈ B $
  by cb_bijection_maps_range [#1, #2, l0]
l2: $ F , G ⊢ maps (cb_bijection A B f g) x y → y ∈ B $
  by imp_intro [l1]
l3: $ F , G ⊢ ∀ y ∀ x (maps (cb_bijection A B f g) x y → y ∈ B) $
  by all_intro [all_intro [l2]]
l4: $ F , G ⊢ range_sub (cb_bijection A B f g) B $
  by range_sub_intro [l3]

cb_bijection_function_from_injections
-------------------------------------
l1: $ F , G ⊢ functional (cb_bijection A B f g) $
  by cb_bijection_functional_from_injections [#1, #2]
l2: $ F , G ⊢ domain_on (cb_bijection A B f g) A $
  by cb_bijection_domain_on_from_injections [#1, #2]
l3: $ F , G ⊢ range_sub (cb_bijection A B f g) B $
  by cb_bijection_range_sub_from_injections [#1, #2]
l4: $ F , G ⊢ function (cb_bijection A B f g) A B $
  by function_intro [l1, l2, l3]

cb_g_setdiff_maps_not_core
--------------------------
l0: $ x ∈ cb_core A B f g ⊢ x ∈ cb_core A B f g $ by ax
l1: $ G , I ⊢ x ∈ A $ by injective_maps_range [#1, #3]
l2: $ G , I , H ⊢ x ∈ image g (B ∖ image f (cb_core A B f g) B) A $
  by image_intro [l1, #2, #3]
l3: $ emp ⊢ cb_core A B f g ⊆ cb_step A B f g (cb_core A B f g) $
  by cb_core_subset_step_core
l4: $ x ∈ cb_core A B f g ⊢
      x ∈ cb_step A B f g (cb_core A B f g) $ by subset_elim [l3, l0]
l5: $ x ∈ cb_core A B f g ⊢
      x ∉ image g (B ∖ image f (cb_core A B f g) B) A $
  by cb_step_elim_right [l4]
l6: $ x ∈ cb_core A B f g , G , I , H ⊢ ⊥ $
  by not_elim [l5, l2]
l7: $ G , I , H ⊢ x ∉ cb_core A B f g $ by not_intro [l6]

cb_bijection_has_preimage_image
-------------------------------
l0: $ x ∈ cb_core A B f g ∧ maps f x y ⊢
      x ∈ cb_core A B f g ∧ maps f x y $ by ax
l1: $ H ⊢ ∃ x (x ∈ cb_core A B f g ∧ maps f x y) $
  by image_has_preimage [#2]
l2: $ x ∈ cb_core A B f g ∧ maps f x y ⊢ x ∈ cb_core A B f g $
  by and_elim_l [l0]
l3: $ x ∈ cb_core A B f g ∧ maps f x y ⊢ maps f x y $
  by and_elim_r [l0]
l4: $ emp ⊢ cb_core A B f g ⊆ A $ by cb_core_subset
l5: $ x ∈ cb_core A B f g ∧ maps f x y ⊢ x ∈ A $
  by subset_elim [l4, l2]
l6: $ F , x ∈ cb_core A B f g ∧ maps f x y ⊢ y ∈ B $
  by injective_maps_range [#1, l3]
l7: $ x ∈ cb_core A B f g ∧ maps f x y , F ⊢
      maps (cb_bijection A B f g) x y $
  by cb_bijection_f_branch_maps [l5, l6, l0]
l8: $ x ∈ cb_core A B f g ∧ maps f x y , F ⊢
      has_preimage (cb_bijection A B f g) A y $
  by has_preimage_intro [l5, l7]
l9: $ H , F ⊢ has_preimage (cb_bijection A B f g) A y $
  by ex_elim [l1, l8]

cb_bijection_has_preimage_setdiff
---------------------------------
l1: $ G ⊢ function g B A $ by injective_function [#1]
l2: $ G ⊢ domain_on g B $ by function_domain_on [l1]
l3: $ H ⊢ y ∈ B $ by setdiff_elim_left [#2]
l4: $ G , H ⊢ ∃ x (maps g y x) $
  by domain_on_has_maps [l2, l3]
l5a: $ maps g y x ⊢ maps g y x $ by ax
l5: $ G , maps g y x ⊢ x ∈ A $ by injective_maps_range [#1, l5a]
l6: $ G , H , maps g y x ⊢ x ∉ cb_core A B f g $
  by cb_g_setdiff_maps_not_core [#1, #2, l5a]
l7: $ G , H , maps g y x ⊢
      x ∉ cb_core A B f g ∧ maps g y x $ by and_intro [l6, l5a]
l8: $ G , maps g y x , H ⊢
      maps (cb_bijection A B f g) x y $
  by cb_bijection_g_branch_maps [l5, l3, l7]
l9: $ G , maps g y x , H ⊢
      has_preimage (cb_bijection A B f g) A y $
  by has_preimage_intro [l5, l8]
l10: $ G , H ⊢ has_preimage (cb_bijection A B f g) A y $
  by ex_elim [l4, l9]

cb_bijection_injective_body
---------------------------
l0: $ ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) ⊢
      ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) $ by ax
l1: $ ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) ⊢
      maps (cb_bijection A B f g) x z ∧
      maps (cb_bijection A B f g) y z $ by and_elim_r [l0]
l2: $ ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) ⊢
      maps (cb_bijection A B f g) x z $ by and_elim_l [l1]
l3: $ ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) ⊢
      maps (cb_bijection A B f g) y z $ by and_elim_r [l1]
l4: $ F , G , ((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) ⊢ x = y $
  by cb_bijection_maps_injective [#1, #2, l2, l3]
l5: $ F , G ⊢ (((x ∈ A ∧ y ∈ A) ∧
       (maps (cb_bijection A B f g) x z ∧
        maps (cb_bijection A B f g) y z)) → x = y) $
  by imp_intro [l4]
l6: $ F , G ⊢ ∀ x ∀ y ∀ z
      (((x ∈ A ∧ y ∈ A) ∧
        (maps (cb_bijection A B f g) x z ∧
         maps (cb_bijection A B f g) y z)) → x = y) $
  by all_intro [all_intro [all_intro [l5]]]

cb_bijection_surj_body
----------------------
l0y: $ y ∈ B ⊢ y ∈ B $ by ax
l0i: $ y ∈ image f (cb_core A B f g) B ⊢
       y ∈ image f (cb_core A B f g) B $ by ax
l0n: $ y ∉ image f (cb_core A B f g) B ⊢
       y ∉ image f (cb_core A B f g) B $ by ax
l1: $ F , y ∈ image f (cb_core A B f g) B ⊢
      has_preimage (cb_bijection A B f g) A y $
  by cb_bijection_has_preimage_image [#1, l0i]
l2: $ y ∈ B , y ∉ image f (cb_core A B f g) B ⊢
      y ∈ B ∖ image f (cb_core A B f g) B $ by setdiff_intro [l0y, l0n]
l3: $ G , y ∈ B , y ∉ image f (cb_core A B f g) B ⊢
      has_preimage (cb_bijection A B f g) A y $
  by cb_bijection_has_preimage_setdiff [#2, l2]
l4: $ emp ⊢ y ∈ image f (cb_core A B f g) B ∨
      y ∉ image f (cb_core A B f g) B $ by excluded_middle_nd
l5: $ F , G , y ∈ B ⊢
      has_preimage (cb_bijection A B f g) A y $
  by or_elim [l4, l1, l3]
l6: $ F , G ⊢
      y ∈ B → has_preimage (cb_bijection A B f g) A y $
  by imp_intro [l5]
l7: $ F , G ⊢ ∀ y
      (y ∈ B → has_preimage (cb_bijection A B f g) A y) $
  by all_intro [l6]

cb_bijection_injective
----------------------
l1: $ F , G ⊢ function (cb_bijection A B f g) A B $
  by cb_bijection_function_from_injections [#1, #2]
l2: $ F , G ⊢ ∀ x ∀ y ∀ z
      (((x ∈ A ∧ y ∈ A) ∧
        (maps (cb_bijection A B f g) x z ∧
         maps (cb_bijection A B f g) y z)) → x = y) $
  by cb_bijection_injective_body [#1, #2]
l3: $ F , G ⊢ injective (cb_bijection A B f g) A B $
  by injective_intro [l1, l2]

cb_bijection_surj
-----------------
l1: $ F , G ⊢ function (cb_bijection A B f g) A B $
  by cb_bijection_function_from_injections [#1, #2]
l2: $ F , G ⊢ ∀ y
      (y ∈ B → has_preimage (cb_bijection A B f g) A y) $
  by cb_bijection_surj_body [#1, #2]
l3: $ F , G ⊢ surj (cb_bijection A B f g) A B $
  by surj_intro [l1, l2]

cantor_bernstein
----------------
l1: $ G , H ⊢ injective (cb_bijection A B f g) A B $
  by cb_bijection_injective [#1, #2]
l2: $ G , H ⊢ surj (cb_bijection A B f g) A B $
  by cb_bijection_surj [#1, #2]
l3: $ G , H ⊢ bijective (cb_bijection A B f g) A B $
  by bijective_intro [l1, l2]

-- König: bounded families, choice, and cardinal comparison.
-- The earlier results remain choice-free.
--
-- Assume an injection F from the product to the tagged sum. At index i,
-- trace the values of those product elements sent to tags of the form
-- ⟨i,a⟩. Injectivity makes this a partial function of a. Since the i-th
-- small fibre is strictly smaller, the trace misses a large-fibre value.
-- Bounded choice assembles these misses into a product element that F
-- cannot send to any tag. Cardinal comparison gives the lower inequality.

fibre_intro
-----------
l1: $ G , H ⊢ a ∈ fibre R U i $ by sep_intro [#1, #2]

fibre_mem
---------
l1: $ G ⊢ a ∈ U $ by sep_elim_left [#1]

fibre_maps
----------
l1: $ G ⊢ maps R i a $ by sep_elim_right [#1]

product_selection
-----------------
l1: $ G ⊢ selection f R I U $ by sep_elim_right [#1]

product_function
----------------
l1: $ G ⊢ selection f R I U $ by product_selection [#1]
l2: $ G ⊢ function f I U $ by and_elim_l [l1]

product_maps
------------
l1: $ G ⊢ selection f R I U $ by product_selection [#1]
l2: $ G ⊢ ∀ x ∀ y (maps f x y → maps R x y) $ by and_elim_r [l1]
l3: $ G ⊢ ∀ y (maps f i y → maps R i y) $ by all_elim [l2]
l4: $ G ⊢ maps f i a → maps R i a $ by all_elim [l3]
l5: $ G , H ⊢ maps R i a $ by imp_elim [l4, #2]

choice_apply
------------
l1: $ G ⊢
      ∀ Y ∀ X ((∀ i (i ∈ I → ∃ a (a ∈ Y ∧ maps X i a))) → ∃ f (f ∈
      indexed_product I Y X)) $
  by all_elim [#1]
l2: $ G ⊢
      ∀ X ((∀ i (i ∈ I → ∃ a (a ∈ U ∧ maps X i a))) → ∃ f (f ∈ indexed_product
      I U X)) $
  by all_elim [l1]
l3: $ G ⊢
      (∀ i (i ∈ I → ∃ a (a ∈ U ∧ maps R i a))) → ∃ f (f ∈ indexed_product I U
      R) $
  by all_elim [l2]
l4: $ G , H ⊢ ∃ f (f ∈ indexed_product I U R) $ by imp_elim [l3, #2]

inverse_intro
-------------
l1: $ G , H ⊢ ⟨ a , b ⟩ ∈ pair_carrier B A $
  by opair_mem_pair_carrier [#1, #2]
l2: $ emp ⊢ ⟨ a , b ⟩ = ⟨ a , b ⟩ $ by eq_intro
l3: $ G , H ⊢ (a ∈ B ∧ b ∈ A) $ by and_intro [#1, #2]
l4: $ G , H , K ⊢ ((a ∈ B ∧ b ∈ A) ∧ maps R b a) $ by and_intro [l3, #3]
l5: $ G , H , K ⊢ (⟨ a , b ⟩ = ⟨ a , b ⟩ ∧ ((a ∈ B ∧ b ∈ A) ∧ maps R b a)) $
  by and_intro [l2, l4]
l6: $ G , H , K ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ a , y ⟩ ∧ ((a ∈ B ∧ y ∈ A) ∧ maps R y a))) $
  by ex_intro [l5]
l7: $ G , H , K ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)))) $
  by ex_intro [l6]
l8: $ G , H , K ⊢
      ⟨ a , b ⟩ ∈ {w ∈ pair_carrier B A | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y
      ∈ A) ∧ maps R y x))} $
  by sep_intro [l1, l7]

inverse_elim
------------
l1: $ G ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)))) $
  by sep_elim_right [#1]
l2: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x))) ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x))) $
  by ax
l3: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢
      (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) $
  by ax
l4: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢
      ⟨ a , b ⟩ = ⟨ x , y ⟩ $
  by and_elim_l [l3]
l5: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢
      ((x ∈ B ∧ y ∈ A) ∧ maps R y x) $
  by and_elim_r [l3]
l6: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢ a = x $
  by opair_eq_left [l4]
l7: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢ x = a $
  by set_sym [l6]
l8: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢ b = y $
  by opair_eq_right [l4]
l9: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢ y = b $
  by set_sym [l8]
l10: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢
      ((a ∈ B ∧ y ∈ A) ∧ maps R y a) $
  by eq_replace [l7, l5]
l11: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x)) ⊢
      ((a ∈ B ∧ b ∈ A) ∧ maps R b a) $
  by eq_replace [l9, l10]
l12: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ B ∧ y ∈ A) ∧ maps R y x))) ⊢
      ((a ∈ B ∧ b ∈ A) ∧ maps R b a) $
  by ex_elim [l2, l11]
l13: $ G ⊢ ((a ∈ B ∧ b ∈ A) ∧ maps R b a) $ by ex_elim [l1, l12]

-- Choice turns a functional covering relation into a reverse injection.

inverse_selection_injective
---------------------------
l1: $ H ⊢ function f B A $ by product_function [#2]
l2: $ ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) $
  by ax
l3: $ ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      (maps f x z ∧ maps f y z) $
  by and_elim_r [l2]
l4: $ ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢ maps f x z $
  by and_elim_l [l3]
l5: $ ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢ maps f y z $
  by and_elim_r [l3]
l6: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      maps (inverse R A B) x z $
  by product_maps [#2, l4]
l7: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      maps (inverse R A B) y z $
  by product_maps [#2, l5]
l8: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      ((x ∈ B ∧ z ∈ A) ∧ maps R z x) $
  by inverse_elim [l6]
l9: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢
      ((y ∈ B ∧ z ∈ A) ∧ maps R z y) $
  by inverse_elim [l7]
l10: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢ maps R z x $
  by and_elim_r [l8]
l11: $ H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢ maps R z y $
  by and_elim_r [l9]
l12: $ G , H , ((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) ⊢ x = y $
  by functional_elim [#1, l10, l11]
l13: $ G , H ⊢ (((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) → x = y) $
  by imp_intro [l12]
l14: $ G , H ⊢ ∀ z ((((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) → x = y)) $
  by all_intro [l13]
l15: $ G , H ⊢
      ∀ y (∀ z ((((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) → x = y))) $
  by all_intro [l14]
l16: $ G , H ⊢
      ∀ x (∀ y (∀ z ((((x ∈ B ∧ y ∈ B) ∧ (maps f x z ∧ maps f y z)) → x =
      y)))) $
  by all_intro [l15]
l17: $ H , G ⊢ injective f B A $ by injective_intro [l1, l16]

choice_cover_injection
----------------------
l1: $ b ∈ B ⊢ b ∈ B $ by ax
l2: $ K ⊢ b ∈ B → has_preimage R A b $ by all_elim [#3]
l3: $ K , b ∈ B ⊢ has_preimage R A b $ by imp_elim [l2, l1]
l4: $ (a ∈ A ∧ maps R a b) ⊢ (a ∈ A ∧ maps R a b) $ by ax
l5: $ (a ∈ A ∧ maps R a b) ⊢ a ∈ A $ by and_elim_l [l4]
l6: $ (a ∈ A ∧ maps R a b) ⊢ maps R a b $ by and_elim_r [l4]
l7: $ b ∈ B , (a ∈ A ∧ maps R a b) ⊢ maps (inverse R A B) b a $
  by inverse_intro [l1, l5, l6]
l8: $ (a ∈ A ∧ maps R a b) , b ∈ B ⊢ (a ∈ A ∧ maps (inverse R A B) b a) $
  by and_intro [l5, l7]
l9: $ (a ∈ A ∧ maps R a b) , b ∈ B ⊢
      ∃ v ((v ∈ A ∧ maps (inverse R A B) b v)) $
  by ex_intro [l8]
l10: $ K , b ∈ B ⊢ ∃ v ((v ∈ A ∧ maps (inverse R A B) b v)) $
  by ex_elim [l3, l9]
l11: $ K ⊢ (b ∈ B → ∃ v ((v ∈ A ∧ maps (inverse R A B) b v))) $
  by imp_intro [l10]
l12: $ K ⊢ ∀ b ((b ∈ B → ∃ v ((v ∈ A ∧ maps (inverse R A B) b v)))) $
  by all_intro [l11]
l13: $ G , K ⊢ ∃ f (f ∈ indexed_product B A (inverse R A B)) $
  by choice_apply [#1, l12]
l14: $ f ∈ indexed_product B A (inverse R A B) ⊢
      f ∈ indexed_product B A (inverse R A B) $
  by ax
l15: $ H , f ∈ indexed_product B A (inverse R A B) ⊢ injective f B A $
  by inverse_selection_injective [#2, l14]
l16: $ H , f ∈ indexed_product B A (inverse R A B) ⊢ ∃ v (injective v B A) $
  by ex_intro [l15]
l17: $ G , K , H ⊢ ∃ v (injective v B A) $ by ex_elim [l13, l16]

-- A small partial function misses a value in the larger set.

not_all_preimage_exists_miss
----------------------------
l1: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢
      ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) $
  by ax
l2: $ y ∈ B ⊢ y ∈ B $ by ax
l3: $ ¬ (has_preimage R A y) ⊢ ¬ (has_preimage R A y) $ by ax
l4: $ y ∈ B , ¬ (has_preimage R A y) ⊢ (y ∈ B ∧ ¬ (has_preimage R A y)) $
  by and_intro [l2, l3]
l5: $ y ∈ B , ¬ (has_preimage R A y) ⊢ ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) $
  by ex_intro [l4]
l6: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) , y ∈ B , ¬ (has_preimage R A
      y) ⊢
      ⊥ $
  by not_elim [l1, l5]
l7: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) , y ∈ B , ¬ (has_preimage R A
      y) ⊢
      has_preimage R A y $
  by bot_elim [l6]
l8: $ has_preimage R A y ⊢ has_preimage R A y $ by ax
l9: $ emp ⊢ has_preimage R A y ∨ ¬ (has_preimage R A y) $
  by excluded_middle_nd
l10: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) , y ∈ B ⊢ has_preimage R A y $
  by or_elim [l9, l8, l7]
l11: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢
      (y ∈ B → has_preimage R A y) $
  by imp_intro [l10]
l12: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢
      ∀ y ((y ∈ B → has_preimage R A y)) $
  by all_intro [l11]
l13: $ ∀ y ((y ∈ B → has_preimage R A y)) ↔ ∀ x (x ∈ B → has_preimage R A x) $
  by all_alpha
l14: $ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢
      ∀ x (x ∈ B → has_preimage R A x) $
  by mpbi [nd_congr [ctx_refl [], l13], l12]
l15: $ G , ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢ ⊥ $
  by not_elim [#1, l14]
l16: $ G , ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R A x))) ⊢
      ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) $
  by bot_elim [l15]
l17: $ ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) ⊢
      ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) $
  by ax
l18: $ emp ⊢
      ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) ∨ ¬ (∃ x (x ∈ B ∧ ¬ (has_preimage R
      A x))) $
  by excluded_middle_nd
l19: $ G ⊢ ∃ x (x ∈ B ∧ ¬ (has_preimage R A x)) $ by or_elim [l18, l17, l16]

partial_function_misses
-----------------------
l1: $ ∀ b (b ∈ B → has_preimage R A b) ⊢ ∀ b (b ∈ B → has_preimage R A b) $
  by ax
l2: $ G , H , ∀ b (b ∈ B → has_preimage R A b) ⊢ card_le B A $
  by choice_cover_injection [#1, #2, l1]
l3: $ K , G , H , ∀ b (b ∈ B → has_preimage R A b) ⊢ ⊥ $ by not_elim [#3, l2]
l4: $ K , G , H ⊢ ¬ (∀ b (b ∈ B → has_preimage R A b)) $ by not_intro [l3]
l5: $ K , G , H ⊢ ∃ b (b ∈ B ∧ ¬ (has_preimage R A b)) $
  by not_all_preimage_exists_miss [l4]

product_graph_subset
--------------------
l1: $ G ⊢ f ∈ 𝒫 (cartesian_product I U) $ by sep_elim_left [#1]
l2: $ G ⊢ f ⊆ cartesian_product I U $ by power_elim [l1]

product_member_cases
--------------------
l1: $ G ⊢ f ⊆ cartesian_product I U $ by product_graph_subset [#1]
l2: $ G , H ⊢ p ∈ cartesian_product I U $ by subset_elim [l1, #2]
l3: $ G , H ⊢ ∃ i ∃ a (p = ⟨ i , a ⟩ ∧ (i ∈ I ∧ a ∈ U)) $
  by sep_elim_right [l2]

-- General surjection and cardinal-order rules.

surj_function
-------------
l1: $ G ⊢ function f A B $ by and_elim_l [#1]

surj_covers
-----------
l1: $ G ⊢ ∀ b (b ∈ B → has_preimage f A b) $ by and_elim_r [#1]

surj_reverse_card_le
--------------------
l1: $ H ⊢ function f A B $ by surj_function [#2]
l2: $ H ⊢ functional f $ by function_functional [l1]
l3: $ H ⊢ ∀ b (b ∈ B → has_preimage f A b) $ by surj_covers [#2]
l4: $ G , H ⊢ card_le B A $ by choice_cover_injection [#1, l2, l3]

not_reverse_no_surj
-------------------
l1: $ surj f A B ⊢ surj f A B $ by ax
l2: $ G , surj f A B ⊢ card_le B A $ by surj_reverse_card_le [#1, l1]
l3: $ H , G , surj f A B ⊢ ⊥ $ by not_elim [#2, l2]
l4: $ H , G ⊢ ¬ (surj f A B) $ by not_intro [l3]

cardinal_comparison_elim
------------------------
l1: $ G ⊢ ∀ Y (card_le A Y ∨ card_le Y A) $ by all_elim [#1]
l2: $ G ⊢ card_le A B ∨ card_le B A $ by all_elim [l1]

card_lt_from_comparison
-----------------------
l1: $ card_le A B ⊢ card_le A B $ by ax
l2: $ card_le B A ⊢ card_le B A $ by ax
l3: $ G , card_le B A ⊢ ⊥ $ by not_elim [#1, l2]
l4: $ G , card_le B A ⊢ card_le A B $ by bot_elim [l3]
l5: $ H , G ⊢ card_le A B $ by or_elim [#2, l1, l4]
l6: $ H , G ⊢ (card_le A B ∧ ¬ (card_le B A)) $ by and_intro [l5, #1]

-- Tagged sums and the coordinate trace of a reverse injection.

indexed_sum_intro
-----------------
l1: $ G , H ⊢ ⟨ a , b ⟩ ∈ pair_carrier I U $
  by opair_mem_pair_carrier [#1, #2]
l2: $ emp ⊢ ⟨ a , b ⟩ = ⟨ a , b ⟩ $ by eq_intro
l3: $ G , H ⊢ (a ∈ I ∧ b ∈ U) $ by and_intro [#1, #2]
l4: $ G , H , K ⊢ ((a ∈ I ∧ b ∈ U) ∧ maps R a b) $ by and_intro [l3, #3]
l5: $ G , H , K ⊢ (⟨ a , b ⟩ = ⟨ a , b ⟩ ∧ ((a ∈ I ∧ b ∈ U) ∧ maps R a b)) $
  by and_intro [l2, l4]
l6: $ G , H , K ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ a , y ⟩ ∧ ((a ∈ I ∧ y ∈ U) ∧ maps R a y))) $
  by ex_intro [l5]
l7: $ G , H , K ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)))) $
  by ex_intro [l6]
l8: $ G , H , K ⊢
      ⟨ a , b ⟩ ∈ {w ∈ pair_carrier I U | ∃ x (∃ y ((w = ⟨ x , y ⟩ ∧ ((x ∈ I ∧
      y ∈ U) ∧ maps R x y))))} $
  by sep_intro [l1, l7]

indexed_sum_elim
----------------
l1: $ G ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)))) $
  by sep_elim_right [#1]
l2: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y))) ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y))) $
  by ax
l3: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢
      (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) $
  by ax
l4: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢
      ⟨ a , b ⟩ = ⟨ x , y ⟩ $
  by and_elim_l [l3]
l5: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢
      ((x ∈ I ∧ y ∈ U) ∧ maps R x y) $
  by and_elim_r [l3]
l6: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢ a = x $
  by opair_eq_left [l4]
l7: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢ x = a $
  by set_sym [l6]
l8: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢ b = y $
  by opair_eq_right [l4]
l9: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢ y = b $
  by set_sym [l8]
l10: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢
      ((a ∈ I ∧ y ∈ U) ∧ maps R a y) $
  by eq_replace [l7, l5]
l11: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y)) ⊢
      ((a ∈ I ∧ b ∈ U) ∧ maps R a b) $
  by eq_replace [l9, l10]
l12: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ U) ∧ maps R x y))) ⊢
      ((a ∈ I ∧ b ∈ U) ∧ maps R a b) $
  by ex_elim [l2, l11]
l13: $ G ⊢ ((a ∈ I ∧ b ∈ U) ∧ maps R a b) $ by ex_elim [l1, l12]

koenig_trace_intro
------------------
l1: $ G , H ⊢ ⟨ a , b ⟩ ∈ pair_carrier U V $
  by opair_mem_pair_carrier [#1, #2]
l2: $ emp ⊢ ⟨ a , b ⟩ = ⟨ a , b ⟩ $ by eq_intro
l3: $ G , H ⊢ (a ∈ U ∧ b ∈ V) $ by and_intro [#1, #2]
l4: $ G , H , K ⊢
      ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))) $
  by and_intro [l3, #3]
l5: $ G , H , K ⊢
      (⟨ a , b ⟩ = ⟨ a , b ⟩ ∧ ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , a ⟩ ∧ maps f i b))))) $
  by and_intro [l2, l4]
l6: $ G , H , K ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ a , y ⟩ ∧ ((a ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f
      ⟨ i , a ⟩ ∧ maps f i y)))))) $
  by ex_intro [l5]
l7: $ G , H , K ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧
      (maps F f ⟨ i , x ⟩ ∧ maps f i y))))))) $
  by ex_intro [l6]
l8: $ G , H , K ⊢
      ⟨ a , b ⟩ ∈ {w ∈ pair_carrier U V | ∃ x (∃ y ((w = ⟨ x , y ⟩ ∧ ((x ∈ U ∧
      y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , x ⟩ ∧ maps f i y)))))))} $
  by sep_intro [l1, l7]

koenig_trace_elim
-----------------
l1: $ G ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧
      (maps F f ⟨ i , x ⟩ ∧ maps f i y))))))) $
  by sep_elim_right [#1]
l2: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f
      ⟨ i , x ⟩ ∧ maps f i y)))))) ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f
      ⟨ i , x ⟩ ∧ maps f i y)))))) $
  by ax
l3: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) $
  by ax
l4: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      ⟨ a , b ⟩ = ⟨ x , y ⟩ $
  by and_elim_l [l3]
l5: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , x ⟩ ∧ maps f i y)))) $
  by and_elim_r [l3]
l6: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      a = x $
  by opair_eq_left [l4]
l7: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      x = a $
  by set_sym [l6]
l8: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      b = y $
  by opair_eq_right [l4]
l9: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      y = b $
  by set_sym [l8]
l10: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      ((a ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i y)))) $
  by eq_replace [l7, l5]
l11: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i
      , x ⟩ ∧ maps f i y))))) ⊢
      ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))) $
  by eq_replace [l9, l10]
l12: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ U ∧ y ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F
      f ⟨ i , x ⟩ ∧ maps f i y)))))) ⊢
      ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))) $
  by ex_elim [l2, l11]
l13: $ G ⊢
      ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))) $
  by ex_elim [l1, l12]

koenig_omissions_intro
----------------------
l1: $ G , H ⊢ ⟨ a , b ⟩ ∈ pair_carrier I V $
  by opair_mem_pair_carrier [#1, #2]
l2: $ emp ⊢ ⟨ a , b ⟩ = ⟨ a , b ⟩ $ by eq_intro
l3: $ G , H ⊢ (a ∈ I ∧ b ∈ V) $ by and_intro [#1, #2]
l4: $ G , H , K ⊢
      ((a ∈ I ∧ b ∈ V) ∧ (maps T a b ∧ ¬ (has_preimage (koenig_trace F P U V
      a) (fibre R U a) b))) $
  by and_intro [l3, #3]
l5: $ G , H , K ⊢
      (⟨ a , b ⟩ = ⟨ a , b ⟩ ∧ ((a ∈ I ∧ b ∈ V) ∧ (maps T a b ∧ ¬
      (has_preimage (koenig_trace F P U V a) (fibre R U a) b)))) $
  by and_intro [l2, l4]
l6: $ G , H , K ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ a , y ⟩ ∧ ((a ∈ I ∧ y ∈ V) ∧ (maps T a y ∧ ¬
      (has_preimage (koenig_trace F P U V a) (fibre R U a) y))))) $
  by ex_intro [l5]
l7: $ G , H , K ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))))) $
  by ex_intro [l6]
l8: $ G , H , K ⊢
      ⟨ a , b ⟩ ∈ {w ∈ pair_carrier I V | ∃ x (∃ y ((w = ⟨ x , y ⟩ ∧ ((x ∈ I ∧
      y ∈ V) ∧ (maps T x y ∧ ¬ (has_preimage (koenig_trace F P U V x) (fibre R
      U x) y))))))} $
  by sep_intro [l1, l7]

koenig_omissions_elim
---------------------
l1: $ G ⊢
      ∃ x (∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))))) $
  by sep_elim_right [#1]
l2: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y))))) ⊢
      ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y))))) $
  by ax
l3: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) $
  by ax
l4: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      ⟨ a , b ⟩ = ⟨ x , y ⟩ $
  by and_elim_l [l3]
l5: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬ (has_preimage (koenig_trace F P U V
      x) (fibre R U x) y))) $
  by and_elim_r [l3]
l6: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      a = x $
  by opair_eq_left [l4]
l7: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      x = a $
  by set_sym [l6]
l8: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      b = y $
  by opair_eq_right [l4]
l9: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      y = b $
  by set_sym [l8]
l10: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      ((a ∈ I ∧ y ∈ V) ∧ (maps T a y ∧ ¬ (has_preimage (koenig_trace F P U V
      a) (fibre R U a) y))) $
  by eq_replace [l7, l5]
l11: $ (⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y)))) ⊢
      ((a ∈ I ∧ b ∈ V) ∧ (maps T a b ∧ ¬ (has_preimage (koenig_trace F P U V
      a) (fibre R U a) b))) $
  by eq_replace [l9, l10]
l12: $ ∃ y ((⟨ a , b ⟩ = ⟨ x , y ⟩ ∧ ((x ∈ I ∧ y ∈ V) ∧ (maps T x y ∧ ¬
      (has_preimage (koenig_trace F P U V x) (fibre R U x) y))))) ⊢
      ((a ∈ I ∧ b ∈ V) ∧ (maps T a b ∧ ¬ (has_preimage (koenig_trace F P U V
      a) (fibre R U a) b))) $
  by ex_elim [l2, l11]
l13: $ G ⊢
      ((a ∈ I ∧ b ∈ V) ∧ (maps T a b ∧ ¬ (has_preimage (koenig_trace F P U V
      a) (fibre R U a) b))) $
  by ex_elim [l1, l12]

indexed_sum_cases
-----------------
l1: $ G ⊢ ∃ i ∃ a (q = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) $
  by sep_elim_right [#1]

koenig_trace_witness
--------------------
l1: $ G ⊢
      ((a ∈ U ∧ b ∈ V) ∧ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))) $
  by koenig_trace_elim [#1]
l2: $ G ⊢ ∃ f ((f ∈ P ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b))) $
  by and_elim_r [l1]

koenig_trace_unique
-------------------
l1: $ H ⊢
      ∃ f ((f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))
      $
  by koenig_trace_witness [#2]
l2: $ K ⊢
      ∃ g ((g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)))
      $
  by koenig_trace_witness [#3]
l3: $ (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) $
  by ax
l4: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) $
  by ax
l5: $ (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      f ∈ (indexed_product I V T) $
  by and_elim_l [l3]
l6: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      g ∈ (indexed_product I V T) $
  by and_elim_l [l4]
l7: $ (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      (maps F f ⟨ i , a ⟩ ∧ maps f i b) $
  by and_elim_r [l3]
l8: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      (maps F g ⟨ i , a ⟩ ∧ maps g i c) $
  by and_elim_r [l4]
l9: $ (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      maps F f ⟨ i , a ⟩ $
  by and_elim_l [l7]
l10: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      maps F g ⟨ i , a ⟩ $
  by and_elim_l [l8]
l11: $ (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      maps f i b $
  by and_elim_r [l7]
l12: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      maps g i c $
  by and_elim_r [l8]
l13: $ G , (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ,
      (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      f = g $
  by injective_elim_auto [#1, l9, l10]
l14: $ G , (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ,
      (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      maps g i b $
  by eq_replace [l13, l11]
l15: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) ⊢
      function g I V $
  by product_function [l6]
l16: $ (g ∈ (indexed_product I V T) ∧ (maps F g ⟨ i , a ⟩ ∧ maps g i c)) , G ,
      (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)) ⊢
      b = c $
  by function_unique [l15, l14, l12]
l17: $ K , G , (f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i
      b)) ⊢
      b = c $
  by ex_elim [l2, l16]
l18: $ H , K , G ⊢ b = c $ by ex_elim [l1, l17]

koenig_trace_functional
-----------------------
l1: $ (maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) ⊢
      (maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) $
  by ax
l2: $ (maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) ⊢
      maps (koenig_trace F (indexed_product I V T) U V i) a b $
  by and_elim_l [l1]
l3: $ (maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) ⊢
      maps (koenig_trace F (indexed_product I V T) U V i) a c $
  by and_elim_r [l1]
l4: $ G , (maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) ⊢
      b = c $
  by koenig_trace_unique [#1, l2, l3]
l5: $ G ⊢
      ((maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) → b = c) $
  by imp_intro [l4]
l6: $ G ⊢
      ∀ c (((maps (koenig_trace F (indexed_product I V T) U V i) a b ∧ maps
      (koenig_trace F (indexed_product I V T) U V i) a c) → b = c)) $
  by all_intro [l5]
l7: $ G ⊢
      ∀ b (∀ c (((maps (koenig_trace F (indexed_product I V T) U V i) a b ∧
      maps (koenig_trace F (indexed_product I V T) U V i) a c) → b = c))) $
  by all_intro [l6]
l8: $ G ⊢
      ∀ a (∀ b (∀ c (((maps (koenig_trace F (indexed_product I V T) U V i) a b
      ∧ maps (koenig_trace F (indexed_product I V T) U V i) a c) → b = c)))) $
  by all_intro [l7]

-- Choose a missed value at every coordinate.

koenig_coordinate_miss
----------------------
l1: $ H ⊢ functional (koenig_trace F (indexed_product I V T) U V i) $
  by koenig_trace_functional [#2]
l2: $ K ⊢ ¬ (card_le (fibre T V i) (fibre R U i)) $ by and_elim_r [#3]
l3: $ G , H , K ⊢
      ∃ a ((a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F
      (indexed_product I V T) U V i) (fibre R U i) a))) $
  by partial_function_misses [#1, l1, l2]
l4: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) $
  by ax
l5: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      a ∈ (fibre T V i) $
  by and_elim_l [l4]
l6: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      ¬ (has_preimage (koenig_trace F (indexed_product I V T) U V i) (fibre R
      U i) a) $
  by and_elim_r [l4]
l7: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      a ∈ V $
  by fibre_mem [l5]
l8: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      maps T i a $
  by fibre_maps [l5]
l9: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) ⊢
      (maps T i a ∧ ¬ (has_preimage (koenig_trace F (indexed_product I V T) U
      V i) (fibre R U i) a)) $
  by and_intro [l8, l6]
l10: $ L , (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F
      (indexed_product I V T) U V i) (fibre R U i) a)) ⊢
      maps (koenig_omissions F (indexed_product I V T) I U V R T) i a $
  by koenig_omissions_intro [#4, l7, l9]
l11: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) , L ⊢
      (a ∈ V ∧ maps (koenig_omissions F (indexed_product I V T) I U V R T) i
      a) $
  by and_intro [l7, l10]
l12: $ (a ∈ (fibre T V i) ∧ ¬ (has_preimage (koenig_trace F (indexed_product I
      V T) U V i) (fibre R U i) a)) , L ⊢
      ∃ b ((b ∈ V ∧ maps (koenig_omissions F (indexed_product I V T) I U V R
      T) i b)) $
  by ex_intro [l11]
l13: $ G , H , K , L ⊢
      ∃ b ((b ∈ V ∧ maps (koenig_omissions F (indexed_product I V T) I U V R
      T) i b)) $
  by ex_elim [l3, l12]

koenig_omission_selected
------------------------
l1: $ G , H ⊢ maps (koenig_omissions F P I U V R T) i a $
  by product_maps [#1, #2]
l2: $ G , H ⊢
      ((i ∈ I ∧ a ∈ V) ∧ (maps T i a ∧ ¬ (has_preimage (koenig_trace F P U V
      i) (fibre R U i) a))) $
  by koenig_omissions_elim [l1]
l3: $ G , H ⊢
      (maps T i a ∧ ¬ (has_preimage (koenig_trace F P U V i) (fibre R U i) a))
      $
  by and_elim_r [l2]

koenig_omission_product
-----------------------
l1: $ G ⊢ f ∈ 𝒫 (cartesian_product I V) $ by sep_elim_left [#1]
l2: $ G ⊢ function f I V $ by product_function [#1]
l3: $ maps f i a ⊢ maps f i a $ by ax
l4: $ G , maps f i a ⊢
      (maps T i a ∧ ¬ (has_preimage (koenig_trace F P U V i) (fibre R U i) a))
      $
  by koenig_omission_selected [#1, l3]
l5: $ G , maps f i a ⊢ maps T i a $ by and_elim_l [l4]
l6: $ G ⊢ (maps f i a → maps T i a) $ by imp_intro [l5]
l7: $ G ⊢ ∀ a ((maps f i a → maps T i a)) $ by all_intro [l6]
l8: $ G ⊢ ∀ i (∀ a ((maps f i a → maps T i a))) $ by all_intro [l7]
l9: $ G ⊢ selection f T I V $ by and_intro [l2, l8]
l10: $ G ⊢ f ∈ indexed_product I V T $ by sep_intro [l1, l9]

koenig_diagonal_exists
----------------------
l1: $ i ∈ I ⊢ i ∈ I $ by ax
l2: $ K ⊢ i ∈ I → card_lt (fibre R U i) (fibre T V i) $ by all_elim [#3]
l3: $ K , i ∈ I ⊢ card_lt (fibre R U i) (fibre T V i) $ by imp_elim [l2, l1]
l4: $ G , H , K , i ∈ I ⊢
      ∃ a ((a ∈ V ∧ maps (koenig_omissions F (indexed_product I V T) I U V R
      T) i a)) $
  by koenig_coordinate_miss [#1, #2, l3, l1]
l5: $ G , H , K ⊢
      (i ∈ I → ∃ a ((a ∈ V ∧ maps (koenig_omissions F (indexed_product I V T)
      I U V R T) i a))) $
  by imp_intro [l4]
l6: $ G , H , K ⊢
      ∀ i ((i ∈ I → ∃ a ((a ∈ V ∧ maps (koenig_omissions F (indexed_product I
      V T) I U V R T) i a)))) $
  by all_intro [l5]
l7: $ G , H , K ⊢
      ∃ f (f ∈ indexed_product I V (koenig_omissions F (indexed_product I V T)
      I U V R T)) $
  by choice_apply [#1, l6]

-- The diagonal cannot be assigned any tag in the sum.

koenig_tag_absurd
-----------------
l1: $ G ⊢ d ∈ (indexed_product I V T) $ by koenig_omission_product [#1]
l2: $ G ⊢ function d I V $ by product_function [l1]
l3: $ G ⊢ domain_on d I $ by function_domain_on [l2]
l4: $ G , H ⊢ ∃ b (maps d i b) $ by domain_on_has_maps [l3, #2]
l5: $ maps d i b ⊢ maps d i b $ by ax
l6: $ G , maps d i b ⊢ b ∈ V $ by function_maps_range [l2, l5]
l7: $ J ⊢ a ∈ U $ by fibre_mem [#3]
l8: $ K , maps d i b ⊢ (maps F d ⟨ i , a ⟩ ∧ maps d i b) $
  by and_intro [#4, l5]
l9: $ G , K , maps d i b ⊢
      (d ∈ (indexed_product I V T) ∧ (maps F d ⟨ i , a ⟩ ∧ maps d i b)) $
  by and_intro [l1, l8]
l10: $ G , K , maps d i b ⊢
      ∃ f ((f ∈ (indexed_product I V T) ∧ (maps F f ⟨ i , a ⟩ ∧ maps f i b)))
      $
  by ex_intro [l9]
l11: $ J , G , maps d i b , K ⊢
      maps (koenig_trace F (indexed_product I V T) U V i) a b $
  by koenig_trace_intro [l7, l6, l10]
l12: $ J , G , maps d i b , K ⊢
      has_preimage (koenig_trace F (indexed_product I V T) U V i) (fibre R U
      i) b $
  by has_preimage_intro [#3, l11]
l13: $ G , maps d i b ⊢
      (maps T i b ∧ ¬ (has_preimage (koenig_trace F (indexed_product I V T) U
      V i) (fibre R U i) b)) $
  by koenig_omission_selected [#1, l5]
l14: $ G , maps d i b ⊢
      ¬ (has_preimage (koenig_trace F (indexed_product I V T) U V i) (fibre R
      U i) b) $
  by and_elim_r [l13]
l15: $ G , maps d i b , J , K ⊢ ⊥ $ by not_elim [l14, l12]
l16: $ G , H , J , K ⊢ ⊥ $ by ex_elim [l4, l15]

koenig_reverse_injection_absurd
-------------------------------
l1: $ G , K , H ⊢
      ∃ d (d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T)
      I U V R T)) $
  by koenig_diagonal_exists [#1, #3, #2]
l2: $ d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T) I U
      V R T) ⊢
      d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T) I U
      V R T) $
  by ax
l3: $ d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T) I U
      V R T) ⊢
      d ∈ (indexed_product I V T) $
  by koenig_omission_product [l2]
l4: $ K ⊢ function F (indexed_product I V T) (indexed_sum I U R) $
  by injective_function [#3]
l5: $ K ⊢ domain_on F (indexed_product I V T) $ by function_domain_on [l4]
l6: $ K , d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T)
      I U V R T) ⊢
      ∃ c (maps F d c) $
  by domain_on_has_maps [l5, l3]
l7: $ maps F d c ⊢ maps F d c $ by ax
l8: $ K , maps F d c ⊢ c ∈ (indexed_sum I U R) $
  by injective_maps_range [#3, l7]
l9: $ K , maps F d c ⊢
      ∃ i (∃ a ((c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)))) $
  by indexed_sum_cases [l8]
l10: $ ∃ a ((c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a))) ⊢
      ∃ a ((c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a))) $
  by ax
l11: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢
      (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) $
  by ax
l12: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ c = ⟨ i , a ⟩ $
  by and_elim_l [l11]
l13: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢
      ((i ∈ I ∧ a ∈ U) ∧ maps R i a) $
  by and_elim_r [l11]
l14: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ (i ∈ I ∧ a ∈ U) $
  by and_elim_l [l13]
l15: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ i ∈ I $
  by and_elim_l [l14]
l16: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ a ∈ U $
  by and_elim_r [l14]
l17: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ maps R i a $
  by and_elim_r [l13]
l18: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) ⊢ a ∈ fibre R U i $
  by fibre_intro [l16, l17]
l19: $ (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) , maps F d c ⊢
      maps F d ⟨ i , a ⟩ $
  by eq_replace [l12, l7]
l20: $ d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T) I U
      V R T) , (c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a)) , maps F d c ⊢
      ⊥ $
  by koenig_tag_absurd [l2, l15, l18, l19]
l21: $ ∃ a ((c = ⟨ i , a ⟩ ∧ ((i ∈ I ∧ a ∈ U) ∧ maps R i a))) , d ∈
      indexed_product I V (koenig_omissions F (indexed_product I V T) I U V R
      T) , maps F d c ⊢
      ⊥ $
  by ex_elim [l10, l20]
l22: $ K , maps F d c , d ∈ indexed_product I V (koenig_omissions F
      (indexed_product I V T) I U V R T) ⊢
      ⊥ $
  by ex_elim [l9, l21]
l23: $ K , d ∈ indexed_product I V (koenig_omissions F (indexed_product I V T)
      I U V R T) ⊢
      ⊥ $
  by ex_elim [l6, l22]
l24: $ G , K , H ⊢ ⊥ $ by ex_elim [l1, l23]

koenig_no_reverse_injection
---------------------------
l1: $ card_le (indexed_product I V T) (indexed_sum I U R) ⊢
      card_le (indexed_product I V T) (indexed_sum I U R) $
  by ax
l2: $ injective f (indexed_product I V T) (indexed_sum I U R) ⊢
      injective f (indexed_product I V T) (indexed_sum I U R) $
  by ax
l3: $ G , H , injective f (indexed_product I V T) (indexed_sum I U R) ⊢ ⊥ $
  by koenig_reverse_injection_absurd [#1, #2, l2]
l4: $ card_le (indexed_product I V T) (indexed_sum I U R) , G , H ⊢ ⊥ $
  by ex_elim [l1, l3]
l5: $ G , H ⊢ ¬ (card_le (indexed_product I V T) (indexed_sum I U R)) $
  by not_intro [l4]

-- König: the diagonal obstruction and the full strict inequality.

koenig_no_surjection
--------------------
l1: $ G , H ⊢ ¬ (card_le (indexed_product I V T) (indexed_sum I U R)) $
  by koenig_no_reverse_injection [#1, #2]
l2: $ G , H ⊢ ¬ (surj F (indexed_sum I U R) (indexed_product I V T)) $
  by not_reverse_no_surj [#1, l1]

koenig
------
l1: $ G , K ⊢ ¬ (card_le (indexed_product I V T) (indexed_sum I U R)) $
  by koenig_no_reverse_injection [#1, #3]
l2: $ H ⊢
      card_le (indexed_sum I U R) (indexed_product I V T) ∨ card_le
      (indexed_product I V T) (indexed_sum I U R) $
  by cardinal_comparison_elim [#2]
l3: $ G , K , H ⊢ card_lt (indexed_sum I U R) (indexed_product I V T) $
  by card_lt_from_comparison [l1, l2]

-- The empty index set is allowed: the fibrewise hypothesis is vacuous.

koenig_empty_index
------------------
l1: $ i ∈ ∅ ⊢ i ∈ ∅ $ by ax
l2: $ i ∈ ∅ ⊢ ⊥ $ by empty_elim [l1]
l3: $ i ∈ ∅ ⊢ card_lt (fibre R U i) (fibre T V i) $ by bot_elim [l2]
l4: $ emp ⊢ (i ∈ ∅ → card_lt (fibre R U i) (fibre T V i)) $ by imp_intro [l3]
l5: $ emp ⊢ ∀ i ((i ∈ ∅ → card_lt (fibre R U i) (fibre T V i))) $
  by all_intro [l4]
l6: $ G , H ⊢ card_lt (indexed_sum ∅ U R) (indexed_product ∅ V T) $
  by koenig [#1, #2, l5]
