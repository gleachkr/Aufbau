delimiter $ ( ) $;
provable sort wff;
sort ctx;

term and (a b: wff): wff; infixr and: $/\$ prec 30;
term not (a: wff): wff; prefix not: $~$ prec 35;
term bot: wff;

term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx; infixl join: $,$ prec 5;
term hyp (a: wff): ctx; coercion hyp: wff > ctx;
term nd (g: ctx) (a: wff): wff; infixl nd: $|-$ prec 0;
term ctx_eq (g h: ctx): wff;
term bi (a b: wff): wff;

--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ bi a a $;
axiom bitr (a b c: wff): $ bi a b $ > $ bi b c $ > $ bi a c $;
axiom bisym (a b: wff): $ bi a b $ > $ bi b a $;
axiom mpbi (a b: wff): $ bi a b $ > $ a $ > $ b $;
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx): $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;
--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ bi a b $ > $ bi (g |- a) (h |- b) $;

-- `left a b` is just `~ ~ a`, so a proof of `g |- ~ ~ a` is a proof of
-- `g |- left a b` with `b` left open: only the conclusion `a /\ b` of
-- `and_left` pins `b`, even though `b` occurs in its premise.
def left (a b: wff): wff = $ ~ ~ a $;

axiom ax (g: ctx) (a: wff): $ g , a |- a $;
axiom and_left (g: ctx) (a b: wff): $ g |- left a b $ > $ g |- a /\ b $;
axiom not_elim (g: ctx) (a: wff): $ g |- ~ a $ > $ g |- a $ > $ g |- bot $;
axiom raa (g: ctx) (a: wff): $ g , ~ a |- bot $ > $ g |- a $;
axiom not_left (g: ctx) (a: wff): $ g , ~ a |- a $ > $ g , ~ a |- bot $;

-- `raa` hands `not_elim` the hint `emp , ~(a /\ b) |- bot`, whose context
-- differs from the sibling `l1`'s only up to ACUI. The sibling must still
-- pin `a /\ b` for the inline `and_left` minor.
theorem nested (a b: wff): $ ~ (a /\ b) |- ~ ~ a $ > $ emp |- a /\ b $;

-- `not_left`'s conclusion `g , ~ a |- bot` does not strictly match the
-- one-member context of `~ (a /\ b) |- bot`, so without an ACUI-aware
-- fallback the inline `and_left` gets no hint and cannot pin `b`.
theorem additive_root (a b: wff): $ ~ (a /\ b) |- ~ ~ a $ > $ ~ (a /\ b) |- bot $;
