delimiter $ ( ) $;
provable sort wff;
sort ctx;
sort nat;

term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

term ex {x: nat} (p: wff x): wff;
prefix ex: $∃$ prec 46;

term eq (s t: nat): wff;
infixl eq: $=$ prec 50;

term F (t: nat): wff;

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (p: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @relation nat eq eq_refl eq_trans eq_sym _
axiom eq_refl (s: nat): $ s = s $;
axiom eq_trans (s t v: nat): $ s = t $ > $ t = v $ > $ s = v $;
axiom eq_sym (s t: nat): $ s = t $ > $ t = s $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;
--| @congr
axiom F_congr (s t: nat): $ s = t $ > $ F s ↔ F t $;
--| @congr
axiom ex_congr {x: nat} (p q: wff x): $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;

def exists_F (.x: nat): wff = $ ∃ x (F x) $;

axiom ex_elim_many {x: nat} (g: ctx x) (h: ctx) (p: wff x) (c: wff):
  $ g ⊢ ∃ x p $ > $ h , p ⊢ c $ >
  $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ > $ p $ >
  $ g , h ⊢ F x $;

-- Once the first premise has left `p` mentioning the hidden witness, every
-- later bare-binder premise is matched through the kept session state. Each
-- must extend the branch, not duplicate it: with 16 such premises a doubled
-- population would be 2^16 branches.
theorem repeated_premises {a b: nat} (G H: ctx) (c: wff):
  $ G ⊢ exists_F $ > $ F a , H , F b ⊢ c $ >
  $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ > $ F a $ >
  $ G , H , F b ⊢ F a $;
