-- Two-variable-sort first-order natural deduction, after the proof system of
-- forallx: Calgary. Quantifiable variables (x, y, z) and names (a, b, c) are
-- distinct sorts, both coercing into tm. Quantifiers can only bind a var;
-- generalization and existential elimination demand a name as eigenvariable.
-- The eigenvariable side conditions are MM0 dependency typing: in all_intro /
-- ex_elim the context and conclusion binders may not depend on {a: name}.
--
-- Predicates take an argument *sequence* rather than a single term, so the
-- textbook's variadic atomic sentences — F(a), R(a,b), R(a,b,c) — are all
-- well-formed with the same predicate letter. The sequence combiner is `,`,
-- declared associative (@acui with no commutativity, unit law, or idempotence:
-- argument order and multiplicity are meaning-bearing). Contexts, which really
-- are unordered, keep the full ACUI treatment and are combined with `;`.
delimiter $ ( ) [ / ] , ; $;
provable sort wff;
sort ctx;

--| @vars x y z
sort var;
--| @vars a b c d
sort name;
sort tm;
sort seq;

term v2t (x: var): tm;
coercion v2t: var > tm;
term n2t (a: name): tm;
coercion n2t: name > tm;
term t2s (t: tm): seq;
coercion t2s: tm > seq;

term imp (p q: wff): wff;
infixr imp: $→$ prec 25;
term and (p q: wff): wff;
infixl and: $∧$ prec 30;
term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

term all {x: var} (p: wff x): wff;
prefix all: $∀$ prec 46;
term ex {x: var} (p: wff x): wff;
prefix ex: $∃$ prec 46;

-- Rewriting equality at the term level (drives subst normalization).
term eq (s t: tm): wff;
infixl eq: $=$ prec 50;

-- Argument sequences. `snil` exists only to name a unit for the @acui
-- annotation; no unit law is stated, so the normalizer never introduces or
-- eliminates it, and a predicate always carries at least one argument.
term snil: seq;
--| @acui seq_assoc _ snil _
term scomma (s t: seq): seq;
infixl scomma: $,$ prec 10;
term seq_eq (s t: seq): wff;

-- A small fixed signature so worked problems read naturally. Arity is not
-- fixed by the declaration: F(a) and F(a,b) are both well-formed.
term F (s: seq): wff;
term G (s: seq): wff;
term R (s: seq): wff;

term sb_s {x: var} (t: tm x) (s: seq x): seq;
notation sb_s {x: var} (t: tm x) (s: seq x): seq =
  ($subst$:41) x ($/$:0) t s;
term sb_f {x: var} (t: tm x) (p: wff x): wff;
notation sb_f {x: var} (t: tm x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $;$ prec 5;
term hyp (p: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g ; h) ; i) (g ; (h ; i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g ; h) (h ; g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g ; g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (_ ; g) g $;

--| @relation tm eq eq_refl eq_trans eq_sym _
axiom eq_refl (s: tm): $ s = s $;
axiom eq_trans (s t u: tm): $ s = t $ > $ t = u $ > $ s = u $;
axiom eq_sym (s t: tm): $ s = t $ > $ t = s $;

--| @relation seq seq_eq seq_refl seq_trans seq_sym _
axiom seq_refl (s: seq): $ seq_eq s s $;
axiom seq_trans (s t u: seq):
  $ seq_eq s t $ > $ seq_eq t u $ > $ seq_eq s u $;
axiom seq_sym (s t: seq): $ seq_eq s t $ > $ seq_eq t s $;
axiom seq_assoc (s t u: seq): $ seq_eq ((s , t) , u) (s , (t , u)) $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 ; h1) (g2 ; h2) $;
--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;
--| @congr
axiom imp_congr (p q r s: wff):
  $ p ↔ q $ > $ r ↔ s $ > $ (p → r) ↔ (q → s) $;
--| @congr
axiom and_congr (p q r s: wff):
  $ p ↔ q $ > $ r ↔ s $ > $ (p ∧ r) ↔ (q ∧ s) $;
--| @congr
axiom scomma_congr (s1 s2 t1 t2: seq):
  $ seq_eq s1 s2 $ > $ seq_eq t1 t2 $ > $ seq_eq (s1 , t1) (s2 , t2) $;
--| @congr
axiom t2s_congr (s t: tm): $ s = t $ > $ seq_eq (t2s s) (t2s t) $;
--| @congr
axiom F_congr (s t: seq): $ seq_eq s t $ > $ F s ↔ F t $;
--| @congr
axiom G_congr (s t: seq): $ seq_eq s t $ > $ G s ↔ G t $;
--| @congr
axiom R_congr (s t: seq): $ seq_eq s t $ > $ R s ↔ R t $;
--| @congr
axiom all_congr {x: var} (p q: wff x): $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom ex_congr {x: var} (p q: wff x): $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;

-- Push [x/t] through the syntactic operators so @rewrite normalization can
-- reduce the substitutions arising from the quantifier rules to atoms. At a
-- predicate the substitution moves onto the argument sequence, then
-- distributes over `,` one argument at a time.
--| @rewrite
axiom sb_f_imp {x: var} (t: tm x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;
--| @rewrite
axiom sb_f_and {x: var} (t: tm x) (p q: wff x):
  $ [x/t] (p ∧ q) ↔ ([x/t] p ∧ [x/t] q) $;
--| @rewrite
axiom sb_f_F {x: var} (t: tm x) (s: seq x):
  $ [x/t] (F s) ↔ F (subst x / t s) $;
--| @rewrite
axiom sb_f_G {x: var} (t: tm x) (s: seq x):
  $ [x/t] (G s) ↔ G (subst x / t s) $;
--| @rewrite
axiom sb_f_R {x: var} (t: tm x) (s: seq x):
  $ [x/t] (R s) ↔ R (subst x / t s) $;
--| @rewrite
axiom sb_f_id {x: var} (p: wff x): $ [x/x] p ↔ p $;
--| @rewrite
axiom sb_f_irrel {x: var} (t: tm x) (p: wff): $ [x/t] p ↔ p $;
--| @rewrite
axiom sb_s_comma {x: var} (t: tm x) (s u: seq x):
  $ seq_eq (subst x / t (s , u)) ((subst x / t s) , (subst x / t u)) $;
--| @rewrite
axiom sb_s_var {x: var} (t: tm x): $ seq_eq (subst x / t x) t $;
--| @rewrite
axiom sb_s_irrel {x: var} (t: tm x) (s: tm): $ seq_eq (subst x / t s) s $;

-- Structural rules. Like the one-sort forallx theory, each rule's conclusion
-- joins a slack context binder (implicit weakening).
axiom ax (g: ctx) (p: wff): $ g ; p ⊢ p $;
axiom reit (g h: ctx) (p: wff): $ g ⊢ p $ > $ g ; h ⊢ p $;

axiom imp_intro (g h: ctx) (p q: wff): $ g ; p ⊢ q $ > $ g ; h ⊢ p → q $;
axiom imp_elim (g h i: ctx) (p q: wff):
  $ g ⊢ p → q $ > $ h ⊢ p $ > $ g ; h ; i ⊢ q $;

axiom and_intro (g h i: ctx) (p q: wff):
  $ g ⊢ p $ > $ h ⊢ q $ > $ g ; h ; i ⊢ p ∧ q $;
axiom and_elim_l (g h: ctx) (p q: wff): $ g ⊢ p ∧ q $ > $ g ; h ⊢ p $;
axiom and_elim_r (g h: ctx) (p q: wff): $ g ⊢ p ∧ q $ > $ g ; h ⊢ q $;

-- ∀I in textbook form: from Γ ⊢ P(a) conclude Γ ⊢ ∀x P(x), provided the name
-- a does not occur in Γ or P. The proviso is dependency typing: g, h, and p
-- carry an x-dependency (bound occurrences of x inside context formulas are
-- harmless) but no a-dependency — that omission IS the eigenvariable
-- condition. There is no all_intro_sub/@fallback split as in the one-sort
-- theory: a var can never occur free in a sentence, so "mentions x" and
-- "mentions the eigenvariable" are separated by sort.
--| @view {x: var} {a: name} (g h: ctx x) (p: wff x) (q: wff): $ g ⊢ q $ > $ g ; h ⊢ ∀ x p $
--| @recover a q p x
axiom all_intro {x: var} {a: name} (g h: ctx x) (p: wff x):
  $ g ⊢ [x/a] p $ > $ g ; h ⊢ ∀ x p $;

axiom all_elim {x: var} (g h: ctx x) (t: tm) (p: wff x):
  $ g ⊢ ∀ x p $ > $ g ; h ⊢ [x/t] p $;

--| @view {x: var} (g h: ctx x) (t: tm) (p: wff x) (q: wff): $ g ⊢ q $ > $ g ; h ⊢ ∃ x p $
--| @recover t q p x
axiom ex_intro {x: var} (g h: ctx x) (t: tm) (p: wff x):
  $ g ⊢ [x/t] p $ > $ g ; h ⊢ ∃ x p $;

-- ∃E: the eigenvariable a may not occur in the side contexts or the
-- conclusion c — again, the absent a-dependency is the whole proviso.
--| @view {x: var} {a: name} (g h i: ctx x) (p: wff x) (q: wff) (c: wff x): $ g ⊢ ∃ x p $ > $ h ; q ⊢ c $ > $ g ; h ; i ⊢ c $
--| @recover a q p x
axiom ex_elim {x: var} {a: name} (g h i: ctx x) (p: wff x) (c: wff x):
  $ g ⊢ ∃ x p $ > $ h ; [x/a] p ⊢ c $ > $ g ; h ; i ⊢ c $;

theorem all_mono {x: var}:
  $ ∀ x (F(x) → G(x)) ; ∀ x F(x) ⊢ ∀ x G(x) $;
theorem all_to_ex {x: var}: $ ∀ x F(x) ⊢ ∃ x F(x) $;
theorem ex_mono {x: var}:
  $ ∃ x F(x) ; ∀ x (F(x) → G(x)) ⊢ ∃ x G(x) $;

-- Many-place atomic sentences, written with the same predicate letter shapes
-- the textbook uses. In r_inst the substitution has to walk into a sequence
-- and replace one argument while leaving the other alone; r_assoc pins down
-- that an argument sequence is flat, so the grouping the parser happens to
-- produce carries no meaning.
theorem r_diag {x: var}: $ ∀ x R(x,x) ⊢ ∃ x R(x,x) $;
theorem r_inst {x: var} (e: name): $ ∀ x R(x,e) ⊢ ∃ x R(x,e) $;
theorem r_assoc (u v w: name): $ R(u,v,w) ⊢ R(u,(v,w)) $;
