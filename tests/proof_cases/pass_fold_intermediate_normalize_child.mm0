import "lib/iff.mm0";

sort obj;

term top: wff;
term atom (x: obj): wff;
term mark (a: wff): wff;
term pair (a b: wff): wff;

def named_atom (x: obj): wff = $ atom x $;

--| @congr
axiom pair_congr (a b c d: wff):
  $ a <-> b $ > $ c <-> d $ > $ pair a c <-> pair b d $;

--| @rewrite
axiom mark_top (a: wff): $ mark a <-> a $;

axiom raw_pair (x: obj): $ pair (atom x) (mark top) $;

theorem fold_intermediate_normalize_child (x: obj):
  $ pair (named_atom x) top $;
