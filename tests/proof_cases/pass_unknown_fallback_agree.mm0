delimiter $ ( ) $;
--| @hole _
--| @unknown ?
provable sort wff;
--| @unknown ?G
sort ctx;
term imp (a b: wff): wff;
infixr imp: $->$ prec 25;
term and (a b: wff): wff;
infixr and: $/\$ prec 30;
term nd (g: ctx) (a: wff): wff;
infixr nd: $|-$ prec 10;
axiom id (g: ctx) (a: wff): $ g |- a -> a $;
axiom keep (g h: ctx) (a b: wff): $ g |- a $ > $ h |- b $ > $ g |- a $;
axiom and_elim_l (g: ctx) (a b: wff): $ g |- a /\ b $ > $ g |- a $;
--| @fallback and_elim_l
axiom and_elim (g: ctx) (a b: wff): $ g |- a /\ b $ > $ g |- b $;
theorem choice_agree (G: ctx) (p q: wff): $ G |- p /\ q $ > $ G |- q $;
