goal_43: $ - (q / 2) * (q / 2) = - (q / 2 * (q / 2)) $ by neg_mul
goal_44: $ - (- (q / 2) * (q / 2)) = - - (q / 2 * (q / 2)) $ by neg_congr [goal_43]
goal_45: $ - - (q / 2 * (q / 2)) = q / 2 * (q / 2) $ by neg_neg
goal_46: $ - (- (q / 2) * (q / 2)) = q / 2 * (q / 2) $ by eq_trans [goal_44, goal_45]
goal_47: $ - (s * - (q / 2)) = - (s * - (q / 2)) $ by eq_refl
goal_48: $ - (- (q / 2) * (q / 2)) + - (s * - (q / 2)) = q / 2 * (q / 2) + - (s * - (q / 2)) $ by add_congr [goal_46, goal_47]
