-- Proofs for Cardano's formula. Every proof body below was generated by a
-- single `conversion?` search on the goal line kept in the comment above
-- it; the search saturates the field identities over the hypotheses and
-- lowers the found path to these ordinary rewrite chains. `halves` first
-- puts the facts the search needs about 2 into scope by hand.

-- goal: $ -(a / 2) + -(a / 2) = -a $ by conversion?
halves
------
h1: $ 2 ≠ 0 $ by two_ne_zero
h2: $ 2 * inv 2 = 1 $ by mul_inv [h1]
h3: $ 2 = 1 + 1 $ by eq_refl
h4: $ a * 1 = a $ by mul_one
goal_1: $ - (a / 2 + a / 2) = - (a / 2) + - (a / 2) $ by neg_add
goal_2: $ - (a / 2) + - (a / 2) = - (a / 2 + a / 2) $ by eq_symm [goal_1]
goal_3: $ a / 2 = a * inv 2 $ by eq_refl
goal_4: $ a / 2 = a / 2 $ by eq_refl
goal_5: $ a / 2 + a / 2 = inv 2 * a + a / 2 $ by add_congr [goal_3, goal_4]
goal_6: $ inv 2 * a = inv 2 * a $ by eq_refl
goal_7: $ inv 2 * a + a / 2 = inv 2 * a + inv 2 * a $ by add_congr [goal_6, goal_3]
goal_8: $ a / 2 + a / 2 = inv 2 * a + inv 2 * a $ by eq_trans [goal_5, goal_7]
goal_9: $ a * (inv 2 + inv 2) = a * inv 2 + a * inv 2 $ by distrib
goal_10: $ a * inv 2 + a * inv 2 = a * (inv 2 + inv 2) $ by eq_symm [goal_9]
goal_11: $ a / 2 + a / 2 = (inv 2 + inv 2) * a $ by eq_trans [goal_8, goal_10]
goal_12: $ inv 2 * (1 + 1) = inv 2 * 1 + inv 2 * 1 $ by distrib
goal_13: $ inv 2 * 1 + inv 2 * 1 = inv 2 * (1 + 1) $ by eq_symm [goal_12]
goal_14: $ 1 + 1 = 2 $ by eq_symm [h3]
goal_15: $ inv 2 = inv 2 $ by eq_refl
goal_16: $ inv 2 * (1 + 1) = inv 2 * 2 $ by mul_congr [goal_15, goal_14]
goal_17: $ inv 2 * 1 + inv 2 * 1 = inv 2 * 2 $ by eq_trans [goal_13, goal_16]
goal_18: $ 2 * inv 2 = 1 $ by mul_inv [h1]
goal_19: $ inv 2 * 1 + inv 2 * 1 = 1 $ by eq_trans [goal_17, goal_18]
goal_20: $ a = a $ by eq_refl
goal_21: $ (inv 2 * 1 + inv 2 * 1) * a = 1 * a $ by mul_congr [goal_19, goal_20]
goal_22: $ a / 2 + a / 2 = 1 * a $ by eq_trans [goal_11, goal_21]
goal_23: $ - (a / 2 + a / 2) = - a $ by neg_congr [goal_22]
goal_24: $ - (a / 2) + - (a / 2) = - a $ by eq_trans [goal_2, goal_23]
goal_25: $ - (a / 2) + - (a / 2) = - (a / 2) + - (a / 2) $ by eq_refl
goal: $ -(a / 2) + -(a / 2) = -a $ by eq_trans [goal_25, goal_24]

-- goal: $ u * u * u + v * v * v = -q $ by conversion?
sum_of_cubes
------------
goal_1: $ v * (v * v) = v * (v * v) $ by eq_refl
goal_2: $ u * (u * u) + v * (v * v) = - (q / 2) + s + v * (v * v) $ by add_congr [#1, goal_1]
goal_3: $ - (q / 2) + s = - (q / 2) + s $ by eq_refl
goal_4: $ - (q / 2) + s + v * (v * v) = - (q / 2) + s + (- (q / 2) + - s) $ by add_congr [goal_3, #2]
goal_5: $ u * u * u + v * v * v = - (q / 2) + s + (- (q / 2) + - s) $ by eq_trans [goal_2, goal_4]
goal_6: $ s + - s = 0 $ by add_neg
goal_7: $ - (q / 2) + - (q / 2) = - (q / 2) + - (q / 2) $ by eq_refl
goal_8: $ s + - s + (- (q / 2) + - (q / 2)) = 0 + (- (q / 2) + - (q / 2)) $ by add_congr [goal_6, goal_7]
goal_9: $ u * u * u + v * v * v = - (q / 2) + (- (q / 2) + 0) $ by eq_trans [goal_5, goal_8]
goal_10: $ - (q / 2) + - (q / 2) = - q $ by halves
goal_11: $ u * u * u + v * v * v = - q $ by eq_trans [goal_9, goal_10]
goal_12: $ u * u * u + v * v * v = u * u * u + v * v * v $ by eq_refl
goal: $ u * u * u + v * v * v = -q $ by eq_trans [goal_12, goal_11]

-- goal: $ (u * u * u) * (v * v * v) = -(p / 3) * -(p / 3) * -(p / 3) $ by conversion?
product_of_cubes
----------------
goal_1: $ v = v $ by eq_refl
goal_2: $ v * (u * (u * u)) = v * (s + - (q / 2)) $ by mul_congr [goal_1, #2]
goal_3: $ v * (v * (u * (u * u))) = v * (v * (s + - (q / 2))) $ by mul_congr [goal_1, goal_2]
goal_4: $ v * (v * (v * (u * (u * u)))) = v * (v * (v * (s + - (q / 2)))) $ by mul_congr [goal_1, goal_3]
goal_5: $ v * (s + - (q / 2)) = v * s + v * - (q / 2) $ by distrib
goal_6: $ v * v = v * v $ by eq_refl
goal_7: $ v * (s + - (q / 2)) * (v * v) = (v * s + v * - (q / 2)) * (v * v) $ by mul_congr [goal_5, goal_6]
goal_8: $ u * u * u * (v * v * v) = v * (v * (v * s + v * - (q / 2))) $ by eq_trans [goal_4, goal_7]
goal_9: $ v * (v * s + v * - (q / 2)) = v * (v * s) + v * (v * - (q / 2)) $ by distrib
goal_10: $ v * (v * s + v * - (q / 2)) * v = (v * (v * s) + v * (v * - (q / 2))) * v $ by mul_congr [goal_9, goal_1]
goal_11: $ u * u * u * (v * v * v) = v * (v * (v * s) + v * (v * - (q / 2))) $ by eq_trans [goal_8, goal_10]
goal_12: $ v * (v * (v * s) + v * (v * - (q / 2))) = v * (v * (v * s)) + v * (v * (v * - (q / 2))) $ by distrib
goal_13: $ u * u * u * (v * v * v) = v * (v * (v * s)) + v * (v * (v * - (q / 2))) $ by eq_trans [goal_11, goal_12]
goal_14: $ s = s $ by eq_refl
goal_15: $ s * (v * (v * v)) = s * (- (q / 2) + - s) $ by mul_congr [goal_14, #3]
goal_16: $ s * (- (q / 2) + - s) = s * - (q / 2) + s * - s $ by distrib
goal_17: $ s * (v * (v * v)) = s * - (q / 2) + s * - s $ by eq_trans [goal_15, goal_16]
goal_18: $ v * (v * (v * - (q / 2))) = v * (v * (v * - (q / 2))) $ by eq_refl
goal_19: $ s * (v * (v * v)) + v * (v * (v * - (q / 2))) = s * - (q / 2) + s * - s + v * (v * (v * - (q / 2))) $ by add_congr [goal_17, goal_18]
goal_20: $ u * u * u * (v * v * v) = s * - (q / 2) + s * - s + v * (v * (v * - (q / 2))) $ by eq_trans [goal_13, goal_19]
goal_21: $ - (q / 2) * v = - (q / 2 * v) $ by neg_mul
goal_22: $ v * (v * - (q / 2)) = v * - (v * (q / 2)) $ by mul_congr [goal_1, goal_21]
goal_23: $ - (v * (q / 2)) * v = - (v * (q / 2) * v) $ by neg_mul
goal_24: $ v * (v * - (q / 2)) = - (v * (v * (q / 2))) $ by eq_trans [goal_22, goal_23]
goal_25: $ v * (v * (v * - (q / 2))) = v * - (v * (v * (q / 2))) $ by mul_congr [goal_1, goal_24]
goal_26: $ - (v * (v * (q / 2))) * v = - (v * (v * (q / 2)) * v) $ by neg_mul
goal_27: $ v * (v * (v * - (q / 2))) = - (v * (v * (v * (q / 2)))) $ by eq_trans [goal_25, goal_26]
goal_28: $ q / 2 = q / 2 $ by eq_refl
goal_29: $ v * (v * v) * (q / 2) = (- (q / 2) + - s) * (q / 2) $ by mul_congr [#3, goal_28]
goal_30: $ q / 2 * (- (q / 2) + - s) = q / 2 * - (q / 2) + q / 2 * - s $ by distrib
goal_31: $ v * (v * v) * (q / 2) = - s * (q / 2) + - (q / 2) * (q / 2) $ by eq_trans [goal_29, goal_30]
goal_32: $ - s * (q / 2) = - (s * (q / 2)) $ by neg_mul
goal_33: $ - (q / 2) * s = - (q / 2 * s) $ by neg_mul
goal_34: $ - (q / 2 * s) = - (q / 2) * s $ by eq_symm [goal_33]
goal_35: $ - s * (q / 2) = s * - (q / 2) $ by eq_trans [goal_32, goal_34]
goal_36: $ - (q / 2) * (q / 2) = - (q / 2) * (q / 2) $ by eq_refl
goal_37: $ - s * (q / 2) + - (q / 2) * (q / 2) = s * - (q / 2) + - (q / 2) * (q / 2) $ by add_congr [goal_35, goal_36]
goal_38: $ v * (v * v) * (q / 2) = s * - (q / 2) + - (q / 2) * (q / 2) $ by eq_trans [goal_31, goal_37]
goal_39: $ - (v * (v * v) * (q / 2)) = - (s * - (q / 2) + - (q / 2) * (q / 2)) $ by neg_congr [goal_38]
goal_40: $ v * (v * (v * - (q / 2))) = - (s * - (q / 2) + - (q / 2) * (q / 2)) $ by eq_trans [goal_27, goal_39]
goal_41: $ - (s * - (q / 2) + - (q / 2) * (q / 2)) = - (s * - (q / 2)) + - (- (q / 2) * (q / 2)) $ by neg_add
