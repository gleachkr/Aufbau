goal_50: $ - (s * - (q / 2)) = - - (s * (q / 2)) $ by neg_congr [goal_33]
goal_51: $ - - (s * (q / 2)) = s * (q / 2) $ by neg_neg
goal_52: $ - (s * - (q / 2)) = s * (q / 2) $ by eq_trans [goal_50, goal_51]
goal_53: $ q / 2 * (q / 2) = q / 2 * (q / 2) $ by eq_refl
goal_54: $ q / 2 * (q / 2) + - (s * - (q / 2)) = q / 2 * (q / 2) + s * (q / 2) $ by add_congr [goal_53, goal_52]
goal_55: $ v * (v * (v * - (q / 2))) = q / 2 * (q / 2) + s * (q / 2) $ by eq_trans [goal_49, goal_54]
goal_56: $ s * - s = s * - s $ by eq_refl
goal_57: $ v * (v * (v * - (q / 2))) + s * - s = q / 2 * (q / 2) + s * (q / 2) + s * - s $ by add_congr [goal_55, goal_56]
goal_58: $ s * - (q / 2) = s * - (q / 2) $ by eq_refl
goal_59: $ s * - (q / 2) + (v * (v * (v * - (q / 2))) + s * - s) = s * - (q / 2) + (q / 2 * (q / 2) + s * (q / 2) + s * - s) $ by add_congr [goal_58, goal_57]
goal_60: $ u * u * u * (v * v * v) = s * - (q / 2) + (q / 2 * (q / 2) + s * (q / 2) + s * - s) $ by eq_trans [goal_20, goal_59]
goal_61: $ - s * s = - (s * s) $ by neg_mul
goal_62: $ p / 3 = p * inv 3 $ by eq_refl
goal_63: $ p / 3 * (p / 3) = p / 3 * (p / 3) $ by eq_refl
