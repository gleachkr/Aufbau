delimiter $ ( ) $;
provable sort wff;
sort ctx;
term bi (a b: wff): wff;
--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ bi a a $;
axiom bitr (a b c: wff): $ bi a b $ > $ bi b c $ > $ bi a c $;
axiom bisym (a b: wff): $ bi a b $ > $ bi b a $;
axiom mpbi (a b: wff): $ bi a b $ > $ a $ > $ b $;
-- A context: an idempotent bag with a unit.
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx; infixl join: $,$ prec 5;
term hyp (a: wff): ctx; coercion hyp: wff > ctx;
term ctx_eq (g h: ctx): wff;
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx): $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;
--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ bi a b $ > $ ctx_eq (hyp a) (hyp b) $;
term ok (g: ctx): wff;
--| @congr
axiom ok_congr (g h: ctx): $ ctx_eq g h $ > $ bi (ok g) (ok h) $;
axiom ok_ax (g: ctx): $ ok g $;

-- A 120-member context reversed. The conversion proof reads back few of
-- its lines; saving every line overflowed the verifier's heap.
theorem reversed (a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 a32 a33 a34 a35 a36 a37 a38 a39 a40 a41 a42 a43 a44 a45 a46 a47 a48 a49 a50 a51 a52 a53 a54 a55 a56 a57 a58 a59 a60 a61 a62 a63 a64 a65 a66 a67 a68 a69 a70 a71 a72 a73 a74 a75 a76 a77 a78 a79 a80 a81 a82 a83 a84 a85 a86 a87 a88 a89 a90 a91 a92 a93 a94 a95 a96 a97 a98 a99 a100 a101 a102 a103 a104 a105 a106 a107 a108 a109 a110 a111 a112 a113 a114 a115 a116 a117 a118 a119 a120: wff):
  $ ok (a120 , a119 , a118 , a117 , a116 , a115 , a114 , a113 , a112 , a111 , a110 , a109 , a108 , a107 , a106 , a105 , a104 , a103 , a102 , a101 , a100 , a99 , a98 , a97 , a96 , a95 , a94 , a93 , a92 , a91 , a90 , a89 , a88 , a87 , a86 , a85 , a84 , a83 , a82 , a81 , a80 , a79 , a78 , a77 , a76 , a75 , a74 , a73 , a72 , a71 , a70 , a69 , a68 , a67 , a66 , a65 , a64 , a63 , a62 , a61 , a60 , a59 , a58 , a57 , a56 , a55 , a54 , a53 , a52 , a51 , a50 , a49 , a48 , a47 , a46 , a45 , a44 , a43 , a42 , a41 , a40 , a39 , a38 , a37 , a36 , a35 , a34 , a33 , a32 , a31 , a30 , a29 , a28 , a27 , a26 , a25 , a24 , a23 , a22 , a21 , a20 , a19 , a18 , a17 , a16 , a15 , a14 , a13 , a12 , a11 , a10 , a9 , a8 , a7 , a6 , a5 , a4 , a3 , a2 , a1) $;
