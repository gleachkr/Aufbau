delimiter $ ( ) [ / ] $;
import "lib/nd.mm0";

sort obj;

term all {x: obj} (p: wff): wff;
prefix all: $∀$ prec 41;
term and (a b: wff): wff;
infixr and: $∧$ prec 30;

notation emp: ctx = ($_$:max);

--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom and_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;

--| @congr
axiom all_congr {x: obj} (p q: wff):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;

axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

def packed {.x: obj} (a q: wff): wff =
  $ a ∧ ∀ x q $;

theorem pass_def_hidden_dummy_ax (a q: wff):
  $ packed a q ⊢ packed a q $;
