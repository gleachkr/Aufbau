-- A hole in the part of a line an inline sub-proof needs as its hint: the
-- sub-proof gets a hint with a hole in it and reads what it can from the
-- visible part (`a := Q` from `Q \/ P _obj` for `or_r`).

delimiter $ ( ) $;
--| @hole _wff
provable sort wff;
--| @hole _obj
sort obj;
term c: obj;
term P (x: obj): wff;
term Q: wff;
term R: wff;
term and (a b: wff): wff;
infixl and: $/\$ prec 20;
term or (a b: wff): wff;
infixl or: $\/$ prec 30;

axiom pc: $ P c $;
axiom q: $ Q $;
axiom and_intro (a b: wff): $ a $ > $ b $ > $ a /\ b $;
axiom or_l (a b: wff): $ a $ > $ a \/ b $;
axiom or_r (a b: wff): $ b $ > $ a \/ b $;

theorem hint_into_hole: $ (Q \/ P c) /\ P c $;
-- The hint passes through `or_l`, which takes `Q \/ P _obj` as its `a`.
theorem nested_hint: $ ((Q \/ P c) \/ R) /\ P c $;
-- The hint's holes spend no dependency slot, so a theorem may hold more
-- holey lines than there are slots (55).
theorem many_lines: $ (Q \/ P c) /\ P c $;
