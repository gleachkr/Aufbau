import "lib/ctx.mm0";
import "lib/iff.mm0";

term seq (g d: ctx): wff;
infixl seq: $==>$ prec 0;

--| @congr
axiom seq_congr (g1 g2 d1 d2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq d1 d2 $ > $ (g1 ==> d1) ↔ (g2 ==> d2) $;

axiom pair_cut (g h d e: ctx) (a b: wff):
  $ g , a ==> d $
  > $ h , b ==> e $
  > $ g , h ==> d , e $;

theorem acui_multi_remainder_impossible (a b u v: wff):
  $ a ==> u $
  > $ b ==> v $
  > $ emp ==> u $;
