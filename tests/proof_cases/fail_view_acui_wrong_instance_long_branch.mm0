delimiter $ ( ) $;
provable sort wff;
sort ctx;
sort var;
sort name;
sort tm;
term v2t (x: var): tm;
coercion v2t: var > tm;
term n2t (a: name): tm;
coercion n2t: name > tm;

term iff (a b: wff): wff;
infixr iff: $<->$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
term hyp (a: wff): ctx;
term cl (g: ctx): wff;
term cf (g: ctx) (a: wff): wff;
term all {x: var} (p: wff x): wff;
prefix all: $A.$ prec 41;
term ex {x: var} (p: wff x): wff;
prefix ex: $E.$ prec 41;
term neg (a: wff): wff;
prefix neg: $~$ prec 45;
term pred (t: tm): wff;
prefix pred: $P$ prec 50;
term sb (t: tm) {x: var} (p: wff x): wff;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a <-> a $;
axiom iff_trans (a b c: wff):
  $ a <-> b $ > $ b <-> c $ > $ a <-> c $;
axiom iff_sym (a b: wff): $ a <-> b $ > $ b <-> a $;
axiom iff_mp (a b: wff): $ a <-> b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq (join (join g h) i) (join g (join h i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (join g h) (join h g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (join g g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (join emp g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (join g1 h1) (join g2 h2) $;

--| @congr
axiom hyp_congr (a b: wff): $ a <-> b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom cl_congr (g h: ctx): $ ctx_eq g h $ > $ cl g <-> cl h $;

--| @congr
axiom cf_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a <-> b $ > $ cf g a <-> cf h b $;

--| @rewrite
axiom sb_pred (t: tm) {x: var}: $ sb t x (P x) <-> P t $;

-- A tableau step writing two instances of a universal row: the branch
-- `g ; A. x p` closes once `g ; A. x p ; p[t/x] ; p[u/x]` does. The view
-- names the new rows `q` and `r`, and each instance is read back out of
-- its row.
--| @view {x: var} (g: ctx x) (t u: tm) (p: wff x) (q r: wff): $ cl (join (join (join g (hyp (A. x p))) (hyp q)) (hyp r)) $ > $ cf g (A. x p) $
--| @recover t q p x
--| @recover u r p x
axiom all_step2 {x: var} (g: ctx x) (t u: tm) (p: wff x):
  $ cl (join (join (join g (hyp (A. x p))) (hyp (sb t x p))) (hyp (sb u x p))) $
  > $ cf g (A. x p) $;

-- The one new row, `~ P c`, is no instance of `P x`. The branch is a set,
-- so `q` and `r` may each stand for any of its rows as long as one of them
-- is the new row; a choice whose row is no instance of `P x` is dropped as
-- it is made, so the step fails without trying every pair of rows.
theorem wrong_instance_long_branch {x: var} {b c: name}:
  $ cl (join (join (join (join (join (join (join (join (join (join (hyp (A. x (P x))) (hyp (~ P b))) (hyp (~ ~ P b))) (hyp (~ ~ ~ P b))) (hyp (~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ ~ ~ P b))) (hyp (~ P c))) $
  > $ cf (join (join (join (join (join (join (join (join (join (hyp (A. x (P x))) (hyp (~ P b))) (hyp (~ ~ P b))) (hyp (~ ~ ~ P b))) (hyp (~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ ~ P b))) (hyp (~ ~ ~ ~ ~ ~ ~ ~ ~ P b))) (A. x (P x)) $;
