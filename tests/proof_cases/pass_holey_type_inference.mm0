-- Sections 1-4 of reynolds.mm0 (System F typing), plus `@hole _ty`.

-- System F: the polymorphic lambda calculus, as typing rules.
--
-- Two binder levels.  `λ x : A. t` binds a term variable, `Λ a. t` binds a
-- *type* variable, and the two eliminators are ordinary application `f · u`
-- and type application `f @ A`.  The side condition on ∀-introduction — the
-- abstracted type variable must not occur free in the context — is not a
-- side condition here at all: it falls out of MM0's dependency tracking,
-- because `t_tlam` declares its context binder `g` with no dependency on the
-- bound type variable `a`.
--
-- ∀-elimination substitutes a type into a type, so the file also carries a
-- small explicit-substitution layer.  Its `@rewrite` axioms are what let the
-- proofs below state the *computed* instance type rather than a stack of
-- pending substitutions.
--
-- Delimiters split left and right so that bracketed substitution syntax
-- `[a/S] B` tokenizes alongside the notation for arrows and binders.
delimiter $ ( [ / $ $ / . : , ) ] ~ @ $;

strict provable sort jdg;
sort ctx;
--| @vars a b c d
--| @hole _ty
sort ty;
--| @vars x y z f n
sort tm;

-- ==================================================================
-- SECTION 1: judgements and the equality layer
-- ==================================================================

term jiff (J K: jdg): jdg;
infixr jiff: $<=>$ prec 20;

--| @relation jdg jiff jiff_refl jiff_trans jiff_sym jiff_mp
axiom jiff_refl (J: jdg): $ J <=> J $;
axiom jiff_trans (J K L: jdg): $ J <=> K $ > $ K <=> L $ > $ J <=> L $;
axiom jiff_sym (J K: jdg): $ J <=> K $ > $ K <=> J $;
axiom jiff_mp (J K: jdg): $ J <=> K $ > $ J $ > $ K $;

term eq_ctx (g h: ctx): jdg;
infixl eq_ctx: $≋$ prec 15;
term eq_ty (A B: ty): jdg;
infixl eq_ty: $~$ prec 15;
term eq_tm (s t: tm): jdg;
infixl eq_tm: $≈$ prec 15;

--| @relation ctx eq_ctx eq_ctx_refl eq_ctx_trans eq_ctx_sym _
axiom eq_ctx_refl (g: ctx): $ g ≋ g $;
axiom eq_ctx_trans (g h i: ctx): $ g ≋ h $ > $ h ≋ i $ > $ g ≋ i $;
axiom eq_ctx_sym (g h: ctx): $ g ≋ h $ > $ h ≋ g $;

--| @relation ty eq_ty eq_ty_refl eq_ty_trans eq_ty_sym _
axiom eq_ty_refl (A: ty): $ A ~ A $;
axiom eq_ty_trans (A B C: ty): $ A ~ B $ > $ B ~ C $ > $ A ~ C $;
axiom eq_ty_sym (A B: ty): $ A ~ B $ > $ B ~ A $;

--| @relation tm eq_tm eq_tm_refl eq_tm_trans eq_tm_sym _
axiom eq_tm_refl (s: tm): $ s ≈ s $;
axiom eq_tm_trans (s t u: tm): $ s ≈ t $ > $ t ≈ u $ > $ s ≈ u $;
axiom eq_tm_sym (s t: tm): $ s ≈ t $ > $ t ≈ s $;

term has_ty (t: tm) (A: ty): jdg;
infixl has_ty: $:$ prec 12;
term nd (g: ctx) (J: jdg): jdg;
infixl nd: $⊢$ prec 0;

--| @congr
axiom has_ty_congr (s t: tm) (A B: ty):
  $ s ≈ t $ > $ A ~ B $ > $ (s : A) <=> (t : B) $;

--| @congr
axiom nd_congr (g h: ctx) (J K: jdg):
  $ g ≋ h $ > $ J <=> K $ > $ (g ⊢ J) <=> (h ⊢ K) $;

--| @congr
axiom jiff_congr (J1 J2 K1 K2: jdg):
  $ J1 <=> J2 $ > $ K1 <=> K2 $ > $ (J1 <=> K1) <=> (J2 <=> K2) $;

-- ==================================================================
-- SECTION 2: contexts
-- ==================================================================
--
-- A typing context is a set of `x : A` hypotheses.  Declaring the join
-- associative, commutative, unital and idempotent supports weakening,
-- exchange and contraction.

term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui eq_ctx_assoc eq_ctx_comm emp eq_ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (J: jdg): ctx;
coercion hyp: jdg > ctx;

axiom eq_ctx_assoc (g h i: ctx): $ ((g , h) , i) ≋ (g , (h , i)) $;
axiom eq_ctx_comm (g h: ctx): $ (g , h) ≋ (h , g) $;
axiom eq_ctx_idem (g: ctx): $ (g , g) ≋ g $;
axiom eq_ctx_unit (g: ctx): $ (emp , g) ≋ g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ g1 ≋ g2 $ > $ h1 ≋ h2 $ > $ (g1 , h1) ≋ (g2 , h2) $;

--| @congr
axiom hyp_congr (J K: jdg): $ J <=> K $ > $ hyp J ≋ hyp K $;

-- ==================================================================
-- SECTION 3: types, terms, and type substitution
-- ==================================================================

term arr (A B: ty): ty;
infixr arr: $→$ prec 25;
infixr arr: $->$ prec 25;
term all {a: ty} (B: ty a): ty;
notation all {a: ty} (B: ty a): ty = ($∀$:20) a ($.$:0) B;

term lam (A: ty) {x: tm} (t: tm x): tm;
notation lam (A: ty) {x: tm} (t: tm x): tm =
  ($λ$:20) x ($:$:12) A ($.$:0) t;
term app (f u: tm): tm;
infixl app: $·$ prec 70;
term tlam {a: ty} (t: tm a): tm;
notation tlam {a: ty} (t: tm a): tm = ($Λ$:20) a ($.$:0) t;
term tapp (f: tm) (A: ty): tm;
infixl tapp: $@$ prec 70;

--| @congr
axiom arr_congr (A1 A2 B1 B2: ty):
  $ A1 ~ A2 $ > $ B1 ~ B2 $ > $ (A1 → B1) ~ (A2 → B2) $;

--| @congr
axiom all_congr {a: ty} (A B: ty a): $ A ~ B $ > $ (∀ a. A) ~ (∀ a. B) $;

--| @congr
axiom lam_congr (A B: ty) {x: tm} (t u: tm x):
  $ A ~ B $ > $ t ≈ u $ > $ (λ x : A. t) ≈ (λ x : B. u) $;

--| @congr
axiom app_congr (f1 f2 u v: tm): $ f1 ≈ f2 $ > $ u ≈ v $ > $ (f1 · u) ≈ (f2 · v) $;

--| @congr
axiom tlam_congr {a: ty} (t u: tm a): $ t ≈ u $ > $ (Λ a. t) ≈ (Λ a. u) $;

--| @congr
axiom tapp_congr (f1 f2: tm) (A B: ty):
  $ f1 ≈ f2 $ > $ A ~ B $ > $ (f1 @ A) ≈ (f2 @ B) $;

-- Explicit type-in-type substitution, written `[a/S] B`.
term sb_ty {a: ty} (S: ty) (B: ty a): ty;
notation sb_ty {a: ty} (S: ty) (B: ty a): ty =
  ($[$:41) a ($/$:0) S ($]$:0) B;

--| @congr
axiom sb_ty_congr {a: ty} (S1 S2: ty) (A B: ty a):
  $ S1 ~ S2 $ > $ A ~ B $ > $ [a/S1] A ~ [a/S2] B $;

-- The substituted variable itself.
--| @rewrite
axiom sb_ty_hit {a: ty} (S: ty): $ [a/S] a ~ S $;

-- `A: ty` carries no dependency on `a`, so this is exactly the "`a` is not
-- free in `A`" case.
--| @rewrite
axiom sb_ty_free {a: ty} (S: ty) (A: ty): $ [a/S] A ~ A $;

--| @rewrite
axiom sb_ty_arr {a: ty} (S: ty) (A B: ty a):
  $ [a/S] (A → B) ~ ([a/S] A → [a/S] B) $;

-- `S: ty` carries no dependency on `b`, which is the capture-avoidance
-- condition on pushing a substitution under a ∀.
--| @rewrite
axiom sb_ty_all {a b: ty} (S: ty) (A: ty a b):
  $ [a/S] (∀ b. A) ~ (∀ b. [a/S] A) $;

-- ==================================================================
-- SECTION 4: the typing rules
-- ==================================================================

axiom t_var (g: ctx) {x: tm} (A: ty): $ g , x : A ⊢ x : A $;

axiom t_weak (g d: ctx) (J: jdg): $ g ⊢ J $ > $ g , d ⊢ J $;

axiom t_lam (g: ctx) (A B: ty) {x: tm} (t: tm x):
  $ g , x : A ⊢ t : B $
  > $ g ⊢ (λ x : A. t) : A → B $;

axiom t_app (g: ctx) (A B: ty) (f u: tm):
  $ g ⊢ f : A → B $
  > $ g ⊢ u : A $
  > $ g ⊢ f · u : B $;

axiom t_tlam (g: ctx) {a: ty} (t: tm a) (B: ty a):
  $ g ⊢ t : B $
  > $ g ⊢ (Λ a. t) : ∀ a. B $;

axiom t_tapp {a: ty} (g: ctx a) (f: tm a) (B: ty a) (S: ty):
  $ g ⊢ f : ∀ a. B $
  > $ g ⊢ f @ S : [a/S] B $;

-- Type inference with a type hole: each proof's one line states a term and
-- leaves its type as the hole `_ty`, and the proof fills it. The theorem
-- statement fixes the expected type, so a wrong fill fails the final-line
-- check. The proofs are the ones `auto?` finds on those lines.

theorem infer_id (g: ctx) {a: ty} {x: tm}:
  $ g ⊢ (λ x : a. x) : a → a $;

theorem infer_const (g: ctx) {a b: ty} {x y: tm}:
  $ g ⊢ (λ x : a. λ y : b. x) : a → b → a $;

theorem infer_app (g: ctx) {a b: ty} {f x: tm}:
  $ g , f : a → b , x : a ⊢ f · x : b $;

theorem infer_app2 (g: ctx) {a b c: ty} {f x y: tm}:
  $ g , f : a → b → c , x : a , y : b ⊢ f · x · y : c $;

theorem infer_compose (g: ctx) {a b c: ty} {f n x: tm}:
  $ g ⊢ (λ f : b → c. λ n : a → b. λ x : a. f · (n · x)) : (b → c) → (a → b) → a → c $;

theorem infer_flip (g: ctx) {a b c: ty} {f x y: tm}:
  $ g ⊢ (λ f : a → b → c. λ y : b. λ x : a. f · x · y) : (a → b → c) → b → a → c $;

theorem infer_poly_id (g: ctx) {a: ty} {x: tm}:
  $ g ⊢ (Λ a. λ x : a. x) : ∀ a. a → a $;

theorem infer_tapp (g: ctx) {a b: ty} {x: tm}:
  $ g ⊢ (Λ a. λ x : a. x) @ b : b → b $;
