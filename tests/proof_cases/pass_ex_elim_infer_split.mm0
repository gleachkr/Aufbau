-- #216 minimal repro (one sort, ambiguous context split): the second
-- premise's context joins a side hypothesis with the [x/u] p instance, so
-- inference must pick the right member for the view's q slot. Committing
-- greedily to the ∀-member is refutable only through the @recover (a ∀
-- formula cannot be a substitution instance of p) — recover-as-constraint,
-- with backtracking, is what this case demands. The witness u again appears
-- only inside the second premise.
delimiter $ ( ) [ / ] $;
provable sort wff;
sort ctx;

--| @vars x y z u w
sort nat;

term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

term all {x: nat} (p: wff x): wff;
prefix all: $∀$ prec 46;
term ex {x: nat} (p: wff x): wff;
prefix ex: $∃$ prec 46;

term eq (s t: nat): wff;
infixl eq: $=$ prec 50;

term F (t: nat): wff;

term sb_t {x: nat} (t: nat x) (s: nat x): nat;
notation sb_t {x: nat} (t: nat x) (s: nat x): nat =
  ($subst$:41) x ($/$:0) t s;
term sb_f {x: nat} (t: nat x) (p: wff x): wff;
notation sb_f {x: nat} (t: nat x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (p: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @relation nat eq eq_refl eq_trans eq_sym _
axiom eq_refl (s: nat): $ s = s $;
axiom eq_trans (s t v: nat): $ s = t $ > $ t = v $ > $ s = v $;
axiom eq_sym (s t: nat): $ s = t $ > $ t = s $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;
--| @congr
axiom F_congr (s t: nat): $ s = t $ > $ F s ↔ F t $;
--| @congr
axiom all_congr {x: nat} (p q: wff x): $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom ex_congr {x: nat} (p q: wff x): $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;

--| @rewrite
axiom sb_f_F {x: nat} (t: nat x) (s: nat x):
  $ [x/t] (F s) ↔ F (subst x / t s) $;
--| @rewrite
axiom sb_f_irrel {x: nat} (t: nat x) (p: wff): $ [x/t] p ↔ p $;
--| @rewrite
axiom sb_t_var {x: nat} (t: nat x): $ (subst x / t x) = t $;
--| @rewrite
axiom sb_t_irrel {x: nat} (t: nat x) (s: nat): $ (subst x / t s) = s $;

axiom ax (g: ctx) (p: wff): $ g , p ⊢ p $;

--| @view {x: nat} (g: ctx x) (t: nat x) (p: wff x) (q: wff): $ g ⊢ q $ > $ g ⊢ ∃ x p $
--| @recover t q p x
axiom ex_intro {x: nat} (g: ctx x) (t: nat x) (p: wff x):
  $ g ⊢ [x/t] p $ > $ g ⊢ ∃ x p $;

--| @view {x u: nat} (g: ctx x u) (h: ctx x) (p: wff x) (q c: wff): $ g ⊢ ∃ x p $ > $ h , q ⊢ c $ > $ g , h ⊢ c $
--| @recover u q p x
axiom ex_elim {x u: nat} (g: ctx x u) (h: ctx x) (p: wff x) (c: wff):
  $ g ⊢ ∃ x p $ > $ h , [x/u] p ⊢ c $ > $ g , h ⊢ c $;

theorem ex_side {x y: nat}:
  $ ∃ x (F x) , ∀ y (F y) ⊢ ∃ y (F y) $;
