import "lib/ctx.mm0";

term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

notation emp: ctx = ($_$:max);

term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;

-- `wrap` erases its second argument. Structural matching binds q from the
-- first premise and then clashes on the second; the two applications are
-- still the same wff once the def is unfolded.
def wrap (p q: wff): wff = $ p ↔ p $;
axiom rr (g h: ctx) (p q c: wff):
  $ wrap p q $ > $ wrap p q $ > $ g , p ⊢ c $ > $ h ⊢ c $ >
  $ g , h ⊢ c $;
theorem erased_arg (G H I: ctx) (p c d e: wff):
  $ wrap p d $ > $ wrap p e $ > $ p , G , I ⊢ c $ > $ H ⊢ c $ >
  $ G , I , H ⊢ c $;
