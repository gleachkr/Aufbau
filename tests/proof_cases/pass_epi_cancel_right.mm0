delimiter $ ( ) [ / ] $;
import "lib/nd.mm0";

strict sort obj;
--| @vars x y z alpha beta
sort mor;

term imp (a b: wff): wff;
infixr imp: $→$ prec 25;
infixr imp: $->$ prec 25;
term and (a b: wff): wff;
infixr and: $∧$ prec 30;
infixr and: $/\\$ prec 30;

term all {x: mor} (p: wff x): wff;
prefix all: $∀$ prec 41;
prefix all: $A.$ prec 41;

term mor_eq (f g: mor): wff;
infixl mor_eq: $~$ prec 15;
term hom (f: mor) (A B: obj): wff;
term obj_eq (A B: obj): wff;
term id (A: obj): mor;
term comp (f g: mor): mor;
infixl comp: $∘$ prec 35;
infixl comp: $o$ prec 35;

term sb_m {x: mor} (t: mor x) (a: mor x): mor;
notation sb_m {x: mor} (t: mor x) (a: mor x): mor =
  ($subst$:41) x ($/$:0) t a;
term sb_f {x: mor} (t: mor x) (p: wff x): wff;
notation sb_f {x: mor} (t: mor x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

notation emp: ctx = ($_$:max);

--| @relation mor mor_eq mor_refl_raw mor_trans_raw mor_sym_raw _
axiom mor_refl_raw (f: mor): $ f ~ f $;
axiom mor_trans_raw (f g h: mor):
  $ f ~ g $ > $ g ~ h $ > $ f ~ h $;
axiom mor_sym_raw (f g: mor): $ f ~ g $ > $ g ~ f $;

--| @relation obj obj_eq obj_refl obj_trans obj_sym _
axiom obj_refl (A: obj): $ obj_eq A A $;
axiom obj_trans (A B C: obj):
  $ obj_eq A B $ > $ obj_eq B C $ > $ obj_eq A C $;
axiom obj_sym (A B: obj): $ obj_eq A B $ > $ obj_eq B A $;

--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom imp_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;

--| @congr
axiom and_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;

--| @congr
axiom all_congr {x: mor} (p q: wff x):
  $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;

--| @congr
axiom mor_eq_congr (f1 f2 g1 g2: mor):
  $ f1 ~ f2 $ > $ g1 ~ g2 $ > $ (f1 ~ g1) ↔ (f2 ~ g2) $;

--| @congr
axiom hom_congr (f g: mor) (A1 A2 B1 B2: obj):
  $ f ~ g $ > $ obj_eq A1 A2 $ > $ obj_eq B1 B2 $ >
  $ hom f A1 B1 ↔ hom g A2 B2 $;

--| @congr
axiom comp_congr (f1 f2 g1 g2: mor):
  $ f1 ~ f2 $ > $ g1 ~ g2 $ > $ f1 ∘ g1 ~ f2 ∘ g2 $;

--| @rewrite
axiom comp_assoc (f g h: mor): $ (f ∘ g) ∘ h ~ f ∘ (g ∘ h) $;

--| @rewrite
axiom sb_m_var {x: mor} (t: mor x): $ subst x / t x ~ t $;

--| @rewrite
axiom sb_m_other {x y: mor} (t: mor x): $ subst x / t y ~ y $;

--| @rewrite
axiom sb_m_irrel {x: mor} (t: mor x) (a: mor): $ subst x / t a ~ a $;

--| @rewrite
axiom sb_m_id {x: mor} (t: mor x) (A: obj): $ subst x / t (id A) ~ id A $;

--| @rewrite
axiom sb_m_comp {x: mor} (t: mor x) (a b: mor x):
  $ subst x / t (a ∘ b) ~ (subst x / t a ∘ subst x / t b) $;

--| @congr
axiom sb_f_congr {x: mor} (t1 t2: mor x) (p1 p2: wff x):
  $ t1 ~ t2 $ > $ p1 ↔ p2 $ > $ [x/t1] p1 ↔ [x/t2] p2 $;

--| @rewrite
axiom sb_f_mor_eq {x: mor} (t: mor x) (a b: mor x):
  $ [x/t] (a ~ b) ↔ (subst x / t a ~ subst x / t b) $;

--| @rewrite
axiom sb_f_hom {x: mor} (t: mor x) (a: mor x) (A B: obj):
  $ [x/t] hom a A B ↔ hom (subst x / t a) A B $;

--| @rewrite
axiom sb_f_imp {x: mor} (t: mor x) (p q: wff x):
  $ [x/t] (p → q) ↔ ([x/t] p → [x/t] q) $;

--| @rewrite
axiom sb_f_and {x: mor} (t: mor x) (p q: wff x):
  $ [x/t] (p ∧ q) ↔ ([x/t] p ∧ [x/t] q) $;

--| @rewrite
axiom sb_f_all {x y: mor} (t: mor x) (p: wff x y):
  $ [x/t] (∀ y p) ↔ ∀ y ([x/t] p) $;

axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

axiom imp_intro (g: ctx) (a b: wff): $ g , a ⊢ b $ > $ g ⊢ a → b $;

axiom imp_elim (g h: ctx) (a b: wff):
  $ g ⊢ a → b $ > $ h ⊢ a $ > $ g , h ⊢ b $;

axiom and_elim_l (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ a $;

axiom and_elim_r (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ b $;

axiom all_intro (g: ctx) {x: mor} (p: wff x): $ g ⊢ p $ > $ g ⊢ ∀ x p $;

--| @view {x: mor} (g: ctx x) (t: mor x) (p: wff x) (q: wff): $ g ⊢ ∀ x p $ > $ g ⊢ q $
--| @recover t q p x
axiom all_elim {x: mor} (g: ctx) (t: mor x) (p: wff x):
  $ g ⊢ ∀ x p $ > $ g ⊢ [x/t] p $;

axiom mor_refl (g: ctx) (f: mor): $ g ⊢ f ~ f $;

axiom mor_sym (g: ctx) (f h: mor): $ g ⊢ f ~ h $ > $ g ⊢ h ~ f $;

axiom mor_trans (g: ctx) (f h i: mor):
  $ g ⊢ f ~ h $ > $ g ⊢ h ~ i $ > $ g ⊢ f ~ i $;

axiom comp_right (g: ctx) (f h i: mor):
  $ g ⊢ f ~ h $ > $ g ⊢ f ∘ i ~ h ∘ i $;

axiom comp_left (g: ctx) (f h i: mor):
  $ g ⊢ f ~ h $ > $ g ⊢ i ∘ f ~ i ∘ h $;

def epi {.a .b: mor} (f: mor): wff =
  $ ∀ a ∀ b ((a ∘ f ~ b ∘ f) → (a ~ b)) $;

theorem epi_cancel_right (f g: mor):
  $ epi (g ∘ f) ⊢ epi g $;
