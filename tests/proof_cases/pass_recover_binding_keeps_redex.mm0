delimiter $ ( ) [ / ] $;
import "lib/ctx.mm0";
import "lib/iff.mm0";

sort mor;

term imp (a b: wff): wff;
infixr imp: $->$ prec 25;

term all {x: mor} (p: wff x): wff;
prefix all: $A.$ prec 41;

term mor_eq (f g: mor): wff;
infixl mor_eq: $~$ prec 15;
term comp (f g: mor): mor;
infixl comp: $o$ prec 35;

term sb_m {x: mor} (t: mor x) (a: mor x): mor;
notation sb_m {x: mor} (t: mor x) (a: mor x): mor =
  ($subst$:41) x ($/$:0) t a;
term sb_f {x: mor} (t: mor x) (p: wff x): wff;
notation sb_f {x: mor} (t: mor x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

notation emp: ctx = ($_$:max);

term nd (g: ctx) (a: wff): wff;
infixl nd: $|-$ prec 0;

--| @relation mor mor_eq mor_refl_raw mor_trans_raw mor_sym_raw _
axiom mor_refl_raw (f: mor): $ f ~ f $;
axiom mor_trans_raw (f g h: mor):
  $ f ~ g $ > $ g ~ h $ > $ f ~ h $;
axiom mor_sym_raw (f g: mor): $ f ~ g $ > $ g ~ f $;

--| @congr
axiom hyp_congr (a b: wff): $ a <-> b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a <-> b $ > $ (g |- a) <-> (h |- b) $;
--| @congr
axiom imp_congr (a b c d: wff):
  $ a <-> b $ > $ c <-> d $ > $ (a -> c) <-> (b -> d) $;
--| @congr
axiom all_congr {x: mor} (p q: wff x):
  $ p <-> q $ > $ A. x p <-> A. x q $;
--| @congr
axiom mor_eq_congr (f1 f2 g1 g2: mor):
  $ f1 ~ f2 $ > $ g1 ~ g2 $ > $ (f1 ~ g1) <-> (f2 ~ g2) $;
--| @congr
axiom comp_congr (f1 f2 g1 g2: mor):
  $ f1 ~ f2 $ > $ g1 ~ g2 $ > $ f1 o g1 ~ f2 o g2 $;
--| @congr
axiom sb_m_congr {x: mor} (t u a b: mor x):
  $ t ~ u $ > $ a ~ b $ > $ subst x / t a ~ subst x / u b $;
--| @congr
axiom sb_f_congr {x: mor} (t u: mor x) (p q: wff x):
  $ t ~ u $ > $ p <-> q $ > $ [x/t] p <-> [x/u] q $;

--| @rewrite
axiom sb_m_var {x: mor} (t: mor x): $ subst x / t x ~ t $;
--| @rewrite
axiom sb_m_other {x y: mor} (t: mor x): $ subst x / t y ~ y $;
--| @rewrite
axiom sb_m_irrel {x: mor} (t: mor x) (a: mor): $ subst x / t a ~ a $;
--| @rewrite
axiom sb_m_comp {x: mor} (t: mor x) (a b: mor x):
  $ subst x / t (a o b) ~ (subst x / t a o subst x / t b) $;
--| @rewrite
axiom sb_f_mor_eq {x: mor} (t: mor x) (a b: mor x):
  $ [x/t] (a ~ b) <-> (subst x / t a ~ subst x / t b) $;
--| @rewrite
axiom sb_f_imp {x: mor} (t: mor x) (p q: wff x):
  $ [x/t] (p -> q) <-> ([x/t] p -> [x/t] q) $;
--| @rewrite
axiom sb_f_all {x y: mor} (t: mor x) (p: wff x y):
  $ [x/t] (A. y p) <-> A. y ([x/t] p) $;

--| @view (g: ctx) {x: mor} (t: mor x) (p: wff x) (q: wff): $ g |- A. x p $ > $ g |- q $
--| @recover t q p x
axiom all_elim (g: ctx) {x: mor} (t: mor x) (p: wff x):
  $ g |- A. x p $ > $ g |- [x/t] p $;

term e: mor;

-- `rr` has no substitution @rewrite and nothing below mentions it. Its
-- body matches the ref's `k1 o (a o x)`, and the view's `p` once reached
-- the rule folded into `rr a x`, where `[x/w]` cannot be pushed through
-- (#626).
def k0: mor = $ e $;
def k1: mor = $ k0 o e $;
def rr (a b: mor): mor = $ k1 o (a o b) $;

theorem pass_recover_binding_keeps_redex {x: mor} (a f w: mor):
  $ emp |- A. x (k1 o (a o x) ~ f) $ > $ emp |- k1 o (a o w) ~ f $;
