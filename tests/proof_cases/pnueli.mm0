-- Linear-time temporal logic: safety and liveness of a sticky-bit server.
--
-- G p means p holds now and forever; F p includes the current instant.
-- The server laws are an explicit assumption, not logical axioms.
-- First derive reusable invariant rules, then eventual joint response,
-- persistence of a joint response, and the combined safety/liveness claim.
-- This is a propositional abstraction: it does not model resetting bits,
-- individual request identities, or a bound on response time.

delimiter $ ( ) $;
provable sort wff;
sort ctx;

term imp (a b: wff): wff;
infixr imp: $→$ prec 25;
term and (a b: wff): wff;
infixr and: $∧$ prec 30;

-- Linear-time temporal operators.
term next (a: wff): wff;
prefix next: $○$ prec 40;
term globally (a: wff): wff;
prefix globally: $G$ prec 40;
term eventually (a: wff): wff;
prefix eventually: $F$ prec 40;

-- Atomic propositions for the request/response server.
term req: wff;
term res: wff;

term iff (a b: wff): wff;
infixr iff: $↔$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;
notation emp: ctx = ($_$:max);

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (a: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a ↔ a $;
axiom iff_trans (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom iff_sym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom iff_mp (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (g1 , h1) (g2 , h2) $;

--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a ↔ b $ > $ (g ⊢ a) ↔ (h ⊢ b) $;

--| @congr
axiom imp_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a → c) ↔ (b → d) $;

--| @congr
axiom and_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;

--| @congr
axiom next_congr (a b: wff): $ a ↔ b $ > $ ○ a ↔ ○ b $;

--| @congr
axiom globally_congr (a b: wff): $ a ↔ b $ > $ G a ↔ G b $;

--| @congr
axiom eventually_congr (a b: wff): $ a ↔ b $ > $ F a ↔ F b $;

-- Propositional ND fragment.
axiom ax (g: ctx) (a: wff): $ g , a ⊢ a $;

axiom imp_intro (g: ctx) (a b: wff):
  $ g , a ⊢ b $ > $ g ⊢ a → b $;

axiom imp_elim (g: ctx) (a b: wff):
  $ g ⊢ a → b $ > $ g ⊢ a $ > $ g ⊢ b $;

axiom and_intro (g: ctx) (a b: wff):
  $ g ⊢ a $ > $ g ⊢ b $ > $ g ⊢ a ∧ b $;

axiom and_elim_l (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ a $;
axiom and_elim_r (g: ctx) (a b: wff): $ g ⊢ a ∧ b $ > $ g ⊢ b $;

-- LTL inference rules.
--
-- These are sound under the standard "linear, discrete, infinite future"
-- semantics where worlds are natural-number stamps and ⊢ asserts a fact
-- "now" given hypotheses "now". Note that necessitation (from `g ⊢ a`,
-- conclude `g ⊢ G a`) is NOT sound for arbitrary g — only the rules below
-- are admitted.

-- K-axiom (modus ponens under G).
axiom gop_K (g: ctx) (a b: wff):
  $ g ⊢ G (a → b) $ > $ g ⊢ G a $ > $ g ⊢ G b $;

-- T-axiom (reflexivity: G refers to all worlds including the current one).
axiom gop_T (g: ctx) (a: wff): $ g ⊢ G a $ > $ g ⊢ a $;

-- Conjunction under G.
axiom gop_and (g: ctx) (a b: wff):
  $ g ⊢ G a $ > $ g ⊢ G b $ > $ g ⊢ G (a ∧ b) $;

-- Pnueli's induction rule: from a step law and a base case, conclude
-- a global invariant.
axiom gop_ind (g: ctx) (a: wff):
  $ g ⊢ G (a → ○ a) $ > $ g ⊢ a $ > $ g ⊢ G a $;

-- F-pair: an eventual `a` together with the always-implication `a → b`
-- yields an eventual state where both `b` and `a` hold simultaneously.
axiom fop_pair (g: ctx) (a b: wff):
  $ g ⊢ F a $ > $ g ⊢ G (a → b) $ > $ g ⊢ F (b ∧ a) $;

-- Server specification: two safety laws, liveness, and causality.
-- This transparent definition asserts nothing by itself. Only the final
-- server theorems assume it; the generic LTL rules above do not need it.
def server_spec: wff =
  $ G (req → ○ req) ∧ G (res → ○ res) ∧
    G (req → F res) ∧ G (res → req) $;

-- Pnueli's induction principle, stated as a wff implication.
theorem gop_ind_thm (p: wff):
  $ emp ⊢ ((G (p → ○ p)) → (p → G p)) $;

-- K-distribution stated as a wff implication.
theorem gop_K_thm (p q: wff):
  $ emp ⊢ ((G (p → q)) → ((G p) → G q)) $;

-- Two inductive invariants can be maintained simultaneously.
theorem invariant_pair (g: ctx) (p q: wff):
  $ g ⊢ G (p → ○ p) $ > $ g ⊢ G (q → ○ q) $ >
  $ g ⊢ p ∧ q $ > $ g ⊢ G (p ∧ q) $;

-- Safety: persistence requires both the step law and the current bit.
theorem stick_req (g: ctx):
  $ g ⊢ G (req → ○ req) $ > $ g ⊢ req $ > $ g ⊢ G req $;

theorem stick_res (g: ctx):
  $ g ⊢ G (res → ○ res) $ > $ g ⊢ res $ > $ g ⊢ G res $;

-- Liveness plus causality suffices for an eventual joint response.
-- Neither sticky-bit law is needed for this weaker claim.
theorem req_response (g: ctx):
  $ g ⊢ G (req → F res) $ > $ g ⊢ G (res → req) $ >
  $ g ⊢ req $ > $ g ⊢ F (req ∧ res) $;

-- Once both bits hold, both persist: an application of invariant_pair.
theorem response_stable:
  $ server_spec ⊢ (req ∧ res) → G (req ∧ res) $;

-- Combined safety and liveness: under the explicit server specification,
-- every request persists forever and eventually meets a response.
-- This is NOT G (req ∧ res): a response need not hold immediately.
theorem req_response_safe:
  $ server_spec ⊢ req → (G req ∧ F (req ∧ res)) $;
