-- Cardano's formula: the depressed cubic x³ + p x + q = 0, with
-- `conversion?` doing the algebra.
--
-- A cubic a x³ + b x² + c x + d = 0 loses its x² term under the shift
-- x ↦ x - b/3a, so x³ + p x + q = 0 is the general case. Cardano's method
-- writes the unknown as a sum x = u + v of two auxiliary unknowns and
-- expands:
--
--   x³ + p x + q  =  (u³ + v³ + q) + (3uv + p)(u + v).
--
-- So x is a root whenever u³ + v³ = -q and 3uv = -p. The second equation
-- gives u³v³ = (-p/3)³, which makes u³ and v³ the two roots of the
-- quadratic z² + q z - (p/3)³ = 0, namely -q/2 ± s with
-- s² = (q/2)² + (p/3)³. Extracting the roots, with the cube roots paired so
-- that uv = -p/3, is Cardano's formula:
--
--   x  =  ∛(-q/2 + s) + ∛(-q/2 - s),      s = √((q/2)² + (p/3)³).
--
-- This file has no root-extraction operations. The radicals are variables
-- pinned down by hypotheses instead: s² = (q/2)² + (p/3)³, u³ = -q/2 + s,
-- v³ = -q/2 - s, and p = -3uv. The theorems then check the algebra behind
-- the formula. `sum_of_cubes` is u³ + v³ = -q, `product_of_cubes` is
-- u³v³ = (-p/3)³ (the cube roots can be paired with uv = -p/3), and
-- `cardano` is the formula itself: x = u + v satisfies x³ + p x = -q.
--
-- The theory is a field written for `conversion?`: `@acui` on + and *,
-- the ring identities as `@compute` folds, division a / b = a * inv b as an
-- unfolding definition, `mul_inv` conditional on a ≠ 0, and the numeral 3
-- transparent as 1 + 1 + 1 so that the three cross terms of the cube
-- collect against 3uv. Every proof body in cardano.auf was produced by a
-- single `conversion?` search on the goal line kept in the comment above
-- it; in the web editor, restore that line and the code action regenerates
-- the chain.

delimiter $ ( ) - / $;

provable sort wff;
sort R;

term bi (a b: wff): wff;
infixl bi: $↔$ prec 20;
term eq (a b: R): wff;
infixl eq: $=$ prec 50;
term ne (a b: R): wff;
infixl ne: $≠$ prec 50;

term zero: R;
notation zero: R = ($0$:max);
term one: R;
notation one: R = ($1$:max);
--| @acui add_assoc add_comm zero _
term add (a b: R): R;
infixl add: $+$ prec 64;
--| @acui mul_assoc mul_comm one _
term mul (a b: R): R;
infixl mul: $*$ prec 70;
term neg (a: R): R;
prefix neg: $-$ prec 90;
term inv (a: R): R;

-- ------------------------------------------------------------------
-- Equality and congruence
-- ------------------------------------------------------------------

--| @relation wff bi bi_refl bi_trans bi_symm mpbi
axiom bi_refl (a: wff): $ a ↔ a $;
axiom bi_trans (a b c: wff): $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom bi_symm (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom mpbi (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

--| @relation R eq eq_refl eq_trans eq_symm _
axiom eq_refl (a: R): $ a = a $;
axiom eq_trans (a b c: R): $ a = b $ > $ b = c $ > $ a = c $;
axiom eq_symm (a b: R): $ a = b $ > $ b = a $;

--| @congr
axiom bi_congr (a b c d: wff): $ a ↔ b $ > $ c ↔ d $ > $ (a ↔ c) ↔ (b ↔ d) $;
--| @congr
axiom eq_congr (a b c d: R): $ a = b $ > $ c = d $ > $ (a = c) ↔ (b = d) $;
--| @congr
axiom ne_congr (a b c d: R): $ a = b $ > $ c = d $ > $ (a ≠ c) ↔ (b ≠ d) $;
--| @congr
axiom add_congr (a b c d: R): $ a = b $ > $ c = d $ > $ a + c = b + d $;
--| @congr
axiom mul_congr (a b c d: R): $ a = b $ > $ c = d $ > $ a * c = b * d $;
--| @congr
axiom neg_congr (a b: R): $ a = b $ > $ -a = -b $;
--| @congr
axiom inv_congr (a b: R): $ a = b $ > $ inv a = inv b $;

-- ------------------------------------------------------------------
-- Field axioms
-- ------------------------------------------------------------------

--| @conversion assoc
axiom add_assoc (a b c: R): $ (a + b) + c = a + (b + c) $;
--| @conversion comm
axiom add_comm (a b: R): $ a + b = b + a $;
--| @conversion assoc
axiom mul_assoc (a b c: R): $ (a * b) * c = a * (b * c) $;
--| @conversion comm
axiom mul_comm (a b: R): $ a * b = b * a $;

--| @compute ltr
axiom add_zero (a: R): $ a + 0 = a $;
--| @compute ltr
axiom mul_zero (a: R): $ a * 0 = 0 $;
--| @compute ltr
axiom mul_one (a: R): $ a * 1 = a $;
--| @compute ltr
axiom add_neg (a: R): $ a + -a = 0 $;
--| @compute ltr
axiom distrib (a b c: R): $ a * (b + c) = a * b + a * c $;
--| @compute ltr
axiom neg_mul (a b: R): $ (-a) * b = -(a * b) $;
--| @compute ltr
axiom neg_neg (a: R): $ -(-a) = a $;
-- Enrolled as a plain conversion, not a fold: as a fold it would
-- distribute every negated sum in sight.
--| @conversion ltr
axiom neg_add (a b: R): $ -(a + b) = -a + -b $;

--| @conversion ltr
axiom mul_inv (a: R): $ a ≠ 0 $ > $ a * inv a = 1 $;

--| @conversion unfold
def div (a b: R): R = $ a * inv b $;
infixl div: $/$ prec 70;

-- ------------------------------------------------------------------
-- Numerals. Halves and thirds must exist, so 2 and 3 are nonzero.
-- ------------------------------------------------------------------

def two: R = $ 1 + 1 $;
notation two: R = ($2$:max);
--| @conversion unfold
def three: R = $ 1 + 1 + 1 $;
notation three: R = ($3$:max);
axiom two_ne_zero: $ 2 ≠ 0 $;
axiom three_ne_zero: $ 3 ≠ 0 $;

-- ------------------------------------------------------------------
-- Cardano
-- ------------------------------------------------------------------

-- Two halves make a whole. Collecting numerals in general (a + a = 2 * a)
-- would turn 0 + 0 into 2 * 0 and keep the search busy inside the class of
-- zero, so only this instance is enrolled as a fold.
--| @compute ltr
theorem halves (a: R): $ -(a / 2) + -(a / 2) = -a $;

-- Vieta, first half: the sum of the cube roots' cubes is -q.
theorem sum_of_cubes (u v q s: R)
  (hu: $ u * u * u = -(q / 2) + s $)
  (hv: $ v * v * v = -(q / 2) + -s $):
  $ u * u * u + v * v * v = -q $;

-- Vieta, second half: the product of the cubes is (-p/3)³, so the cube
-- roots can be paired with uv = -p/3.
theorem product_of_cubes (u v p q s: R)
  (hs: $ s * s = (q / 2) * (q / 2) + (p / 3) * (p / 3) * (p / 3) $)
  (hu: $ u * u * u = -(q / 2) + s $)
  (hv: $ v * v * v = -(q / 2) + -s $):
  $ (u * u * u) * (v * v * v) = -(p / 3) * -(p / 3) * -(p / 3) $;

-- Cardano's formula: with the cube roots paired as p = -3uv, x = u + v
-- satisfies x³ + p x + q = 0.
theorem cardano (u v p q s: R)
  (hp: $ p = -(3 * u * v) $)
  (hu: $ u * u * u = -(q / 2) + s $)
  (hv: $ v * v * v = -(q / 2) + -s $):
  $ (u + v) * (u + v) * (u + v) + p * (u + v) = -q $;
