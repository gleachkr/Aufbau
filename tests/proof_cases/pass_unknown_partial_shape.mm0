delimiter $ ( ) $;
--| @hole _wff
--| @unknown ?
provable sort wff;
--| @hole _ctx
--| @unknown ?G
sort ctx;
--| @hole _set
sort set;

term iff (a b: wff): wff;
infixr iff: $<->$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
term hyp (a: wff): ctx;
term nd (g: ctx) (a: wff): wff;
term all {x: set} (p: wff x): wff;
prefix all: $A.$ prec 41;
term pred (t: set): wff;
prefix pred: $P$ prec 50;
term sb (t: set) {x: set} (p: wff x): wff;
term and (a b: wff): wff;
infixr and: $/\$ prec 30;
term qred (t: set): wff;
prefix qred: $Q$ prec 50;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a <-> a $;
axiom iff_trans (a b c: wff):
  $ a <-> b $ > $ b <-> c $ > $ a <-> c $;
axiom iff_sym (a b: wff): $ a <-> b $ > $ b <-> a $;
axiom iff_mp (a b: wff): $ a <-> b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq (join (join g h) i) (join g (join h i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (join g h) (join h g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (join g g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (join emp g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ >
  $ ctx_eq (join g1 h1) (join g2 h2) $;

--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a <-> b $ > $ nd g a <-> nd h b $;

--| @congr
axiom and_congr (a b c d: wff):
  $ a <-> b $ > $ c <-> d $ > $ (a /\ c) <-> (b /\ d) $;
--| @rewrite
axiom sb_pred (t: set) {x: set}: $ sb t x (P x) <-> P t $;
--| @rewrite
axiom sb_qred (t: set) {x: set}: $ sb t x (Q x) <-> Q t $;
--| @rewrite
axiom sb_and (t: set) {x: set} (p q: wff x):
  $ sb t x (p /\ q) <-> (sb t x p /\ sb t x q) $;

--| @view (g: ctx) {x: set} (t: set) (p: wff x) (q: wff): $ nd g (A. x p) $ > $ nd g q $
--| @recover t q p x
axiom all_elim (g: ctx) {x: set} (t: set) (p: wff x):
  $ nd g (A. x p) $ > $ nd g (sb t x p) $;
-- A context the view conclusion splits, as forallx's `ga ; de`.
--| @view (g h: ctx) {x: set} (t: set) (p: wff x) (q: wff): $ nd g (A. x p) $ > $ nd (join g h) q $
--| @recover t q p x
axiom all_elim_w (g h: ctx) {x: set} (t: set) (p: wff x):
  $ nd g (A. x p) $ > $ nd (join g h) (sb t x p) $;
axiom and_l (g: ctx) (a b: wff): $ nd g (a /\ b) $ > $ nd g a $;
axiom and_r (g: ctx) (a b: wff): $ nd g (a /\ b) $ > $ nd g b $;

-- The later line forces `?f = P u /\ _`: written into l1, the view rule
-- reads `u` off the visible conjunct and fills the rest.
theorem unknown_partial_shape (a: wff) (u: set) {x: set}:
  $ nd (hyp a) (A. x (P x /\ Q x)) $ > $ nd (hyp a) (P u) $;
-- The open part is a name of its own, written as that name.
theorem unknown_partial_shape_named (a: wff) (u: set) {x: set}:
  $ nd (hyp a) (A. x (P x /\ Q x)) $ > $ nd (hyp a) (Q u) $;
