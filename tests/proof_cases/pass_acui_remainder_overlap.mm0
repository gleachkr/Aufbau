import "lib/seq.mm0";

term imp (a b: wff): wff;
infixr imp: $→$ prec 25;
infixr imp: $->$ prec 25;
term not (a: wff): wff;
prefix not: $¬$ prec 35;
prefix not: $~$ prec 35;
term bot: wff;

axiom imp_app (g: ctx) (a b c: wff):
  $ g ⇒ a $ > $ g , b ⇒ c $ > $ g , (a → b) ⇒ c $;

theorem acui_remainder_overlap (a b: wff):
  $ emp , ((a → b) → a) , ¬ a ⇒ a → b $
  > $ emp , ((a → b) → a) , ¬ a , a ⇒ bot $
  > $ emp , ((a → b) → a) , ¬ a ⇒ bot $;
