delimiter $ ( ) $;
provable sort wff;
sort ctx;

term iff (a b: wff): wff;
infixr iff: $↔$ prec 20;
infixr iff: $<->$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp _
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;
term seq (g d: ctx): wff;
infixl seq: $==>$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a ↔ a $;
axiom iff_trans (a b c: wff):
  $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom iff_sym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom iff_mp (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;

--| @congr
axiom seq_congr (g1 g2 d1 d2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq d1 d2 $ > $ (g1 ==> d1) ↔ (g2 ==> d2) $;

term picks (g d: ctx): wff;

--| @congr
axiom picks_congr (g1 g2 d1 d2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq d1 d2 $ > $ picks g1 d1 ↔ picks g2 d2 $;

axiom unfocus (g d u: ctx): $ picks (g , d) d $ > $ g , d ==> u $;

def dd (a: wff): wff = $ a $;

-- `d` is fixed to `x`, which `dd x` also matches, so neither member's copy
-- count in `d` is known in advance: the splits are listed and checked
-- against `d` rather than counted.
theorem acu_def_member_split (x y u: wff) (h: $ picks (x , dd x , y) x $):
  $ x , dd x , y ==> u $;
