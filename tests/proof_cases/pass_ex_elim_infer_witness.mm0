-- #216 minimal repro (one sort, no split ambiguity): premise-side
-- eigenvariable inference for substitution-form ∃-elimination. The witness u
-- appears ONLY inside the second premise's [x/u] p instance — never in the
-- conclusion — so the @recover must fire against a premise. The second
-- premise's context has a single member, so the h , q split is forced and
-- the only difficulty is solving the open witness through the sb_f rewrite.
delimiter $ ( ) [ / ] $;
import "lib/ctx.mm0";

--| @vars x y z u w
sort nat;

term iff (p q: wff): wff;
infixr iff: $↔$ prec 20;

term all {x: nat} (p: wff x): wff;
prefix all: $∀$ prec 46;
term ex {x: nat} (p: wff x): wff;
prefix ex: $∃$ prec 46;

term eq (s t: nat): wff;
infixl eq: $=$ prec 50;

term F (t: nat): wff;

term sb_t {x: nat} (t: nat x) (s: nat x): nat;
notation sb_t {x: nat} (t: nat x) (s: nat x): nat =
  ($subst$:41) x ($/$:0) t s;
term sb_f {x: nat} (t: nat x) (p: wff x): wff;
notation sb_f {x: nat} (t: nat x) (p: wff x): wff =
  ($[$:41) x ($/$:0) t ($]$:0) p;

notation emp: ctx = ($_$:max);

term nd (g: ctx) (p: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (p: wff): $ p ↔ p $;
axiom iff_trans (p q r: wff): $ p ↔ q $ > $ q ↔ r $ > $ p ↔ r $;
axiom iff_sym (p q: wff): $ p ↔ q $ > $ q ↔ p $;
axiom iff_mp (p q: wff): $ p ↔ q $ > $ p $ > $ q $;

--| @relation nat eq eq_refl eq_trans eq_sym _
axiom eq_refl (s: nat): $ s = s $;
axiom eq_trans (s t v: nat): $ s = t $ > $ t = v $ > $ s = v $;
axiom eq_sym (s t: nat): $ s = t $ > $ t = s $;

--| @congr
axiom hyp_congr (p q: wff): $ p ↔ q $ > $ ctx_eq (hyp p) (hyp q) $;
--| @congr
axiom nd_congr (g h: ctx) (p q: wff):
  $ ctx_eq g h $ > $ p ↔ q $ > $ (g ⊢ p) ↔ (h ⊢ q) $;
--| @congr
axiom F_congr (s t: nat): $ s = t $ > $ F s ↔ F t $;
--| @congr
axiom all_congr {x: nat} (p q: wff x): $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @congr
axiom ex_congr {x: nat} (p q: wff x): $ p ↔ q $ > $ ∃ x p ↔ ∃ x q $;

--| @rewrite
axiom sb_f_F {x: nat} (t: nat x) (s: nat x):
  $ [x/t] (F s) ↔ F (subst x / t s) $;
--| @rewrite
axiom sb_f_irrel {x: nat} (t: nat x) (p: wff): $ [x/t] p ↔ p $;
--| @rewrite
axiom sb_t_var {x: nat} (t: nat x): $ (subst x / t x) = t $;
--| @rewrite
axiom sb_t_irrel {x: nat} (t: nat x) (s: nat): $ (subst x / t s) = s $;

axiom ax (g: ctx) (p: wff): $ g , p ⊢ p $;

--| @view {x: nat} (g: ctx x) (t: nat x) (p: wff x) (q: wff): $ g ⊢ q $ > $ g ⊢ ∃ x p $
--| @recover t q p x
axiom ex_intro {x: nat} (g: ctx x) (t: nat x) (p: wff x):
  $ g ⊢ [x/t] p $ > $ g ⊢ ∃ x p $;

--| @view {x u: nat} (g: ctx x u) (h: ctx x) (p: wff x) (q c: wff): $ g ⊢ ∃ x p $ > $ h , q ⊢ c $ > $ g , h ⊢ c $
--| @recover u q p x
axiom ex_elim {x u: nat} (g: ctx x u) (h: ctx x) (p: wff x) (c: wff):
  $ g ⊢ ∃ x p $ > $ h , [x/u] p ⊢ c $ > $ g , h ⊢ c $;

theorem ex_rename {x y: nat}: $ ∃ x (F x) ⊢ ∃ y (F y) $;
