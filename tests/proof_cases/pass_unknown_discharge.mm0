delimiter $ ( ) $;
--| @hole _
--| @unknown ?
provable sort wff;
sort ctx;
term emp: ctx;
term cons (g: ctx) (a: wff): ctx;
infixl cons: $,$ prec 5;
term pf (g: ctx) (a: wff): wff;
infixl pf: $|-$ prec 2;
term imp (a b: wff): wff;
infixr imp: $->$ prec 25;
axiom ax (g: ctx) (a: wff): $ g , a |- a $;
axiom imp_intro (g: ctx) (a b: wff): $ g , a |- b $ > $ g |- a -> b $;
theorem self2 (g: ctx) (p: wff): $ g |- p -> p $;
