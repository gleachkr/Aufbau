-- Herbrand's rules of passage: prenexification as `conversion?` search.
--
-- The "règles de passage" of Herbrand's thesis move a quantifier past a
-- connective when the other operand does not mention the bound variable:
--
--   ∀x (a ∧ b(x))  ↔  a ∧ ∀x b(x)      [x not free in a]
--   (∀x b(x)) → a  ↔  ∃x (b(x) → a)    [x not free in a]   ... etc.
--
-- Applied left-to-right they drive every quantifier to the front (prenex
-- normal form); right-to-left they miniscope. This fixture states the full
-- set as `@conversion` axioms — plus an alpha-conversion battery over an
-- object-level substitution calculus (`@conversion alpha`, below) — and
-- proves prenexifications, reverse prenexifications, and bound-variable
-- renamings whose proofs were each produced by a single
-- `conversion?` search — the egraph explores the passage laws in both
-- directions at once and emits the ordinary rewrite chain you see in
-- herbrand.auf. In the web editor, replace any proof body with its
-- one-line original (kept in a comment above each proof)
--
--   goal: $ ... $ by conversion?
--
-- and the code action regenerates it.
--
-- The side conditions are not checked by any bespoke machinery: `a: form`
-- (declared without `x`) *is* the proviso, enforced by MM0's dependency
-- discipline. The `conversion?` egraph respects it by construction — a
-- passage law only fires when the moved operand's e-class can denote an
-- x-free formula, so unsound instances like `P x ⊢ ∀x P x` (via the
-- vacuous-quantifier law) are never even proposed, while a local
-- equivalence in scope can legitimately unlock the same law
-- (`constant_gen` below).

delimiter $ ( ) $;

provable sort form;

--| @vars x y z u v w
sort obj;

-- ============================================================
-- Formula language
-- ============================================================

term im (a b: form): form;
infixr im: $→$ prec 25;
term an (a b: form): form;
infixr an: $∧$ prec 35;
term or (a b: form): form;
infixr or: $∨$ prec 30;
term not (a: form): form;
prefix not: $¬$ prec 40;
term bi (a b: form): form;
infixl bi: $↔$ prec 20;

term all {x: obj} (p: form x): form;
prefix all: $∀$ prec 41;
term ex {x: obj} (p: form x): form;
prefix ex: $∃$ prec 41;

-- Schematic predicate symbols for concrete goals.
term P (a: obj): form;
prefix P: $P$ prec 45;
term Q (a: obj): form;
prefix Q: $Q$ prec 45;

-- ============================================================
-- Equivalence scaffolding: the ↔ relation bundle and congruence
-- rules for every connective the chains rewrite under.
-- ============================================================

--| @relation form bi bi_refl bi_trans bi_symm mpbi
axiom bi_refl (a: form): $ a ↔ a $;
axiom bi_trans (a b c: form) (h1: $ a ↔ b $) (h2: $ b ↔ c $):
  $ a ↔ c $;
axiom bi_symm (a b: form) (h: $ a ↔ b $): $ b ↔ a $;
axiom mpbi (a b: form) (h1: $ a ↔ b $) (h2: $ a $): $ b $;

--| @congr
axiom an_congr (a b c d: form) (h1: $ a ↔ b $) (h2: $ c ↔ d $):
  $ (a ∧ c) ↔ (b ∧ d) $;
--| @congr
axiom or_congr (a b c d: form) (h1: $ a ↔ b $) (h2: $ c ↔ d $):
  $ (a ∨ c) ↔ (b ∨ d) $;
--| @congr
axiom im_congr (a b c d: form) (h1: $ a ↔ b $) (h2: $ c ↔ d $):
  $ (a → c) ↔ (b → d) $;
--| @congr
axiom not_congr (a b: form) (h: $ a ↔ b $): $ (¬ a) ↔ (¬ b) $;
--| @congr
axiom all_congr {x: obj} (p q: form x) (h: $ p ↔ q $):
  $ (∀ x p) ↔ (∀ x q) $;
--| @congr
axiom ex_congr {x: obj} (p q: form x) (h: $ p ↔ q $):
  $ (∃ x p) ↔ (∃ x q) $;

-- ============================================================
-- The rules of passage. In each, `a: form` cannot mention x —
-- that declaration is the classical side condition.
-- ============================================================

--| @conversion both
axiom pass_al_an {x: obj} (a: form) (b: form x):
  $ (∀ x (a ∧ b)) ↔ (a ∧ (∀ x b)) $;
--| @conversion both
axiom pass_al_or {x: obj} (a: form) (b: form x):
  $ (∀ x (a ∨ b)) ↔ (a ∨ (∀ x b)) $;
--| @conversion both
axiom pass_ex_an {x: obj} (a: form) (b: form x):
  $ (∃ x (a ∧ b)) ↔ (a ∧ (∃ x b)) $;
--| @conversion both
axiom pass_ex_or {x: obj} (a: form) (b: form x):
  $ (∃ x (a ∨ b)) ↔ (a ∨ (∃ x b)) $;
--| @conversion both
axiom pass_im_ante_al {x: obj} (a: form) (b: form x):
  $ ((∀ x b) → a) ↔ (∃ x (b → a)) $;
--| @conversion both
axiom pass_im_ante_ex {x: obj} (a: form) (b: form x):
  $ ((∃ x b) → a) ↔ (∀ x (b → a)) $;
--| @conversion both
axiom pass_im_cons_al {x: obj} (a: form) (b: form x):
  $ (a → (∀ x b)) ↔ (∀ x (a → b)) $;
--| @conversion both
axiom pass_im_cons_ex {x: obj} (a: form) (b: form x):
  $ (a → (∃ x b)) ↔ (∃ x (a → b)) $;

-- Negation passage: no side condition, the binder is fully dependent.
--| @conversion both
axiom neg_al {x: obj} (b: form x): $ (¬ (∀ x b)) ↔ (∃ x (¬ b)) $;
--| @conversion both
axiom neg_ex {x: obj} (b: form x): $ (¬ (∃ x b)) ↔ (∀ x (¬ b)) $;

-- Vacuous quantification. Enrolled ltr only: the right-hand side is a
-- bare formula variable, which cannot be e-matched.
--| @conversion ltr
axiom al_vac {x: obj} (a: form): $ (∀ x a) ↔ a $;
--| @conversion ltr
axiom ex_vac {x: obj} (a: form): $ (∃ x a) ↔ a $;

-- Commutations, so each passage law (stated with the x-free operand on
-- the left) also reaches the mirrored operand order. The `comm` role
-- token certifies the law's shape; without a matching `assoc`
-- certificate the theorems still enroll for ordinary both-ways
-- saturation (comm alone cannot be absorbed into bag interning).
--| @conversion comm
axiom an_comm (a b: form): $ (a ∧ b) ↔ (b ∧ a) $;
--| @conversion comm
axiom or_comm (a b: form): $ (a ∨ b) ↔ (b ∨ a) $;

-- ============================================================
-- Alpha conversion. `sb x y p` is object-level substitution of y
-- for x in p; the calculus below pushes it through every
-- connective, and the two alpha laws relate a quantifier to its
-- renamed image. `@conversion alpha` cannot enroll for ordinary
-- saturation (y appears only on the right); instead the pairing
-- scheduler fires a literal instance whenever two same-head
-- binder e-nodes look like renamings of each other, and the sb
-- rules reduce the substitution image until congruence closes
-- the gap. The freshness side condition is, once again, just the
-- dependency discipline: `p: form x` cannot mention y.
-- ============================================================

term sb {x: obj} (y: obj) (p: form x): form;

-- `sb` is a first-class operator, so chains must be able to rewrite
-- INSIDE a substitution image — which takes a @congr rule for sb, and
-- stating one requires a relation on obj for the variable slot. `=o`
-- is equality of object variables; the emitted chains only ever cite
-- `eqo_refl` (the variable slots themselves never rewrite), but the
-- bundle is what lets `sb_congr` enroll.
term eqo (a b: obj): form;
infixl eqo: $=o$ prec 50;
--| @relation obj eqo eqo_refl eqo_trans eqo_symm _
axiom eqo_refl (a: obj): $ a =o a $;
axiom eqo_trans (a b c: obj) (h1: $ a =o b $) (h2: $ b =o c $):
  $ a =o c $;
axiom eqo_symm (a b: obj) (h: $ a =o b $): $ b =o a $;

--| @congr
axiom sb_congr {x: obj} (y z: obj) (a b: form x)
  (hy: $ y =o z $) (h: $ a ↔ b $): $ (sb x y a) ↔ (sb x z b) $;

--| @conversion alpha
axiom all_alpha {x y: obj} (p: form x):
  $ (∀ x p) ↔ (∀ y (sb x y p)) $;
--| @conversion alpha
axiom ex_alpha {x y: obj} (p: form x):
  $ (∃ x p) ↔ (∃ y (sb x y p)) $;

-- The substitution calculus, enrolled left-to-right only: each
-- right-hand side merely rearranges material the match side
-- already binds. `sb_const` carries the classical "x not free in
-- a" proviso the same way the passage laws do.
--| @conversion ltr
axiom sb_p {x: obj} (y: obj): $ (sb x y (P x)) ↔ (P y) $;
--| @conversion ltr
axiom sb_q {x: obj} (y: obj): $ (sb x y (Q x)) ↔ (Q y) $;
--| @conversion ltr
axiom sb_an {x: obj} (y: obj) (a b: form x):
  $ (sb x y (a ∧ b)) ↔ ((sb x y a) ∧ (sb x y b)) $;
--| @conversion ltr
axiom sb_or {x: obj} (y: obj) (a b: form x):
  $ (sb x y (a ∨ b)) ↔ ((sb x y a) ∨ (sb x y b)) $;
--| @conversion ltr
axiom sb_im {x: obj} (y: obj) (a b: form x):
  $ (sb x y (a → b)) ↔ ((sb x y a) → (sb x y b)) $;
--| @conversion ltr
axiom sb_not {x: obj} (y: obj) (a: form x):
  $ (sb x y (¬ a)) ↔ (¬ (sb x y a)) $;
--| @conversion ltr
axiom sb_const {x: obj} (y: obj) (a: form): $ (sb x y a) ↔ a $;

-- Binder commutation: pushes a substitution image through an inner
-- quantifier. The comparator recognizes a two-binder rename
-- outside-in: only the outer alpha instance fires, the inner pair is
-- closed on a later pass once the image has crossed the inner
-- binder — via these laws, or (in this theory) via a passage detour
-- rewritten under sb through sb_congr. The z ≠ y proviso is the
-- dependency discipline yet again: z (a regular variable) can never
-- be instantiated with a bound variable of the instance.
--| @conversion ltr
axiom sb_all {x y: obj} (z: obj) (p: form x y):
  $ (sb x z (∀ y p)) ↔ (∀ y (sb x z p)) $;
--| @conversion ltr
axiom sb_ex {x y: obj} (z: obj) (p: form x y):
  $ (sb x z (∃ y p)) ↔ (∃ y (sb x z p)) $;

-- ============================================================
-- The battery. Every proof in herbrand.auf is `conversion?` output.
-- ============================================================

-- Reverse prenexification with a commuted operand: the quantifier leaves
-- a disjunction whose x-free part sits on the wrong side for the law.
theorem prenex_or {x: obj} (q: form) (h: $ ∀ x ((P x) ∨ q) $):
  $ (∀ x (P x)) ∨ q $;

-- Half of the drinker: an antecedent ∀ flips to an ∃ over the whole
-- implication.
theorem drinker_half {x: obj} (q: form) (h: $ ∃ x ((P x) → q) $):
  $ (∀ x (P x)) → q $;

-- Miniscoping in reverse: push a conjunct into the quantifier.
theorem miniscope_an {x: obj} (q: form) (h: $ (∃ x (P x)) ∧ q $):
  $ ∃ x ((P x) ∧ q) $;

-- Negation passage.
theorem prenex_neg {x: obj} (h: $ ∃ x (¬ (P x)) $): $ ¬ (∀ x (P x)) $;

-- Two quantifiers pulled out of one implication, one from each side.
theorem prenex_two {x y: obj} (h: $ (∀ x (P x)) → (∃ y (Q y)) $):
  $ ∃ x (∃ y ((P x) → (Q y))) $;

-- A full prenexification: commute, pull ∃ out of the disjunction, flip
-- it across the implication, then pull the consequent's ∀ through.
theorem prenex_deep {x y: obj} (q: form)
  (h: $ ((∃ x (P x)) ∨ q) → (∀ y (Q y)) $):
  $ ∀ x (∀ y (((P x) ∨ q) → (Q y))) $;

-- Generalization is unsound in general — `P x ⊢ ∀x P x` gets refused,
-- and `conversion?` reports the dependency constraint. But a local
-- equivalence certifying that P x does not really depend on x makes the
-- vacuous-quantifier law legal, and the chain must cite the x-free
-- representative `p` inside the quantifier, never `P x` itself.
theorem constant_gen {x: obj} (p: form) (h1: $ (P x) ↔ p $)
  (h2: $ P x $): $ ∀ x (P x) $;

-- ============================================================
-- Alpha battery. As above, every proof is a single `conversion?`
-- search; the chains cite the alpha law, the sb calculus, and
-- congruence — no bespoke machinery in the emitted proof. Most
-- goals mix alpha with the passage laws in one search; only the
-- first two are renames alone.
-- ============================================================

-- A pure rename as an equation goal (no hypothesis to transport).
theorem rename_iff {x y: obj}: $ (∀ x (P x)) ↔ (∀ y (P y)) $;

-- A pure rename with a deep substitution image: sb pushes through
-- ¬, ∧ and ∨ before `sb_const` discharges the x-free leaf. No
-- passage law can move the quantifier — both conjuncts mention x.
theorem rename_deep {x y: obj} (q: form)
  (h: $ ∀ x ((¬ (P x)) ∧ ((Q x) ∨ q)) $):
  $ ∀ y ((¬ (P y)) ∧ ((Q y) ∨ q)) $;

-- Passage and alpha in one search: the quantifier must first leave
-- the disjunction (commute, pass ∀ out), and only then does the
-- renamed pair exist for the scheduler to find — the alpha partner
-- is an e-node minted mid-saturation, not a seeded term.
theorem rename_prenex {x y: obj} (q: form) (h: $ ∀ x ((P x) ∨ q) $):
  $ (∀ y (P y)) ∨ q $;

-- Negation passage plus a rename through ¬.
theorem rename_neg {x y: obj} (h: $ ¬ (∃ x (P x)) $):
  $ ∀ y (¬ (P y)) $;

-- A nested rename: both quantifiers change and the body mentions
-- both, so no single alpha instance closes the gap. The outer
-- rename fires first, `sb_ex` pushes its image through the inner
-- binder, and the inner pair — which only exists once that image
-- reduces — is found on a later pass. `sb_const` discharges each
-- leaf the substitution cannot touch.
theorem rename_nested {x y u v: obj}
  (h: $ ∀ x (∃ y ((P x) ∧ (Q y))) $):
  $ ∀ u (∃ v ((P u) ∧ (Q v))) $;

-- Prenexification straight into a renamed binder: the ∃ flips
-- across the implication as a ∀, whose bound variable then has to
-- be renamed to reach the goal.
theorem prenex_rename {x u: obj} (q: form) (h: $ (∃ x (P x)) → q $):
  $ ∀ u ((P u) → q) $;

-- The prenex_two goal with both prenexed binders renamed: two
-- passage laws pull the quantifiers out, then a nested rename
-- rewrites both bound variables through the commutation rule.
theorem prenex_rename_two {x y u v: obj}
  (h: $ (∀ x (P x)) → (∃ y (Q y)) $):
  $ ∃ u (∃ v ((P u) → (Q v))) $;
