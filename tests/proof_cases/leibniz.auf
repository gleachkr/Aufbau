eq_subst_in_place
-----------------

l1: $ [x | a] q = [x | b] q $ by eq_subst [#1]
l2: $ p = [x | b] q $ by eq_trans [#2, l1]

sub_add_in_place
----------------

l1: $ (a + b) - (c + d) = (a - c) + (b - d) $ by sub_add []
l2: $ p = [x | (a - c) + (b - d)] q $ by eq_subst_in_place [l1, #1]

div_add_in_place
----------------

l1: $ (a + b) / c = a / c + b / c $ by div_add []
l2: $ p = [x | a / c + b / c] q $ by eq_subst_in_place [l1, #1]

factor_in_place
---------------

l1: $ a * b - c * d = a * (b - d) + d * (a - c) $ by factor []
l2: $ p = [x | a * (b - d) + d * (a - c)] q $ by eq_subst_in_place [l1, #1]

mul_sub_in_place
----------------

l1: $ a * b - a * c = a * (b - c) $ by mul_sub []
l2: $ p = [x | a * (b - c)] q $ by eq_subst_in_place [l1, #1]

div_mul_in_place
----------------

l1: $ a * b / c = a * (b / c) $ by div_mul []
l2: $ p = [x | a * (b / c)] q $ by eq_subst_in_place [l1, #1]

lim_add_in_place
----------------

l1: $ lim h (a + b) = lim h a + lim h b $ by lim_add []
l2: $ p = [x | lim h a + lim h b] q $ by eq_subst_in_place [l1, #1]

lim_mul_in_place
----------------

l1: $ lim h (a * b) = (lim h a) * (lim h b) $ by lim_mul []
l2: $ p = [x | (lim h a) * (lim h b)] q $ by eq_subst_in_place [l1, #1]

lim_const_in_place
------------------

l1: $ lim h c = c $ by lim_const []
l2: $ p = [x | c] q $ by eq_subst_in_place [l1, #1]

-- Each calc step keeps its predecessor's LHS, written as _real.
-- Do h-dependent algebra in the body, then lift once with lim_congr.
-- After that, rewrite whole limits and apply hypotheses in place.

sum_rule
--------

l1: $ (fh + gh - (f + g)) / h = (fh + gh - (f + g)) / h $
  by eq_refl []
l2: $ _real = ((fh - f) + (gh - g)) / h $
  by sub_add_in_place [l1]
l3: $ _real = (fh - f) / h + (gh - g) / h $
  by div_add_in_place [l2]

l4: $ lim h ((fh + gh - (f + g)) / h)
    = lim h ((fh - f) / h + (gh - g) / h) $ by lim_congr [l3]
l5: $ _real = lim h ((fh - f) / h) + lim h ((gh - g) / h) $
  by lim_add_in_place [l4]
l6: $ _real = df + lim h ((gh - g) / h) $
  by eq_subst_in_place [#1, l5]
l7: $ _real = df + dg $ by eq_subst_in_place [#2, l6]

const_mul_rule
--------------

l1: $ (c * fh - c * f) / h = (c * fh - c * f) / h $
  by eq_refl []
l2: $ _real = c * (fh - f) / h $ by mul_sub_in_place [l1]
l3: $ _real = c * ((fh - f) / h) $ by div_mul_in_place [l2]

l4: $ lim h ((c * fh - c * f) / h) = lim h (c * ((fh - f) / h)) $
  by lim_congr [l3]
l5: $ _real = (lim h c) * (lim h ((fh - f) / h)) $
  by lim_mul_in_place [l4]
l6: $ _real = c * (lim h ((fh - f) / h)) $ by lim_const_in_place [l5]
l7: $ _real = c * df $ by eq_subst_in_place [#1, l6]

product_rule
------------

-- Factor the numerator, distribute division, then reassociate each term.
l1: $ (fh * gh - f * g) / h = (fh * gh - f * g) / h $
  by eq_refl []
l2: $ _real = (fh * (gh - g) + g * (fh - f)) / h $
  by factor_in_place [l1]
l3: $ _real = fh * (gh - g) / h + g * (fh - f) / h $
  by div_add_in_place [l2]
l4: $ _real = fh * ((gh - g) / h) + g * (fh - f) / h $
  by div_mul_in_place [l3]
l5: $ _real = fh * ((gh - g) / h) + g * ((fh - f) / h) $
  by div_mul_in_place [l4]

-- Lift the body equality and distribute the limits in place.
l6: $ lim h ((fh * gh - f * g) / h)
    = lim h (fh * ((gh - g) / h) + g * ((fh - f) / h)) $
  by lim_congr [l5]
l7: $ _real = lim h (fh * ((gh - g) / h))
            + lim h (g * ((fh - f) / h)) $ by lim_add_in_place [l6]
l8: $ _real = (lim h fh) * (lim h ((gh - g) / h))
            + lim h (g * ((fh - f) / h)) $ by lim_mul_in_place [l7]
l9: $ _real = (lim h fh) * (lim h ((gh - g) / h))
            + (lim h g) * (lim h ((fh - f) / h)) $
  by lim_mul_in_place [l8]

-- Continuity (#3), the two derivatives (#2, #1), and a constant limit.
l10: $ _real = f * (lim h ((gh - g) / h))
             + (lim h g) * (lim h ((fh - f) / h)) $
  by eq_subst_in_place [#3, l9]
l11: $ _real = f * dg + (lim h g) * (lim h ((fh - f) / h)) $
  by eq_subst_in_place [#2, l10]
l12: $ _real = f * dg + g * (lim h ((fh - f) / h)) $
  by lim_const_in_place [l11]
l13: $ _real = f * dg + g * df $ by eq_subst_in_place [#1, l12]

chain_rule
----------

-- Split the quotient through the intermediate value gh - g.
l1: $ ((fgh - fg) / (gh - g)) * ((gh - g) / h) = (fgh - fg) / h $
  by div_cancel []
l2: $ (fgh - fg) / h = ((fgh - fg) / (gh - g)) * ((gh - g) / h) $
  by eq_sym [l1]

l3: $ lim h ((fgh - fg) / h)
    = lim h (((fgh - fg) / (gh - g)) * ((gh - g) / h)) $
  by lim_congr [l2]
l4: $ _real = (lim h ((fgh - fg) / (gh - g)))
            * (lim h ((gh - g) / h)) $ by lim_mul_in_place [l3]
l5: $ _real = df * (lim h ((gh - g) / h)) $
  by eq_subst_in_place [#2, l4]
l6: $ _real = df * dg $ by eq_subst_in_place [#1, l5]
