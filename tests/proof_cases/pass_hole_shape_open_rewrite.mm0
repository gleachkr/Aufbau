delimiter $ ( ) , $;
provable sort wff;
--| @hole _ctx
--| @unknown ?G
sort ctx;

term and (a b: wff): wff;
infixr and: $∧$ prec 30;
term iff (a b: wff): wff;
infixr iff: $↔$ prec 20;
term ctx_eq (g h: ctx): wff;
term emp: ctx;

--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx;
infixl join: $,$ prec 5;
term hyp (a: wff): ctx;
coercion hyp: wff > ctx;
term nd (g: ctx) (a: wff): wff;
infixl nd: $⊢$ prec 0;

--| @relation wff iff iff_refl iff_trans iff_sym iff_mp
axiom iff_refl (a: wff): $ a ↔ a $;
axiom iff_trans (a b c: wff): $ a ↔ b $ > $ b ↔ c $ > $ a ↔ c $;
axiom iff_sym (a b: wff): $ a ↔ b $ > $ b ↔ a $;
axiom iff_mp (a b: wff): $ a ↔ b $ > $ a $ > $ b $;

--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx):
  $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx):
  $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;

--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom nd_congr (g h: ctx) (a b: wff):
  $ ctx_eq g h $ > $ a ↔ b $ > $ (g ⊢ a) ↔ (h ⊢ b) $;

term top: wff;
term sb (t: wff) {x: wff} (r: wff x): wff;
def both (a: wff): wff = $ a ∧ a $;
--| @rewrite
axiom sb_var (t: wff) {x: wff}: $ sb t x x ↔ t $;
--| @rewrite
axiom sb_top (t: wff) {x: wff}: $ sb t x top ↔ top $;
--| @rewrite
axiom sb_and (t: wff) {x: wff} (a b: wff x):
  $ sb t x (a ∧ b) ↔ (sb t x a ∧ sb t x b) $;
--| @congr
axiom and_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a ∧ c) ↔ (b ∧ d) $;

--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;

axiom same (g: ctx) (a: wff): $ g ⊢ a $ > $ g ⊢ a $;
--| @view {x: wff} (g: ctx) (a b: wff) (r: wff x) (p q: wff): $ a ↔ b $ > $ g , p ⊢ top $ > $ g , q ⊢ top $
--| @abstract r p q x a b
axiom repl {x: wff} (g: ctx) (a b: wff) (r: wff x):
  $ a ↔ b $ > $ g , sb a x r ⊢ top $ > $ g , sb b x r ⊢ top $;

-- The context of `l1` is fixed by its own check, not before it: a member
-- under a definition may stand for any number of members. The line that
-- cites it forces only `_ , [a / x] _`, whose second member shows nothing
-- until the substitution can be carried out.
theorem redex_shape {x: wff} (a b c: wff):
  $ a ↔ b $ > $ both c , (a ∧ top) ⊢ top $ > $ both c , (b ∧ top) ⊢ top $;
theorem redex_shape_named {x: wff} (a b c: wff):
  $ a ↔ b $ > $ both c , (a ∧ top) ⊢ top $ > $ both c , (b ∧ top) ⊢ top $;
