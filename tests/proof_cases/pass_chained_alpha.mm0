delimiter $ ( ) , $;
--| @vars y z w
sort obj;
import "lib/ctx.mm0";
import "lib/iff.mm0";

 notation emp: ctx = ($_$:max);

term seq (g d: ctx): wff; infixl seq: $==>$ prec 0;
term all {x: obj} (p: wff x): wff; prefix all: $∀$ prec 41;
term P (t: obj): wff; prefix P: $P$ prec 50;
term sb (t: obj) {x: obj} (p: wff x): wff;
axiom keep (a: wff): $ a $ > $ a $;

--| @congr
axiom hyp_congr (a b: wff): $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;
--| @congr
axiom seq_congr (g1 g2 d1 d2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq d1 d2 $ > $ (g1 ==> d1) ↔ (g2 ==> d2) $;
--| @congr
axiom all_congr {x: obj} (p q: wff x): $ p ↔ q $ > $ ∀ x p ↔ ∀ x q $;
--| @rewrite
axiom sb_P (t: obj) {x: obj}: $ sb t x (P x) ↔ P t $;
--| @rewrite
axiom sb_P_other {x y: obj} (t: obj x): $ sb t x (P y) ↔ P y $;
--| @alpha x y
axiom all_alpha {x y: obj} (p: wff x y): $ ∀ x p ↔ ∀ y (sb y x p) $;
--| @freshen g x
--| @freshen d x
axiom all_right (g d: ctx) {x: obj} (p: wff x):
  $ g ==> d , p $ > $ g ==> d , ∀ x p $;
theorem chained_alpha {a b: obj}:
  $ ∀ a (P a) , P b ==> P b $ >
  $ ∀ a (P a) , P b ==> ∀ a (P b) $;
