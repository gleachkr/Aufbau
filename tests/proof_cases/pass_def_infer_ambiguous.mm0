import "lib/seq.mm0";

term imp (a b: wff): wff;
infixr imp: $->$ prec 25;
def id (a: wff): wff = $ a -> a $;

term bot: wff;

--| @congr
axiom hyp_congr (a b: wff):
  $ a ↔ b $ > $ ctx_eq (hyp a) (hyp b) $;

--| @congr
axiom imp_congr (a b c d: wff):
  $ a ↔ b $ > $ c ↔ d $ > $ (a -> c) ↔ (b -> d) $;

axiom pair_bot_id (g: ctx) (p q: wff): $ g , id p , id q ⇒ bot $;

theorem def_infer_ambiguous (a b: wff):
  $ emp , (a -> a) , (b -> b) ⇒ bot $;
