delimiter $ ( ) $;
provable sort wff;
sort ctx;
sort rc;

term bi (a b: wff): wff;
--| @relation wff bi biid bitr bisym mpbi
axiom biid (a: wff): $ bi a a $;
axiom bitr (a b c: wff): $ bi a b $ > $ bi b c $ > $ bi a c $;
axiom bisym (a b: wff): $ bi a b $ > $ bi b a $;
axiom mpbi (a b: wff): $ bi a b $ > $ a $ > $ b $;
term an (a b: wff): wff;
--| @congr
axiom an_congr (a1 a2 b1 b2: wff):
  $ bi a1 a2 $ > $ bi b1 b2 $ > $ bi (an a1 b1) (an a2 b2) $;
term top: wff;

-- A context, nested to the left.
term emp: ctx;
--| @acui ctx_assoc ctx_comm emp ctx_idem
term join (g h: ctx): ctx; infixl join: $,$ prec 5;
term hyp (a: wff): ctx; coercion hyp: wff > ctx;
term ctx_eq (g h: ctx): wff;
--| @relation ctx ctx_eq ctx_refl ctx_trans ctx_sym _
axiom ctx_refl (g: ctx): $ ctx_eq g g $;
axiom ctx_trans (g h i: ctx): $ ctx_eq g h $ > $ ctx_eq h i $ > $ ctx_eq g i $;
axiom ctx_sym (g h: ctx): $ ctx_eq g h $ > $ ctx_eq h g $;
axiom ctx_assoc (g h i: ctx): $ ctx_eq ((g , h) , i) (g , (h , i)) $;
axiom ctx_comm (g h: ctx): $ ctx_eq (g , h) (h , g) $;
axiom ctx_idem (g: ctx): $ ctx_eq (g , g) g $;
axiom ctx_unit (g: ctx): $ ctx_eq (emp , g) g $;
--| @congr
axiom join_congr (g1 g2 h1 h2: ctx):
  $ ctx_eq g1 g2 $ > $ ctx_eq h1 h2 $ > $ ctx_eq (g1 , h1) (g2 , h2) $;
--| @congr
axiom hyp_congr (a b: wff): $ bi a b $ > $ ctx_eq (hyp a) (hyp b) $;
term ok (g: ctx): wff;
--| @congr
axiom ok_congr (g h: ctx): $ ctx_eq g h $ > $ bi (ok g) (ok h) $;

-- A context nested to the right.
term rnil: rc;
--| @acui rc_assoc rc_comm rnil rc_idem
term rjoin (g h: rc): rc; infixr rjoin: $&$ prec 6;
term rh (a: wff): rc; coercion rh: wff > rc;
term rc_eq (g h: rc): wff;
--| @relation rc rc_eq rc_refl rc_trans rc_sym _
axiom rc_refl (g: rc): $ rc_eq g g $;
axiom rc_trans (g h i: rc): $ rc_eq g h $ > $ rc_eq h i $ > $ rc_eq g i $;
axiom rc_sym (g h: rc): $ rc_eq g h $ > $ rc_eq h g $;
axiom rc_assoc (g h i: rc): $ rc_eq ((g & h) & i) (g & (h & i)) $;
axiom rc_comm (g h: rc): $ rc_eq (g & h) (h & g) $;
axiom rc_idem (g: rc): $ rc_eq (g & g) g $;
axiom rc_unit (g: rc): $ rc_eq (g & rnil) g $;
--| @congr
axiom rjoin_congr (g1 g2 h1 h2: rc):
  $ rc_eq g1 g2 $ > $ rc_eq h1 h2 $ > $ rc_eq (g1 & h1) (g2 & h2) $;
--| @congr
axiom rh_congr (a b: wff): $ bi a b $ > $ rc_eq (rh a) (rh b) $;
term okr (g: rc): wff;
--| @congr
axiom okr_congr (g h: rc): $ rc_eq g h $ > $ bi (okr g) (okr h) $;
axiom okr_ax (g: rc): $ okr g $;

axiom dbl (p: wff): $ p $ > $ an p p $;
axiom both (p: wff): $ p $ > $ p $ > $ top $;

-- A right-nested context with its first two members swapped: each member
-- moved out of the statement must not be dug out from under its whole
-- right spine.
theorem right_nested_swap (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 x29 x30 x31 x32 x33 x34 x35 x36 x37 x38 x39 x40 x41 x42 x43 x44 x45 x46 x47 x48 x49 x50 x51 x52 x53 x54 x55 x56 x57 x58 x59 x60 x61 x62 x63 x64 x65 x66 x67 x68 x69 x70 x71 x72 x73 x74 x75 x76 x77 x78 x79 x80 x81 x82 x83 x84 x85 x86 x87 x88 x89 x90 x91 x92 x93 x94 x95 x96 x97 x98 x99 x100 x101 x102 x103 x104 x105 x106 x107 x108 x109 x110 x111 x112 x113 x114 x115 x116 x117 x118 x119: wff):
  $ okr (x0 & (x1 & (x2 & (x3 & (x4 & (x5 & (x6 & (x7 & (x8 & (x9 & (x10 & (x11 & (x12 & (x13 & (x14 & (x15 & (x16 & (x17 & (x18 & (x19 & (x20 & (x21 & (x22 & (x23 & (x24 & (x25 & (x26 & (x27 & (x28 & (x29 & (x30 & (x31 & (x32 & (x33 & (x34 & (x35 & (x36 & (x37 & (x38 & (x39 & (x40 & (x41 & (x42 & (x43 & (x44 & (x45 & (x46 & (x47 & (x48 & (x49 & (x50 & (x51 & (x52 & (x53 & (x54 & (x55 & (x56 & (x57 & (x58 & (x59 & (x60 & (x61 & (x62 & (x63 & (x64 & (x65 & (x66 & (x67 & (x68 & (x69 & (x70 & (x71 & (x72 & (x73 & (x74 & (x75 & (x76 & (x77 & (x78 & (x79 & (x80 & (x81 & (x82 & (x83 & (x84 & (x85 & (x86 & (x87 & (x88 & (x89 & (x90 & (x91 & (x92 & (x93 & (x94 & (x95 & (x96 & (x97 & (x98 & (x99 & (x100 & (x101 & (x102 & (x103 & (x104 & (x105 & (x106 & (x107 & (x108 & (x109 & (x110 & (x111 & (x112 & (x113 & (x114 & (x115 & (x116 & (x117 & (x118 & x119))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) $;

-- Both premises sit under 16 doublings, each a pair of one shared
-- subterm: the rearrangement inside is proved once, not once per path.
theorem shared_subterms (a b: wff): $ ok (b , a) $ > $ ok (a , b) $ > $ top $;
